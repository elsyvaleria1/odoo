<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_pricelist_form" model="ir.ui.view">
        <field name="name">sale.subscription.product.pricelist.form.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.view_product_pricelist_form" />
        <field name="arch" type="xml">
            <page name="pricelist_rules" position="after">
                <page name="subscription_pricelist_rules" string="Recurring Prices">
                    <field
                        name="subscription_item_ids"
                        nolabel="1"
                        context="{'form_view_ref': 'sale_subscription.view_product_pricelist_item_form_recurring'}">
                        <list string="Subscription Pricelist Rules">
                            <field name="product_tmpl_id" />
                            <field
                                name="product_id"
                                groups="product.group_product_variant" />
                            <field name="plan_id" />
                            <field name="price" />
                            <field name="min_quantity" optional="hide" />

                            <field name="base" column_invisible="True" />
                            <field name="price_discount" column_invisible="True" />
                            <field name="compute_price" column_invisible="True" />
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
