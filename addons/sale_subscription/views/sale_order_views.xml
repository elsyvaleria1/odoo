<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_subscription_order_view_form" model="ir.ui.view">
        <field name="name">sale.subscription.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <sheet position="before">
                <div
                    class="alert alert-warning p-3 text-center"
                    role="alert"
                    invisible="not user_pause_start or next_invoice_date &lt;= current_date">
                    <span>
                        This subscription has been paused by the customer until <field name="next_invoice_date" readonly="1" />
                    </span>
                </div>
            </sheet>
            <button position="before" id="create_invoice">
                <button
                    name="resume_subscription"
                    type="object"
                    string="Resume"
                    invisible="subscription_state != '4_paused'"
                    class="btn-primary"
                    data-hotkey="r" />
            </button>
            <button position="attributes" id="create_invoice">
                <attribute name="invisible">(not is_subscription and not is_invoiceable) or (is_subscription and (state != 'done' or (next_invoice_date &gt; current_date and invoice_state != 'to do')))</attribute>
            </button>
            <button position="after" id="create_invoice">
                <button
                    name="%(sale.action_view_sale_advance_payment_inv)d"
                    id="create_invoice_sub"
                    type="action"
                    string="Create Invoice"
                    invisible="(not is_subscription or state != 'done') or (is_subscription and (invoice_state == 'to do') or (next_invoice_date &lt;= current_date))"
                    class="btn-secondary"
                    data-hotkey="q" />
            </button>
            <button position="attributes" id="create_invoice_percentage">
                <attribute name="invisible" add="is_subscription" separator="or" />
            </button>
            <!-- FIXME ARJ shouldn't overwrite the existing value unless it's a primary view -->
            <!-- <button name="action_cancel" position="attributes">
                <attribute name="invisible">not id or state not in ['draft', 'sent', 'done']</attribute>
            </button> -->
            <separator name="operations" position="before">
                <button
                    name="create_alternative"
                    type="object"
                    string="Create Alternative"
                    invisible="subscription_state != '2_renewal' or state not in ['draft', 'sent']" />
                <button
                    name="create_alternative"
                    type="object"
                    string="Create Alternative"
                    context="{'default_subscription_state': '7_upsell'}"
                    invisible="subscription_state != '7_upsell' or state not in ['draft', 'sent']" />
                <button
                    name="prepare_upsell_order"
                    type="object"
                    string="Upsell"
                    invisible="not is_subscription or subscription_state not in ['3_progress', '4_paused'] or state != 'done'"
                    data-hotkey="e" />
                <button
                    name="prepare_renewal_order"
                    type="object"
                    string="Renew"
                    invisible="not is_subscription or subscription_state not in ['3_progress', '4_paused', '6_churn'] or state != 'done'"
                    data-hotkey="w" />
                <button
                    name="reopen_order"
                    type="object"
                    string="Reopen"
                    invisible="not is_subscription or subscription_state != '6_churn' or state != 'done'"
                    data-hotkey="o" />
            </separator>
            <button name="action_cancel" position="after">
                <!--  Change the label of cancel button for subscription -->
                <button
                    name="%(sale_subscription.sale_subscription_close_reason_wizard_action)d"
                    type="action"
                    string="Close"
                    invisible="subscription_state not in ['3_progress', '4_paused'] or not id"
                    data-hotkey="z" />
            </button>
            <button name="action_unlock" position="attributes">
                <attribute
                    name="invisible"
                    add="subscription_state == '5_renewed'"
                    separator="or" />
            </button>
            <xpath expr="//sheet/div[hasclass('badge')]" position="attributes">
                <attribute
                    name="invisible"
                    add="subscription_state == '5_renewed'"
                    separator="or" />
            </xpath>
            <xpath expr="//sheet" position="before">
                <div
                    role="alert"
                    class="alert alert-info text-center"
                    invisible="not warn_system_closing">
                    <p class="mt-3">This subscription is overdue and exceeds the auto-close limit of the recurring plan. It will be closed soon by the system.</p>
                </div>
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="open_subscription_renewal"
                    type="object"
                    icon="fa-repeat"
                    invisible="not is_renewing"
                    class="oe_stat_button">
                    <field
                        name="renewal_count"
                        string="Renewal Quote"
                        widget="statinfo" />
                </button>
                <button
                    name="open_subscription_upsell"
                    type="object"
                    icon="fa-arrow-circle-o-up"
                    invisible="not is_upselling"
                    class="oe_stat_button">
                    <field
                        name="upsell_count"
                        string="Upsell Quote"
                        widget="statinfo" />
                </button>
                <button
                    name="open_subscription_history"
                    type="object"
                    icon="fa-dollar"
                    invisible="history_count &lt; 2"
                    class="oe_stat_button">
                    <field
                        name="history_count"
                        string="Sales History"
                        widget="statinfo" />
                </button>
                <button
                    name="action_sale_order_log"
                    type="object"
                    icon="fa-line-chart"
                    invisible="not is_subscription or subscription_state in ['1_draft', '2_renewal'] or state == 'cancel'"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex">
                            <field name="currency_id" invisible="True" />
                            <field name="recurring_monthly" />
                        </span>
                        <span class="o_stat_text">MRR</span>
                    </div>
                    </button>
            </div>
            <div name="button_box" position="after">
                <div class="px-2 rounded-pill text-bg-danger float-end" invisible="not payment_exception">Payment Failure</div>
                <div class="px-2 rounded-pill text-bg-warning float-end" invisible="not pending_transaction">Pending transaction</div>
                <field
                    name="subscription_state"
                    widget="badge"
                    invisible="subscription_state not in ['2_renewal', '5_renewed', '7_upsell'] or state not in ['draft', 'sent']"
                    class="float-end"
                    decoration-info="subscription_state in ['2_renewal']"
                    decoration-primary="subscription_state in ['7_upsell']"
                    decoration-secondary="subscription_state in ['5_renewed']" />
                <field
                    name="subscription_state"
                    widget="badge"
                    invisible="subscription_state not in ['3_progress', '4_paused', '5_renewed', '6_churn'] or state == 'cancel'"
                    class="float-end"
                    decoration-danger="subscription_state in ['6_churn']"
                    decoration-info="subscription_state in ['1_draft']"
                    decoration-success="subscription_state in ['3_progress', '5_renewed']"
                    decoration-warning="subscription_state in ['4_paused']" />
                <div name="subscription_quotation_pill" class="float-end badge rounded-pill fw-bold text-bg-info" invisible="subscription_state != '1_draft' or state not in ['draft', 'sent']">Subscription Quotation</div>
                <div name="late_pill" invisible="not display_late">
                    <div name="subscription_to_renew" class="float-end badge rounded-pill fw-bold text-bg-warning" invisible="not payment_token_id and require_payment">To Renew</div>
                    <div name="subscription_waiting_payment" class="float-end badge rounded-pill fw-bold text-bg-warning" invisible="payment_token_id or not require_payment">Waiting customer payment</div>
                </div>
                <div
                    name="subscription_closing_pill"
                    class="o_field_badge float-end fs-6 mx-1"
                    invisible="not is_closing">
                    <span class="badge rounded-pill text-bg-warning">Closing</span>
                </div>
            </div>
            <field name="pricelist_id" position="attributes">
                <attribute
                    name="readonly"
                    add="subscription_state not in ['3_progress', '4_paused']"
                    separator="and" />
            </field>
            <label for="pricelist_id" position="before">
                <label
                    name="plan_label"
                    for="plan_id"
                    invisible="not plan_id and state in ['done', 'cancel']" />
                    <div
                        name="plan_block"
                        class="o_row"
                        invisible="not plan_id and state in ['done', 'cancel']">
                        <field
                            name="plan_id"
                            options="{'no_create': True}"
                            groups="!sale.group_sale_manager"
                            readonly="subscription_state in ['3_progress', '4_paused', '5_renewed', '6_churn', '7_upsell']"
                            required="has_recurring_line" />
                        <field
                            name="plan_id"
                            options="{'no_create': True}"
                            groups="sale.group_sale_manager"
                            readonly="subscription_state == '7_upsell'" />
                        <span invisible="not plan_id or subscription_state == '7_upsell'">until</span>
                        <field
                            name="end_date"
                            invisible="not plan_id or subscription_state == '7_upsell'" />
                </div>
                <field
                    name="next_invoice_date"
                    groups="!sale.group_sale_manager"
                    invisible="subscription_state not in ['3_progress', '4_paused'] or not plan_id"
                    readonly="True"
                    required="plan_id and state == 'done'" />
                <field
                    name="next_invoice_date"
                    groups="sale.group_sale_manager"
                    invisible="subscription_state not in ['3_progress', '4_paused'] or not plan_id"
                    required="plan_id and state == 'done'" />
                <field
                    name="close_reason_id"
                    groups="sale.group_sale_manager"
                    invisible="subscription_state != '6_churn'" />
                <field
                    name="close_reason_id"
                    groups="!sale.group_sale_manager"
                    invisible="subscription_state != '6_churn'"
                    readonly="True" />
            </label>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='name']"
                position="after">
                <field name="recurring_invoice" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='price_subtotal']"
                position="attributes">
                <attribute name="decoration-info">recurring_invoice</attribute>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='price_total']"
                position="attributes">
                <attribute name="decoration-info">recurring_invoice</attribute>
            </xpath>
            <field name="require_payment" position="attributes">
                <attribute name="help">Request a online payment from the customer to confirm the order. For a subscription, a payment will be required also before each renewal</attribute>
            </field>
            <page name="customer_signature" position="after">
                <page name="notes" string="Notes">
                    <field
                        name="internal_note_display"
                        placeholder="Internal notes"
                        nolabel="1" />
                </page>
            </page>
            <group name="invoice_info" position="before">
                <group
                    name="subscription_info"
                    string="Subscription"
                    invisible="not is_subscription and subscription_state != '7_upsell'">
                    <field
                        name="start_date"
                        groups="!sale.group_sale_manager"
                        readonly="subscription_state in ['2_renewal', '3_progress', '4_paused']" />
                    <field
                        name="start_date"
                        groups="sale.group_sale_manager"
                        readonly="subscription_state == '2_renewal'" />
                    <field name="first_contract_date" invisible="not origin_order_id" />
                    <field
                        name="origin_order_id"
                        invisible="not origin_order_id"
                        readonly="1" />
                    <field
                        name="subscription_id"
                        groups="base.group_no_one"
                        readonly="1" />
                    <field
                        name="payment_token_id"
                        options="{'no_create': True}"
                        groups="base.group_no_one" />
                    <field name="payment_exception" groups="base.group_no_one" />
                    <field name="pending_transaction" groups="base.group_no_one" />
                </group>
            </group>
            <field name="tax_totals" position="after">
                <field
                    name="recurring_details"
                    colspan="2"
                    nolabel="1"
                    invisible="not recurring_details" />
            </field>
        </field>
    </record>

    <record id="view_sale_order_list" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_list" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field
                    name="subscription_state"
                    widget="badge"
                    optional="hide"
                    readonly="1"
                    decoration-danger="subscription_state == '6_churn'"
                    decoration-info="subscription_state in ['1_draft', '2_renewal']"
                    decoration-primary="subscription_state == '7_upsell'"
                    decoration-success="subscription_state == '3_progress'"
                    decoration-warning="subscription_state == '4_paused'" />
                <field name="recurring_total" optional="hide" />
                <field name="plan_id" optional="hide" />
                <field name="recurring_monthly" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_sale_order_list_2" model="ir.ui.view">
        <field name="name">sale.order.list</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_list_2" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="decoration-warning">subscription_state == '4_paused'</attribute>
            </list>
        </field>
    </record>

    <record id="view_sale_order_search_subscription" model="ir.ui.view">
        <field name="name">sale.order.filter.subscription</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_search" />
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator />
                <filter
                    name="recurring"
                    string="Recurring"
                    domain="[('is_subscription', '=', True)]" />
                <filter
                    name="not_recurring"
                    string="Not Recurring"
                    domain="[('is_subscription', '=', False)]" />
            </filter>
        </field>
    </record>

</odoo>
