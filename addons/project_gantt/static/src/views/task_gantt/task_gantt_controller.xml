<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_gantt.TaskGanttController" t-inherit="web_gantt.GanttController" t-inherit-mode="primary">
        <button class="o_gantt_button_add btn btn-primary" position="replace">
            <ProjectTaskTemplateDropdown
                projectId="this.props.context.default_project_id"
                onCreate="() => this.onNewClicked()"
                newButtonClasses="'o_gantt_button_add btn btn-primary'"
                hotkey="this.r"
                context="this.props.context"
                getAdditionalContext.bind="this.getCreateContext"
            />
        </button>
    </t>
</templates>
