<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_gantt.GanttRenderer.Pill" t-inherit="web_gantt.GanttRenderer.Pill" t-inherit-mode="primary">
        <xpath expr="//span[hasclass('o_gantt_pill_title')]" position="attributes">
            <attribute name="t-out">
                " " + pill.displayName + " " + pill.record.waiting_list_capacity + "p"
            </attribute>
        </xpath>
    </t>
    <t t-name="pos_gantt.GanttRenderer.RowHeader" t-inherit="web_gantt.GanttRenderer.RowHeader" t-inherit-mode="primary">
        <xpath expr='//t[@t-out="row.name"]' position="replace">
            <t t-else="">
                <t t-if="row.resId" t-out="row.name"/>
                <span t-else="">Unassigned</span>
            </t>
        </xpath>
    </t>
</templates>
