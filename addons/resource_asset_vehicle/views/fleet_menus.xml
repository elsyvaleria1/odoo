<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        A vehicle is an asset, so its menus live in the Assets app instead of an
        app of their own: the day-to-day entries under a "Vehicles" section, and
        the catalog and tags under the Assets configuration.
    -->
    <menuitem
        id="fleet_vehicles"
        name="Vehicles"
        parent="base.menu_asset_root"
        sequence="5"
        groups="fleet_group_user" />

    <menuitem
        id="fleet_vehicle_menu"
        parent="fleet_vehicles"
        action="fleet_vehicle_action"
        sequence="0"
        groups="fleet_group_user" />

    <menuitem
        id="fleet_vehicle_log_services_menu"
        parent="fleet_vehicles"
        action="fleet_vehicle_service_action"
        sequence="3"
        groups="fleet_group_user" />

    <menuitem
        id="fleet_vehicle_odometer_menu"
        parent="fleet_vehicles"
        action="fleet_vehicle_odometer_action"
        sequence="10"
        groups="fleet_group_user" />

    <menuitem
        id="menu_fleet_reporting_costs"
        parent="fleet_vehicles"
        action="fleet_costs_reporting_action"
        sequence="20"
        groups="fleet_group_manager" />

    <menuitem
        id="fleet_models_configuration"
        name="Vehicle Models"
        parent="base.menu_asset_config"
        sequence="10"
        groups="fleet_group_manager" />

    <menuitem
        id="fleet_vehicle_model_brand_menu"
        parent="fleet_models_configuration"
        action="product.action_partner_manufacturers"
        sequence="1"
        groups="fleet_group_manager" />

    <menuitem
        id="fleet_vehicle_model_menu"
        parent="fleet_models_configuration"
        action="fleet_vehicle_model_action"
        sequence="2"
        groups="fleet_group_manager" />

    <menuitem
        id="fleet_vehicles_configuration"
        name="Vehicle"
        parent="base.menu_asset_config"
        sequence="11"
        groups="base.group_no_one" />

    <menuitem
        id="fleet_vehicle_tag_menu"
        parent="fleet_vehicles_configuration"
        action="fleet_vehicle_tag_action"
        sequence="2"
        groups="fleet_group_manager" />

</odoo>
