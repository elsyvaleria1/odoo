#. module: approval_shipment_telegram
#. odoo-python
#: code:addons/approval_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid ""
"%(picking)s keeps the tracking number and the sheet, but I could not prepare"
" the freight request %(category)s: %(reason)s"
msgstr ""
"%(picking)s conserva la guía y la hoja, pero no pude preparar la solicitud "
"de flete %(category)s: %(reason)s"

#. module: approval_shipment_telegram
#: model:ir.model.fields,help:approval_shipment_telegram.field_delivery_carrier__freight_approval_category_id
msgid ""
"A shipping order sent with /embarque prepares a draft request of this "
"category for the freight. Empty: none is prepared."
msgstr ""
"Una hoja de embarque enviada con /embarque prepara un borrador de "
"solicitud de esta categoría para el flete. Vacío: no se prepara "
"ninguna."

