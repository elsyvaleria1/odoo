#: code:addons/approval_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid ""
"Freight request %(category)s prepared as a draft without an amount: the "
"total could not be read off the sheet."
msgstr ""
"Solicitud de flete %(category)s preparada en borrador sin monto: no "
"se pudo leer el total de la hoja."

