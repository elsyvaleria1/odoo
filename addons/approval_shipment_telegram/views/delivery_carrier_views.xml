<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_carrier_form_freight" model="ir.ui.view">
        <field name="name">delivery.carrier.form.freight</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <field name="tracking_url" position="after">
                <field name="freight_approval_category_id" />
                <field
                    name="freight_partner_id"
                    invisible="not freight_approval_category_id" />
            </field>
        </field>
    </record>

</odoo>
