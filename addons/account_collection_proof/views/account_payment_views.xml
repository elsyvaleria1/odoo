<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.account.collection.proof</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_collection.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="collection_method" position="after">
                <field
                    name="confirmation_state"
                    widget="badge"
                    invisible="not confirmation_state"
                    decoration-danger="confirmation_state == 'disputed'"
                    decoration-info="confirmation_state == 'pending'"
                    decoration-success="confirmation_state == 'confirmed'"
                    decoration-warning="confirmation_state in ('unreachable', 'expired')" />
                <field name="confirmation_date" invisible="not confirmation_date" />
                <field
                    name="confirmation_sent_to"
                    invisible="not confirmation_sent_to" />
                <widget
                    name="proof_button"
                    string="Customer Is Here: Confirm With a Code"
                    invisible="confirmation_state not in ('pending', 'unreachable', 'expired')"
                    issue="action_issue_confirmation_code"
                    submit="action_prove_confirmation_code" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.list.inherit.account.collection.proof</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_collection.view_account_payment_tree" />
        <field name="arch" type="xml">
            <field name="collection_method" position="after">
                <field
                    name="confirmation_state"
                    widget="badge"
                    optional="show"
                    decoration-danger="confirmation_state == 'disputed'"
                    decoration-info="confirmation_state == 'pending'"
                    decoration-success="confirmation_state == 'confirmed'"
                    decoration-warning="confirmation_state in ('unreachable', 'expired')" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field
            name="name">account.payment.search.inherit.account.collection.proof</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_collection.view_account_payment_search" />
        <field name="arch" type="xml">
            <filter name="far_from_customer" position="after">
                <filter
                    name="customer_unconfirmed"
                    string="Not Confirmed by the Customer"
                    domain="[('confirmation_state', 'in', ('pending', 'unreachable', 'expired', 'disputed'))]" />
                <filter
                    name="customer_disputed"
                    string="Disputed by the Customer"
                    domain="[('confirmation_state', '=', 'disputed')]" />
            </filter>
        </field>
    </record>

</odoo>
