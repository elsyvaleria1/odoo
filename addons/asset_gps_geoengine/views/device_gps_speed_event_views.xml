<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_device_gps_speed_event_list" model="ir.ui.view">
        <field name="name">device.gps.speed.event.list</field>
        <field name="model">device.gps.speed.event</field>
        <field name="arch" type="xml">
            <list
                create="0"
                edit="0"
                decoration-danger="level == 'critical'"
                decoration-warning="level == 'alert'">
                <field name="start" />
                <field name="operator_id" />
                <field name="asset_id" />
                <field name="device_id" optional="hide" />
                <field name="speed_max" decoration-bf="1" />
                <field name="speed_avg" optional="show" />
                <field name="speed_limit" optional="show" />
                <field
                    name="level"
                    widget="badge"
                    decoration-danger="level == 'critical'"
                    decoration-info="level == 'warning'"
                    decoration-warning="level == 'alert'" />
                <field name="duration_min" sum="Total" />
                <field name="distance_km" optional="show" sum="Total" />
                <field name="place" />
                <field name="nearby_partner_id" optional="hide" />
                <field name="state_id" optional="hide" />
                <field name="date" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
                <button
                    name="action_view_trail"
                    type="object"
                    string="View Trail"
                    icon="fa-map-marker" />
            </list>
        </field>
    </record>

    <record id="view_device_gps_speed_event_graph" model="ir.ui.view">
        <field name="name">device.gps.speed.event.graph</field>
        <field name="model">device.gps.speed.event</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1">
                <field name="operator_id" />
                <field name="level" />
            </graph>
        </field>
    </record>

    <record id="view_device_gps_speed_event_search" model="ir.ui.view">
        <field name="name">device.gps.speed.event.search</field>
        <field name="model">device.gps.speed.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="operator_id" />
                <field name="asset_id" />
                <field name="nearby_partner_id" />
                <field name="state_id" />
                <filter
                    name="critical"
                    string="Critical"
                    domain="[('level', '=', 'critical')]" />
                <filter
                    name="alert"
                    string="Alert"
                    domain="[('level', '=', 'alert')]" />
                <filter
                    name="warning"
                    string="Warning"
                    domain="[('level', '=', 'warning')]" />
                <separator />
                <filter
                    name="today"
                    string="Today"
                    domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter
                    name="this_week"
                    string="This Week"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]" />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter
                        name="group_operator"
                        string="Operator"
                        context="{'group_by': 'operator_id'}" />
                    <filter
                        name="group_asset"
                        string="Vehicle"
                        context="{'group_by': 'asset_id'}" />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'date:day'}" />
                    <filter
                        name="group_week"
                        string="Week"
                        context="{'group_by': 'date:week'}" />
                    <filter
                        name="group_level"
                        string="Level"
                        context="{'group_by': 'level'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state_id'}" />
                    <filter
                        name="group_client"
                        string="Nearest Client"
                        context="{'group_by': 'nearby_partner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_device_gps_speed_event" model="ir.actions.act_window">
        <field name="name">Speeding Events</field>
        <field name="res_model">device.gps.speed.event</field>
        <field name="view_mode">list,graph</field>
        <field name="search_view_id" ref="view_device_gps_speed_event_search" />
        <field
            name="context">{'search_default_this_week': 1, 'search_default_group_operator': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No speeding events</p>
            <p>Each row is one continuous stretch above the device's warning
                limit. The ones that passed the critical limit are in red.</p>
        </field>
    </record>

    <record id="view_device_gps_speed_day_list" model="ir.ui.view">
        <field name="name">device.gps.speed.day.list</field>
        <field name="model">device.gps.speed.day</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="over_critical">
                <field name="date" />
                <field name="operator_id" />
                <field name="asset_id" />
                <field name="device_id" optional="hide" />
                <field name="speed_max" string="Max Speed" decoration-bf="1" />
                <field name="speed_min" string="Min Speed" />
                <field name="speed_avg" string="Avg Speed" optional="show" />
                <field
                    name="speed_limit_critical"
                    string="Critical Limit"
                    optional="hide" />
                <field name="over_critical" optional="hide" />
                <field name="first_seen" string="First Position" optional="show" />
                <field name="last_seen" string="Last Position" optional="show" />
                <field name="moving_positions" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_device_gps_speed_day_graph" model="ir.ui.view">
        <field name="name">device.gps.speed.day.graph</field>
        <field name="model">device.gps.speed.day</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="operator_id" />
                <field name="speed_max" type="measure" />
            </graph>
        </field>
    </record>

    <record id="view_device_gps_speed_day_search" model="ir.ui.view">
        <field name="name">device.gps.speed.day.search</field>
        <field name="model">device.gps.speed.day</field>
        <field name="arch" type="xml">
            <search>
                <field name="operator_id" />
                <field name="asset_id" />
                <filter
                    name="over_critical"
                    string="Over the Critical Limit"
                    domain="[('over_critical', '=', True)]" />
                <separator />
                <filter
                    name="today"
                    string="Today"
                    domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]" />
                <filter
                    name="this_week"
                    string="This Week"
                    domain="[('date', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]" />
                <filter name="date" string="Date" date="date" />
                <group>
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'date:day'}" />
                    <filter
                        name="group_operator"
                        string="Operator"
                        context="{'group_by': 'operator_id'}" />
                    <filter
                        name="group_asset"
                        string="Vehicle"
                        context="{'group_by': 'asset_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_device_gps_speed_day" model="ir.actions.act_window">
        <field name="name">Daily Speed</field>
        <field name="res_model">device.gps.speed.day</field>
        <field name="view_mode">list,graph</field>
        <field name="search_view_id" ref="view_device_gps_speed_day_search" />
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No GPS positions</p>
            <p>One row per vehicle and day with the maximum, minimum and average
                speed of the whole route. The ones that passed the device's
                critical limit are in red.</p>
        </field>
    </record>

</odoo>
