<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_molecular_screening" model="res.groups.privilege">
        <field name="name">Molecular Screening</field>
        <field name="category_id" ref="base.module_category_productivity" />
        <field name="sequence" eval="20" />
    </record>

    <record id="group_molecular_screening_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="res_groups_privilege_molecular_screening" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_molecular_screening_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="res_groups_privilege_molecular_screening" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_molecular_screening_user'))]" />
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
