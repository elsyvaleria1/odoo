<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="stock_barcode.LineDestinationLocation" t-inherit-mode="extension">
        <xpath expr="//div[@name='destination_location']" position="after">
            <div t-if="this.pickingName &amp;&amp; !this.props.hidePickingName" class="small">
                <i class="fa-solid fa-truck me-1" role="img" />
                <span class="o_picking_label" t-out="this.pickingName"/>
            </div>
        </xpath>
    </t>

    <t t-inherit="stock_barcode.LineComponent" t-inherit-mode="extension" t-translation="off">
        <xpath expr="//div[hasclass('o_barcode_line')]" position="attributes">
            <attribute name="t-att-style">(this.line.colorLine or this.line.colorLine === 0) ? 'border-color: hsla(' + this.line.colorLine + ', 80%, 50%, 0.6);' : ''</attribute>
        </xpath>
        <xpath expr="//div[@name='package']" position="attributes">
            <attribute name="t-if">this.line.package_id || this.line.result_package_id || this.line.suggested_package</attribute>
        </xpath>
        <xpath expr="//div[@name='package']" position="inside">
            <span t-if="!this.line.result_package_id &amp;&amp; this.line.suggested_package"
                  t-out="this.line.suggested_package + ' ?'" class="text-muted ms-1"/>
        </xpath>
    </t>

</templates>
