<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_put_in_pack_form" model="ir.ui.view">
        <field name="name">stock.put.in.pack.form</field>
        <field name="model">wizard.stock.move.line.put.in.pack</field>
        <field name="inherit_id" ref="stock.stock_put_in_pack_form" />
        <field name="arch" type="xml">
            <div name="package_weight" position="after">
                <field name="iot_ip" invisible="1" />
                <field name="available_scale_ids" invisible="1" />
                <field name="iot_device_identifier" invisible="1" />
                <field name="manual_measurement" invisible="1" />
                <field
                    name="iot_device_id"
                    widget="field_many2one_iot_scale"
                    domain="[('id', 'in', available_scale_ids)]"
                    options="{'value_field': 'shipping_weight', 'identifier': 'iot_device_identifier', 'ip_field': 'iot_ip', 'manual_measurement_field': 'manual_measurement'}"
                    invisible="not package_carrier_type or (not package_type_id and not result_package_id)" />
            </div>
        </field>
    </record>

</odoo>
