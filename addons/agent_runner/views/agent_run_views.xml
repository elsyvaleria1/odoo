<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agent_run_search" model="ir.ui.view">
        <field name="name">agent.run.search</field>
        <field name="model">agent.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="kind" />
                <field name="runner_id" />
                <filter
                    name="filter_open"
                    string="Open"
                    domain="[('run_state', 'in', ('queued', 'leased', 'running'))]" />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('run_state', '=', 'failed')]" />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'run_state'}" />
                    <filter
                        name="group_by_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}" />
                    <filter
                        name="group_by_runner"
                        string="Runner"
                        context="{'group_by': 'runner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_agent_run_list" model="ir.ui.view">
        <field name="name">agent.run.list</field>
        <field name="model">agent.run</field>
        <field name="arch" type="xml">
            <list string="Agent Runs" create="false">
                <field name="name" />
                <field name="kind" />
                <field name="runner_id" optional="show" />
                <field name="count_attempt" optional="show" />
                <field name="date_started" optional="show" />
                <field name="date_finished" optional="hide" />
                <field name="cost" optional="show" sum="Cost" />
                <field
                    name="run_state"
                    widget="badge"
                    decoration-danger="run_state == 'failed'"
                    decoration-info="run_state in ('leased', 'running')"
                    decoration-muted="run_state == 'cancelled'"
                    decoration-success="run_state == 'succeeded'" />
            </list>
        </field>
    </record>

    <record id="view_agent_run_form" model="ir.ui.view">
        <field name="name">agent.run.form</field>
        <field name="model">agent.run</field>
        <field name="arch" type="xml">
            <form string="Agent Run" create="false">
                <header>
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="run_state not in ('queued', 'leased', 'running')" />
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry"
                        invisible="run_state not in ('failed', 'cancelled')"
                        class="btn-primary" />
                    <field
                        name="run_state"
                        widget="statusbar"
                        statusbar_visible="queued,running,succeeded" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group name="work" string="Work">
                            <field name="kind" readonly="1" />
                            <field name="capability_id" readonly="1" />
                            <field name="priority" />
                            <field name="max_attempts" />
                            <field name="ml_purpose" invisible="not ml_purpose" />
                            <field name="res_model" invisible="not res_model" />
                            <field name="res_id" invisible="not res_model" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group name="lease" string="Lease">
                            <field name="runner_id" />
                            <field name="count_attempt" />
                            <field name="date_lease_until" />
                            <field name="date_started" />
                            <field name="date_finished" />
                        </group>
                        <group name="usage" string="Usage">
                            <field name="count_input_token" />
                            <field name="count_output_token" />
                            <field name="cost" />
                        </group>
                    </group>
                    <field name="error" invisible="not error" class="text-danger" />
                    <notebook>
                        <page name="events" string="Events">
                            <field name="event_ids">
                                <list>
                                    <field name="date_event" />
                                    <field name="event_type" />
                                    <field name="message" />
                                </list>
                            </field>
                        </page>
                        <page name="payload" string="Payload">
                            <field name="payload" />
                        </page>
                        <page name="result" string="Result">
                            <field name="result" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_agent_run" model="ir.actions.act_window">
        <field name="name">Agent Runs</field>
        <field name="res_model">agent.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No run is waiting</p>
            <p>The modules that hand work to runners queue it here.</p>
        </field>
    </record>

</odoo>
