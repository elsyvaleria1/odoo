<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agent_runner_list" model="ir.ui.view">
        <field name="name">agent.runner.list</field>
        <field name="model">agent.runner</field>
        <field name="arch" type="xml">
            <list string="Agent Runners">
                <field name="name" />
                <field name="capability_ids" widget="many2many_tags" />
                <field name="concurrency" optional="show" />
                <field name="date_last_seen" />
                <field name="is_online" widget="boolean" optional="show" />
            </list>
        </field>
    </record>

    <record id="view_agent_runner_form" model="ir.ui.view">
        <field name="name">agent.runner.form</field>
        <field name="model">agent.runner</field>
        <field name="arch" type="xml">
            <form string="Agent Runner">
                <header>
                    <button
                        name="action_issue_token"
                        type="object"
                        string="Issue Token"
                        confirm="Any token issued before stops working. Continue?"
                        class="btn-primary" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. runner-1" /></h1>
                    </div>
                    <group>
                        <group string="Work">
                            <field name="capability_ids" widget="many2many_tags" />
                            <field name="concurrency" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                        <group string="Connection">
                            <field name="date_last_seen" />
                            <field name="is_online" />
                            <field
                                name="credential_fingerprint"
                                string="Token Fingerprint" />
                            <field name="service_user_id" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="runs" string="Runs">
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="run_state" />
                                    <field name="date_started" />
                                    <field name="date_finished" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_agent_runner" model="ir.actions.act_window">
        <field name="name">Agent Runners</field>
        <field name="res_model">agent.runner</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a runner machine</p>
            <p>Each runner claims work of the capabilities it is given, with a token of its own.</p>
        </field>
    </record>

</odoo>
