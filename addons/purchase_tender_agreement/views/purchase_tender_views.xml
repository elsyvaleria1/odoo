<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_tender_view_form_agreement" model="ir.ui.view">
        <field name="name">purchase.tender.form.agreement</field>
        <field name="model">purchase.tender</field>
        <field name="inherit_id" ref="purchase_tender.purchase_tender_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_agreements"
                    type="object"
                    icon="fa-handshake-o"
                    invisible="not agreement_count"
                    class="oe_stat_button">
                    <field
                        name="agreement_count"
                        string="Agreements"
                        widget="statinfo" />
                </button>
            </div>
            <field name="date_deadline" position="after">
                <field name="award_as" widget="radio" readonly="state != 'open'" />
                <field
                    name="agreement_commitment"
                    invisible="award_as != 'agreements'"
                    readonly="state != 'open'" />
                <label
                    for="date_start"
                    string="Supply Period"
                    invisible="award_as != 'agreements'" />
                <div class="o_row" invisible="award_as != 'agreements'">
                    <field name="date_start" readonly="state != 'open'" />
                    <i class="fa fa-long-arrow-right mx-2" title="to" />
                    <field name="date_end" readonly="state != 'open'" />
                </div>
            </field>
        </field>
    </record>

    <record id="purchase_order_form_tender_agreement" model="ir.ui.view">
        <field name="name">purchase.order.form.tender.agreement</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_tender.purchase_order_form_inherit_tender" />
        <field name="arch" type="xml">
            <field name="tender_id" position="after">
                <field
                    name="awarded_agreement_id"
                    invisible="not awarded_agreement_id" />
            </field>
        </field>
    </record>

</odoo>
