<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_error_incident_autofix_policy_form" model="ir.ui.view">
        <field name="name">error.incident.autofix.policy.form</field>
        <field name="model">error.incident.autofix.policy</field>
        <field name="arch" type="xml">
            <form string="Autofix Policy">
                <header>
                    <field
                        name="mode"
                        widget="statusbar"
                        options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group string="When">
                            <field name="min_occurrences" />
                            <field name="require_internal_user" />
                            <field name="excluded_exception_types" />
                            <field name="excluded_modules" />
                        </group>
                        <group string="How Much">
                            <field name="company_id" />
                            <field name="daily_run_cap" />
                            <field name="max_attempts" />
                        </group>
                        <group string="Agents">
                            <field name="diagnose_model" />
                            <field name="diagnose_timeout" />
                            <field name="fix_model" />
                            <field name="fix_timeout" />
                        </group>
                        <group string="Commits">
                            <field name="commit_author_name" />
                            <field name="commit_author_email" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_error_incident_autofix_repository_list" model="ir.ui.view">
        <field name="name">error.incident.autofix.repository.list</field>
        <field name="model">error.incident.autofix.repository</field>
        <field name="arch" type="xml">
            <list string="Repositories" editable="bottom">
                <field name="checkout" />
                <field name="github_repository" />
                <field name="base_branch" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_error_incident_autofix_prompt_list" model="ir.ui.view">
        <field name="name">error.incident.autofix.prompt.list</field>
        <field name="model">error.incident.autofix.prompt</field>
        <field name="arch" type="xml">
            <list string="Prompts">
                <field name="phase" />
                <field name="version" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_error_incident_autofix_prompt_form" model="ir.ui.view">
        <field name="name">error.incident.autofix.prompt.form</field>
        <field name="model">error.incident.autofix.prompt</field>
        <field name="arch" type="xml">
            <form string="Prompt">
                <sheet>
                    <group>
                        <field name="phase" />
                        <field name="version" />
                        <field name="active" />
                    </group>
                    <field name="body" widget="text" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_error_incident_autofix_policy" model="ir.actions.act_window">
        <field name="name">Autofix Policy</field>
        <field name="res_model">error.incident.autofix.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_error_incident_autofix_repository" model="ir.actions.act_window">
        <field name="name">Autofix Repositories</field>
        <field name="res_model">error.incident.autofix.repository</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_error_incident_autofix_prompt" model="ir.actions.act_window">
        <field name="name">Autofix Prompts</field>
        <field name="res_model">error.incident.autofix.prompt</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
