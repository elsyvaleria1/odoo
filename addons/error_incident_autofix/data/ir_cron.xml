<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_autofix_check_production" model="ir.cron">
        <field name="name">Autofix: Ask Production Which Fixes It Runs</field>
        <field name="model_id" ref="error_incident.model_error_incident" />
        <field name="state">code</field>
        <field name="code">model._cron_autofix_check_production()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="10" />
        <field name="repeat_unit">minute</field>
        <field name="priority" eval="40" />
        <field name="active" eval="True" />
    </record>

</odoo>
