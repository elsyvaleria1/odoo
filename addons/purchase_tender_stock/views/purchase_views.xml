<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_purchase_tender_stock" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.tender.stock</field>
        <field name="model">purchase.order</field>
        <field
            name="inherit_id"
            ref="purchase_tender.purchase_order_form_inherit_tender" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='alternative_pos']//field[@name='alternative_po_ids']//field[@name='partner_id']"
                position="after">
                <field
                    name="on_time_rate_perc"
                    widget="percentage"
                    invisible="on_time_rate_perc &lt; 0" />
            </xpath>
        </field>
    </record>

    <record
        id="purchase_order_line_compare_tree_inherit_purchase_tender_stock"
        model="ir.ui.view">
        <field
            name="name">purchase.order.line.compare.list.purchase.tender.stock</field>
        <field name="model">purchase.order.line</field>
        <field
            name="inherit_id"
            ref="purchase_tender.purchase_order_line_compare_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="on_time_rate_perc"
                    widget="percentage"
                    invisible="on_time_rate_perc &lt; 0" />
            </field>
        </field>
    </record>

</odoo>
