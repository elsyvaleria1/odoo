<templates>
    <t t-name="voip.CallStatusBadgeField">
        <span class="badge rounded-pill" t-att-class="this.badgeClass" t-if="this.props.record.data[this.props.name]">
            <i class="me-1" t-att-class="this.iconClass" aria-hidden="true"/>
            <span t-out="this.statusLabel"/>
        </span>
    </t>
</templates>
