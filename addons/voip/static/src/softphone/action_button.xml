<?xml version="1.0"?>
<templates>
<t t-name="voip.ActionButton">
    <button t-if="this.props.inCallPad" t-attf-class="btn btn-{{ this.props.type }} d-flex flex-column justify-content-center align-items-center p-2 {{ this.props.disabled and 'opacity-25' }} {{ this.props.extraClass or '' }}" t-att-title="this.props.title or this.props.name" t-att-disabled="this.props.disabled" t-on-click="this.props.onClick">
        <i t-attf-class="o-voip-ActionButton-icon {{ this.iconLib }} {{ this.props.icon }} p-1" aria-hidden="true"/>
        <span t-if="!this.props.hideLabel" class="text-center smaller text-truncate" t-out="this.props.name"/>
    </button>
    <div t-else="" class="position-relative d-flex flex-column align-items-center gap-1" t-att-class="this.props.extraClass">
        <button t-attf-class="o-voip-ActionButton btn btn-{{ this.props.type }} d-flex rounded-circle {{ this.props.isSmall ? 'p-2' : 'p-3' }}" t-att-class="{ 'o-label-hidden': this.props.hideLabel }" t-att-title="this.props.title or this.props.name" t-on-click="this.props.onClick" t-att-disabled="this.props.disabled">
            <i t-attf-class="o-voip-ActionButton-icon {{ this.iconLib }} {{ this.props.icon }}" aria-hidden="true"/>
        </button>
        <span t-if="!this.props.hideLabel" class="text-center smaller" t-out="this.props.name"/>
    </div>
</t>
</templates>
