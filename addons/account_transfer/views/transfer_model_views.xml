<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SEARCH VIEW -->
    <record id="view_generated_transfer_search" model="ir.ui.view">
        <field name="name">account.auto.transfer.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="transfer_model_id" />
            </xpath>
        </field>
    </record>

    <!-- ACTIONS -->
    <!--    MOVE MODELS (FROM MENU) -->
    <record id="transfer_model_action" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">account.transfer.model</field>
        <field name="path">transfers</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--    GENERATED MOVES -->
    <record id="generated_transfers_action" model="ir.actions.act_window">
        <field name="name">Generated Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree" />
        <field name="search_view_id" ref="view_generated_transfer_search" />
    </record>

    <!-- VIEWS -->
    <!--    LIST -->
    <record id="view_transfer_model_tree" model="ir.ui.view">
        <field name="name">account.auto.transfer.model.list</field>
        <field name="model">account.transfer.model</field>
        <field name="arch" type="xml">
            <list string="Move Models" sample="1">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="date_start" />
                <field name="date_stop" />
                <field name="repeat_interval" />
                <field name="repeat_unit" />
            </list>
        </field>
    </record>

    <!--    FORM -->
    <record id="view_transfer_model_form" model="ir.ui.view">
        <field name="name">account.auto.transfer.model.form</field>
        <field name="model">account.transfer.model</field>
        <field name="arch" type="xml">
            <form string="Move Model" class="o_auto_transfer_form">
                <header>
                    <button
                        name="action_perform_auto_transfer"
                        type="object"
                        string="Compute Transfer"
                        invisible="not active"
                        class="oe_highlight btn btn-primary" />
                    <button
                        name="action_disable"
                        type="object"
                        string="Disable"
                        help="Puts the transfer model in a state in which it will not automatically recompute its draft entries' values every day."
                        invisible="state == 'disabled' and active" />
                    <button
                        name="action_enable"
                        type="object"
                        string="Enable"
                        help="Puts the transfer model in a state in which it will automatically recompute its draft entries' values every day."
                        invisible="state == 'in_progress' and active" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box" invisible="not id">
                        <button
                            name="%(generated_transfers_action)d"
                            type="action"
                            icon="fa-book"
                            context="{'search_default_transfer_model_id': id, 'default_transfer_model_id': id}"
                            invisible="has_draft_moves"
                            class="oe_stat_button">
                            <field
                                name="move_ids_count"
                                string="Transfers"
                                widget="statinfo" />
                        </button>
                        <button
                            name="%(generated_transfers_action)d"
                            type="action"
                            icon="fa-book"
                            context="{'search_default_transfer_model_id': id, 'default_transfer_model_id': id}"
                            invisible="not has_draft_moves"
                            class="oe_stat_button text-info">
                            <field
                                name="move_ids_count"
                                string="Transfers"
                                widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="bg-danger" />
                    <div class="oe_title">
                        <label for="name" string="Description" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Monthly Expense Transfer" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="date_start" string="Period" />
                            <div>
                                <field name="date_start" class="oe_inline" />
                                <span> to </span>
                                <field
                                    name="date_stop"
                                    placeholder="forever"
                                    class="oe_inline" />
                            </div>
                            <field
                                name="account_ids"
                                string="Accounts"
                                widget="many2many_tags"
                                required="1" />
                        </group>
                        <group>
                            <field
                                name="journal_id"
                                string="Journal"
                                domain="[('type', '=', 'general')]" />
                            <label for="repeat_interval" string="Every" />
                            <div>
                                <field name="repeat_interval" class="oe_inline" />
                                <field name="repeat_unit" class="oe_inline" />
                            </div>
                        </group>
                        <field
                            name="conditions"
                            widget="domain"
                            options="{'model': 'account.move.line'}" />
                    </group>
                    <group string="Destination">
                        <field name="line_ids" colspan="2" nolabel="1">
                            <list editable="bottom">
                                <field
                                    name="account_id"
                                    string="Account"
                                    placeholder="Keep Original" />
                                <field name="percent" string="Rate (%)" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_transfer_model_search" model="ir.ui.view">
        <field name="name">account.auto.transfer.model.search</field>
        <field name="model">account.transfer.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

</odoo>
