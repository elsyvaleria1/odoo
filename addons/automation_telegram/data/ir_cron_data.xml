<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_deliver_answers" model="ir.cron">
        <field name="name">Automation: deliver answers given on Telegram</field>
        <field name="model_id" ref="model_automation_telegram_wait" />
        <field name="state">code</field>
        <field name="code">model._cron_deliver_answers()</field>
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">hour</field>
        <field name="active" eval="True" />
    </record>

</odoo>
