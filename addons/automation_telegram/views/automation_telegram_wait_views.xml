<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="automation_telegram_wait_view_list" model="ir.ui.view">
        <field name="name">automation.telegram.wait.list</field>
        <field name="model">automation.telegram.wait</field>
        <field name="arch" type="xml">
            <list string="Questions on Telegram" create="false">
                <field name="create_date" string="Asked" />
                <field name="runtime_id" />
                <field name="line_id" />
                <field name="chat_id" />
                <field name="accepted_kinds" />
                <field name="event_code" />
                <field name="date_received" />
                <field
                    name="state"
                    widget="badge"
                    decoration-danger="state == 'error'"
                    decoration-info="state == 'waiting'"
                    decoration-muted="state in ('delivered', 'cancelled')"
                    decoration-warning="state == 'received'" />
            </list>
        </field>
    </record>

    <record id="automation_telegram_wait_view_form" model="ir.ui.view">
        <field name="name">automation.telegram.wait.form</field>
        <field name="model">automation.telegram.wait</field>
        <field name="arch" type="xml">
            <form string="Question on Telegram" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group string="Question">
                            <field name="runtime_id" />
                            <field name="line_id" />
                            <field name="chat_id" />
                            <field name="bot_id" />
                            <field name="prompt_message_id" />
                            <field name="accepted_kinds" />
                            <field name="event_code" />
                        </group>
                        <group string="Answer">
                            <field name="reply_kind" />
                            <field name="reply_text" />
                            <field name="date_received" />
                            <field name="date_delivered" />
                            <field name="attachment_ids" widget="many2many_binary" />
                            <field name="attempts" invisible="not attempts" />
                            <field name="error_message" invisible="not error_message" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="automation_telegram_wait_view_search" model="ir.ui.view">
        <field name="name">automation.telegram.wait.search</field>
        <field name="model">automation.telegram.wait</field>
        <field name="arch" type="xml">
            <search string="Questions on Telegram">
                <field name="runtime_id" />
                <field name="chat_id" />
                <filter
                    name="filter_waiting"
                    string="Waiting"
                    domain="[('state', '=', 'waiting')]" />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('state', '=', 'error')]" />
            </search>
        </field>
    </record>

    <record id="automation_telegram_wait_action" model="ir.actions.act_window">
        <field name="name">Questions on Telegram</field>
        <field name="res_model">automation.telegram.wait</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
