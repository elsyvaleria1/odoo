<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="page_mailing_confirm_unsubscribe">
        <t t-call="mass_mailing.layout">
            <div class="container o_unsubscribe_form">
                <div class="row">
                    <div class="col-lg-6 offset-lg-3 mt-4">
                        <div id="info_state" class="alert alert-success">
                            <div class="text-center">
                                <form
                                    id="o_mailing_confirm_unsubscribe"
                                    t-att-action="form_action or '/mailing/confirm_unsubscribe'"
                                    method="POST">
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()" />
                                    <input
                                        type="hidden"
                                        name="mailing_id"
                                        t-att-value="mailing_id" />
                                    <input
                                        type="hidden"
                                        name="document_id"
                                        t-att-value="document_id" />
                                    <input
                                        type="hidden"
                                        name="email"
                                        t-att-value="email" />
                                    <input
                                        type="hidden"
                                        name="hash_token"
                                        t-att-value="hash_token" />
                                    <p t-if="unsubscribed_lists">
                                        Are you sure you want to unsubscribe from the mailing list "<span t-out="unsubscribed_lists" />"? 
                                    </p>
                                    <p t-else="">
                                        Are you sure you want to unsubscribe from our mailing list?
                                    </p>
                                    <button type="submit" class="btn btn-primary">Unsubscribe</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="page_mailing_has_unsubscribed">
        <t t-call="mass_mailing.layout">
            <div class="container o_unsubscribe_form">
                <div class="row">
                    <div class="col-lg-6 offset-lg-3 mt-4">
                        <div id="info_state" class="alert alert-success">
                            <div class="text-center">
                                <p>Successfully unsubscribed!</p>
                                <a t-att-href="settings_url" class="btn btn-primary">Manage Subscriptions</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="page_mailing_unsubscribe" name="Unsubscribe">
        <t t-call="mass_mailing.layout">
            <t t-call="mass_mailing.unsubscribe_form" />
        </t>
    </template>

    <template id="subscription_identity">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
        <input t-if="email" type="hidden" name="email" t-att-value="email" />
        <input
            t-if="hash_token"
            type="hidden"
            name="hash_token"
            t-att-value="hash_token" />
        <input
            t-if="mailing_id"
            type="hidden"
            name="mailing_id"
            t-att-value="mailing_id" />
        <input
            t-if="document_id"
            type="hidden"
            name="document_id"
            t-att-value="document_id" />
    </template>

    <template id="unsubscribe_form">
        <div
            id="o_mailing_portal_subscription"
            class="container o_mailing_portal_body"
            data-fragment="mass_mailing.unsubscribe_form">
            <div class="row">
                <div class="col-lg-6 offset-lg-3 mt-4">
                    <div id="o_mailing_subscription_form">
                        <form
                            action="/mailing/list/update"
                            method="POST"
                            data-fragment-form="">
                            <t t-call="mass_mailing.subscription_identity" />
                            <h1 class="o_page_header">Mailing Subscriptions</h1>

                            <div
                                t-if="is_blocklisted"
                                id="o_mailing_subscription_form_blocklisted">
                                <p>
                                    Your email is currently <strong>in our block list</strong>.
                                    <t t-if="lists_optin">
                                        You will not receive any news from those mailing lists you are a member of:
                                    </t>
                                    <t t-else="">
                                        You will not hear from us anymore.
                                    </t>
                                </p>
                                <ul class="list-group mb-4" t-if="lists_optin">
                                    <t t-foreach="lists_optin" t-as="mailing_list">
                                        <li
                                            class="list-group-item d-flex align-items-center">
                                            <strong>
                                                <t
                                                    t-if="mailing_list.is_public"
                                                    t-out="mailing_list.name" />
                                                <t t-else="">Mailing List #<t t-out="mailing_list.id" /></t>
                                            </strong>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <div t-else="" id="o_mailing_subscription_form_manage">
                                <p t-if="lists_optin + lists_optout">
                                    Choose your mailing subscriptions
                                </p>
                                <ul
                                    id="o_mailing_subscription_form_lists"
                                    t-if="lists_optin + lists_optout"
                                    class="list-group">
                                    <li
                                        t-foreach="(lists_optin + lists_optout)"
                                        t-as="mailing_list"
                                        class="list-group-item d-flex align-items-center"
                                        t-if="mailing_list not in lists_optout or mailing_list.is_public">
                                        <t t-set="title" t-value="mailing_list.name" />
                                        <input
                                            type="checkbox"
                                            name="mailing_list_ids"
                                            t-att-data-member="1"
                                            t-att-value="mailing_list.id"
                                            t-att-checked="None if mailing_list in lists_optout else 'checked'"
                                            t-att-title="title" />
                                        <span class="ms-1" t-out="title" />
                                        <span
                                            class="o_mailing_list_unsubscribed ms-auto">
                                            <t t-if="mailing_list in lists_optout">
                                                Not subscribed
                                            </t>
                                            <t t-else="">
                                                Subscribed
                                            </t>
                                        </span>
                                    </li>
                                </ul>
                                <p t-if="lists_public">
                                    You may also be interested in
                                </p>
                                <ul
                                    id="o_mailing_subscription_form_lists_additional"
                                    t-if="lists_public"
                                    class="list-group">
                                    <li
                                        t-foreach="lists_public"
                                        t-as="mailing_list"
                                        class="list-group-item">
                                        <input
                                            type="checkbox"
                                            name="mailing_list_ids"
                                            t-att-value="mailing_list.id"
                                            t-att-title="mailing_list.name" />
                                        <span class="ms-1" t-out="mailing_list.name" />
                                    </li>
                                </ul>
                                <p
                                    t-if="not lists_optin and not lists_optout and not lists_public">
                                    You are not subscribed to any of our mailing list.
                                </p>
                            </div>
                            <div
                                id="o_mailing_subscription_blocklist"
                                class="d-flex align-items-center mb-4 pt-3">
                                <button
                                    t-if="not is_blocklisted and (lists_optin or lists_optout or lists_public)"
                                    type="submit"
                                    id="button_form_send"
                                    class="btn btn-primary">
                                    Apply changes
                                </button>
                                <button
                                    t-if="blocklist_enabled and blocklist_possible and not is_blocklisted"
                                    type="submit"
                                    id="button_blocklist_add"
                                    formaction="/mailing/blocklist/add"
                                    class="btn btn-link me-2 text-uppercase">
                                    Exclude Me
                                </button>
                                <button
                                    t-if="is_blocklisted"
                                    type="submit"
                                    id="button_blocklist_remove"
                                    formaction="/mailing/blocklist/remove"
                                    class="btn btn-link text-uppercase">
                                    Come Back
                                </button>
                                <div
                                    t-if="last_action in ('subscription_updated', 'subscription_updated_optout', 'blocklist_add', 'blocklist_remove')"
                                    id="o_mailing_subscription_update_info"
                                    class="text-success">
                                    <i class="fa-solid fa-check me-1" />
                                    <span t-if="last_action == 'blocklist_add'">Email added to our blocklist</span>
                                    <span t-elif="last_action == 'blocklist_remove'">Email removed from our blocklist</span>
                                    <span t-else="">Membership updated</span>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div id="o_mailing_subscription_info" class="mb-4" role="status">
                        <t t-if="unsubscribed_name">
                            <h1 class="o_page_header">Successfully Unsubscribed</h1>
                            <span t-out="unsubscribed_name" />
                        </t>
                        <div
                            t-if="feedback_enabled"
                            id="o_mailing_subscription_feedback">
                            <form
                                action="/mailing/feedback"
                                method="POST"
                                class="mt-3"
                                data-fragment-form="">
                                <t t-call="mass_mailing.subscription_identity" />
                                <input
                                    t-if="last_action"
                                    type="hidden"
                                    name="last_action"
                                    t-att-value="last_action" />
                                <p t-if="last_action == 'blocklist_add'">
                                    Please let us know why you want to be in our block list.
                                </p>
                                <p t-else="">
                                    Please let us know why you updated your subscription.
                                </p>
                                <fieldset
                                    t-att-disabled="'disabled' if last_action == 'feedback_sent' else None">
                                    <div
                                        class="form-check"
                                        t-foreach="opt_out_reasons"
                                        t-as="opt_out_reason">
                                        <input
                                            class="form-check-input o_mailing_subscription_opt_out_reason"
                                            type="radio"
                                            name="opt_out_reason_id"
                                            required=""
                                            t-att-id="'opt_out_reason_id' + str(opt_out_reason.id)"
                                            t-att-data-is-feedback="opt_out_reason.is_feedback"
                                            t-att-value="opt_out_reason.id" />
                                        <label
                                            class="form-check-label"
                                            t-att-for="'opt_out_reason_id' + str(opt_out_reason.id)"
                                            t-out="opt_out_reason.name" />
                                    </div>
                                    <textarea
                                        class="o_mailing_subscription_feedback_text form-control"
                                        name="feedback"
                                        cols="60"
                                        rows="3" />
                                    <div class="d-flex align-items-center mt-2">
                                        <button type="submit" id="button_feedback" class="btn btn-primary text-start me-2">Send</button>
                                        <div
                                            t-if="last_action == 'feedback_sent'"
                                            id="o_mailing_subscription_feedback_info"
                                            class="text-success">
                                            <i class="fa-solid fa-check me-1" />
                                            <span>Sent. Thanks you for your feedback!</span>
                                        </div>
                                    </div>
                                </fieldset>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div
                id="o_mailing_portal_subscription_editor"
                class="oe_structure oe_empty" />
        </div>
    </template>

</odoo>
