<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="field_github_app_app_id" model="credential.category.field">
        <field name="category_id" ref="credential_category_github_app" />
        <field name="code">app_id</field>
        <field name="name">App ID</field>
        <field name="sequence" eval="10" />
    </record>

    <record id="field_github_app_private_key" model="credential.category.field">
        <field name="category_id" ref="credential_category_github_app" />
        <field name="code">private_key</field>
        <field name="name">Private Key (PEM)</field>
        <field name="sequence" eval="20" />
    </record>

    <record id="field_github_app_installation_id" model="credential.category.field">
        <field name="category_id" ref="credential_category_github_app" />
        <field name="code">installation_id</field>
        <field name="name">Installation ID</field>
        <field name="sequence" eval="30" />
    </record>

</odoo>
