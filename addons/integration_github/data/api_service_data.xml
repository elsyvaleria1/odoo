<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="service_github" model="integration.service">
        <field name="name">GitHub</field>
        <field name="code">github</field>
        <field name="category">other</field>
        <field name="provider">GitHub, Inc.</field>
        <field name="website">https://github.com</field>
        <field name="documentation_url">https://docs.github.com/en/rest</field>
        <field name="endpoint_url">https://api.github.com</field>
        <field name="auth_type">bearer</field>
        <field name="allow_user_credentials" eval="True" />
        <field name="rate_limit_requests">5000</field>
        <field name="rate_limit_period">hour</field>
    </record>

</odoo>
