<?xml version="1.0" encoding="utf-8"?>
<templates>

<div t-name="document_spreadsheet.SpreadsheetAction" class="o_spreadsheet_action">
    <t t-if="this.dataFetched">
        <SpreadsheetNavbar
            t-props="this.navbarProps"
            isReadonly="this.isReadonly || !!this.accessToken"
            model="this.model"
        >
            <t t-set-slot="navbar-additional-actions">
                <a
                    title="Toggle favorite"
                    t-on-click="this._onSpreadSheetFavoriteToggled"
                    t-attf-class="o-sp-favorite fa-lg {{!this.state.isFavorited ? 'fa-regular fa-star' : 'fa-solid fa-star favorite_button_enabled'}}"
                />
            </t>
        </SpreadsheetNavbar>
        <SpreadsheetComponent model="this.model"/>
    </t>
</div>

</templates>
