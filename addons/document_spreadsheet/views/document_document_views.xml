<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_document_view_kanban" model="ir.ui.view">
        <field name="name">spreadsheet.documents.document.kanban</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.document_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="handler" />
                <field name="spreadsheet_thumbnail_checksum" />
            </xpath>
            <xpath expr="//div[@name='document_preview']" position="before">
                <t
                    t-set="isSpreadsheet"
                    t-value="['spreadsheet', 'frozen_spreadsheet'].includes(record.handler.raw_value)" />
                <t
                    t-set="isXlsx"
                    t-value="record.mimetype.raw_value === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'" />
            </xpath>
            <xpath expr="//div[@name='document_preview']" position="attributes">
                <attribute
                    name="t-attf-class"
                    add="#{(isSpreadsheet) ? 'o_document_spreadsheet' : ''}"
                    separator=" " />
                <attribute
                    name="t-attf-class"
                    add="#{(isXlsx) ? 'o_document_xlsx' : ''}"
                    separator=" " />
            </xpath>
            <xpath
                expr="//div[@name='document_preview']/*[contains(@t-elif, 'isTextualDocument')]"
                position="before">
                <div
                    t-elif="isSpreadsheet"
                    class="o_attachment_image o_documents_image">
                    <t
                        t-set="hasThumbnail"
                        t-value="!!(record.spreadsheet_thumbnail_checksum.raw_value)" />
                    <t
                        t-set="unique"
                        t-value="record.spreadsheet_thumbnail_checksum.raw_value.slice(-8)" />
                    <img
                        t-att-src="hasThumbnail                             ? '/documents/display_thumbnail/' + window.encodeURIComponent(record.access_token.raw_value) + '?unique=' + unique                             : '/spreadsheet/static/img/spreadsheet.svg'"
                        alt="Spreadsheet Preview" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="documents_document_view_list" model="ir.ui.view">
        <field name="name">document.document.view.list</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.documents_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="handler" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record id="document_view_search_spreadsheet" model="ir.ui.view">
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.document_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='pdf_doc']" position="after">
                <filter
                    name="spreadsheet"
                    string="Spreadsheets"
                    domain="[('handler', 'in', ('spreadsheet', 'frozen_spreadsheet'))]" />
            </xpath>
        </field>
    </record>

</odoo>
