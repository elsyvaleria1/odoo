<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_compliance_report_search_hr" model="ir.ui.view">
        <field name="name">asset.compliance.report.search.hr</field>
        <field name="model">asset.compliance.report</field>
        <field
            name="inherit_id"
            ref="asset_ledger_document_compliance.view_asset_compliance_report_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='asset_name']" position="after">
                <field name="asset_manager_id" />
            </xpath>

            <xpath expr="//filter[@name='group_location']" position="after">
                <filter
                    name="group_manager"
                    string="Asset Manager"
                    context="{'group_by': 'asset_manager_id'}" />
            </xpath>
        </field>
    </record>

    <record id="view_asset_compliance_report_list_hr" model="ir.ui.view">
        <field name="name">asset.compliance.report.list.hr</field>
        <field name="model">asset.compliance.report</field>
        <field
            name="inherit_id"
            ref="asset_ledger_document_compliance.view_asset_compliance_report_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='asset_name']" position="after">
                <field name="asset_manager_id" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
