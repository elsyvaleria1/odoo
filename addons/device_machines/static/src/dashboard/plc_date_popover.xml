<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="device_machines.PlcDatePopover">
    <DateTimePicker t-props="this.props.pickerProps" />
    <div class="o_datetime_buttons d-flex gap-2 justify-content-end p-2 pt-0">
        <button
                class="btn btn-sm btn-secondary"
                title="Clear"
                tabindex="-1"
                t-on-click="this.props.pickerProps.onReset"
            >
            <i class="fa-solid fa-eraser" />
        </button>
        <button class="btn btn-sm btn-primary" tabindex="-1" t-on-click="this.props.close">
            <span>Apply</span>
        </button>
    </div>
</t>

</templates>
