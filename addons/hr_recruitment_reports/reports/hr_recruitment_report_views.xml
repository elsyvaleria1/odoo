<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="recruitment_report_view_pivot" model="ir.ui.view">
            <field name="name">hr.recruitment.report.pivot</field>
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <pivot
                    string="Application Analysis"
                    sample="1"
                    js_class="recruitment_report_pivot">
                    <field name="create_date" type="row" interval="month" />
                    <field name="job_id" type="row" />
                    <field name="stage_id" type="col" />
                    <field name="in_progress" type="measure" />
                    <field name="refused" type="measure" />
                    <field name="hired" type="measure" />
                    <field name="count" type="measure" />
                </pivot>
            </field>
        </record>
        <record id="recruitment_report_view_source_pivot" model="ir.ui.view">
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <pivot
                    string="Source Analysis"
                    sample="1"
                    js_class="recruitment_report_pivot">
                    <field name="source_id" type="row" />
                    <field name="in_progress" type="measure" />
                    <field name="refused" type="measure" />
                    <field name="hired" type="measure" />
                    <field name="count" type="measure" />
                </pivot>
            </field>
        </record>
        <record id="recruitment_report_view_graph" model="ir.ui.view">
            <field name="name">hr.recruitment.report.graph</field>
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <graph
                    type="line"
                    string="Recruitment Analysis"
                    sample="1"
                    js_class="recruitment_report_view_graph">
                    <field name="create_date" interval="month" />
                    <field name="count" type="measure" />
                </graph>
            </field>
        </record>
        <record id="recruitment_report_source_view_graph" model="ir.ui.view">
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <graph string="Source Analysis" sample="1">
                    <field name="source_id" />
                    <field name="state" />
                    <field name="count" type="measure" />
                </graph>
            </field>
        </record>
        <record id="recruitment_report_hr_recruitment_view_graph" model="ir.ui.view">
            <field name="name">hr.recruitment.report.view.graph</field>
            <field name="model">hr.recruitment.report</field>
            <field
                name="inherit_id"
                ref="hr_recruitment_reports.recruitment_report_source_view_graph" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//graph" position="attributes">
                    <attribute name="type">line</attribute>
                    <attribute name="stacked">0</attribute>
                </xpath>
                <xpath expr="//field[@name='source_id']" position="replace">
                    <field name="create_date" />
                </xpath>
            </field>
        </record>
        <record id="hr_recruitment_report_view_tree" model="ir.ui.view">
            <field name="name">hr.recruitment.report.view.list</field>
            <field name="model">hr.recruitment.report</field>
            <field name="arch" type="xml">
                <list
                    type="object"
                    string="Recruitment Analysis"
                    action="action_view_applicant"
                    decoration-danger="state == 'refused'">
                    <field name="name" />
                    <field name="job_id" optional="show" />
                    <field name="source_id" optional="show" />
                    <field name="medium_id" optional="show" />
                    <field name="create_date" optional="show" />
                    <field name="stage_id" optional="show" />
                    <field name="state" optional="show" />
                </list>
            </field>
        </record>
        <record id="recruitment_report_view_search" model="ir.ui.view">
            <field name="name">hr.recruitment.report.search</field>
            <field name="model">hr.recruitment.report</field>
            <field name="arch" type="xml">
                <search string="Recruitment Analysis">
                    <field name="source_id" />
                    <field
                        name="company_id"
                        filter_domain="[('company_id', 'ilike', self)]" />
                    <field name="job_id" />
                    <field name="name" filter_domain="[('name', 'ilike', self)]" />
                    <field
                        name="refuse_reason_id"
                        filter_domain="[('refuse_reason_id', 'ilike', self)]" />
                    <field name="create_date" />
                    <field name="date_closed" />
                    <filter
                        name="year"
                        string="Last 365 Days Applicant"
                        domain="[                         ('create_date', '&gt;=', 'today -365d'),                         ('create_date', '&lt;', 'today +1d')]" />
                    <separator />
                    <separator />
                    <filter
                        name="filter_create_date"
                        string="Application Date"
                        date="create_date" />
                    <filter
                        name="filter_date_closed"
                        string="Hired Date"
                        date="date_closed" />
                    <group>
                        <filter
                            name="groupby_state"
                            string="State"
                            context="{'group_by': 'state'}" />
                        <filter
                            name="groupby_job"
                            string="Job Position"
                            context="{'group_by':'job_id'}" />
                        <filter
                            name="groupby_name"
                            string="Applicant Name"
                            context="{'group_by':'name'}" />
                        <filter
                            name="groupby_source"
                            string="Source"
                            context="{'group_by': 'source_id'}" />
                        <filter
                            name="groupby_medium"
                            string="Medium"
                            context="{'group_by': 'medium_id'}" />
                        <filter
                            name="company"
                            string="Company"
                            context="{'group_by':'company_id'}"
                            groups="base.group_multi_company" />
                    </group>
                </search>
            </field>
        </record>
        <record id="recruitment_report_action" model="ir.actions.act_window">
            <field name="name">Application Analysis</field>
            <field name="res_model">hr.recruitment.report</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="recruitment_report_view_search" />
            <field
                name="context">{
                'search_default_year': True,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No data to display
                </p>
                <p>
                    This report allows you to follow the evolution of the number of applicants and hired employees over time.
                </p>
            </field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('recruitment_report_hr_recruitment_view_graph')})]" />
        </record>
        <record id="recruitment_report_job_action" model="ir.actions.act_window">
            <field name="name">Recruitment Analysis</field>
            <field name="res_model">hr.recruitment.report</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="recruitment_report_view_search" />
            <field
                name="context">{
                'search_default_year': True,
                'search_default_job_id': active_id,
            }</field>
            <field
                name="help">This report performs analysis on your recruitment.</field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('recruitment_report_source_view_graph')})]" />
        </record>
        <record id="recruitment_report_source_action" model="ir.actions.act_window">
            <field name="name">Source Analysis</field>
            <field name="res_model">hr.recruitment.report</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="recruitment_report_view_search" />
            <field
                name="context">{
                'search_default_year': True,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No data to display
                </p>
                <p>
                    This report allows you to compare various measures grouped by your sources of applicants (e.g. LinkedIn, Monster, etc.).
                </p>
            </field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('recruitment_report_source_view_graph')}), Command.create({'view_mode': 'pivot', 'view_id': ref('recruitment_report_view_source_pivot')})]" />
        </record>
        <record id="recruitment_report_source_job_action" model="ir.actions.act_window">
            <field name="name">Source Analysis</field>
            <field name="res_model">hr.recruitment.report</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="recruitment_report_view_search" />
            <field
                name="context">{
                'search_default_year': True,
                'search_default_job_id': active_id,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No data to display
                </p>
                <p>
                    This report allows you to compare various measures grouped by your sources of applicants (e.g. LinkedIn, Monster, etc.).
                </p>
            </field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('recruitment_report_source_view_graph')})]" />
        </record>
        <record id="recruitment_report_team_view_graph" model="ir.ui.view">
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <graph string="Team Performance" sample="1" stacked="0">
                    <field name="user_id" />
                    <field name="state" />
                </graph>
            </field>
        </record>
        <record id="recruitment_report_team_view_pivot" model="ir.ui.view">
            <field name="model">hr.recruitment.report</field>
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <pivot
                    string="Team Performance"
                    sample="1"
                    js_class="recruitment_report_pivot">
                    <field name="user_id" type="row" />
                    <field name="in_progress" type="measure" />
                    <field name="refused" type="measure" />
                    <field name="hired" type="measure" />
                    <field name="count" type="measure" />
                </pivot>
            </field>
        </record>
        <record id="recruitment_report_team_action" model="ir.actions.act_window">
            <field name="name">Team Performance</field>
            <field name="res_model">hr.recruitment.report</field>
            <field name="view_mode">graph,pivot</field>
            <field name="search_view_id" ref="recruitment_report_view_search" />
            <field
                name="context">{
                'search_default_year': True,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    No data to display
                </p>
                <p>
                    This report allows you to compare recruiters and their performances.
                </p>
            </field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'graph', 'view_id': ref('recruitment_report_team_view_graph')}), Command.create({'view_mode': 'pivot', 'view_id': ref('recruitment_report_team_view_pivot')})]" />
        </record>
    </data>

</odoo>
