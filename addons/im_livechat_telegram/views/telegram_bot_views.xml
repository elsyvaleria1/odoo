<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="telegram_bot_view_form_livechat" model="ir.ui.view">
        <field name="name">telegram.bot.form.livechat</field>
        <field name="model">telegram.bot</field>
        <field name="inherit_id" ref="telegram.view_telegram_bot_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="livechat" string="Live Chat">
                    <group>
                        <field name="livechat_channel_id" />
                        <field
                            name="livechat_chatbot_script_id"
                            invisible="not livechat_channel_id" />
                        <field
                            name="livechat_operator_label"
                            invisible="not livechat_channel_id" />
                        <field
                            name="livechat_waiting_message"
                            invisible="not livechat_channel_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
