msgstr "Ahora nadie puede atenderte aquí. Inténtalo más tarde, por favor."

#. module: im_livechat_telegram
#. odoo-python
#: code:addons/im_livechat_telegram/models/telegram_handler_livechat.py:0
msgid "Only text, photos and documents reach us here."
msgstr "Aquí solo nos llegan textos, fotos y documentos."

#. module: im_livechat_telegram
#: model:ir.model.fields,help:im_livechat_telegram.field_telegram_bot__livechat_operator_label
msgid ""
"Prefix operators' messages with their name. Off, customers see the bot "
"speaking for the company."
msgstr ""
"Antepone el nombre del operador a sus mensajes. Desactivado, los clientes "
"ven al bot hablando por la empresa."

#. module: im_livechat_telegram
#: model:ir.model.fields,help:im_livechat_telegram.field_telegram_bot__livechat_waiting_message
msgid "Sent to a customer whose session opens with no operator online."
msgstr "Se envía al cliente cuya sesión se abre sin operadores en línea."

#. module: im_livechat_telegram
#: model:ir.model.fields,field_description:im_livechat_telegram.field_telegram_bot__livechat_operator_label
