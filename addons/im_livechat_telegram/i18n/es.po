#, python-format
msgid "The chatbot of bot %(bot)s must be one of its Live Chat channel's rules."
msgstr ""
"El chatbot del bot %(bot)s debe ser una de las reglas de su canal de chat "
"en vivo."

#. module: im_livechat_telegram
#: model:ir.model.fields,help:im_livechat_telegram.field_telegram_bot__livechat_chatbot_script_id
msgid ""
"The script that greets a customer on a new session, when no operator should"
" answer first. It must be one of the channel's rules."
msgstr ""
"El guion que saluda al cliente en una sesión nueva, cuando no debe "
"responder primero un operador. Debe ser una de las reglas del canal."
