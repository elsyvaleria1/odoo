#. module: approval_ai_telegram
#: model_terms:ir.ui.view,arch_db:approval_ai_telegram.telegram_bot_view_form_smart_approval
msgid ""
"<strong>AI is off for this bot.</strong>\n"
"                        The <code>/solicitar</code> wizard will still work but\n"
"                        without natural-language classification — the user picks\n"
"                        the approval category manually. Enable AI and pick a\n"
"                        provider whose service the company is connected to under\n"
"                        Integrations to turn it on."
msgstr ""
"<strong>La IA está desactivada para este bot.</strong>\n"
"                        El asistente <code>/solicitar</code> seguirá funcionando, pero\n"
"                        sin clasificación en lenguaje natural — el usuario elige\n"
"                        la categoría de aprobación manualmente. Para activarla, habilita la IA\n"
"                        y elige un proveedor a cuyo servicio esté conectada la empresa\n"
"                        en Integraciones."

#. module: approval_ai_telegram
#: model_terms:ir.ui.view,arch_db:approval_ai_telegram.telegram_bot_view_form_smart_approval
msgid ""
"<strong>This provider cannot transcribe voice notes.</strong>\n"
"                        Text classification works, but a voice note sent to\n"
"                        <code>/solicitar</code> will be refused and the user\n"
"                        asked to type the description instead."
msgstr ""
"<strong>Este proveedor no puede transcribir notas de voz.</strong>\n"
"                        La clasificación de texto funciona, pero una nota de voz enviada a\n"
"                        <code>/solicitar</code> será rechazada y se pedirá al usuario\n"
"                        que escriba la descripción."

