<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.industry.fsm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="75" />
        <!-- below project -->
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    name="industry_fsm"
                    string="Field Service"
                    groups="industry_fsm.group_fsm_manager"
                    data-string="industry_fsm">
                    <block id="fsm_tasks_management" title="Field Service">
                        <setting
                            help="Keep track of the products used for your tasks, and invoice your time and material to your customers"
                            documentation="/applications/services/fsm/sales/onsite_tasks_from_sales_orders.html">
                            <field name="module_industry_fsm_sale" />
                        </setting>
                        <setting
                            name="module_industry_fsm_report"
                            help="Design tailored worksheet templates for various interventions, and analyze collected intervention data.">
                            <field name="module_industry_fsm_report" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
