<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_access_changeset" model="approval.category">
        <field name="name">Security Change Set</field>
        <field
            name="description">A change to access rows, predicates, field classes, duty rules, group implications or eligibilities, activated once another access administrator approves it.</field>
        <field name="sequence_code">SECCHG</field>
        <field name="company_id" eval="False" />
        <field name="approval_minimum">1</field>
        <field name="allow_self_approval" eval="False" />
        <field name="privacy_visibility">private</field>
    </record>

    <record id="approval_category_step_access_changeset" model="approval.category.step">
        <field name="name">Security change approver</field>
        <field name="category_id" ref="approval_category_access_changeset" />
        <field name="group_id" ref="base.group_access_change_approver" />
        <field name="minimum" eval="1" />
        <field name="sequence" eval="10" />
    </record>

    <record id="obligation_access_changeset_activate" model="approval.binding">
        <field name="model_id" ref="base.model_ir_access_changeset" />
        <field name="verb">activate</field>
        <field name="category_id" ref="approval_category_access_changeset" />
        <field name="mode">request</field>
        <field name="run_on_approval" eval="True" />
        <field name="origin">module</field>
    </record>

</odoo>
