<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="voice_sentence_view_list" model="ir.ui.view">
        <field name="name">voice.sentence.view.list</field>
        <field name="model">voice.sentence</field>
        <field name="arch" type="xml">
            <list string="Voice Sentences" create="0" edit="0">
                <field name="day" />
                <field name="answered_by" />
                <field name="text" />
                <field name="spoken" />
                <field name="language" />
                <field name="res_model" />
                <field name="view_type" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="voice_sentence_view_search" model="ir.ui.view">
        <field name="name">voice.sentence.view.search</field>
        <field name="model">voice.sentence</field>
        <field name="arch" type="xml">
            <search string="Voice Sentences">
                <field name="text" />
                <field name="res_model" />
                <filter
                    name="missed"
                    string="Not understood by the grammar"
                    domain="[('answered_by', '!=', 'grammar')]" />
                <filter
                    name="spoken"
                    string="Spoken"
                    domain="[('spoken', '=', True)]" />
                <separator />
                <filter
                    name="group_answered_by"
                    string="Answered by"
                    context="{'group_by': 'answered_by'}" />
                <filter name="group_day" string="Day" context="{'group_by': 'day'}" />
            </search>
        </field>
    </record>

    <record id="voice_sentence_action" model="ir.actions.act_window">
        <field name="name">Voice Sentences</field>
        <field name="res_model">voice.sentence</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_answered_by': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sentence shared yet</p>
            <p>Users who choose to share what they say add one row per command. The words are kept only when the grammar did not understand them; no row names who spoke.</p>
        </field>
    </record>

</odoo>
