<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="default_map_extent_param" model="ir.config_parameter">
        <field name="key">geoengine.default_map_extent</field>
        <field name="value" />
    </record>

    <record id="validate_geometry_param" model="ir.config_parameter">
        <field name="key">geoengine.validate_geometry</field>
        <field name="value">True</field>
    </record>

    <record id="auto_repair_geometry_param" model="ir.config_parameter">
        <field name="key">geoengine.auto_repair_geometry</field>
        <field name="value">True</field>
    </record>

    <record id="max_geometry_size_param" model="ir.config_parameter">
        <field name="key">geoengine.max_geometry_size</field>
        <field name="value">1000000</field>
    </record>

</odoo>
