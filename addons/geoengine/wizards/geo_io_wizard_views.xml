<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geo_import_wizard_form" model="ir.ui.view">
        <field name="name">geo.import.wizard.form</field>
        <field name="model">wizard.base.import.geodata</field>
        <field name="arch" type="xml">
            <form string="Import Geodata">
                <group>
                    <group string="Target">
                        <field name="model_id" options="{'no_create': True}" />
                        <field name="model_name" invisible="1" />
                        <field name="geo_field_id" options="{'no_create': True}" />
                    </group>
                    <group string="File">
                        <field name="file_data" filename="file_name" />
                        <field name="file_name" invisible="1" />
                        <div class="text-muted" colspan="2">
                            GeoJSON (.geojson/.json), a zipped Shapefile (.zip) or a
                            GeoPackage (.gpkg) -- the format is detected automatically.
                        </div>
                        <field name="feature_count" invisible="feature_count == 0" />
                        <field name="detected_crs" invisible="not detected_crs" />
                        <field
                            name="preview_properties"
                            widget="text"
                            invisible="not preview_properties" />
                    </group>
                </group>
                <group string="Field Mapping" invisible="not file_data">
                    <field
                        name="name_property"
                        placeholder="e.g., NAME, title, label" />
                    <field name="mapping_lines" nolabel="1">
                        <list editable="bottom">
                            <field
                                name="property_name"
                                placeholder="GeoJSON property name" />
                            <field name="field_id" options="{'no_create': True}" />
                        </list>
                    </field>
                </group>
                <group string="Options" invisible="not file_data">
                    <field name="skip_invalid" />
                </group>
                <group string="Results" invisible="imported_count == 0">
                    <field name="imported_count" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        invisible="not file_data"
                        class="btn-primary" />
                    <button
                        name="action_preview"
                        type="object"
                        string="Preview"
                        invisible="not file_data"
                        class="btn-secondary" />
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_geo_export_wizard_form" model="ir.ui.view">
        <field name="name">geo.export.wizard.form</field>
        <field name="model">wizard.base.export.geodata</field>
        <field name="arch" type="xml">
            <form string="Export Geodata">
                <group>
                    <group string="Source">
                        <field name="model_id" options="{'no_create': True}" />
                        <field name="model_name" invisible="1" />
                        <field name="geo_field_id" options="{'no_create': True}" />
                    </group>
                    <group string="Output">
                        <field name="output_format" widget="radio" />
                        <field name="output_srid" widget="radio" />
                    </group>
                </group>
                <group string="Properties to Include">
                    <field
                        name="property_field_ids"
                        widget="many2many_tags"
                        nolabel="1"
                        options="{'no_create': True}" />
                </group>
                <group string="Filter">
                    <field name="domain" placeholder="[('active', '=', True)]" />
                </group>
                <group string="Download" invisible="not output_file">
                    <field name="output_file" filename="output_filename" />
                    <field name="output_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_export"
                        type="object"
                        string="Export"
                        class="btn-primary" />
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_geo_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Geodata</field>
        <field name="res_model">wizard.base.import.geodata</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_geo_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Geodata</field>
        <field name="res_model">wizard.base.export.geodata</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
