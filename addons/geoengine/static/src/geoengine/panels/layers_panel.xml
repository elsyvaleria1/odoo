<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="geoengine.LayersPanel">
        <div
            class="menu border-end"
            t-attf-class="{{ this.state.isFolded ? 'o_layer_panel_fold ' : 'o_layer_panel bg-view' }}"
        >
            <div
                class="w-100 d-flex"
                t-attf-class="{{ this.state.isFolded ? 'justify-content-center' : 'justify-content-end'}}"
            >
                <button
                    class="btn"
                    t-attf-class="{{this.state.isFolded ? 'unfold text-900': 'fold'}}"
                    t-on-click="this.fold"
                    aria-label="Toggle layers panel"
                >
                    <i class="fa-solid fa-left-right" role="img" />
                </button>
            </div>
            <div t-if="!this.state.isFolded">
                <section class="o_search_panel_section">
                    <header
                        class="o_search_panel_section_header text-uppercase cursor-default"
                    >
                        <span class="fs-6 fw-bold">Vectors</span>
                    </header>
                    <div t-ref="this.rootRef" class="root">
                        <ul class="list p-0">
                            <li
                                t-foreach="this.geoLayers.vectors"
                                t-as="vector"
                                t-key="vector.resId"
                                class="item d-flex align-items-center"
                                t-att-data-id="vector.id"
                            >
                                <i class="fa-solid fa-sort m-3" />
                                <i
                                    t-if="this.layerProblem(vector)"
                                    class="fa-solid fa-triangle-exclamation text-warning me-1"
                                    t-att-title="this.layerProblem(vector)"
                                    role="img"
                                />
                                <div
                                    class="d-flex justify-content-between align-items-center"
                                >
                                    <CheckBox
                                        value="vector.isVisible"
                                        onChange.bind="(checked) => this.onCheckboxChange(vector, checked)"
                                    >
                                        <t t-out="vector.name" />
                                    </CheckBox>
                                    <button
                                        class="btn btn-edit"
                                        t-on-click.prevent="() => this.onEditFilterButtonSelected(vector)"
                                        aria-label="Edit layer filter"
                                    >
                                        <i class="fa-solid fa-filter text-primary" />
                                    </button>
                                    <button
                                        t-if="this.isGeoengineAdmin"
                                        class="btn btn-edit"
                                        t-on-click.prevent="() => this.onEditButtonSelected(vector)"
                                        aria-label="Edit layer"
                                    >
                                        <i
                                            class="fa-regular fa-pen-to-square text-primary"
                                        />
                                    </button>
                                </div>
                            </li>
                        </ul>
                    </div>
                </section>
                <section class="o_search_panel_section">
                    <header
                        class="o_search_panel_section_header pt-4 pb-2 text-uppercase cursor-default"
                    >
                        <span class="fs-6 fw-bold">Rasters</span>

                        <button
                            t-if="this.isGeoengineAdmin"
                            class="btn btn-edit"
                            t-on-click="this.openNewRaster"
                            aria-label="Add raster layer"
                        >
                            <i class="fa-solid fa-plus text-primary" />
                        </button>
                    </header>
                    <ul class="raster list-group d-block o_search_panel_field">
                        <li t-foreach="this.geoLayers.rasters" t-as="layer" t-key="layer.id">
                            <div class="form-check o_radio_item" aria-atomic="true">
                                <input
                                    t-att-type="layer.overlay ? 'checkbox' : 'radio'"
                                    t-att-checked="layer.isVisible"
                                    class="form-check-input o_radio_input"
                                    t-att-id="'geoengine_raster_' + layer.id"
                                    t-att-name="layer.overlay ? 'geoengine_overlay_' + layer.id : 'geoengine_base_map'"
                                    t-att-value="layer.id"
                                    t-on-change="(ev) => this.onRasterChange(layer, ev.target.checked)"
                                />
                                <label
                                    class="form-check-label o_form_label"
                                    t-att-for="'geoengine_raster_' + layer.id"
                                    t-out="layer.name"
                                />
                                <button
                                    t-if="this.isGeoengineAdmin"
                                    class="btn btn-edit"
                                    t-on-click.prevent="() => this.onEditRasterButtonSelected(layer)"
                                    aria-label="Edit raster layer"
                                >
                                    <i
                                        class="fa-regular fa-pen-to-square text-primary"
                                    />
                                </button>
                            </div>
                        </li>
                    </ul>
                </section>

                <FeaturesList
                    t-if="this.featuresList.enabled"
                    records="this.props.model.root.records"
                    onZoomToRecord="this.props.onZoomToRecord"
                    onZoomToRecords="this.props.onZoomToRecords"
                    displayField="this.featuresList.displayField"
                    groupByField="this.featuresList.groupByField"
                />
            </div>
            <div t-else="" class="d-flex justify-content-center text-900">
                <span class="title-panel">Layers (<t t-out="this.numberOfLayers" />)</span>
            </div>
        </div>
    </t>
</templates>
