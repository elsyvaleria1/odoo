<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_model_fields_form_geo" model="ir.ui.view">
        <field name="name">ir.model.fields.form.geo</field>
        <field name="model">ir.model.fields</field>
        <field name="inherit_id" ref="base.view_model_fields_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <group>
                    <field name="is_geo_field" invisible="1" />
                    <field name="srid" invisible="not is_geo_field" readonly="1" />
                    <field name="geo_type" invisible="not is_geo_field" readonly="1" />
                    <field name="dim" invisible="not is_geo_field" readonly="1" />
                </group>
            </sheet>
        </field>
    </record>

</odoo>
