<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="geoengine_view_settings_view_form" model="ir.ui.view">
        <field name="name">geoengine.view.settings.form</field>
        <field name="model">geoengine.view.settings</field>
        <field name="arch" type="xml">
            <form string="Map Settings">
                <sheet>
                    <group>
                        <field name="view_id" />
                    </group>
                    <group string="Map">
                        <field name="projection" />
                        <field name="restricted_extent" />
                        <field name="default_map_extent" />
                        <field name="default_map_zoom" />
                    </group>
                    <group string="Render Engine">
                        <field name="render_engine" />
                        <field
                            name="webgl_threshold"
                            invisible="render_engine != 'auto'" />
                    </group>
                    <group string="Map Controls">
                        <field name="show_attribution" />
                        <field name="show_fullscreen" />
                        <field name="show_zoom_slider" />
                        <field name="show_overview_map" />
                        <field name="show_mouse_position" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
