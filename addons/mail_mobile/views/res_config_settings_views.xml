<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.mobile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="web.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block position="after" id="user_default_rights">
                <div id="mobile_settings" groups="base.group_no_one">
                    <block title="Mobile">
                        <setting
                            help="Receive notifications on Android and iOS application">
                            <field name="enable_ocn" />
                        </setting>
                    </block>
                </div>
            </block>
        </field>
    </record>

</odoo>
