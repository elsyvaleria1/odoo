<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_inherit_tender" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tender</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page name="tender" string="Tender">
                    <group>
                        <field
                            name="tender_id"
                            invisible="not tender_id"
                            readonly="1" />
                    </group>
                    <div class="d-flex gap-5">
                        <button
                            name="action_invite_counterparties"
                            type="object"
                            string="Invite Buyers"
                            icon="fa-copy"
                            invisible="state != 'draft' or not id"
                            class="btn-link d-block" />
                    </div>
                    <field
                        name="tender_order_ids"
                        invisible="not tender_id"
                        readonly="1">
                        <list
                            default_order="amount_total desc"
                            decoration-muted="state == 'cancel'">
                            <field name="currency_id" column_invisible="1" />
                            <field name="partner_id" />
                            <field name="name" string="Reference" />
                            <field name="amount_total" widget="monetary" />
                            <field name="state" />
                            <field name="outcome" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_compare_list" model="ir.ui.view">
        <field name="name">sale.order.line.compare.list</field>
        <field name="model">sale.order.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list
                string="Bids"
                editable="bottom"
                create="0"
                delete="0"
                decoration-muted="state in ['done', 'cancel']">
                <header>
                    <button
                        name="action_award_line"
                        type="object"
                        string="Award Selected" />
                    <button
                        name="action_clear_award"
                        type="object"
                        string="Clear Award" />
                </header>
                <field name="is_best_total" column_invisible="1" />
                <field name="is_best_unit" column_invisible="1" />
                <field name="product_id" readonly="1" />
                <field name="partner_id" string="Buyer" readonly="1" />
                <field name="order_id" string="Bid" readonly="1" />
                <field name="state" readonly="1" />
                <field name="product_qty" readonly="1" />
                <field name="qty_awarded" readonly="state != 'draft'" />
                <field
                    name="product_uom_id"
                    widget="many2one_uom"
                    groups="uom.group_uom"
                    readonly="1" />
                <field
                    name="price_unit"
                    readonly="1"
                    decoration-success="is_best_unit" />
                <field
                    name="price_subtotal"
                    string="Total"
                    decoration-success="is_best_total" />
                <field name="currency_id" column_invisible="1" />
                <button
                    name="action_award_line"
                    type="object"
                    string="Award"
                    icon="fa-bullseye"
                    invisible="product_qty &lt;= 0.0 or state != 'draft'" />
                <button
                    name="action_clear_award"
                    type="object"
                    string="Clear"
                    icon="fa-times"
                    invisible="qty_awarded &lt;= 0.0 or state != 'draft'" />
            </list>
        </field>
    </record>

    <record id="sale_tender_view_form" model="ir.ui.view">
        <field name="name">sale.tender.form</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <form string="Sale Tender">
                <header>
                    <button
                        name="action_award"
                        type="object"
                        string="Award"
                        invisible="state != 'open'"
                        class="btn-primary" />
                    <button
                        name="action_invite"
                        type="object"
                        string="Invite Buyers"
                        invisible="state != 'open'" />
                    <button
                        name="action_compare"
                        type="object"
                        string="Compare Bids"
                        invisible="state != 'open' or not order_ids" />
                    <button
                        name="action_reopen"
                        type="object"
                        string="Reopen"
                        invisible="state != 'cancel'" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'open'" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="open,awarded" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_offers"
                            type="object"
                            icon="fa-list-alt"
                            class="oe_stat_button">
                            <field
                                name="order_count"
                                string="Offers"
                                widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" domain="[('share', '=', False)]" />
                            <field
                                name="date_deadline"
                                decoration-danger="is_overdue" />
                            <field name="is_overdue" invisible="1" />
                        </group>
                        <group>
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="needs" string="Needs">
                            <field name="line_ids" readonly="state != 'open'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="product_id" />
                                    <field name="description" optional="show" />
                                    <field name="product_qty" />
                                    <field
                                        name="product_uom_id"
                                        groups="uom.group_uom" />
                                    <field name="date_needed" optional="show" />
                                    <field name="offer_count" optional="show" />
                                    <field name="qty_awarded" />
                                    <field
                                        name="qty_to_award"
                                        decoration-danger="qty_to_award &lt; 0"
                                        decoration-warning="qty_to_award &gt; 0" />
                                </list>
                            </field>
                        </page>
                        <page name="offers" string="Bids">
                            <field name="order_ids" readonly="state != 'open'">
                                <list
                                    default_order="amount_total"
                                    create="0"
                                    decoration-muted="state == 'cancel'">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="partner_id" />
                                    <field name="name" string="Reference" />
                                    <field name="date_commitment" />
                                    <field name="amount_total" widget="monetary" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'done'" />
                                    <field
                                        name="outcome"
                                        widget="badge"
                                        decoration-danger="outcome in ('lost', 'rejected')"
                                        decoration-success="outcome == 'won'" />
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Description">
                            <field name="description" class="oe-bordered-editor" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="sale_tender_view_list" model="ir.ui.view">
        <field name="name">sale.tender.list</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <list string="Sale Tenders" sample="1">
                <field name="name" decoration-bf="1" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="date_deadline" optional="show" />
                <field name="order_count" string="Offers" optional="show" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'open'"
                    decoration-success="state == 'awarded'" />
            </list>
        </field>
    </record>

    <record id="sale_tender_view_search" model="ir.ui.view">
        <field name="name">sale.tender.search</field>
        <field name="model">sale.tender</field>
        <field name="arch" type="xml">
            <search string="Sale Tenders">
                <field name="name" />
                <field name="user_id" />
                <filter
                    name="my_tenders"
                    string="My Tenders"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter name="open" string="Open" domain="[('state', '=', 'open')]" />
                <filter
                    name="awarded"
                    string="Awarded"
                    domain="[('state', '=', 'awarded')]" />
            </search>
        </field>
    </record>

    <record id="sale_tender_action" model="ir.actions.act_window">
        <field name="name">Sale Tenders</field>
        <field name="res_model">sale.tender</field>
        <field name="path">sale-tenders</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sale tender yet
            </p><p>
                From a quotation, invite several buyers to bid for the same lot;
                compare their bids line by line and award the best, in full or
                split between buyers.
            </p>
        </field>
    </record>

</odoo>
