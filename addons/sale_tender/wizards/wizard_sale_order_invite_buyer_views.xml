<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="sale_tender_invite_form" model="ir.ui.view">
            <field name="name">sale.tender.invite.form</field>
            <field name="model">wizard.sale.order.invite.buyer</field>
            <field name="arch" type="xml">
                <form string="Invite Buyers">
                    <group>
                        <field name="origin_order_id" invisible="1" />
                        <field name="tender_id" invisible="1" />
                        <group>
                            <field name="partner_ids" widget="many2many_tags" />
                            <field name="copy_products" />
                        </group>
                    </group>
                    <footer>
                        <button
                            name="action_invite"
                            type="object"
                            string="Invite"
                            colspan="1"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            special="cancel"
                            string="Cancel"
                            colspan="1"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
