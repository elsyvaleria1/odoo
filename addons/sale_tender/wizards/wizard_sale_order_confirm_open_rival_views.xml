<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="sale_tender_warning_form" model="ir.ui.view">
            <field name="name">sale.tender.warning.form</field>
            <field name="model">wizard.sale.order.confirm.open.rival</field>
            <field name="arch" type="xml">
                <form string="Other Bids">
                    <field name="rival_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="currency_id" column_invisible="1" />
                            <field
                                name="partner_id"
                                readonly="state in ['cancel', 'done']" />
                            <field name="name" string="Reference" />
                            <field name="date_commitment" />
                            <field name="amount_total" />
                            <field name="state" />
                        </list>
                    </field>
                    <footer>
                        <button
                            name="action_reject_rivals"
                            type="object"
                            string="Reject the Others"
                            colspan="1"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            name="action_keep_rivals"
                            type="object"
                            string="Keep Them Open"
                            colspan="1"
                            class="btn-primary"
                            data-hotkey="w" />
                        <button
                            special="cancel"
                            string="Discard"
                            colspan="1"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
