<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="appointment_crm.AppointmentCrmCalendarController" t-inherit="calendar.AttendeeCalendarController" t-inherit-mode="extension">
        <xpath expr="//span[@t-if='this.appointmentState.lastAppointment.url and !this.appointmentState.lastAppointment.waitingCopyLinkCustomType']" position="after">
            <p t-elif="this.getOpportunityName()" class="mx-2 user-select-none">
                Click in your calendar to pick meeting time proposals for <b t-out="this.getOpportunityName()"/>
            </p>
        </xpath>
    </t>
</templates>
