<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="appointment_type_view_form" model="ir.ui.view">
        <field name="name">appointment.type.view.form.inherit.crm</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="calendar.appointment_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_calendar_meetings']" position="before">
                <button
                    name="action_appointment_leads"
                    type="object"
                    icon="fa-star"
                    groups="sale.group_sale_salesman"
                    invisible="lead_count == 0"
                    class="oe_stat_button">
                    <field name="lead_count" string="Leads" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//group[@name='options_left_details']" position="inside">
                <field name="lead_create" groups="sale.group_sale_manager" />
            </xpath>
        </field>
    </record>

</odoo>
