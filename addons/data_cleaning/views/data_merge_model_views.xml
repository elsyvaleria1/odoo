<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_data_merge_model_list" model="ir.ui.view">
            <field name="name">Deduplication Model List</field>
            <field name="model">data_merge.model</field>
            <field name="arch" type="xml">
                <list decoration-muted="not active">
                    <field name="name" />
                    <field name="res_model_id" />
                    <field name="merge_mode" groups="base.group_no_one" />
                    <field name="active" widget="boolean_toggle" />
                </list>
            </field>
        </record>
        <record id="view_data_merge_model_form" model="ir.ui.view">
            <field name="name">Deduplication Model Form</field>
            <field name="model">data_merge.model</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            name="action_find_duplicates"
                            type="object"
                            string="Deduplicate"
                            class="oe_highlight" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button
                                name="open_records"
                                type="object"
                                icon="fa-clone"
                                class="oe_stat_button">
                                <field
                                    name="records_to_merge_count"
                                    string="Duplicates"
                                    widget="statinfo" />
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field
                                    name="res_model_id"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="res_model_name" invisible="1" />
                                <field
                                    name="domain"
                                    widget="domain"
                                    options="{'model': 'res_model_name'}" />
                                <field
                                    name="mix_by_company"
                                    widget="boolean_toggle"
                                    groups="base.group_multi_company" />
                                <field name="custom_merge_method" invisible="1" />
                                <field
                                    name="removal_mode"
                                    widget="radio"
                                    options="{'horizontal': true}"
                                    invisible="custom_merge_method" />
                                <label
                                    for="removal_mode"
                                    invisible="not custom_merge_method" />
                                <span invisible="not custom_merge_method">Model specific</span>
                            </group>
                            <group>
                                <field
                                    name="merge_mode"
                                    widget="radio"
                                    options="{'horizontal': true}" />

                                <!-- Manual merge -->
                                <label
                                    for="notify_user_ids"
                                    invisible="merge_mode == 'automatic'" />
                                <div invisible="merge_mode == 'automatic'">
                                    <field
                                        name="notify_user_ids"
                                        widget="many2many_tags"
                                        domain="[('share', '=', False)]"
                                        options="{'no_create': True, 'no_edit': True}" />
                                    <div
                                        class="d-flex w-50"
                                        invisible="not notify_user_ids">
                                        <span class="me-1">Every</span>
                                        <field
                                            name="notify_interval"
                                            required="notify_user_ids" />
                                        <field
                                            name="notify_unit"
                                            required="notify_user_ids" />
                                    </div>
                                </div>

                                <!-- Automatic merge -->
                                <label
                                    for="merge_threshold"
                                    invisible="merge_mode == 'manual'" />
                                <div invisible="merge_mode == 'manual'">
                                    <field
                                        name="merge_threshold"
                                        required="merge_mode == 'automatic'"
                                        class="oe_inline" />
                                    <span class="oe_inline">%</span>
                                </div>

                                <label
                                    for="create_threshold"
                                    groups="base.group_no_one" />
                                <div groups="base.group_no_one">
                                    <field name="create_threshold" class="oe_inline" />
                                    <span class="oe_inline">%</span>
                                </div>
                                <field name="active" widget="boolean_toggle" />
                            </group>
                        </group>
                        <group invisible="res_model_id">
                            <group>
                                <div class="alert alert-info" role="alert" colspan="2">
                                    Select a model to configure deduplication rules
                                </div>
                            </group>
                        </group>
                        <group invisible="not res_model_id">
                            <field
                                name="rule_ids"
                                context="{'default_res_model_id': res_model_id}">
                                <list string="Deduplication Rules" editable="bottom">
                                    <field
                                        name="res_model_id"
                                        column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="field_id"
                                        options="{'no_create': True, 'no_open': True}" />
                                    <field name="match_mode" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="data_merge_model_view_search" model="ir.ui.view">
            <field name="name">data_merge.model.search</field>
            <field name="model">data_merge.model</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <separator />
                    <filter
                        name="archived"
                        string="Archived"
                        domain="[('active', '=', False)]" />
                </search>
            </field>
        </record>
        <record id="action_data_merge_config" model="ir.actions.act_window">
            <field name="name">Deduplication Rules</field>
            <field name="res_model">data_merge.model</field>
            <field name="view_mode">list,form</field>
            <field
                name="domain">[('is_contextual_merge_action', '=', False), '|', ('active', '=', False), ('active', '=', True)]</field>
        </record>
    </data>

</odoo>
