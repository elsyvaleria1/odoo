<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_data_storage_tree" model="ir.ui.view">
            <field name="name">Storage</field>
            <field name="model">ir.attachment.report</field>
            <field name="arch" type="xml">
                <list create="0" delete="0" export_xlsx="0" sample="0">
                    <field name="res_id" widget="many2one_reference" />
                    <field name="res_model" />
                    <field name="size" />
                    <button
                        name="action_attachment_detail"
                        type="object"
                        string="Details"
                        icon="fa-pencil-square-o" />
                </list>
            </field>
        </record>
        <record id="view_data_storage_search" model="ir.ui.view">
            <field name="name">Data Cleaning Storage Search</field>
            <field name="model">ir.attachment.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="res_model" />
                    <field name="res_id" />
                    <group>
                        <filter
                            name="group_res_model"
                            string="Model"
                            context="{'group_by':'res_model'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="action_data_storage" model="ir.actions.act_window">
            <field name="name">Storage</field>
            <field name="res_model">ir.attachment.report</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_data_storage_search" />
            <field name="domain" />
            <field name="context">{}</field>
            <field
                name="view_ids"
                eval="[Command.clear(), Command.create({'view_mode': 'list', 'view_id': ref('view_data_storage_tree'), 'sequence': 1})]" />
        </record>
        <record id="view_data_storage_attachment_tree" model="ir.ui.view">
            <field name="name">Storage Detail</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <list
                    default_order="file_size desc"
                    create="0"
                    delete="0"
                    export_xlsx="0"
                    sample="0">
                    <field name="name" />
                    <field name="file_size" />
                </list>
            </field>
        </record>
    </data>

</odoo>
