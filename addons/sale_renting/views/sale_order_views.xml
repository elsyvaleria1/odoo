<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rental_order_form_view" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <field name="is_rental_order" invisible="1" />
            </header>
            <button name="action_send_quotation" position="before">
                <button
                    name="action_view_pickup"
                    type="object"
                    string="Pickup"
                    invisible="not has_pickable_lines or state != 'done'"
                    class="btn-primary"
                    data-hotkey="y" />
                <button
                    name="action_view_return"
                    type="object"
                    string="Return"
                    invisible="state != 'done' or not has_returnable_lines or has_returnable_lines and has_pickable_lines"
                    class="btn-primary"
                    data-hotkey="k" />
                <button
                    name="action_view_return"
                    type="object"
                    string="Return"
                    invisible="state != 'done' or not has_returnable_lines or has_returnable_lines and not has_pickable_lines"
                    class="btn-secondary"
                    data-hotkey="k" />
            </button>
            <div name="button_box" position="after">
                <div class="badge rounded-pill text-bg-success float-end border-0" invisible="not has_rented_products or state != 'done' or rental_status != 'pickup' or is_late">Booked</div>
                <div class="badge rounded-pill text-bg-danger float-end border-0" invisible="not has_rented_products or state != 'done' or rental_status != 'pickup' or not is_late">Late Pickup</div>
                <div class="badge rounded-pill text-bg-warning float-end border-0" invisible="not has_rented_products or state != 'done' or rental_status != 'return' or is_late">Picked-up</div>
                <div class="badge rounded-pill text-bg-danger float-end border-0" invisible="not has_rented_products or state != 'done' or rental_status != 'return' or not is_late">Late Return</div>
                <div class="badge rounded-pill text-bg-default float-end border-0" invisible="not has_rented_products or state != 'done' or rental_status != 'returned'">Returned</div>
            </div>
            <field name="payment_term_id" position="after">
                <field
                    name="rental_return_date"
                    invisible="1"
                    required="has_rented_products" />
                <field
                    name="rental_start_date"
                    string="Rental period"
                    widget="daterange"
                    options="{'end_date_field': 'rental_return_date'}"
                    invisible="not is_rental_order"
                    required="has_rented_products" />
                <label
                    for="duration_days"
                    string="Duration"
                    invisible="not is_rental_order and not rental_start_date" />
                <div
                    class="o_row"
                    invisible="not is_rental_order and not rental_start_date">
                    <field
                        name="duration_days"
                        invisible="duration_days == 0"
                        class="oe_inline"
                        style="max-width: 2rem" />
                    <span invisible="duration_days != 1"> day </span>
                    <span invisible="duration_days in [0,1]"> days </span>
                    <span invisible="duration_days == 0 or remaining_hours == 0">and </span>
                    <field
                        name="remaining_hours"
                        invisible="remaining_hours == 0"
                        class="oe_inline"
                        style="max-width: 2rem" />
                    <span invisible="remaining_hours != 1"> hour </span>
                    <span invisible="remaining_hours in [0,1]"> hours </span>
                    <button
                        name="action_update_rental_prices"
                        type="object"
                        string="Update Rental Prices"
                        help="Recompute all prices based on this duration"
                        confirm="This will update the unit price of all rental products based on the new period."
                        icon="fa-refresh"
                        invisible="not show_update_duration or state in ['done', 'cancel']"
                        class="btn-link mb-1 px-0" />
                </div>
            </field>
            <xpath
                expr="//field[@name='line_ids']//list//field[@name='qty_transferred']"
                position="after">
                <field
                    name="qty_returned"
                    invisible="not is_rental or not is_product_rentable"
                    column_invisible="parent.state != 'done' or not parent.is_rental_order" />
            </xpath>
        </field>
    </record>

    <record id="rental_order_primary_form_view" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="rental_order_form_view" />
        <field name="mode">primary</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <data>
                <!-- empty on purpose, can be dropped once sale_stock_renting override is dropped -->
            </data>
        </field>
    </record>

    <record id="rental_order_view_tree" model="ir.ui.view">
        <field name="name">rental.order.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list sample="1" decoration-muted="rental_status == 'cancel'">
                <field name="name" readonly="1" decoration-bf="1" />
                <field name="date_order" options="{'show_time': false}" />
                <field name="next_action_date" widget="remaining_days" />
                <field name="partner_id" readonly="1" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="team_id" optional="hide" />
                <field
                    name="amount_total"
                    widget="monetary"
                    sum="Total Tax Included"
                    decoration-bf="1"
                    decoration-info="invoice_state == 'to do'" />
                <field
                    name="rental_status"
                    widget="badge"
                    invisible="not has_rented_products"
                    decoration-info="rental_status == 'draft'"
                    decoration-primary="rental_status == 'sent'"
                    decoration-success="rental_status == 'pickup'"
                    decoration-warning="rental_status == 'return'" />
                <field name="currency_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="rental_order_view_kanban" model="ir.ui.view">
        <field name="name">rental.order.kanban</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban" />
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="quick_create">false</attribute>
                <attribute name="class">o_kanban_mobile align-content-start</attribute>
            </kanban>
            <field name="currency_id" position="after">
                <field name="is_late" />
                <field name="has_rented_products" />
            </field>
            <xpath expr="//footer/div" position="replace">
                <div class="text-muted">
                    <field name="name" />
                    <br />
                    <span
                        t-if="record.next_action_date.value"
                        t-attf-class="#{record.is_late.raw_value ? 'text-danger' : 'text-muted'}">
                        <t t-if="record.is_late.raw_value">
                            <i class="fa-solid fa-triangle-exclamation" /> Late
                        </t>
                        <t t-if="record.rental_status.raw_value=='pickup'">
                            Pickup:
                        </t>
                        <t t-elif="record.rental_status.raw_value=='return'">
                            Return:
                        </t>
                    </span>
                    <field name="next_action_date" />
                </div>
            </xpath>
            <field name="state" position="attributes">
                <attribute name="invisible">state == 'done' and rental_status</attribute>
            </field>
            <field name="state" position="after">
                <field
                    name="rental_status"
                    widget="label_selection"
                    options="{'classes': {'pickup': 'success', 'return': 'warning', 'returned': 'default'}}"
                    invisible="state != 'done' or not rental_status or not has_rented_products"
                    class="ms-auto" />
            </field>
        </field>
    </record>

    <record id="rental_order_view_calendar" model="ir.ui.view">
        <field name="name">rental.order.calendar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_calendar" />
        <field name="mode">primary</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="date_start">rental_start_date</attribute>
                <attribute name="date_stop">rental_return_date</attribute>
                <attribute name="color">rental_status</attribute>
                <attribute name="edit">0</attribute>
            </calendar>
            <field name="state" position="replace">
                <field name="rental_status" invisible="1" filters="1" />
            </field>
        </field>
    </record>

    <record id="rental_order_view_search" model="ir.ui.view">
        <field name="name">rental.order.search</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Order"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self)]" />
                <field name="partner_id" operator="child_of" />
                <field name="user_id" />
                <field name="team_id" string="Sales Team" />
                <field
                    name="line_ids"
                    string="Product"
                    filter_domain="[('line_ids.product_id', 'ilike', self)]" />
                <filter
                    name="my_rental_orders"
                    string="My Orders"
                    domain="[('user_id','=',uid)]" />
                <separator />
                <filter
                    name="from_rental"
                    string="Rentals"
                    domain="[('is_rental_order', '=', True)]" />
                <separator />
                    <filter
                        name="filter_today"
                        string="To Do Today"
                        domain="[('next_action_date', '&gt;=', 'today'), ('next_action_date', '&lt;', 'today +1d')]" />
                    <filter
                        name="rental_late_orders"
                        string="Late"
                        domain="[('rental_status', 'in', ['pickup', 'return']), ('next_action_date', '&lt;', '+1H')]" />
                <separator />
                    <filter
                        name="filter_pickup"
                        string="Pickup Date"
                        domain="[('rental_status', '=', 'pickup')]"
                        date="next_action_date" />
                    <filter
                        name="filter_return"
                        string="Return Date"
                        domain="[('rental_status', '=', 'return')]"
                        date="next_action_date" />
                <separator />
                <group>
                    <filter
                        name="groupby_status"
                        string="Status"
                        context="{'group_by': 'rental_status'}" />
                    <separator />
                    <filter
                        name="salesperson"
                        string="Salesperson"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="customer"
                        string="Customer"
                        context="{'group_by': 'partner_id'}" />
                </group>
                <searchpanel>
                    <field name="rental_status" icon="fa-retweet" enable_counters="1" />
                    <field name="invoice_state" icon="fa-retweet" enable_counters="1" />
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="rental_order_view_search_without_searchpanel" model="ir.ui.view">
        <field name="name">rental.order.search.bis</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="rental_order_view_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <filter name="rental_late_orders" position="after">
                <separator />
                <filter
                    name="filter_to_pickup"
                    string="To Pickup"
                    domain="[('rental_status', '=', 'pickup')]" />
                <filter
                    name="filter_to_return"
                    string="To Return"
                    domain="[('rental_status', '=', 'return')]" />
            </filter>
        </field>
    </record>

    <record id="rental_order_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">sale.order</field>
        <field name="path">rental</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="rental_order_view_search" />
        <field
            name="context">{'in_rental_app': 1, 'search_default_from_rental': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new rental!
            </p>
            <p>
                Once the quotation is confirmed, it becomes a rental order.<br /> You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <record id="rental_order_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="rental_order_view_kanban" />
        <field name="act_window_id" ref="rental_order_action" />
    </record>

    <record id="rental_order_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="rental_order_view_tree" />
        <field name="act_window_id" ref="rental_order_action" />
    </record>

    <record id="rental_order_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="rental_order_primary_form_view" />
        <field name="act_window_id" ref="rental_order_action" />
    </record>

    <record id="rental_order_action_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="4" />
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="rental_order_view_calendar" />
        <field name="act_window_id" ref="rental_order_action" />
    </record>

    <record id="rental_order_today_pickup_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field
            name="search_view_id"
            ref="rental_order_view_search_without_searchpanel" />
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field
            name="context">{'in_rental_app': 1, 'search_default_filter_today': 1, 'search_default_filter_to_pickup': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There isn't any scheduled pickup or return.
            </p>
            <p>
                You can search on a larger period using the filters here above
                <br />
                or create a new rental order.
            </p>
        </field>
    </record>

    <record id="rental_order_today_pickup_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="rental_order_view_kanban" />
        <field name="act_window_id" ref="rental_order_today_pickup_action" />
    </record>

    <record id="rental_order_today_pickup_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="rental_order_view_tree" />
        <field name="act_window_id" ref="rental_order_today_pickup_action" />
    </record>

    <record id="rental_order_today_pickup_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="rental_order_primary_form_view" />
        <field name="act_window_id" ref="rental_order_today_pickup_action" />
    </record>

    <record
        id="rental_order_today_pickup_action_view_calendar"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="4" />
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="rental_order_view_calendar" />
        <field name="act_window_id" ref="rental_order_today_pickup_action" />
    </record>

    <record id="rental_order_today_return_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field
            name="search_view_id"
            ref="rental_order_view_search_without_searchpanel" />
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field
            name="context">{'in_rental_app': 1, 'search_default_filter_today': 1, 'search_default_filter_to_return': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There isn't any scheduled pickup or return.
            </p>
            <p>
                You can search on a larger period using the filters here above
                <br />
                or create a new rental order.
            </p>
        </field>
    </record>

    <record id="rental_order_today_return_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="rental_order_view_kanban" />
        <field name="act_window_id" ref="rental_order_today_return_action" />
    </record>

    <record id="rental_order_today_return_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="rental_order_view_tree" />
        <field name="act_window_id" ref="rental_order_today_return_action" />
    </record>

    <record id="rental_order_today_return_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="rental_order_primary_form_view" />
        <field name="act_window_id" ref="rental_order_today_return_action" />
    </record>

    <record
        id="rental_order_today_return_action_view_calendar"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="4" />
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="rental_order_view_calendar" />
        <field name="act_window_id" ref="rental_order_today_return_action" />
    </record>

    <record id="action_create_rental_order" model="ir.actions.act_window">
        <field name="name">Create Rental Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="rental_order_primary_form_view" />
        <field
            name="context">{
                'in_rental_app': 1,
            }</field>
    </record>

</odoo>
