<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rental_order_wizard_view_form" model="ir.ui.view">
        <field name="name">rental.order.wizard.form</field>
        <field name="model">wizard.sale.order.pickup.return</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="status" invisible="1" />
                    <field name="is_late" invisible="1" />
                    <field name="order_id" invisible="1" />
                    <field name="rental_wizard_line_ids">
                        <list editable="top" create="false">
                            <field
                                name="product_id"
                                force_save="1"
                                options="{'no_open': True}"
                                readonly="1" />
                            <field name="order_line_id" column_invisible="True" />
                            <field
                                name="rental_order_wizard_id"
                                column_invisible="True" />
                            <field
                                name="qty_reserved"
                                column_invisible="parent.status == 'return'"
                                readonly="1" />
                            <field
                                name="qty_transferred"
                                force_save="1"
                                readonly="parent.status == 'return'" />
                            <field
                                name="qty_returned"
                                column_invisible="parent.status == 'pickup'" />
                            <field name="status" column_invisible="True" />
                            <button
                                title="Some delay cost will be added to the sales order."
                                icon="fa-clock-o"
                                column_invisible="not parent.is_late or parent.status == 'pickup'"
                                class="text-danger" />
                        </list>
                    </field>
                    <footer>
                        <button
                            name="apply"
                            type="object"
                            string="Validate"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
