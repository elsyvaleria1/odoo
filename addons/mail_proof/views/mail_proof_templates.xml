<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="email_code_body">
        <div style="font-family: sans-serif; font-size: 14px;">
            <p>
                Hello <t t-out="signer.name" />,
            </p>
            <p>
                <t t-out="asker.name" /> is asking you to confirm the following. If you agree, give them this code:
            </p>
            <p style="font-size: 28px; font-weight: bold; letter-spacing: 6px;">
                <t t-out="code" />
            </p>
            <table t-if="summary" style="border-collapse: collapse;">
                <tr t-foreach="summary" t-as="line">
                    <th
                        style="text-align: left; padding: 2px 12px 2px 0;"
                        t-out="line[0]" />
                    <td style="padding: 2px 0;" t-out="line[1]" />
                </tr>
            </table>
            <p style="color: #777;">
                If you did not expect this, do not give the code to anyone.
            </p>
        </div>
    </template>

    <template id="email_confirm_body">
        <div style="font-family: sans-serif; font-size: 14px;">
            <p>
                Hello <t t-out="signer.name" />,
            </p>
            <p t-if="reminder">
                We have not heard from you yet. <t t-out="company.name" /> asks you to confirm the following:
            </p>
            <p t-else="">
                <t t-out="company.name" /> asks you to confirm the following:
            </p>
            <table
                t-if="summary"
                style="border-collapse: collapse; margin-bottom: 16px;">
                <tr t-foreach="summary" t-as="line">
                    <th
                        style="text-align: left; padding: 2px 12px 2px 0;"
                        t-out="line[0]" />
                    <td style="padding: 2px 0;" t-out="line[1]" />
                </tr>
            </table>
            <p>
                <a
                    t-att-href="url"
                    style="display: inline-block; padding: 10px 20px; background-color: #714B67; color: #FFFFFF; text-decoration: none; border-radius: 4px;">
                    Confirm or report a problem
                </a>
            </p>
            <p t-foreach="links" t-as="link">
                <a t-att-href="link[1]" t-out="link[0]" />
            </p>
            <p style="color: #777;">
                The link works until <t t-out="date_expire" t-options="{'widget': 'datetime'}" />. If something is not right, tell us on the same page.
            </p>
        </div>
    </template>

</odoo>
