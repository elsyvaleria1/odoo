<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calendar_event_form_conversation" model="ir.ui.view">
        <field name="name">calendar.event.form.conversation</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_start_conversation"
                    type="object"
                    string="Record conversation"
                    groups="conversation.group_user"
                    class="btn-primary" />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_view_conversations"
                    type="object"
                    icon="fa-comments"
                    groups="conversation.group_user"
                    invisible="conversation_count == 0"
                    class="oe_stat_button">
                    <field
                        name="conversation_count"
                        string="Conversations"
                        widget="statinfo" />
                </button>
            </div>
        </field>
    </record>

</odoo>
