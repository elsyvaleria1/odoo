#. module: approval_proof
#. odoo-python
#: code:addons/approval_proof/models/approval_category.py:0
msgid ""
"%(category)s asks for a proof of identity, so its requests cannot be "
"approved by consent."
msgstr ""
"%(category)s pide una comprobación de identidad, por lo que sus solicitudes "
"no pueden aprobarse por consentimiento."

#. module: approval_proof
#. odoo-python
#: code:addons/approval_proof/models/approval_category.py:0
msgid ""
"%(category)s asks for a proof of identity: choose the proof methods it "
"accepts."
msgstr ""
"%(category)s pide una comprobación de identidad: elija los métodos de "
"comprobación que acepta."

#. module: approval_proof
#. odoo-python
#: code:addons/approval_proof/models/approval_approver.py:0
msgid ""
"%(category)s is decided by the approvers themselves: %(user)s cannot hand "
"their approval to someone else."
msgstr ""
"%(category)s la deciden los propios aprobadores: %(user)s no puede delegar "
"su aprobación en otra persona."

#. module: approval_proof
#. odoo-python
#: code:addons/approval_proof/models/approval_request.py:0
msgid ""
"%(request)s needs a proof that it is you before your decision counts. Decide"
" it from the request, or from your approval activity, one request at a time."
msgstr ""
"%(request)s necesita una comprobación de que es usted antes de que cuente su"
" decisión. Decida desde la solicitud o desde su actividad de aprobación, una"
" solicitud a la vez."

#. module: approval_proof
#. odoo-python
#: code:addons/approval_proof/models/approval_request.py:0
msgid "%(shown)s and %(more)s more"
msgstr "%(shown)s y %(more)s más"

