<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="knowledge.EmbeddedViewLinkPopover">
        <div class="shadow p-3 d-flex">
            <div class="cursor-pointer flex-grow-1 text-primary fw-bold text-truncate pe-2" t-on-click="this.props.openViewLink" t-out="this.props.name"/>
            <div class="cursor-pointer mx-1" t-on-click="this.props.onCopyViewLinkClick" title="Copy Link">
                <i class="fa-solid fa-paste"/>
            </div>
            <div class="cursor-pointer mx-1" t-on-click="this.props.onEditViewLinkClick" title="Edit Link">
                <i class="fa-regular fa-pen-to-square"/>
            </div>
            <div class="cursor-pointer mx-1" t-on-click="this.props.onRemoveViewLinkClick" title="Remove Link">
                <i class="fa-solid fa-link-slash"/>
            </div>
        </div>
    </t>
</templates>
