<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="knowledge.KnowledgeTopbar">
        <div class="o_knowledge_header d-flex align-items-center d-print-none py-2 px-md-2 px-1">
            <div class="d-flex d-md-none align-self-start">
                <button class="o_knowledge_toggle_sidebar btn btn-light text-muted"
                    t-on-click="this.knowledgeContext.toggleAsideMobile"
                    title="Toggle aside menu">
                    <i class="oi oi-lg oi-panel-right"/>
                </button>
            </div>
            <div t-if="this.props.record.resId" class="d-flex flex-grow-1 flex-wrap min-w-0">
                <KnowledgeHierarchy record="this.props.record"/>
            </div>
            <div t-if="this.props.record.resId" class="d-flex align-self-start flex-shrink-0">
                <button t-if="this.props.record.data.active" t-attf-class="btn btn-light text-muted #{this.state.shareBtnIsActive ? 'show' : ''}" t-on-click="this.togglePermissionPanel" data-hotkey="shift+s">
                    <t t-if="this.isInternalUser">Share</t>
                    <t t-else="">Members</t>
                </button>
                <button t-if="this.isInternalUser"
                    t-attf-class="d-none d-md-block btn btn-light text-muted btn-chatter #{this.chatterPanelState.isDisplayed ? 'active' : ''}"
                    t-on-click="this.knowledgeContext.toggleChatter"
                    t-att-title="this.chatterButtonTitle"
                    data-hotkey="d">
                    <i class="fa-regular fa-comments fs-6"/>
                </button>
                <button t-if="this.propertiesPanelState.isDisplayed or this.props.record.data.article_properties.some((prop) => !prop.definition_deleted)"
                    t-attf-class="d-none d-md-block btn btn-light text-muted btn-properties #{this.propertiesPanelState.isDisplayed ? 'active' : ''}"
                    t-on-click="this.knowledgeContext.toggleProperties"
                    title="Show Properties"
                    data-hotkey="o">
                    <i class="fa-solid fa-cogs fs-6"/>
                </button>
                <button t-if="this.commentsState.hasComments"
                    t-attf-class="d-none d-md-block btn btn-light text-muted btn-comments #{this.commentsState.displayMode === 'panel' ? 'active' : ''}"
                    t-on-click="this.knowledgeContext.toggleComments"
                    t-att-title="this.commentButtonTitle">
                    <i class="fa-regular fa-comment-dots fs-6"/>
                </button>
                <button class="d-none d-md-block btn btn-light o_knowledge_toggle_favorite"
                    t-on-click="this.knowledgeContext.toggleFavorite"
                    t-att-title="this.favoriteButtonTitle"
                    data-hotkey="t">
                    <i t-if="this.props.record.data.is_user_favorite" class="fa-solid fa-star fs-4"/>
                    <i t-if="!this.props.record.data.is_user_favorite" class="fa-regular fa-star fs-4"/>
                </button>
                <OptionsDropdown record="this.props.record"/>
            </div>
        </div>
    </t>
</templates>
