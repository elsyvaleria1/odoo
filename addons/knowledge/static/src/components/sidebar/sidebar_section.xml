<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="knowledge.SidebarSection">
        <section
            t-attf-class="o_section #{sectionClass || ''}"
            t-att-class="{'folded': this.state.isFolded}"
            t-att-data-section="this.getSectionIdentifier()">
            <div class="o_section_header d-flex align-items-center mb-0">
                <div class="o_section_header_label flex-grow-1 align-content-center text-muted text-truncate cursor-pointer"
                    t-out="sectionName"
                    t-on-click="this.toggleSidebarSection"
                    title="Fold/unfold the section"/>
                <t t-out="headerButtons"/>
            </div>
            <t t-if="!this.state.isFolded">
                <ul t-if="this.props.rootIds.length" class="o_tree mb-2">
                    <t t-foreach="this.props.rootIds" t-as="rootId" t-key="rootId">
                        <KnowledgeSidebarRow article="this.knowledgeContext.getArticle(rootId)" unfolded="this.props.unfoldedIds.has(rootId)" unfoldedIds="this.props.unfoldedIds" record="this.props.record"/>
                    </t>
                </ul>
                <t t-elif="noContentHelper" t-out="noContentHelper" />
            </t>
        </section>
    </t>

    <t t-name="knowledge.SidebarFavoriteSection">
        <t t-call="knowledge.SidebarSection" sectionName.translate="Favorites"/>
    </t>

    <t t-name="knowledge.SidebarWorkspaceSection">
        <t t-if="this.isInternalUser" t-set="headerButtons">
            <a class="o_knowledge_join_article_members rounded p-1 opacity-75 opacity-100-hover text-muted"
                t-on-click="this.searchHiddenArticle" role="button" title="Join a hidden article">
                <i class="fa-regular fa-eye"/>
            </a>
            <a t-if="this.canCreateArticle" class="o_section_create rounded p-1 opacity-75 opacity-100-hover text-muted"
                t-on-click="this.createRoot" role="button" title="Create a new article in workspace">
                <i class="fa-solid fa-plus"/>
            </a>
        </t>
        <t t-set="noContentHelper">
            <div class="o_knowledge_empty_info text-muted">
                There are no Articles in your Workspace.
            </div>
        </t>
        <t t-call="knowledge.SidebarSection"
            sectionName.translate="Workspace"
            headerButtons="headerButtons"
            noContentHelper="noContentHelper"/>
    </t>

    <t t-name="knowledge.SidebarSharedSection">
        <t t-call="knowledge.SidebarSection" t-if="this.props.rootIds.length"
            sectionName.translate="Shared"/>
    </t>

    <t t-name="knowledge.SidebarPrivateSection">
        <t t-set="headerButtons">
            <a t-if="this.canCreateArticle" class="o_section_create rounded p-1 opacity-75 opacity-100-hover text-muted"
                t-on-click="this.createRoot" role="button" title="Create a new private article">
                <i class="fa-solid fa-plus"/>
            </a>
        </t>
        <t t-set="noContentHelper">
            <div class="o_knowledge_empty_info text-muted">
                You have no private Article.
            </div>
        </t>
        <t t-call="knowledge.SidebarSection"
            sectionName.translate="Private"
            sectionClass="'flex-fill'"
            headerButtons="headerButtons"
            noContentHelper="noContentHelper"/>
    </t>
</templates>
