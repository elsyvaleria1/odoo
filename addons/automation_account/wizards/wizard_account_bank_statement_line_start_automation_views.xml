<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_automation_runtime_create_form" model="ir.ui.view">
        <field name="name">automation.runtime.create.form</field>
        <field name="model">wizard.account.bank.statement.line.start.automation</field>
        <field name="arch" type="xml">
            <form string="Create Automation Workflow">
                <sheet>
                    <group>
                        <group>
                            <field
                                name="st_line_id"
                                options="{'no_open': True, 'no_create': True}"
                                readonly="1" />
                            <field name="automation_id" options="{'no_create': True}" />
                            <field name="started_automation_ids" invisible="1" />
                            <field name="partner_id" options="{'no_create': True}" />
                            <field
                                name="third_party_id"
                                options="{'no_create': True}" />
                        </group>
                        <group>
                            <field name="reference" />
                            <field name="currency_id" invisible="1" />
                            <field name="amount" />
                            <field name="date" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>
                    </group>
                    <div
                        name="problem_banner"
                        class="alert alert-warning"
                        role="alert"
                        invisible="not problem_message">
                        <strong>This run cannot complete as it stands:</strong>
                        <field name="problem_message" />
                    </div>
                    <group
                        name="plan_preview"
                        string="What This Run Does"
                        invisible="not plan_preview">
                        <field name="plan_preview" colspan="2" nolabel="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_create_runtime"
                        type="object"
                        string="Create and Start Workflow"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_automation_runtime_create_from_bank"
        model="ir.actions.act_window">
        <field name="name">Create Automation Workflow…</field>
        <field
            name="res_model">wizard.account.bank.statement.line.start.automation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="binding_model_id"
            ref="account.model_account_bank_statement_line" />
        <field name="binding_view_types">form</field>
    </record>

</odoo>
