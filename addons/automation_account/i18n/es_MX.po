msgstr "Emitir a"

#. module: automation_account
#: model:ir.model.fields.selection,name:automation_account.selection__ir_actions_server__workflow_partner_source__partner
msgid "Run's Partner"
msgstr "Contacto de la ejecución"

#. module: automation_account
#: model:ir.model.fields,field_description:automation_account.field_ir_actions_server__workflow_date_source
#: model:ir.model.fields,field_description:automation_account.field_ir_cron__workflow_date_source
