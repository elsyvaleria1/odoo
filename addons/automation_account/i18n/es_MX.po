#. odoo-python
#: code:addons/automation_account/models/automation_runtime.py:0
msgid ""
"%(line)s already started '%(workflow)s' as %(run)s. A bank statement line "
"starts each workflow once; cancel %(run)s to start it again."
msgstr ""
"%(line)s ya inició '%(workflow)s' como %(run)s. Una línea de estado de cuenta "
"inicia cada flujo de trabajo una sola vez; cancele %(run)s para iniciarlo de "
"nuevo."

#. module: automation_account
#: model:ir.model.fields,help:automation_account.field_wizard_account_bank_statement_line_start_automation__started_automation_ids
msgid ""
"The workflows this bank statement line has already started and not "
"cancelled, which it cannot start again"
msgstr ""
"Los flujos de trabajo que esta línea de estado de cuenta ya inició y no se "
"cancelaron, que no puede volver a iniciar"
