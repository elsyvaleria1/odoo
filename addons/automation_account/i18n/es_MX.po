msgstr "Compañía de la plantilla"

#. module: automation_account
#: model:ir.model.fields,field_description:automation_account.field_ir_actions_server__workflow_partner_source
#: model:ir.model.fields,field_description:automation_account.field_ir_cron__workflow_partner_source
