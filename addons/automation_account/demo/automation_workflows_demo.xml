    <record id="action_cash_exch_simple_invoice" model="ir.actions.server">
        <field name="name">Create Customer Invoice</field>
        <field name="model_id" ref="automation.model_automation_runtime_line" />
        <field name="state">code</field>
        <field
            name="code"># TODO: Update template reference based on actual template for cash exchange
# Using template_8 as placeholder (Customer invoice)
template = env.ref('automation_account.template_customer_invoice_generic', raise_if_not_found=False)
if not template:
    raise UserError("Cash exchange customer invoice template not found. Please configure the correct template.")

move = action.create_move_from_template(record, template)
record.write({'created_record_ref': f'account.move,{move.id}'})
action.mark_action_done_and_continue(record)</field>
        <field name="automation_rule_id" ref="automation_cash_exchange_simple" />
        <field name="sequence" eval="10" />
    </record>

    <record id="action_cash_exch_simple_reconcile" model="ir.actions.server">
        <field name="name">Reconcile Payment</field>
        <field name="model_id" ref="automation.model_automation_runtime_line" />
        <field name="state">code</field>
        <field
            name="code"># Only reconcile if bank statement line exists
if record.runtime_id.st_line_id:
    action.reconcile_statement_with_latest_move(record)
else:
    # Skip reconciliation if no bank statement
    pass

action.mark_action_done_and_continue(record)</field>
        <field name="automation_rule_id" ref="automation_cash_exchange_simple" />
        <field name="sequence" eval="11" />
    </record>

