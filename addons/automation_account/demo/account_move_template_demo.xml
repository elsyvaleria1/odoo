<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="template_customer_invoice_fx_agro" model="account.move.template">
        <field name="name">DEMO - Customer Invoice FX (Agroquimicos)</field>
        <field name="journal_code">DINV</field>
        <field name="move_type">out_invoice</field>
    </record>

    <record
        id="template_customer_invoice_fx_agro_line1"
        model="account.move.template.line">
        <field name="template_id" ref="template_customer_invoice_fx_agro" />
        <field name="name">Invoice Item</field>
        <field name="account_code">400000</field>
        <field name="sequence" eval="10" />
        <field name="price_unit">100.00</field>
    </record>

    <record id="template_customer_invoice_fx" model="account.move.template">
