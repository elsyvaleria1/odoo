<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="view_hr_job_employee_referral_kanban_inherit_referral_whatsapp"
        model="ir.ui.view">
        <field
            name="name">hr.job.employee.referral.kanban.inherit.referral.whatsapp</field>
        <field name="model">hr.job</field>
        <field
            name="inherit_id"
            ref="hr_referral.view_hr_job_employee_referral_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//a[hasclass('o_hr_referral_job_url')]" position="before">
                <a
                    role="button"
                    name="action_view_whatsapp_composer"
                    type="object"
                    class="btn btn-secondary w-25 flex-shrink-1">
                    <i
                        class="fa-brands fa-whatsapp fa-2x"
                        role="img"
                        aria-label="Send by WhatsApp" />
                    <br />
                    <span title="More info">Send WhatsApp</span>
                </a>
            </xpath>

            <xpath expr="//div[hasclass('flex-shrink-1')]" position="replace" />
        </field>
    </record>

</odoo>
