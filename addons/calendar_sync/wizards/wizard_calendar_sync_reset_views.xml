<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_calendar_sync_reset_view_form" model="ir.ui.view">
        <field name="name">wizard.calendar.sync.reset.form</field>
        <field name="model">wizard.calendar.sync.reset</field>
        <field name="arch" type="xml">
            <form>
                <h1>Reset <field name="provider" readonly="1" class="d-inline" /> Account</h1>
                <group>
                    <field name="delete_policy" widget="radio" />
                    <field name="sync_policy" widget="radio" />
                </group>

                <footer>
                    <button
                        name="reset_account"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_calendar_sync_reset_action" model="ir.actions.act_window">
        <field name="name">Reset Calendar Account</field>
        <field name="res_model">wizard.calendar.sync.reset</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
