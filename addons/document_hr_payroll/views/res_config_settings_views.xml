<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.documents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="document_hr.res_config_settings_view_form" />
        <field name="priority" eval="70" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='documents_hr_tags']" position="after">
                <div class="row" invisible="not documents_hr_settings">
                    <label
                        for="documents_hr_payslips_tags"
                        class="col-sm-3 o_light_label" />
                    <field name="documents_hr_payslips_tags" widget="many2many_tags" />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
