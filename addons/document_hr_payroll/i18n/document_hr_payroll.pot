"                        <div t-if=\"document_access_link\" style=\"text-align: center; padding: 16px 0px 16px 0px; font-size: 14px;\">\n"
"                            <a t-attf-href=\"{{ document_access_link }}\" target=\"_blank\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Your Payslip\n"
"                            </a>\n"
"                        </div>\n"
"                        Have a nice day,<br/>\n"
"                        The HR Team\n"
"                    </td></tr>\n"
"                </tbody></table>\n"
"            "
