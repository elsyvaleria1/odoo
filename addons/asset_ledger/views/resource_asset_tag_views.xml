<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_tag_view_list" model="ir.ui.view">
        <field name="name">resource.asset.tag.list</field>
        <field name="model">resource.asset.tag</field>
        <field name="arch" type="xml">
            <list string="Asset Tags" editable="bottom">
                <field name="name" />
                <field name="code" optional="hide" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <record id="resource_asset_tag_view_search" model="ir.ui.view">
        <field name="name">resource.asset.tag.search</field>
        <field name="model">resource.asset.tag</field>
        <field name="arch" type="xml">
            <search string="Asset Tags">
                <field name="name" />
                <field name="code" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_resource_asset_tag" model="ir.actions.act_window">
        <field name="name">Asset Tags</field>
        <field name="res_model">resource.asset.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new asset tag
            </p>
        </field>
    </record>

</odoo>
