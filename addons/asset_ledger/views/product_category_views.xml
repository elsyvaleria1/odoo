<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_category_form_inherit_asset" model="ir.ui.view">
        <field name="name">product.category.form.inherit.asset</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.view_product_category_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group name="asset" string="Asset Logs">
                    <field name="log_type" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
