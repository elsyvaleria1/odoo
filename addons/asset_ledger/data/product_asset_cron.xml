<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_refresh_service_activity" model="ir.cron" forcecreate="True">
        <field name="name">Assets: roll the service activity flag over to today</field>
        <field name="model_id" ref="resource.model_resource_resource" />
        <field name="state">code</field>
        <field name="code">model._cron_refresh_service_activity()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">day</field>
        <field name="active" eval="True" />
    </record>

</odoo>
