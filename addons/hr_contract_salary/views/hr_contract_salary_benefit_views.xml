<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_benefit_action" model="ir.actions.act_window">
        <field name="name">Benefits</field>
        <field name="res_model">hr.contract.salary.benefit</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_groupby_structure_type': 1}</field>
    </record>

    <record id="hr_contract_benefit_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.salary.benefit.view.list</field>
        <field name="model">hr.contract.salary.benefit</field>
        <field name="arch" type="xml">
            <list string="Salary Package Benefit">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="source" />
                <field name="res_field_id" invisible="source != 'field'" />
                <field name="field" column_invisible="True" />
                <field name="structure_type_id" />
            </list>
        </field>
    </record>

    <record id="hr_contract_benefit_view_search" model="ir.ui.view">
        <field name="name">hr.contract.salary.benefit.view.search</field>
        <field name="model">hr.contract.salary.benefit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group>
                    <filter
                        name="groupby_structure_type"
                        string="Structure Type"
                        context="{'group_by':'structure_type_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="hr_contract_benefit_view_form" model="ir.ui.view">
        <field name="name">hr.contract.salary.benefit.view.form</field>
        <field name="model">hr.contract.salary.benefit</field>
        <field name="arch" type="xml">
            <form string="Salary Package Benefit">
                <sheet>
                    <label for="name" string="Benefits" />
                    <div class="oe_title mb-3">
                        <h1><field name="name" placeholder="e.g. Meal Vouchers" /></h1>
                    </div>
                    <group class="px-3">
                        <group class="o_form_fw_labels">
                            <field name="benefit_type_id" />
                            <field
                                name="res_field_public"
                                groups="!base.group_erp_manager"
                                invisible="source != 'field'" />
                            <field
                                name="res_field_id"
                                groups="base.group_erp_manager"
                                invisible="source != 'field'" />
                            <field
                                name="cost_res_field_public"
                                groups="!base.group_erp_manager"
                                invisible="source != 'field'" />
                            <field
                                name="cost_res_field_id"
                                placeholder="Doesn't impact net salary"
                                groups="base.group_erp_manager"
                                invisible="source != 'field'" />
                        </group>
                        <group>
                            <field name="structure_type_id" />
                            <field name="benefit_ids" widget="many2many_tags" />
                            <field
                                name="requested_documents_field_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                groups="base.group_system" />
                            <label
                                for="requested_documents_fields_string"
                                groups="!base.group_system"
                                class="m-0" />
                            <div
                                groups="!base.group_system"
                                class="alert alert-warning m-0 w-100"
                                role="alert">
                                <span>
                                    This field can only be modified by a server administrator, contact them if these field requires modifications.
                                </span>
                                <span invisible="requested_documents_fields_string">
                                    There are currently no requested fields.
                                </span>
                                <span invisible="not requested_documents_fields_string">
                                    The current requested documents are the followings: <field name="requested_documents_fields_string" />
                                </span>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page name="display" string="Salary Configurator Display">
                            <group>
                                <group>
                                    <field name="show_name" />
                                    <field name="icon" invisible="not show_name" />
                                    <field
                                        name="folded"
                                        invisible="source != 'field'" />
                                    <field
                                        name="fold_label"
                                        invisible="not folded or source != 'field'" />
                                    <field
                                        name="fold_res_field_id"
                                        options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                        invisible="not folded or source != 'field'" />
                                    <field name="always_show_description" />
                                </group>
                                <group>
                                    <field name="uom" required="1" />
                                    <field name="display_type" required="1" />
                                    <field
                                        name="value_ids"
                                        invisible="display_type != 'dropdown-group'">
                                        <list editable="bottom">
                                            <control>
                                                <create
                                                    name="add_line_control"
                                                    string="Add a line" />
                                                <create
                                                    name="add_section_control"
                                                    string="Add a section"
                                                    context="{'default_display_type': 'section'}" />
                                            </control>
                                            <field
                                                name="display_type"
                                                column_invisible="True" />
                                            <field name="sequence" widget="handle" />
                                            <field name="name" />
                                            <field
                                                name="value"
                                                invisible="display_type == 'section'"
                                                required="display_type != 'section'" />
                                        </list>
                                    </field>
                                    <field
                                        name="value_ids"
                                        invisible="display_type not in ['dropdown', 'radio']">
                                        <list editable="bottom">
                                            <control>
                                                <create
                                                    name="add_line_control"
                                                    string="Add a line" />
                                            </control>
                                            <field
                                                name="display_type"
                                                column_invisible="True" />
                                            <field name="sequence" widget="handle" />
                                            <field name="name" />
                                            <field
                                                name="value"
                                                invisible="display_type == 'section'"
                                                required="display_type != 'section'" />
                                            <field
                                                name="selector_highlight"
                                                invisible="display_type == 'section' or benefit_display_type == 'dropdown'"
                                                column_invisible="parent.display_type == 'dropdown'"
                                                required="display_type != 'section' and benefit_display_type != 'dropdown'" />
                                            <field
                                                name="always_show_description"
                                                invisible="display_type == 'section' or benefit_display_type == 'dropdown'"
                                                column_invisible="parent.display_type == 'dropdown'" />
                                        </list>
                                    </field>
                                    <field
                                        name="manual_res_field_id"
                                        options="{'no_create': True, 'no_edit': True, 'no_open': True}"
                                        invisible="display_type != 'manual' or source != 'field'" />
                                    <field name="manual_field" invisible="1" />
                                    <field
                                        name="slider_min"
                                        invisible="display_type != 'slider'" />
                                    <field
                                        name="slider_max"
                                        invisible="display_type != 'slider'" />
                                    <field
                                        name="slider_step"
                                        invisible="display_type != 'slider'" />
                                </group>
                            </group>
                            <separator string="Description" />
                            <field name="description" />
                        </page>
                        <page name="actions" string="Actions">
                            <group>
                                <group string="Activity">
                                    <field
                                        name="activity_type_id"
                                        options="{'no_create_edit': True}" />
                                    <field
                                        name="activity_creation"
                                        widget="radio"
                                        invisible="not activity_type_id"
                                        required="activity_type_id" />
                                    <field
                                        name="activity_creation_type"
                                        widget="radio"
                                        invisible="not activity_type_id"
                                        required="activity_type_id" />
                                    <field
                                        name="activity_responsible_id"
                                        options="{'no_create_edit': True}"
                                        invisible="not activity_type_id"
                                        required="activity_type_id" />
                                </group>
                                <group string="Sign">
                                    <field name="sign_template_id" />
                                    <field
                                        name="sign_copy_partner_id"
                                        context="{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"
                                        options="{'no_quick_create': True}"
                                        invisible="not sign_template_id" />
                                    <field
                                        name="sign_frenquency"
                                        widget="radio"
                                        invisible="not sign_template_id" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
