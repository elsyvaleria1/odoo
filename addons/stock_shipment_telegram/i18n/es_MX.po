#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__file_id
msgid "File"
msgstr "Archivo"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__file_name
msgid "File Name"
msgstr "Nombre del archivo"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__file_unique_id
msgid "File Unique"
msgstr "Identificador único del archivo"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Finish"
msgstr "Terminar"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid ""
"I could not read the tracking number. Send the sheet again, whole and in "
"focus, with the barcode in view."
msgstr ""
"No pude leer el número de guía. Manda la hoja otra vez, completa y "
"enfocada, con el código de barras a la vista."

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_handler_stock_shipment__id
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__id
msgid "ID"
msgstr "ID"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "It is a receipt (purchase)"
msgstr "Es una recepción (compra)"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__write_uid
msgid "Last Updated by"
msgstr "Última actualización por"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__write_date
msgid "Last Updated on"
msgstr "Última actualización el"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid "No carrier uses tracking numbers like %(ref)s."
msgstr "Ningún transportista usa guías como %(ref)s."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "No open %(kind)s for tracking number %(ref)s ends in %(digits)s."
msgstr "Ninguna %(kind)s abierta para la guía %(ref)s termina en %(digits)s."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "None of these"
msgstr "Ninguna de estas"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Nothing recorded for that sheet."
msgstr "No se registró nada de esa hoja."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Ocurre"
msgstr "Ocurre"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__candidate_ids
msgid "Offered Transfers"
msgstr "Transferencias ofrecidas"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Only whoever handles transfers sends shipping orders here."
msgstr "Solo quien maneja transferencias manda hojas de embarque aquí."

#. module: stock_shipment_telegram
#: model:ir.model.fields.selection,name:stock_shipment_telegram.selection__telegram_shipment_sheet__state__error
msgid "Refused"
msgstr "Rechazada"

#. module: stock_shipment_telegram
#: model:ir.model.fields,help:stock_shipment_telegram.field_telegram_shipment_sheet__checksum
msgid "SHA-1 of the file's bytes: the same sheet sent again is recognised."
msgstr ""
"SHA-1 del contenido del archivo: la misma hoja enviada otra vez se "
"reconoce."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Send the carrier's shipping order: its tracking number goes on the transfer"
msgstr ""
"Manda la hoja de embarque del transportista: su guía queda en la "
"transferencia"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Send the shipping order as a PDF or a photo."
msgstr "Manda la hoja de embarque en PDF o en foto."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Send the shipping order first, then type the last digits of its transfer."
msgstr ""
"Manda primero la hoja de embarque y luego escribe los últimos dígitos de su "
"transferencia."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Send the shipping order the carrier gave you, one per message: the PDF if you have it, or a photo sent as a file, whole and with the barcode in view. I read the tracking number and you choose the transfer it goes on.\n"
"\n"
"/cancelar stops at any time."
msgstr ""
"Manda la hoja de embarque que te dio el transportista, una por "
"mensaje: el PDF si lo tienes, o una foto enviada como archivo, "
"completa y con el código de barras a la vista. Yo leo el número de "
"guía y tú eliges la transferencia donde va.\n"
"\n"
"/cancelar detiene en "
"cualquier momento."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Shipments"
msgstr "Embarques"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid "Shipping order %(ref)s of %(carrier)s, sent over Telegram."
msgstr "Hoja de embarque %(ref)s de %(carrier)s, enviada por Telegram."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Something went wrong with that sheet; send it again."
msgstr "Algo falló con esa hoja; mándala otra vez."

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__state
msgid "State"
msgstr "Estado"

#. module: stock_shipment_telegram
#: model:ir.model,name:stock_shipment_telegram.model_telegram_shipment_sheet
msgid "Telegram Shipping Order"
msgstr "Hoja de embarque por Telegram"

#. module: stock_shipment_telegram
#: model:ir.model.fields,help:stock_shipment_telegram.field_telegram_shipment_sheet__file_id
msgid "Telegram's id to download the file."
msgstr "Identificador de Telegram para descargar el archivo."

#. module: stock_shipment_telegram
#: model:ir.model,name:stock_shipment_telegram.model_telegram_handler_stock_shipment
msgid "Telegram: Shipping Orders"
msgstr "Telegram: hojas de embarque"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "That button is no longer valid."
msgstr "Ese botón ya no es válido."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "That same sheet already went on %(picking)s."
msgstr "Esa misma hoja ya quedó en %(picking)s."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "The file did not arrive; send it again."
msgstr "El archivo no llegó; mándalo otra vez."

#. module: stock_shipment_telegram
#: model:ir.model.fields.selection,name:stock_shipment_telegram.selection__telegram_shipment_sheet__state__pending
