msgstr "Transferencia"

#. module: stock_shipment_telegram
#: model:ir.model.fields,help:stock_shipment_telegram.field_telegram_shipment_sheet__extracted
msgid "What was read off the sheet: route, service, date and amounts."
msgstr "Lo que se leyó de la hoja: ruta, servicio, fecha y montos."

