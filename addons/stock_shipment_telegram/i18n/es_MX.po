msgstr "Nombre en pantalla"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Does tracking number %(ref)s also cover another %(kind)s? Tap it or type the"
" last digits of its number. If not, send the next sheet or tap Finish."
msgstr ""
"¿La guía %(ref)s cubre también otra %(kind)s? Tócala o escribe los últimos "
"dígitos de su número. Si no, manda la siguiente hoja o toca Terminar."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Done."
msgstr "Listo."

#. module: stock_shipment_telegram
