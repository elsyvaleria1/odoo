msgstr "Por asignar"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__tracking_ref
msgid "Tracking Number"
msgstr "Número de guía"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Tracking number %(ref)s of %(carrier)s. Which %(kind)s is it? Tap it or type"
" the last digits of its number."
msgstr ""
"Guía %(ref)s de %(carrier)s. ¿Qué %(kind)s es? Tócala o escribe los últimos "
"dígitos de su número."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"Tracking number %(ref)s of %(carrier)s: no open %(kind)s of yours is waiting"
" for one."
msgstr ""
"Guía %(ref)s de %(carrier)s: no hay ninguna %(kind)s abierta tuya "
"esperando guía."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "Tracking number %(ref)s: which %(kind)s ending in %(digits)s is it?"
msgstr "Guía %(ref)s: ¿cuál es la %(kind)s que termina en %(digits)s?"

#. module: stock_shipment_telegram
#: model:ir.model.fields,field_description:stock_shipment_telegram.field_telegram_shipment_sheet__picking_id
