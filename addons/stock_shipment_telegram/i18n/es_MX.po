#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "%(carrier)s: %(state)s"
msgstr "%(carrier)s: %(state)s"

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"%(command)s - Send the photo or PDF of the shipping order the carrier gave "
"you; its tracking number goes on the delivery order or receipt you choose."
msgstr ""
"%(command)s - Manda la foto o el PDF de la hoja de embarque que te "
"dio el transportista; su número de guía queda en la entrega o "
"recepción que elijas."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid ""
"%(file)s weighs more than 20 MB, the most Telegram lets a bot download. Send"
" a photo of the sheet instead."
msgstr ""
"%(file)s pesa más de 20 MB, lo máximo que Telegram deja descargar a "
"un bot. Manda mejor una foto de la hoja."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_shipment_sheet.py:0
msgid ""
"%(picking)s already carries tracking number %(other)s; I do not write over "
"it."
msgstr "%(picking)s ya tiene la guía %(other)s; no la sobrescribo."

#. module: stock_shipment_telegram
#. odoo-python
#: code:addons/stock_shipment_telegram/models/telegram_handler.py:0
msgid "%(ref)s is now on %(picking)s · %(customer)s"
msgstr "La guía %(ref)s quedó en %(picking)s · %(customer)s"

