<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_plan_user_view_list" model="ir.ui.view">
        <field name="name">sale.commission.plan.user.view.list</field>
        <field name="model">sale.commission.plan.user</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="user_id" />
                <field name="plan_id" />
                <field name="date_from" />
                <field name="date_to" />
            </list>
        </field>
    </record>

    <record id="sale_commission_plan_user_view_search" model="ir.ui.view">
        <field name="name">sale.commission.plan.user.view.search</field>
        <field name="model">sale.commission.plan.user</field>
        <field name="arch" type="xml">
            <search string="Commission Plan User">
                <field name="user_id" string="User" />
                <separator />
                    <field name="plan_id" />
                <group>
                    <filter
                        name="user"
                        string="User"
                        context="{'group_by':'user_id'}" />
                    <filter
                        name="plan"
                        string="Plan"
                        context="{'group_by':'plan_id'}" />
                    <filter
                        name="date_from"
                        string="Date From"
                        context="{'group_by':'date_from'}" />
                    <filter
                        name="date_to"
                        string="Date To"
                        context="{'group_by':'date_to'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_plan_view_form" model="ir.ui.view">
        <field name="name">sale.commission.plan.view.form</field>
        <field name="model">sale.commission.plan</field>
        <field name="arch" type="xml">
            <form string="Commission Plan">
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        invisible="state != 'draft'"
                        class="btn-primary"
                        data-hotkey="w" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'draft'"
                        class="btn-secondary"
                        data-hotkey="w" />
                    <button
                        name="action_done"
                        type="object"
                        string="Mark as done"
                        invisible="state != 'approved'"
                        class="btn-secondary"
                        data-hotkey="w" />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to draft"
                        invisible="state == 'draft'"
                        class="btn-secondary"
                        data-hotkey="d" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,approved,done" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_commission"
                            type="object"
                            icon="fa-dollar"
                            invisible="state in ['draft', 'cancel']"
                            class="oe_stat_button">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Commissions</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Commission Plan" />
                        <h1>
                            <field
                                name="name"
                                placeholder="i.e. Commissions plan 2025"
                                readonly="state != 'draft'"
                                class="d-block" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="type" string="Based on" />
                            <div>
                                <field
                                    name="type"
                                    readonly="state != 'draft'"
                                    class="oe_inline" />
                                per <field name="user_type" readonly="state != 'draft'" class="oe_inline" />
                            </div>
                            <field
                                name="team_id"
                                invisible="user_type == 'person'"
                                readonly="state != 'draft'" />
                            <field name="currency_id" invisible="1"/>   <!-- Needed for monetary widget -->
                            <field
                                name="commission_amount"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                                invisible="type == 'achieve'"
                                readonly="state != 'draft'" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'" />
                        </group>
                        <group>
                            <label for="date_from" string="Effective Period" />
                            <div class="d-flex align-items-center">
                                <field
                                    name="date_from"
                                    string="Date"
                                    widget="daterange"
                                    force_save="1"
                                    options="{'end_date_field': 'date_to'}"
                                    readonly="state != 'draft'"
                                    required="1" />
                            </div>
                            <field
                                name="periodicity"
                                string="Target Frequency"
                                force_save="1"
                                readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook name="main_book">
                        <page string="Commissions" invisible="type == 'achieve'">
                            <group>
                                <group>
                                    <field
                                        name="target_commission_ids"
                                        nolabel="1"
                                        readonly="state != 'draft'">
                                        <list
                                            default_order="target_rate"
                                            editable="bottom">
                                            <control>
                                                <create
                                                    string="Add a new commission level" />
                                            </control>
                                            <field
                                                name="target_rate"
                                                widget="percentage" />
                                            <field
                                                name="amount"
                                                widget="monetary"
                                                force_save="1"
                                                options="{'currency_field': 'currency_id'}" />
                                            <field
                                                name="amount_rate"
                                                widget="percentage"
                                                optional="hide"
                                                force_save="1" />
                                            <field name="currency_id" column_invisible="1"/> <!-- For monetary field -->
                                        </list>
                                    </field>
                                </group>
                                <group>
                                    <field
                                        name="target_commission_graph"
                                        widget="commission_graph"
                                        nolabel="1" />
                                </group>
                            </group>
                            <button
                                name="action_export_targets"
                                type="object"
                                string="Commission table"
                                icon="fa-download"
                                class="btn btn-link" />
                        </page>
                        <page string="Targets" invisible="type != 'target'">
                            <field name="target_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0">
                                    <field name="name" force_save="1" />
                                    <field
                                        name="date_from"
                                        optional="hide"
                                        force_save="1" />
                                    <field
                                        name="date_to"
                                        optional="hide"
                                        force_save="1" />
                                    <field
                                        name="payment_date"
                                        optional="hide"
                                        force_save="1" />
                                    <field
                                        name="payment_amount"
                                        widget="monetary"
                                        optional="hide"
                                        options="{'currency_field': 'currency_id'}" />
                                    <field
                                        name="amount"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}" />
                                    <field name="currency_id" column_invisible="1"/> <!-- For monetary field -->
                                </list>
                            </field>
                        </page>
                        <page string="Achievements">
                            <field name="achievement_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <control>
                                        <create string="Add a new achievement" />
                                    </control>
                                    <field name="type" required="1" />
                                    <field
                                        name="product_id"
                                        placeholder="All products" />
                                    <field
                                        name="product_categ_id"
                                        placeholder="All categories" />
                                    <field name="rate" widget="percentage" />
                                </list>
                            </field>
                        </page>
                        <page string="Periods" invisible="type == 'target'">
                            <field name="target_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name" force_save="1" />
                                    <field
                                        name="date_from"
                                        optional="hide"
                                        force_save="1" />
                                    <field
                                        name="date_to"
                                        optional="hide"
                                        force_save="1" />
                                    <field
                                        name="amount"
                                        widget="monetary"
                                        optional="hide"
                                        options="{'currency_field': 'currency_id'}" />
                                    <field name="currency_id" column_invisible="1"/> <!-- For monetary field -->
                                </list>
                            </field>
                        </page>
                        <page string="Sales People">
                            <field name="user_ids">
                                <list editable="bottom">
                                    <control>
                                        <create string="Add a new Sales Person" />
                                    </control>
                                    <field name="user_id" />
                                    <field name="date_from" required="True" />
                                    <field name="date_to" />
                                    <field
                                        name="other_plans"
                                        widget="many2many_tags"
                                        readonly="True" />
                                </list>
                            </field>
                            <button
                                name="%(sale_commission.sale_subscription_change_customer_wizard_action)d"
                                type="action"
                                string="Add Multiple Salespersons"
                                groups="base.group_no_one" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="sale_commission_plan_view_list" model="ir.ui.view">
        <field name="name">sale.commission.plan.view.list</field>
        <field name="model">sale.commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="type" />
                <field name="periodicity" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="date_from" string="Start Date" />
                <field name="date_to" string="End Date" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'done'"
                    decoration-success="state == 'approved'" />
            </list>
        </field>
    </record>

    <record id="sale_commission_plan_view_search" model="ir.ui.view">
        <field name="name">sale.commission.plan.view.search</field>
        <field name="model">sale.commission.plan</field>
        <field name="arch" type="xml">
            <search string="Commission Plan">
                <field
                    name="name"
                    string="Name"
                    filter_domain="[('name', 'ilike', self)]" />
                <field
                    name="user_ids"
                    string="Sales Person"
                    filter_domain="[('user_ids.user_id', 'ilike', self)]" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('state', '=', 'approved')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter
                    name="completed"
                    string="Completed"
                    domain="[('date_to', '&lt;', 'today')]" />
                <filter
                    name="current"
                    string="Ongoing"
                    domain="[('date_from', '&lt;', 'today'), ('date_to', '&gt;', 'today')]" />
                <filter
                    name="upcoming"
                    string="Upcoming"
                    domain="[('date_from', '&gt;', 'today')]" />
                <group>
                    <filter
                        name="periodicity"
                        string="Periodicity"
                        context="{'group_by':'periodicity'}" />
                    <filter name="type" string="Type" context="{'group_by':'type'}" />
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_action_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">sale.commission.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sale_commission_plan_view_search" />
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new commission plan
            </p>
            <p>
                Compute commissions of your sales people based on their achievements and targets
            </p>
        </field>
    </record>

</odoo>
