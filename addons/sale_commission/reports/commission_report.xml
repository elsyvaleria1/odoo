<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_commission_report_view_list" model="ir.ui.view">
        <field name="name">sale.commission.report.view.list</field>
        <field name="model">sale.commission.report</field>
        <field name="arch" type="xml">
            <list editable="top" create="0" delete="0">
                <field name="user_id" />
                <field name="plan_id" optional="show" />
                <field name="date_from" string="Period" />
                <field name="payment_date" optional="hide" />
                <field name="forecast" optional="hide" readonly="0" />
                <field name="notes" optional="hide" readonly="0" />
                <field
                    name="target_amount"
                    sum="Total Target"
                    invisible="target_amount == 0" />
                <field name="achieved" sum="Total achieved" />
                <field
                    name="achieved_rate"
                    widget="percentage"
                    optional="hide"
                    invisible="target_amount == 0" />
                <field name="commission" sum="Total commission" />
                <field name="currency_id" column_invisible="True"/>  <!-- Monetary field -->
                <button
                    name="action_achievement_detail"
                    type="object"
                    string="Details"
                    title="Achievements"
                    help="See associated achievements" />
            </list>
        </field>
    </record>

    <record id="sale_commission_report_view_graph" model="ir.ui.view">
        <field name="name">sale.commission.report.view.graph</field>
        <field name="model">sale.commission.report</field>
        <field name="arch" type="xml">
            <graph>
                <field name="payment_date" type="col" />
                <field name="plan_id" />
                <field name="commission" type="measure" />
            </graph>
        </field>
    </record>

    <record id="sale_commission_report_view_pivot" model="ir.ui.view">
        <field name="name">sale.commission.report.view.pivot</field>
        <field name="model">sale.commission.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="plan_id" type="row" />
                <field name="user_id" type="row" />
                <field name="payment_date" type="col" />
                <field name="commission" type="measure" />
                <field name="achieved" type="measure" />
                <field name="forecast" type="measure" />
                <field name="achieved_rate" type="measure" />
                <field name="target_amount" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="sale_commission_report_view_search" model="ir.ui.view">
        <field name="name">sale.commission.report.view.search</field>
        <field name="model">sale.commission.report</field>
        <field name="arch" type="xml">
            <search string="Commission Report">
                <field name="user_id" />
                <field name="plan_id" groups="sale.group_sale_manager" />
                <field name="company_id" />
                <filter
                    name="my"
                    string="My Commissions"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="active_plans"
                    string="Active Plans"
                    domain="[('plan_id.date_from', '&lt;', 'today'), ('plan_id.date_to', '&gt;', 'today')]" />
                <separator />
                <filter name="filter_date_to" string="Period" date="date_to" />
                <separator />
                <filter
                    name="this_year"
                    string="This Year"
                    domain="[('date_to', '&lt;=', '=1m =1d +1y'), ('date_from', '&gt;=', '=1m =1d')]" />
                <filter
                    name="last_year"
                    string="Last Year"
                    domain="[('date_to', '&lt;=', '=1m =1d'), ('date_from', '&gt;=', '=1m =1d -1y')]" />
                <separator />
                <group>
                    <filter
                        name="group_by_salesperson"
                        string="Salesperson"
                        context="{'group_by':'user_id'}" />
                    <filter
                        name="group_by_date_to"
                        string="Period"
                        context="{'group_by': 'date_to:month'}" />
                    <filter
                        name="group_by_payment_date"
                        string="Payment Date"
                        context="{'group_by':'payment_date'}" />
                    <filter
                        name="group_by_plan"
                        string="Commission Plan"
                        context="{'group_by':'plan_id'}"
                        groups="sale.group_sale_manager" />
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="sale_commission_action_report" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sale.commission.report</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="sale_commission_report_view_search" />
        <field
            name="context">{'search_default_active_plans': 1, 'search_default_my': 1, 'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                Unfortunately, there are no commissions for you
            </p>
            <p>
                Ensure you are assigned to a commission plan and have made sales that qualify for commissions
            </p>
        </field>
    </record>

    <record id="sale_commission_action_report_sale" model="ir.actions.act_window">
        <field name="name">Commissions</field>
        <field name="res_model">sale.commission.report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="sale_commission_report_view_search" />
        <field
            name="context">{'search_default_active_plans': 1, 'search_default_my': 1, 'search_default_last_quarter': 1, 'search_default_this_quarter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                Unfortunately, there are no commissions for you
            </p>
            <p>
                Ensure you are assigned to a commission plan and have made sales that qualify for commissions
            </p>
        </field>
    </record>

    <record id="sale_commission_action_my_report" model="ir.actions.act_window">
        <field name="name">My Commissions</field>
        <field name="res_model">sale.commission.report</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="sale_commission_report_view_search" />
        <field name="domain">[('user_id', '=', uid)]</field>
        <field
            name="context">{'commission_user_ids': uid, 'search_default_active_plans': 1, 'search_default_last_quarter': 1, 'search_default_this_quarter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                Unfortunately, there are no commissions for you
            </p>
            <p>
                Ensure you are assigned to a commission plan and have made sales that qualify for commissions
            </p>
        </field>
    </record>

</odoo>
