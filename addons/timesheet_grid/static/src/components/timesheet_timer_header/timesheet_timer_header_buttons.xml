<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="timesheet_grid.TimesheetTimerHeaderButtons">
        <t t-if="this.props.timerRunning">
            <button t-if="this.props.stopTimer"
                    class="btn btn-primary o_stop_timer_button o_stop_timer_button"
                    data-hotkey="x"
                    t-att-disabled="this.timerService.otherCompany"
                    t-on-click.stop="this.onClickTimerButton"
                    t-ref="this.stopButton"
            >
                <i class="fa-solid fa-stop me-2"></i> Stop
            </button>
            <button class="btn btn-muted o_discard_timer_button"
                    title="Press Esc to discard"
                    t-att-disabled="this.timerService.otherCompany"
                    t-on-click.stop="this._onClickDeleteTimer"
            >
                Discard
            </button>
        </t>
        <t t-else="">
            <button class="btn_start_timer btn btn-primary text-uppercase"
                    t-on-click.stop="this.onClickTimerButton"
                    t-ref="this.startButton"
            >
                <i class="fa-solid fa-play me-2"></i> Start
            </button>
        </t>
    </t>

</templates>
