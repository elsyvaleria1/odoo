<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Maybe it is possible to use `TimesheetTimerHeader` component inside of that component to avoid some code duplication -->
    <t t-name="timesheet_grid.GridTimesheetTimerHeader">
        <TimesheetTimerHeader
            t-if="!this.timerRunning or this.timerService.otherCompany"
            onTimerStarted="this.props.onTimerStarted"
            onTimerStopped="this.props.onTimerStopped"
            onTimerUnlinked="this.props.onTimerUnlinked"
        >
            <t t-call="timesheet_grid.GridTimesheetTimerHeaderHelper"/>
        </TimesheetTimerHeader>
        <Record
            t-else=""
            fields="this.timerService.timesheetTimerFields"
            activeFields="this.activeFields"
            resModel="this.props.model.resModel"
            resId="this.timerState.data.id"
            mode="'edit'"
            values="this.timerState.data"
            hooks="this.recordHooks"
            t-slot-scope="data"
        >
            <TimesheetTimerHeader
                timesheet="data.record"
                fields="this.activeFields"
                onTimerStarted="this.props.onTimerStarted"
                onTimerStopped="this.props.onTimerStopped"
                onTimerUnlinked="this.props.onTimerUnlinked"
            >
                <t t-call="timesheet_grid.GridTimesheetTimerHeaderHelper"/>
            </TimesheetTimerHeader>
        </Record>
    </t>

    <t t-name="timesheet_grid.GridTimesheetTimerHeaderHelper">
        <div>
            <span class="text-muted">Press</span> <b>Enter</b> <span class="text-muted">or <b>[a]</b> to launch the timer</span>
        </div>
        <div>
            <span class="text-muted">Press</span> <b>Shift</b> <span class="text-muted">+ <b>[A]</b> to add <t t-out="this.timerService.stepTimer"/> min</span>
        </div>
    </t>

</templates>
