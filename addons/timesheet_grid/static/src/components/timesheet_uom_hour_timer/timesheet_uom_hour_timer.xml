<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="timesheet_grid.TimesheetUOMHourTimer">
        <button type="button"
                t-if="this.displayButton"
                t-on-click.stop.prevent="this.onClick"
                class="o_icon_button me-2 pt-0"
                t-att-title="this.title" t-att-aria-label="this.title">
            <i t-attf-class="{{this.iconClass}}" t-att-title="this.title"/>
        </button>
        <TimesheetDisplayTimer t-props="this.props"/>
    </t>

</templates>
