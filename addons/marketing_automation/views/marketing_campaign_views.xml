<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Campaign -->
    <record id="marketing_campaign_view_kanban" model="ir.ui.view">
        <field name="name">marketing.campaign.view.kanban</field>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                sample="0"
                js_class="marketing_campaign_kanban_view"
                quick_create="false">
                <templates>
                    <t t-name="card" class="o_marketing_automation_campaign_kanban">
                        <span
                            t-att-title="record.name.raw_value"
                            class="o_ma_campaign_header text-primary text-truncate">
                            <field name="name" />
                        </span>
                        <div class="d-flex text-uppercase text-center mt8">
                            <div
                                class="d-flex flex-column flex-grow-1 text-muted o_ma_campaign_item">
                                <span>Total</span>
                                <field
                                    name="total_participant_count"
                                    class="fw-bolder mt4 h2" />
                            </div>
                            <div
                                class="d-flex flex-column flex-grow-1 text-primary o_ma_campaign_item">
                                <span>Running</span>
                                <field
                                    name="running_participant_count"
                                    class="fw-bolder mt4 h2" />
                            </div>
                            <div
                                class="d-flex flex-column flex-grow-1 text-primary o_ma_campaign_item">
                                <span>Completed</span>
                                <field
                                    name="completed_participant_count"
                                    class="fw-bolder mt4 h2" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="marketing_campaign_view_form" model="ir.ui.view">
        <field name="name">marketing.campaign.view.form</field>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign" js_class="marketing_campaign_form_view">
                <header invisible="not active">
                    <button
                        name="action_start_campaign"
                        type="object"
                        string="Start"
                        invisible="state == 'running' or not active"
                        class="btn-primary" />
                    <button
                        name="action_stop_campaign"
                        type="object"
                        string="Stop"
                        invisible="state != 'running'"
                        class="btn-primary" />
                    <button
                        name="%(marketing_campaign_test_action)d"
                        type="action"
                        string="Launch a Test"
                        invisible="not marketing_activity_ids or state == 'stopped'"
                        class="btn-secondary" />
                    <button
                        name="sync_participants"
                        type="object"
                        string="Generate participants"
                        confirm="Are you sure you want to create a new participant for each matching record that has not been used yet?"
                        groups="base.group_no_one"
                        invisible="state != 'running'"
                        class="btn-secondary"
                        confirm-label="Generate Participants"
                        confirm-title="Generate Participants" />
                    <button
                        name="execute_activities"
                        type="object"
                        string="Run"
                        confirm="Run the next scheduled activity for each participant of this campaign?"
                        groups="base.group_no_one"
                        invisible="state != 'running'"
                        class="btn-secondary"
                        confirm-label="Run"
                        confirm-title="Run Activities" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,running,stopped" />
                </header>
                <field name="require_sync" invisible="1" />
                <div
                    class="text-center alert alert-primary"
                    role="alert"
                    invisible="not require_sync">
                    <div class="h4 mt8"><strong>The workflow has been modified!</strong></div>
                    <p>Some participants are already running on this campaign. Click on 'Update' to apply the modifications you've just made.</p>
                    <p>Be aware that participants that had no more activities could be reintroduced into the campaign and new traces could be created for them.</p>
                    <p class="mb8">
                        <button
                            name="action_update_participants"
                            type="object"
                            string="Update"
                            class="btn btn-primary" />
                        <button
                            name="action_set_synchronized"
                            type="object"
                            string="Don't update"
                            class="btn btn-secondary ml8" />
                    </p>
                </div>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="action_view_workflow"
                            type="object"
                            string="Workflow"
                            icon="fa-sitemap"
                            groups="base.group_system"
                            class="oe_stat_button" />
                        <button
                            name="action_view_mailings"
                            type="object"
                            icon="fa-envelope-o"
                            invisible="mass_mailing_count == 0"
                            class="oe_stat_button">
                            <field
                                name="mass_mailing_count"
                                string="Templates"
                                widget="statinfo" />
                        </button>
                        <button
                            name="action_view_tracker_statistics"
                            type="object"
                            icon="fa-mouse-pointer"
                            invisible="link_tracker_click_count == 0 and state == 'draft'"
                            class="oe_stat_button">
                            <field
                                name="link_tracker_click_count"
                                string="Clicks"
                                widget="statinfo" />
                        </button>
                        <button
                            name="%(marketing_participant_action_campaign_test)d"
                            type="action"
                            icon="fa-flask"
                            invisible="test_participant_count == 0"
                            class="oe_stat_button">
                            <field
                                name="test_participant_count"
                                string="Tests"
                                widget="statinfo" />
                        </button>
                        <button
                            name="%(marketing_participant_action_campaign)d"
                            type="action"
                            icon="fa-code-fork fa-rotate-180 fa-flip-vertical"
                            invisible="total_participant_count == 0 and state == 'draft'"
                            class="oe_stat_button">
                            <field
                                name="total_participant_count"
                                string="Participants"
                                widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <h1><field name="title" placeholder="e.g. eCommerce Offers Plan" required="1" class="text-break" /></h1>
                    </div>
                    <group>
                        <field name="name" invisible="1" />
                        <field
                            name="user_id"
                            widget="many2one_avatar_user"
                            groups="base.group_no_one"
                            class="oe_inline" />
                        <label for="model_id" string="Target" />
                        <div name="mailing_container">
                            <div class="row">
                                <div class="col-xs-12 col-md-3">
                                    <field
                                        name="model_id"
                                        context="{'list_view_ref': 'marketing_automation.ir_model_view_tree_marketing'}"
                                        options="{'no_create': True, 'no_open': True}"
                                        readonly="state != 'draft'" />
                                </div>
                                <div class="col-xs-12 col-md-9 o_td_label">
                                    <field
                                        name="mailing_filter_id"
                                        placeholder="Reload a favorite filter"
                                        widget="mailing_filter"
                                        options="{'no_create': '1', 'no_open': '1', 'domain_field': 'domain', 'model_field': 'model_id'}"
                                        class="w-auto" />
                                    <field name="mailing_filter_domain" invisible="1" />
                                    <field name="mailing_filter_count" invisible="1" />
                                </div>
                            </div>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="model_name" invisible="1" />
                            <field name="utm_campaign_id" invisible="1" required="0" />
                            <field
                                name="unique_field_id"
                                string="Unicity based on "
                                options="{'no_create': True, 'no_open': True}" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="domain"
                            widget="domain"
                            options="{'foldable': True, 'model': 'model_name'}" />
                    </group>
                    <div class="o_ma_hierarchy border-top overflow-auto">
                        <div class="o_ma_hierarchy_title" invisible="not marketing_activity_ids">Workflow</div>
                        <div
                            class="o_ma_hierarchy_readonly oe_read_only"
                            invisible="marketing_activity_ids">
                            <h3>No activity for this campaign.</h3>
                        </div>
                        <field
                            name="marketing_activity_ids"
                            widget="hierarchy_kanban"
                            mode="kanban"
                            context="{                                 'default_campaign_id': id,                                 'default_model_id': model_id,                                 'default_utm_campaign_id': utm_campaign_id,                             }"
                            class="o_ma_hierarchy_container o_ma_campaign_hierarchy">
                            <kanban
                                default_order="interval_standardized"
                                limit="1000"
                                can_open="false">
                                <control>
                                    <create
                                        class="o-kanban-button-new"
                                        string="Add new activity" />
                                </control>
                                <field name="interval_standardized" />
                                <field name="model_name" />
                                <field name="trigger_type" />
                                <field name="total_click" />
                                <field name="total_reply" />
                                <field name="total_open" />
                                <field name="parent_id"/><!--required for the widget to display relationships-->
                                <templates>
                                    <div t-name="card">
                                        <div
                                            class="o_ma_body position-relative"
                                            t-att-data-record-id="record.id.raw_value">
                                            <div class="o_ma_timeline text-center">
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_open'"
                                                    class="o_ma_text_processed text-success">
                                                    <i class="fa-regular fa-envelope-open" /> Opened after
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_reply'"
                                                    class="o_ma_text_processed text-success">
                                                    <i class="fa-solid fa-reply" /> Replied after
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_click'"
                                                    class="o_ma_text_processed text-success">
                                                    <i class="fa-regular fa-hand-pointer" /> Clicked after
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_not_open'"
                                                    class="o_ma_text_rejected text-danger">
                                                    <i class="fa-regular fa-envelope-open" /> Not opened within
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_not_reply'"
                                                    class="o_ma_text_rejected text-danger">
                                                    <i class="fa-solid fa-reply" /> Not replied within
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_not_click'"
                                                    class="o_ma_text_rejected text-danger">
                                                    <i class="fa-regular fa-hand-pointer" /> Not clicked within
                                                </div>
                                                <div
                                                    t-if="record.trigger_type.raw_value == 'mail_bounce'"
                                                    class="o_ma_text_rejected text-danger">
                                                    <i class="fa-solid fa-exclamation-circle" /> Bounced after
                                                </div>
                                                <div class="o_ma_interval fw-bolder">
                                                    <i
                                                        class="fa-regular fa-clock pe-1"
                                                        role="img"
                                                        aria-label="Select time"
                                                        title="Select time" />
                                                    <field
                                                        name="interval_number"
                                                        class="pe-1" />
                                                    <field name="interval_type" />
                                                </div>
                                            </div>
                                            <div class="o_ma_icon text-center">
                                                <span
                                                    t-attf-class="fa-solid fa-envelope"
                                                    t-if="record.activity_type.raw_value == 'email'"
                                                    title="Email"
                                                    role="img"
                                                    aria-label="Email" />
                                                <span
                                                    t-attf-class="fa-solid fa-cogs"
                                                    t-else=""
                                                    title="Other activity"
                                                    role="img"
                                                    aria-label="Other activity" />
                                            </div>
                                            <div class="o_ma_card card">
                                                <div class="o_ma_title_bar">
                                                    <div class="o_ma_title ps-2 mt-0">
                                                        <a type="open" t-attf-class="fw-medium mb0 mt0 fs-3 #{!widget.editable and 'o_ma_full' or None}" t-att-title="record.name.raw_value"><field name="name" /></a>
                                                        <div class="o_ma_desc"><field name="activity_type" /></div>
                                                    </div>
                                                    <div class="o_ma_switch">
                                                        <a
                                                            t-if="widget.deletable"
                                                            type="delete"
                                                            title="Delete"
                                                            role="button"
                                                            class="float-start mt8 fa-solid fa-trash-can btn btn-link btn-sm"
                                                            href="#" />
                                                        <span
                                                            role="img"
                                                            title="Graph"
                                                            aria-label="Graph"
                                                            class="o_ma_activity_tab active"
                                                            data-tab-type="graph">
                                                            <i
                                                                class="fa-solid fa-chart-pie" />
                                                        </span>
                                                        <span
                                                            title="Filter"
                                                            role="img"
                                                            aria-label="Filter"
                                                            class="o_ma_activity_tab"
                                                            data-tab-type="filter">
                                                            <i
                                                                class="fa-solid fa-filter" />
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="o_pane o_pane_graph">
                                                    <div class="pb-3 row mt16">
                                                        <div
                                                            t-if="record.statistics_graph_data.value"
                                                            class="col-lg-9 col-9 o_ma_graph mb10">
                                                            <field
                                                                name="statistics_graph_data"
                                                                widget="marketing_activity_graph" />
                                                        </div>
                                                        <div
                                                            class="col-lg-3 col-3 text-center">
                                                            <div
                                                                class="o_ma_text_processed mb16 text-success">
                                                                <field
                                                                    name="processed"
                                                                    class="mt4 mb0 h2" />
                                                                <div>SUCCESS</div>
                                                            </div>
                                                            <div
                                                                class="o_ma_text_rejected text-danger">
                                                                <field
                                                                    name="rejected"
                                                                    class="mt4 mb0 h2" />
                                                                <div>REJECTED</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div
                                                        t-if="record.activity_type.raw_value == 'email'"
                                                        name="mail_details"
                                                        class="row o_ma_email_details text-center position-relative">
                                                        <div class="col text-uppercase">
                                                            <i class="fa-solid fa-chart-pie" /> Details
                                                        </div>
                                                        <a
                                                            name="action_view_sent"
                                                            class="col"
                                                            string="Sent"
                                                            type="object"
                                                            title="Mails sent and not bounced">
                                                            <field name="total_sent" class="fw-bolder" /> Sent
                                                        </a>
                                                        <a
                                                            name="action_view_opened"
                                                            class="col"
                                                            string="Opened"
                                                            type="object">
                                                            <strong><t t-out="Math.round((record.total_open.raw_value/(record.total_sent.raw_value or 1)) * 100) or 0" />%</strong> Opened
                                                        </a>
                                                        <a
                                                            name="action_view_clicked"
                                                            class="col"
                                                            string="Clicked"
                                                            type="object">
                                                            <strong><t t-out="Math.round((record.total_click.raw_value/(record.total_sent.raw_value or 1)) * 100) or 0" />%</strong> Clicked
                                                        </a>
                                                        <a
                                                            name="action_view_replied"
                                                            class="col"
                                                            string="Replied"
                                                            type="object">
                                                            <strong><t t-out="Math.round((record.total_reply.raw_value/(record.total_sent.raw_value or 1)) * 100) or 0" />%</strong> Replied
                                                        </a>
                                                    </div>
                                                </div>
                                                <field
                                                    name="domain"
                                                    widget="domain"
                                                    options="{'foldable': True, 'model': 'model_name'}"
                                                    readonly="1"
                                                    class="o_pane o_pane_filter d-none" />
                                                <div
                                                    t-if="widget.editable"
                                                    class="o_ma_child_activity text-center">
                                                    <div
                                                        class="o_ma_child_activity_title card-footer user-select-none">
                                                        <i class="fa-solid fa-plus-circle" /> Add child activity
                                                    </div>
                                                    <div
                                                        class="o_ma_child_activity_buttons">
                                                        <i
                                                            data-trigger-type="activity"
                                                            class="fa-solid fa-code-branch fa-rotate-180 fa-flip-vertical o_ma_text_processed o_add_child_activity text-success"
                                                            title="Add Another Activity"
                                                            role="img"
                                                            aria-label="Add Another Activity" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_open"
                                                            class="fa-regular fa-envelope-open o_ma_text_processed o_add_child_activity text-success"
                                                            title="Opened"
                                                            role="img"
                                                            aria-label="Opened" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_not_open"
                                                            class="fa-regular fa-envelope-open o_ma_text_rejected o_add_child_activity text-danger"
                                                            title="Not Opened"
                                                            role="img"
                                                            aria-label="Not Opened" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_reply"
                                                            class="fa-solid fa-reply o_ma_text_processed o_add_child_activity text-success"
                                                            title="Replied"
                                                            role="img"
                                                            aria-label="Replied" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_not_reply"
                                                            class="fa-solid fa-reply o_ma_text_rejected o_add_child_activity text-danger"
                                                            title="Not Replied"
                                                            role="img"
                                                            aria-label="Not Replied" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_click"
                                                            class="fa-regular fa-hand-pointer o_ma_text_processed o_add_child_activity text-success"
                                                            title="Clicked"
                                                            role="img"
                                                            aria-label="Clicked" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_not_click"
                                                            class="fa-regular fa-hand-pointer o_ma_text_rejected o_add_child_activity text-danger"
                                                            title="Not Clicked"
                                                            role="img"
                                                            aria-label="Not Clicked" />
                                                        <i
                                                            t-if="record.activity_type.raw_value == 'email'"
                                                            data-trigger-type="mail_bounce"
                                                            class="fa-solid fa-exclamation-circle o_ma_text_rejected o_add_child_activity text-danger"
                                                            title="Bounced"
                                                            role="img"
                                                            aria-label="Bounced" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </templates>
                            </kanban>
                        </field>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="marketing_campaign_view_tree" model="ir.ui.view">
        <field name="name">marketing.campaign.view.list</field>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaign" sample="1" js_class="marketing_campaign_list_view">
                <field name="name" />
                <field name="model_id" string="Target" readonly="state != 'draft'" />
                <field name="mass_mailing_count" string="Mailings" />
                <field name="link_tracker_click_count" string="Clicks" />
                <field name="total_participant_count" string="Participants" />
                <field
                    name="state"
                    widget="badge"
                    readonly="True"
                    decoration-info="state == 'draft'"
                    decoration-muted="state == 'stopped'"
                    decoration-success="state == 'running'" />
            </list>
        </field>
    </record>

    <record id="marketing_campaign_view_search" model="ir.ui.view">
        <field name="name">marketing.campaign.view.search</field>
        <field name="model">marketing.campaign</field>
        <field name="arch" type="xml">
            <search string="Search Campaign">
                <field name="name" string="Campaign" />
                <field name="model_id" string="Target" />
                <filter name="new" string="New" domain="[('state', '=', 'draft')]" />
                <filter
                    name="running"
                    string="Running"
                    domain="[('state', '=', 'running')]" />
                <filter
                    name="stopped"
                    string="Stopped"
                    domain="[('state', '=', 'stopped')]" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_by_model_id"
                        string="Target"
                        context="{'group_by': 'model_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="marketing_campaign_action" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">marketing.campaign</field>
        <field name="path">marketing-automation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <div class="o_view_nocontent o_ma_campaign_container">
                <div class="container">
                    <div
                        class="o_activity_not_found o_nocontent_help container text-center">
                        <p class="o_view_nocontent_smiling_face">Create a Campaign</p>
                        <p>Create one or load a template prepared by our experts.<br />
                            Then sit down and let Odoo handle the rest!</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
