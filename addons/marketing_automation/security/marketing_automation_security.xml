<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_automation" model="res.groups.privilege">
        <field name="name">Marketing Automation</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>

    <record id="group_marketing_automation_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_automation" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('base.group_user')), Command.link(ref('mass_mailing.group_mass_mailing_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
