<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="marketing_campaign_test_view_form" model="ir.ui.view">
        <field name="name">marketing.campaign.test.view.form.test</field>
        <field name="model">wizard.marketing.campaign.launch.test</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Launch a test">
                <sheet>
                    <div class="oe_title mw-100">
                        <span class="o_form_label">Pick or create a/an <field name="model_id" options="{&quot;no_open&quot;: True}" /> to generate a Test Participant</span>
                        <h2>
                            <field
                                name="resource_ref"
                                placeholder="e.g. &quot;Brandon Freeman&quot;"
                                options="{'hide_model': True, 'model_field': 'model_id'}"
                                required="1"
                                class="o_input w-100" />
                        </h2>
                    </div>
                    <field name="campaign_id" invisible="1" />
                    <field name="res_id" invisible="1" readonly="1" />
                </sheet>
                <footer>
                    <button
                        name="action_launch_test"
                        type="object"
                        string="Launch"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="marketing_campaign_test_action" model="ir.actions.act_window">
        <field name="name">Launch a Test…</field>
        <field name="res_model">wizard.marketing.campaign.launch.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="context">{
            'default_campaign_id': active_id,
            'dialog_size' : 'medium',
        }</field>
        <field name="binding_model_id" eval="False" />
    </record>

</odoo>
