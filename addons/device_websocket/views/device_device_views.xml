<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_device_profile_form_websocket" model="ir.ui.view">
        <field name="name">device.profile.form.websocket</field>
        <field name="model">device.profile</field>
        <field name="inherit_id" ref="device.view_device_profile_form" />
        <field name="arch" type="xml">
            <page name="protocol_settings" position="inside">
                <group string="WebSocket Settings" invisible="protocol != 'websocket'">
                    <field name="ws_auto_reconnect" />
                    <field name="ws_ping_interval" />
                </group>
            </page>
        </field>
    </record>

</odoo>
