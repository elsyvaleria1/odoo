<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="access_sale_order_confirm" model="ir.access">
        <field name="name">sale.order: confirm where it is written</field>
        <field name="model_id" ref="model_sale_order" />
        <field name="group_id" ref="base.group_user" />
        <field name="kind">permission</field>
        <field name="verbs">confirm</field>
    </record>

    <record id="sale_order_salesman_ceiling_read" model="ir.access">
        <field name="name">sale.order: what a restricted seller reads</field>
        <field name="model_id" ref="model_sale_order" />
        <field name="group_id" ref="group_sale_salesman" />
        <field name="kind">guard</field>
        <field name="guard_scope">members</field>
        <field name="operation">r</field>
        <field
            name="predicate_args"
            eval="{'operation': 'read', 'role': 'sale.group_sale_salesman', 'with': ['sale.group_sale_readonly']}" />
        <field name="predicate_id" ref="base.access_predicate_conditional_reach" />
        <field name="reach">predicate</field>
    </record>

    <record id="sale_order_salesman_ceiling_change" model="ir.access">
        <field name="name">sale.order: what a restricted seller changes</field>
        <field name="model_id" ref="model_sale_order" />
        <field name="group_id" ref="group_sale_salesman" />
        <field name="kind">guard</field>
        <field name="guard_scope">members</field>
        <field name="operation">cud</field>
        <field
            name="predicate_args"
            eval="{'operation': 'write', 'role': 'sale.group_sale_salesman'}" />
        <field name="predicate_id" ref="base.access_predicate_conditional_reach" />
        <field name="reach">predicate</field>
    </record>

    <record id="sale_order_line_salesman_ceiling_read" model="ir.access">
        <field name="name">sale.order.line: what a restricted seller reads</field>
        <field name="model_id" ref="model_sale_order_line" />
        <field name="group_id" ref="group_sale_salesman" />
        <field name="kind">guard</field>
        <field name="guard_scope">members</field>
        <field name="operation">r</field>
        <field
            name="predicate_args"
            eval="{'operation': 'read', 'role': 'sale.group_sale_salesman', 'with': ['sale.group_sale_readonly']}" />
        <field name="predicate_id" ref="base.access_predicate_conditional_reach" />
        <field name="reach">predicate</field>
    </record>

    <record id="sale_order_line_salesman_ceiling_change" model="ir.access">
        <field name="name">sale.order.line: what a restricted seller changes</field>
        <field name="model_id" ref="model_sale_order_line" />
        <field name="group_id" ref="group_sale_salesman" />
        <field name="kind">guard</field>
        <field name="guard_scope">members</field>
        <field name="operation">cud</field>
        <field
            name="predicate_args"
            eval="{'operation': 'write', 'role': 'sale.group_sale_salesman'}" />
        <field name="predicate_id" ref="base.access_predicate_conditional_reach" />
        <field name="reach">predicate</field>
    </record>

</odoo>
