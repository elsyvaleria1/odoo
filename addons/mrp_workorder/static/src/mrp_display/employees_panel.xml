<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.MrpDisplayEmployeesPanel_content">
        <ul t-if="this.props.employees.connected.length" class="list-group h-100 overflow-y-auto">
            <li t-foreach="this.props.employees.connected" t-as="employee" t-key="employee.id"
                class="list-group-item d-flex gap-2 py-2 cursor-pointer border-end-0 border-top-0"
                t-on-click="() => this.props.setSessionOwner(employee.id,this.pin)"
                t-att-class="{'o_admin_user': employee.id === this.props.employees.admin.id}">
                <img t-attf-src="/web/image/hr.employee/{{employee.id}}/avatar_128"
                    class="o_avatar rounded-circle"
                    t-att-class="{'opacity-50': !employee.workcenters.length and employee.id !== this.props.employees.admin.id}"/>
                <div class="d-flex flex-column flex-grow-1 gap-1 overflow-auto">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="fw-bold text-truncate"
                         t-att-class="{'opacity-50': !employee.workcenters.length and employee.id !== this.props.employees.admin.id}" t-out="employee.name"/>
                    </div>
                    <div t-foreach="employee.workcenters" t-as="wc" t-key="wc.id" class="d-flex justify-content-between">
                        <span t-attf-class="o_tag o_tag_color_{{wc.id % 11}} badge rounded" t-out="wc.name"/>
                        <span class="o_tabular_nums fw-bold text-action" t-out="Math.round(wc.duration) + '\''"/>
                    </div>
                    <div t-if="!employee.workcenters.length" class="d-flex justify-content-between">
                        <span class="text-muted">
                            <t t-if="employee.last_active &amp;&amp; employee.id !== this.props.employees.admin.id">
                                Last seen <RelativeTime datetime="this.makeDate(employee.last_active)"/>
                            </t>
                            <t t-else="">Inactive</t>
                        </span>
                    </div>
                </div>
            </li>
        </ul>
        <div t-else="" class="d-flex justify-content-center align-items-center h-100">
            <span class="text-muted">No operators connected</span>
        </div>
    </t>

    <t t-name="mrp_workorder.MrpDisplayEmployeesPanel">
        <div t-if="!this.ui.isSmall"
             class="o_search_panel o_mrp_employees_panel d-flex flex-column border-end h-100 bg-view"
             t-att-class="this.searchModel.searchPanelInfo.className">
            <t t-call="mrp_workorder.MrpDisplayEmployeesPanel_content"/>
            <div class="p-3 w-100">
                <button class="o_edit_operators btn btn-secondary w-100"
                t-on-click="this.props.popupAddEmployee">
                Edit Operators
            </button>
            </div>
        </div>

        <t t-else="">
            <button class="o_mrp_employees_panel_btn btn btn-outline-secondary d-flex align-items-center bg-view"
                    type="button"
                    t-on-click="() => this.state.panelOpen = true"
                    aria-controls="o_employees_panel">
                <t t-if="this.props.employees.admin.name">
                    <img class="o_avatar rounded-circle me-2" t-att-src="this.props.employees.admin.path"/>
                    <span class="text-truncate" t-out="this.props.employees.admin.name"/>
                </t>
                <t t-else="">
                    <span>Choose Operator</span>
                </t>
            </button>
            <Offcanvas open="this.state.panelOpen"
                       onClose="() => this.state.panelOpen = false"
                       id="'o_employees_panel'"
                       ariaLabelledBy="'o_mrp_employees_panel'"
                       class="'o_mrp_employees_panel bg-view'">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="o_mrp_employees_panel">Operators</h5>
                    <button type="button" class="btn-close" aria-label="Close"
                            t-on-click="() => this.state.panelOpen = false"></button>
                </div>
                <div class="offcanvas-body p-0">
                    <t t-call="mrp_workorder.MrpDisplayEmployeesPanel_content"/>
                </div>
                <div class="offcanvas-footer m-3 border-top">
                    <button class="btn btn-secondary w-100"
                    t-on-click="this.props.popupAddEmployee">
                        Edit Operators
                    </button>
                </div>
            </Offcanvas>
        </t>
    </t>
</templates>
