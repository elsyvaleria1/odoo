<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_workorder_view_form_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.inherit.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <field name="quality_check_fail" invisible="1" />
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,waiting,ready,progress,done" />
                </header>
            </xpath>
            <page name="time_tracking" position="before">
                <page
                    name="finished_steps"
                    string="Instructions"
                    invisible="not check_ids">
                    <field
                        name="check_ids"
                        context="{'form_view_ref': 'mrp_workorder.quality_check_workorder_form'}"
                        readonly="1">
                        <list default_order="control_date">
                            <field name="quality_state" />
                            <field name="test_type" column_invisible="True" />
                            <field name="title" />
                            <field name="control_date" string="Date" />
                            <field name="user_id" string="Operator" />
                            <field
                                name="finished_trace_ids"
                                string="Finished Lot/Serial Number"
                                widget="many2many_tags"
                                options="{'edit_tags': True}"
                                column_invisible="parent.product_tracking == 'none'" />
                            <field name="result" />
                        </list>
                    </field>
                </page>
            </page>
            <field name="production_state" position="after">
                <field name="allowed_employees" invisible="1" />
                <field name="all_employees_allowed" invisible="1" />
            </field>
            <xpath
                expr="//field[@name='time_ids']/list/field[@name='user_id']"
                position="after">
                <field
                    name="employee_id"
                    domain="['|',(parent.all_employees_allowed , '=', True),('id', 'in', parent.allowed_employees)]" />
            </xpath>
            <xpath
                expr="//field[@name='time_ids']/list/field[@name='user_id']"
                position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath
                expr="//field[@name='check_ids']/list/field[@name='user_id']"
                position="after">
                <field name="employee_id" />
            </xpath>
            <xpath
                expr="//field[@name='check_ids']/list/field[@name='user_id']"
                position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='workcenter_id']" position="after">
                <field
                    name="employee_assigned_ids"
                    widget="many2many_avatar_employee"
                    readonly="state == 'done'" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_view_mes"
                    type="object"
                    string="Open Shop Floor"
                    icon="oi-view-kanban"
                    groups="mrp_workorder.group_mrp_wo_shop_floor"
                    invisible="state in ['done', 'cancel']" />
                <button
                    name="action_mark_as_done"
                    type="object"
                    string="Mark as Done"
                    groups="mrp.group_mrp_user"
                    invisible="state in ['done', 'cancel']" />
            </xpath>
        </field>
    </record>

    <record
        id="mrp_production_workorder_tree_editable_view_inherit_workorder"
        model="ir.ui.view">
        <field
            name="name">mrp.production.work.order.list.editable.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field
            name="inherit_id"
            ref="mrp.mrp_production_workorder_tree_editable_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="production_state" column_invisible="True" />
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="allowed_employees" column_invisible="True" />
                <field name="all_employees_allowed" column_invisible="True" />
                <field
                    name="employee_assigned_ids"
                    widget="many2many_avatar_employee"
                    optional="hide"
                    domain="not all_employees_allowed and [('id','in',allowed_employees)] or []" />
            </xpath>
        </field>
    </record>

    <record id="workcenter_line_graph_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.production.work.order.graph.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_graph" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="worksheet_page" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="workcenter_line_pivot_inherit_workorder" model="ir.ui.view">
        <field name="name">mrp.production.work.order.pivot.inherit.mrp.workorder</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.workcenter_line_graph" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="worksheet_page" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="workcenter_line_gantt_production" model="ir.ui.view">
        <field name="name">mrp.production.work.order.gantt.production</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <gantt
                string="Operations"
                default_group_by="production_id"
                create="0"
                delete="0"
                sample="1"
                class="o_mrp_workorder_gantt"
                color="workcenter_id"
                date_start="date_start"
                date_stop="date_end"
                decoration-danger="json_popover and 'text-danger' in json_popover"
                decoration-success="state == 'done'"
                decoration-warning="state == 'cancel' or (json_popover and 'text-warning' in json_popover)"
                display_unavailability="0"
                form_view_id="mrp.mrp_production_workorder_form_view_inherit"
                js_class="mrp_workorder_gantt"
                plan="0"
                precision="{'day': 'hour:full', 'week': 'day:full', 'month': 'day:full', 'year': 'day:full'}"
                progress="progress"
                progress_bar="workcenter_id"
                total_row="True">

                <field name="date_start" />
                <field name="state" />
                <field name="workcenter_id" />
                <field name="json_popover" />

                <templates>
                    <div t-name="gantt-popover" class="container-fluid">
                        <div class="row g-0">
                            <div class="col">
                                <ul class="ps-1 mb-0 list-unstyled">
                                    <li><strong>Start Date: </strong> <t t-out="dates.formatValue(date_start, 'F')" /></li>
                                    <li><strong>Stop Date: </strong> <t t-out="dates.formatValue(date_end, 'F')" /></li>
                                    <li><strong>Workcenter: </strong> <t t-out="workcenter_id.display_name" /></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </templates>
            </gantt>
        </field>
    </record>

    <record id="mrp_workorder_view_gantt" model="ir.ui.view">
        <field name="name">mrp.workorder.view.gantt</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <gantt
                string="Operations"
                default_group_by="workcenter_id"
                create="0"
                delete="0"
                sample="1"
                class="o_mrp_workorder_gantt"
                color="production_id"
                date_start="date_start"
                date_stop="date_end"
                decoration-danger="json_popover and 'text-danger' in json_popover"
                decoration-success="state == 'done'"
                decoration-warning="state == 'cancel' or (json_popover and 'text-warning' in json_popover)"
                display_unavailability="1"
                form_view_id="mrp.mrp_production_workorder_form_view_inherit"
                js_class="mrp_workorder_gantt"
                plan="0"
                precision="{'day': 'hour:full', 'week': 'day:full', 'month': 'day:full', 'year': 'day:full'}"
                progress="progress"
                progress_bar="workcenter_id"
                total_row="True">

                <field name="date_start" />
                <field name="state" />
                <field name="workcenter_id" />
                <field name="json_popover" />

                <templates>
                    <div t-name="gantt-popover" class="container-fluid">
                        <div class="row g-0">
                            <div class="col">
                                <ul class="ps-1 mb-0 list-unstyled">
                                    <li><strong>Start Date: </strong><t t-out="dates.formatValue(date_start, 'F')" /></li>
                                    <li><strong>Stop Date: </strong><t t-out="dates.formatValue(date_end, 'F')" /></li>
                                    <li><strong>Workcenter: </strong> <t t-out="workcenter_id.display_name" /></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </templates>
            </gantt>
        </field>
    </record>

    <record id="workcenter_line_gantt_production_dependencies" model="ir.ui.view">
        <field
