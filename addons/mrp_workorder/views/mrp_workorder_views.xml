    <!-- MRP.WORKORDER TABLET VIEW -->
    <record id="mrp_workorder_view_form_tablet" model="ir.ui.view">
        <field name="name">mrp.workorder.view.form.inherit.quality.tablet.new</field>
        <field name="model">mrp.workorder</field>
        <field name="arch" type="xml">
            <form
                string="Production Workcenter"
                create="0"
                delete="0"
                class="o_workorder_tablet_form form_top">
                <field name="allow_producing_quantity_change" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="is_last_lot" invisible="1" />
                <field name="is_last_unfinished_wo" invisible="1" />
                <field name="is_user_working" invisible="1" />
                <field name="state" invisible="1" />
                <field name="product_tracking" invisible="1" />
                <field name="working_state" invisible="1" />
                <field name="production_id" invisible="1" />
                <field name="current_quality_check_id" invisible="1" />
                <div class="o_workorder_bar">
                    <div class="o_workorder_bar_left o_workorder_bar_content">
                        <button
                            name="action_back"
                            type="object"
                            title="back"
                            class="btn btn-secondary o_exit oi oi-arrow-left o_unblock" />
                        <div class="o_workorder_field">
                            <field name="production_id" options="{'no_open': True}" readonly="1" /> - <field name="name" readonly="1" />
                        </div>
                    </div>
                    <div class="o_workorder_bar_center o_workorder_bar_content">
                        <div class="o_workorder_field">
                            <field
                                name="product_id"
                                context="{'display_default_code': False}"
                                options="{'no_open': True}"
                                readonly="1" />
                            <label for="qty_producing" string=":" />
                            <field
                                name="qty_producing"
                                readonly="not allow_producing_quantity_change or product_tracking == 'serial' or state in ('done', 'cancel')"
                                required="1"
                                class="oe_inline text-start" />
                            / <field name="qty_remaining" invisible="state == 'done'" class="oe_inline text-start" /> <field name="qty_production" invisible="state != 'done'" class="oe_inline text-start" />
                            <label for="product_uom_id" string="" class="oe_inline" />
                            <field
                                name="product_uom_id"
                                widget="many2one_uom"
                                options="{'no_open': True}"
                                readonly="1"
                                class="oe_inline" />
                        </div>
                    </div>
                    <div class="o_workorder_bar_right o_workorder_bar_content">
                        <span style="width:auto; display:block;">
                        <button
                            name="popupEmployeeManagement"
                            type="workorder_event"
                            class="btn-secondary btn-link o_unblock">
                            <span invisible="employee_name">Log In </span>
                            <field
                                name="employee_name"
                                invisible="not employee_name"
                                readonly="1"
                                class="me-2" />
                            <field
                                name="employee_ids"
                                widget="kanban.many2many_avatar_employee"
                                options="{'no_create': True}"
                                invisible="not employee_name"
                                readonly="1" />
                        </button>
                        </span>
                    </div>
                </div>
                <div class="o_workorder_bar">
                    <div
                        class="o_workorder_bar_left o_workorder_action o_workorder_bar_content">
                        <button
                            name="openMenuPopup"
                            type="workorder_event"
                            title="menu"
                            class="btn btn-secondary o_workorder_icon_btn fa-solid fa-bars" />
                        <span groups="mrp_workorder.group_mrp_wo_tablet_timer">
                            <button
                                name="button_pending"
                                type="object"
                                string="PAUSE"
                                invisible="True"
                                class="btn btn-secondary"
                                barcode_trigger="PAUS" />
                            <button
                                name="button_start"
                                type="object"
                                string="CONTINUE"
                                invisible="True"
                                class="btn btn-warning"
                                barcode_trigger="CONT" />
                            <button name="button_unblock" type="object" invisible="working_state != 'blocked'" class="btn btn-secondary btn-danger o_unblock">Unblock</button>
                            <field name="duration_live" invisible="1" />
                            <field
                                name="duration"
                                widget="mrp_timer"
                                readonly="1"
                                class="ms-1" />
                        </span>
                    </div>
                    <div class="o_workorder_bar_center o_workorder_bar_content">
                        <div class="o_workorder_field o_workorder_lot">
                            <div invisible="product_tracking == 'none'">
                                <label
                                    for="finished_trace_ids"
                                    string="Lot"
                                    invisible="product_tracking != 'lot'" />
                                <label
                                    for="finished_trace_ids"
                                    string="Serial"
                                    invisible="product_tracking != 'serial'" />
                                <field
                                    name="finished_trace_ids"
                                    widget="many2many_tags"
                                    domain="[('product_id', '=', product_id)]"
                                    context="{'default_product_id': product_id, 'default_company_id': company_id}"
                                    options="{'edit_tags': True}" />
                                <button
                                    name="action_generate_serial"
                                    type="object"
                                    title="Creates a new serial/lot number"
                                    invisible="finished_trace_ids"
                                    class="o_btn_icon btn btn-secondary"
                                    aria-label="Creates a new serial/lot number">
                                    <i class="fa-solid fa-plus" role="img" />
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="o_workorder_bar_right o_workorder_bar_content">
                        <button
                            name="do_finish"
                            type="object"
                            string="Mark as Done"
                            icon="fa-check"
                            invisible="current_quality_check_id or not is_last_unfinished_wo and not is_last_lot"
                            class="btn-primary"
                            barcode_trigger="CLWO" />
                        <button
                            name="action_view_manufacturing_order"
                            type="object"
                            string="Mark as Done and Close MO"
                            icon="fa-check"
                            invisible="current_quality_check_id or not is_last_unfinished_wo"
                            class="btn-primary"
                            barcode_trigger="CLMO" />
                        <button
                            name="record_production"
                            type="object"
                            string="Record production"
                            invisible="current_quality_check_id or is_last_unfinished_wo or is_last_lot"
                            class="btn-primary"
                            barcode_trigger="RECO" />
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="mrp_workorder_action_tablet" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="target">fullscreen</field>
        <field
            name="context">{'search_default_workcenter_id': active_id, 'search_default_progress': True, 'search_default_ready': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_workorder">
                No work orders to do!
            </p><p>
                Work orders are operations to do as part of a manufacturing order.
                Operations are defined in the bill of materials or added in the manufacturing order directly.
            </p><p>
                Use the table work center control panel to register operations in the shop floor directly.
                The tablet provides worksheets for your workers and allow them to scrap products, track time,
                launch a maintenance request, perform quality tests, etc.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'kanban', 'view_id': ref('mrp.workcenter_line_kanban')}), Command.create({'view_mode': 'list', 'view_id': ref('mrp.mrp_production_workorder_tree_editable_view')})]" />
    </record>

