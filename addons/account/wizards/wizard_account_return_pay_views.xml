<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="return_generic_payment_wizard_form" model="ir.ui.view">
        <field name="name">account.return.payment.wizard.form</field>
        <field name="model">wizard.account.return.pay</field>
        <field name="arch" type="xml">
            <form string="Pay">
                <h2>
                    <group>
                        <field name="currency_id" invisible="1" />
                        <field name="amount_to_pay" readonly="1" />
                    </group>
                </h2>
                <group invisible="not has_settlement">
                    <field name="company_id" invisible="1" />
                    <field name="journal_id" required="has_settlement" />
                </group>
                <footer>
                    <button
                        name="action_create_payment"
                        type="object"
                        string="Create Payment"
                        invisible="not has_settlement"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_mark_as_paid"
                        type="object"
                        string="Mark Paid"
                        invisible="has_settlement"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_send_email_instructions"
                        type="object"
                        string="Send"
                        class="btn-secondary"
                        data-hotkey="s" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
