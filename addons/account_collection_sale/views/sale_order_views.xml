<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.account.collection.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_cash_sale" invisible="1" />
                <button
                    name="action_open_cash_collect"
                    type="object"
                    string="Collect Cash Sale"
                    groups="account_collection.group_collection_collector"
                    invisible="state != 'done' or not is_cash_sale or invoice_state != 'to do'"
                    class="btn-primary" />
            </xpath>
        </field>
    </record>

</odoo>
