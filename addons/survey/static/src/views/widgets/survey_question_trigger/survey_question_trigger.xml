<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

 <t t-name="survey.surveyQuestionTrigger">
 <t t-set="trigger" t-value="this.trigger"/>
 <button t-if="this.props.record.data.triggering_question_ids.records.length" disabled="disabled"
 class="btn btn-link px-1 py-0 pe-auto" t-att-class="trigger.warning ? 'opacity-100' : 'icon_rotates'">
 <i class="fa-solid o_button_icon" t-att-class="trigger.warning ? 'fa-exclamation-triangle text-warning' : 'fa-code-fork'"
 t-att-data-tooltip="trigger.tooltip"/>
 </button>
 </t>

</templates>
