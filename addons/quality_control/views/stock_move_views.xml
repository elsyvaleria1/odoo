<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="view_stock_move_line_detailed_operation_tree_inherit_quality"
        model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="check_state" column_invisible="True" />
                <button
                    name="action_view_quality_check_wizard"
                    type="object"
                    title="Quality Check"
                    icon="fa-check"
                    invisible="check_state != 'in_progress'"
                    class="btn-info" />
                <button
                    name="action_view_quality_check_wizard"
                    type="object"
                    title="Quality Check"
                    icon="fa-check"
                    invisible="check_state != 'fail'"
                    class="btn-danger" />
                <button
                    name="action_view_quality_check_wizard"
                    type="object"
                    title="Quality Check"
                    icon="fa-check"
                    invisible="check_state != 'pass'"
                    class="btn-success" />
            </xpath>
        </field>
    </record>

</odoo>
