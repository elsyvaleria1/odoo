<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_view_form_inherit_quality" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='button_validate'][hasclass('o_btn_validate')]"
                position="before">
                <button
                    name="check_quality"
                    type="object"
                    string="Quality Checks"
                    groups="quality.group_quality_user"
                    invisible="not quality_check_todo or state in ('done', 'cancel')"
                    class="oe_highlight"
                    data-hotkey="shift+z" />
                <button
                    name="button_quality_alert"
                    type="object"
                    string="Quality Alert"
                    context="{'default_picking_id': id}"
                    groups="quality.group_quality_user"
                    invisible="not quality_check_fail or quality_alert_count != 0"
                    class="oe_highlight"
                    data-hotkey="shift+q" />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="open_quality_alert_picking"
                    type="object"
                    icon="fa-bell"
                    groups="quality.group_quality_user"
                    invisible="quality_alert_count == 0"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_alert_count" /></span>
                        <span class="o_stat_text">Quality Alert</span>
                    </div>
                </button>
                <button
                    name="action_view_quality_check_picking"
                    type="object"
                    icon="fa-check"
                    groups="quality.group_quality_user"
                    invisible="not check_ids or quality_check_fail or not quality_check_todo"
                    class="oe_stat_button">
                    <span class="o_stat_text">Quality Checks</span>
                </button>
                <button
                    name="action_view_quality_check_picking"
                    type="object"
                    icon="fa-check"
                    groups="quality.group_quality_user"
                    invisible="not check_ids or quality_check_fail or quality_check_todo"
                    class="oe_stat_button text-success">
                    <span class="o_stat_text text-success">Quality Checks</span>
                </button>
                <button
                    name="action_view_quality_check_picking"
                    type="object"
                    icon="fa-check"
                    groups="quality.group_quality_user"
                    invisible="not check_ids or not quality_check_fail"
                    class="oe_stat_button text-danger">
                    <span class="o_stat_text text-danger">Quality Checks</span>
                </button>
            </div>
        </field>
    </record>

    <record id="stock_picking_view_tree_inherit_quality" model="ir.ui.view">
        <field name="name">stock.picking.view.tree.inherit.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_list_vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="field[@name='company_id']" position="after">
                <field name="quality_check_todo" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_view_search_inherit_quality" model="ir.ui.view">
        <field name="name">stock.picking.view.search.inherit.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_search_internal" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='backorder']" position="before">
                <filter
                    name="quality_check_todo"
                    string="Quality Checks"
                    domain="[('quality_check_todo', '=', True)]" />
            </xpath>
        </field>
    </record>

</odoo>
