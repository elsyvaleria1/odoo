<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_action_quality_alert" model="ir.actions.server">
        <field name="name">Quality Alert</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field
            name="code">if record:
            action = record.button_quality_alert()</field>
    </record>

    <record id="stock_picking_action_quality_check_on_demand" model="ir.actions.server">
        <field name="name">Quality Check</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = record.action_view_on_demand_quality_check()</field>
    </record>

</odoo>
