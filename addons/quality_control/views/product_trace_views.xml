<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_production_lot_view_form" model="ir.ui.view">
        <field name="name">stock.production.lot.view.form</field>
        <field name="model">product.trace</field>
        <field name="inherit_id" ref="stock.view_product_trace_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]/button" position="before">
                <button
                    name="action_lot_open_quality_alerts"
                    type="object"
                    icon="oi-search"
                    groups="quality.group_quality_user"
                    invisible="quality_alert_qty == 0"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <div
                            class="o_field_widget o_stat_info align-items-baseline flex-row gap-1 me-1">
                            <span class="o_stat_text">Quality Alerts:</span>
                            <span class="o_stat_value">
                                <field
                                    name="quality_alert_qty"
                                    widget="statinfo"
                                    nolabel="1"
                                    class="mr4" />
                            </span>
                        </div>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="stock_production_lot_form_quality_control" model="ir.ui.view">
        <field name="name">stock.lot.form.quality</field>
        <field name="model">product.trace</field>
        <field name="inherit_id" ref="stock.view_product_trace_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_quality_checks"
                    type="object"
                    icon="fa-check"
                    groups="quality.group_quality_user"
                    invisible="quality_check_qty == 0"
                    class="oe_stat_button">
                    <field
                        name="quality_check_qty"
                        string="Quality Checks"
                        widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
