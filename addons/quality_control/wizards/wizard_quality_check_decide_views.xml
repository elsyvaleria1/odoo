<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_quality_check_wizard" model="ir.ui.view">
        <field name="name">quality_check_wizard</field>
        <field name="model">wizard.quality.check.decide</field>
        <field name="arch" type="xml">
            <form string="Quality Checks">
                <field name="current_check_id" invisible="1" />
                <field name="measure_on" invisible="1" />
                <field name="test_type" invisible="1" />
                <field name="quality_state" invisible="1" />
                <field name="is_last_check" invisible="1" />
                <field name="testing_percentage_within_lot" invisible="1" />
                <field name="is_lot_tested_fractionally" invisible="1" />
                <field name="show_lot_text" invisible="1" />
                <field name="product_tracking" invisible="1" />
                <field name="product_id" invisible="1" />

                <div class="o_row d-flex justify-content-between">
                    <span>
                        <field name="note" readonly="1" />
                    </span>
                    <h5>
                        <field name="position_current_check" readonly="1" /> /
                        <field name="nb_checks" readonly="1" />
                    </h5>
                </div>
                <group invisible="measure_on != 'move_line'">
                    <group>
                        <label
                            for="qty_to_test"
                            invisible="not is_lot_tested_fractionally" />
                        <div class="o_row" invisible="not is_lot_tested_fractionally">
                            <field name="qty_to_test" />
                            <field name="uom_id" widget="many2one_uom" />
                        </div>
                        <label
                            for="qty_tested"
                            invisible="not is_lot_tested_fractionally" />
                        <div class="o_row" invisible="not is_lot_tested_fractionally">
                            <field
                                name="qty_tested"
                                readonly="quality_state != 'none'" />
                            <field name="uom_id" widget="many2one_uom" />
                        </div>
                    </group>
                </group>
                <group>
                    <group>
                        <label for="measure" invisible="test_type != 'measure'" />
                        <div invisible="test_type != 'measure'" class="o_row">
                            <field name="measure" readonly="quality_state != 'none'" />
                            <field name="norm_unit" string="Unit of Measure" />
                        </div>
                    </group>
                </group>
                <label for="picture" invisible="1" />
                <div invisible="test_type != 'picture'">
                    <field
                        name="picture"
                        widget="image"
                        readonly="quality_state != 'none'" />
                </div>
                <field
                    name="additional_note"
                    placeholder="Write quality check notes..."
                    readonly="quality_state != 'none'" />
                <footer>
                    <button
                        name="do_measure"
                        type="object"
                        string="Validate"
                        invisible="quality_state != 'none' or test_type != 'measure'"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="do_pass"
                        type="object"
                        string="Validate"
                        invisible="quality_state != 'none' or test_type not in ('picture', 'instructions')"
                        class="btn-primary"
                        data-hotkey="w" />
                    <button
                        name="do_pass"
                        type="object"
                        string="Pass"
                        invisible="quality_state != 'none' or test_type != 'passfail'"
                        class="btn-success "
                        data-hotkey="w" />
                    <button
                        name="do_fail"
                        type="object"
                        string="Fail"
                        invisible="quality_state != 'none' or test_type != 'passfail'"
                        class="btn-danger"
                        data-hotkey="k" />
                    <button
                        name="action_view_spreadsheet"
                        type="object"
                        string="Open spreadsheet"
                        invisible="test_type != 'spreadsheet'"
                        class="btn-primary "
                        data-hotkey="w" />
                    <button
                        name="action_generate_previous_window"
                        type="object"
                        string="Previous"
                        invisible="position_current_check == 1"
                        class="btn-secondary" />
                    <button
                        name="action_generate_next_window"
                        type="object"
                        string="Next"
                        invisible="is_last_check"
                        class="btn-secondary" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="quality_check_wizard_form_failure" model="ir.ui.view">
        <field name="name">quality.check.wizard.form.failure</field>
        <field name="model">wizard.quality.check.decide</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Quality Check Failed">
                <field name="test_type" invisible="1" />
                <field name="measure_on" invisible="1" />
                <field name="show_lot_text" invisible="1" />
                <field name="product_tracking" invisible="1" />
                <field name="potential_failure_location_ids" invisible="1" />
                <field name="product_id" invisible="1" />
                <group>
                    <group
                        invisible="measure_on != 'move_line' and not potential_failure_location_ids">
                        <label
                            for="qty_failed"
                            string="Quantity Failed"
                            invisible="measure_on != 'move_line'" />
                        <div invisible="measure_on != 'move_line'">
                            <field
                                name="qty_failed"
                                required="True"
                                class="oe_inline" />
                            <field
                                name="uom_id"
                                widget="many2one_uom"
                                class="oe_inline" />
                        </div>
                        <field
                            name="lot_name"
                            string="Lot/SN"
                            invisible="measure_on != 'move_line' or not show_lot_text or product_tracking == 'none'" />
                        <field
                            name="trace_line_id"
                            string="Lot/SN"
                            invisible="measure_on != 'move_line' or show_lot_text or product_tracking == 'none'" />
                        <field
                            name="failure_location_id"
                            widget="selection_badge"
                            domain="[('id', 'in', potential_failure_location_ids)]"
                            invisible="not potential_failure_location_ids" />
                    </group>
                    <group>
                        <div
                            class="alert"
                            role="alert"
                            colspan="2"
                            invisible="test_type != 'measure'">
                            <field name="warning_message" />
                        </div>
                        <div colspan="2">
                            <field name="failure_message" />
                        </div>
                    </group>
                </group>
                <footer>

                    <button
                        name="confirm_measure"
                        type="object"
                        string="Confirm Measure"
                        invisible="test_type != 'measure'"
                        class="btn-primary"
                        data-hotkey="w" />
                    <button
                        name="confirm_fail"
                        type="object"
                        string="Confirm"
                        invisible="test_type == 'measure' or context.get('from_shopfloor')"
                        class="btn-primary"
                        data-hotkey="w" />
                    <button
                        name="correct_measure"
                        type="object"
                        string="Correct Measure"
                        invisible="test_type != 'measure'"
                        class="btn-secondary"
                        data-hotkey="q" />
                    <button
                        name="action_generate_previous_window"
                        type="object"
                        string="Back"
                        invisible="test_type == 'measure' or context.get('from_shopfloor')"
                        class="btn-secondary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="OK"
                        invisible="test_type == 'measure' or not context.get('from_shopfloor')"
                        class="oe_highlight"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_quality_check_wizard" model="ir.actions.act_window">
        <field name="name">Quality Check</field>
        <field name="res_model">wizard.quality.check.decide</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
