<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="demo_data_temp_01" model="device.data.log">
        <field name="device_id" ref="demo_device_temp_sensor_01" />
        <field name="data_type">json</field>
        <field name="source">iot</field>
        <field
            name="raw_payload">{"temperature": 22.5, "unit": "celsius", "sensor_id": "TMP-001"}</field>
        <field
            name="timestamp"
            eval="(datetime.now() - timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>

    <record id="demo_data_temp_02" model="device.data.log">
        <field name="device_id" ref="demo_device_temp_sensor_01" />
