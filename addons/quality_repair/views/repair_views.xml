<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_repair_order_form_inherit_quality" model="ir.ui.view">
        <field name="name">repair.form.inherit.quality</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <button name="action_repair_cancel" position="before">
                <button name="action_check_quality" type="object" string="Quality Checks" invisible="not quality_check_todo" class="oe_highlight" data-hotkey="shift+z" /> --&gt;
                <button
                    name="action_view_quality_alerts"
                    type="object"
                    string="Quality Alert"
                    context="{'default_repair_id': id}"
                    invisible="not quality_check_ids or quality_check_fail and quality_alert_count == 0" />
                <button
                    name="action_view_quality_alerts"
                    type="object"
                    string="Quality Alert"
                    context="{'default_repair_id': id}"
                    invisible="not quality_check_fail or quality_alert_count != 0"
                    class="oe_highlight" />
            </button>
            <div name="button_box" position="inside">
                <button
                    name="action_view_quality_alerts"
                    type="object"
                    icon="fa-bell"
                    context="{'search_default_repair_id': id}"
                    invisible="quality_alert_count == 0"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="quality_alert_count" /></span>
                        <span class="o_stat_text">Quality Alerts</span>
                    </div>
                </button>
                <button
                    name="action_view_quality_checks"
                    type="object"
                    icon="fa-check"
                    invisible="not quality_check_ids or quality_check_fail or not quality_check_todo"
                    class="oe_stat_button">
                    <span class="o_stat_text">Quality Checks</span>
                </button>
                <button
                    name="action_view_quality_checks"
                    type="object"
                    icon="fa-check"
                    invisible="not quality_check_ids or quality_check_fail or quality_check_todo"
                    class="oe_stat_button text-success">
                    <span class="o_stat_text text-success">Quality Checks</span>
                </button>
                <button
                    name="action_view_quality_checks"
                    type="object"
                    icon="fa-check"
                    invisible="not quality_check_ids or not quality_check_fail"
                    class="oe_stat_button text-danger">
                    <span class="o_stat_text text-danger">Quality Checks</span>
                </button>
            </div>
        </field>
    </record>

</odoo>
