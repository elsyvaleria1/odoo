<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_wallet" model="ir.ui.view">
        <field name="name">purchase.order.form.wallet</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/list/field[@name='product_id']"
                position="after">
                <field name="wallet_card_id" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
