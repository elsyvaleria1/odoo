<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wallet_card_form_inherit_reorder" model="ir.ui.view">
        <field name="name">wallet.card.form.reorder</field>
        <field name="model">wallet.card</field>
        <field name="inherit_id" ref="wallet.view_wallet_card_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_reorder_rule"
                    type="object"
                    icon="fa-refresh"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="amount_to_reload" widget="monetary" />
                        </span>
                        <span class="o_stat_text">To reload</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
