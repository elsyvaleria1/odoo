<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_meter_reading_view_list" model="ir.ui.view">
        <field name="name">resource.meter.reading.list</field>
        <field name="model">resource.meter.reading</field>
        <field name="arch" type="xml">
            <list string="Readings" editable="top">
                <field name="date" />
                <field name="value" />
                <field name="source" />
                <field name="note" />
            </list>
        </field>
    </record>

    <record id="resource_meter_view_form" model="ir.ui.view">
        <field name="name">resource.meter.form</field>
        <field name="model">resource.meter</field>
        <field name="arch" type="xml">
            <form string="Meter">
                <sheet>
                    <group>
                        <group>
                            <field name="resource_id" />
                            <field name="name" />
                            <field name="kind" />
                        </group>
                        <group>
                            <field name="uom_id" />
                            <field name="monotonic" />
                            <field name="value" />
                            <field name="date" />
                        </group>
                    </group>
                    <field name="reading_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_meter_view_list" model="ir.ui.view">
        <field name="name">resource.meter.list</field>
        <field name="model">resource.meter</field>
        <field name="arch" type="xml">
            <list string="Meters">
                <field name="resource_id" />
                <field name="name" />
                <field name="kind" />
                <field name="value" />
                <field name="uom_id" />
                <field name="date" />
            </list>
        </field>
    </record>

    <record id="action_resource_meter" model="ir.actions.act_window">
        <field name="name">Meters</field>
        <field name="res_model">resource.meter</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
