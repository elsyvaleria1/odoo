<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_resource_resource_search" model="ir.ui.view">
        <field name="name">resource.resource.search</field>
        <field name="model">resource.resource</field>
        <field name="arch" type="xml">
            <search string="Search Resource">
                <field name="name" />
                <field name="type" />
                <field name="user_id" />
                <field name="calendar_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter name="human" string="Human" domain="[('type', '=', 'human')]" />
                <filter
                    name="material"
                    string="Material"
                    domain="[('type', '=', 'material')]" />
                <filter
                    name="intangible"
                    string="Intangible"
                    domain="[('type', '=', 'intangible')]" />
                <separator />
                <filter
                    name="available"
                    string="Available"
                    domain="[('state', '=', 'available')]" />
                <filter
                    name="in_service"
                    string="In Service"
                    domain="[('state', '=', 'in_service')]" />
                <filter
                    name="maintenance"
                    string="Under Maintenance"
                    domain="[('state', '=', 'maintenance')]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active','=',False)]" />
                <group>
                    <filter
                        name="user"
                        string="User"
                        context="{'group_by':'user_id'}" />
                    <filter name="type" string="Type" context="{'group_by':'type'}" />
                    <filter
                        name="company"
                        string="Company"
                        context="{'group_by':'company_id'}"
                        groups="base.group_multi_company" />
                    <filter
                        name="working_period"
                        string="Working Time"
                        context="{'group_by':'calendar_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="resource_resource_form" model="ir.ui.view">
        <field name="name">resource.resource.form</field>
        <field name="model">resource.resource</field>
        <field name="arch" type="xml">
            <form string="Resource">
                <header>
                    <button
                        name="action_set_available"
                        type="object"
                        string="Make Available"
                        invisible="state not in ('draft', 'in_service', 'out_of_service')"
                        class="btn-primary" />
                    <button
                        name="action_set_in_service"
                        type="object"
                        string="Put in Service"
                        invisible="state != 'available'"
                        class="btn-primary" />
                    <button
                        name="action_end_maintenance"
                        type="object"
                        string="End Maintenance"
                        invisible="state != 'maintenance'"
                        class="btn-primary" />
                    <button
                        name="action_set_maintenance"
                        type="object"
                        string="Under Maintenance"
                        invisible="state not in ('available', 'in_service')" />
                    <button
                        name="action_set_out_of_service"
                        type="object"
                        string="Take Out of Service"
                        invisible="state not in ('available', 'in_service', 'maintenance')" />
                    <button
                        name="action_dispose"
                        type="object"
                        string="Dispose"
                        confirm="Dispose of this resource? It is archived and its custody ends today."
                        invisible="state == 'disposed'" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,available,in_service,maintenance" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group>
                        <group name="user_details">
                            <field name="name" />
                            <field name="partner_id" invisible="type != 'human'" />
                            <field name="user_id" invisible="type != 'human'" />
                            <field name="type" />
                            <field name="role_ids" widget="many2many_tags" />
                            <field name="default_role_id" />
                        </group>
                        <group name="resource_details">
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                            <field name="calendar_id" />
                            <field name="tz" />
                            <field name="time_efficiency" />
                            <field name="booking_limit_percentage" />
                            <field name="enforce_booking_limit" />
                            <field name="capacity" invisible="type == 'human'" />
                        </group>
                        <group
                            name="custody"
                            string="Custody"
                            invisible="type != 'material'">
                            <field name="operator_id" />
                            <field name="future_operator_id" />
                            <field
                                name="date_future_operator"
                                invisible="not future_operator_id" />
                            <field name="manager_id" />
                        </group>
                        <group name="origin" string="Origin">
                            <field name="date_origin" />
                            <field name="origin_country_id" />
                            <field name="place_origin" />
                        </group>
                        <group
                            name="lifecycle"
                            string="Lifecycle"
                            invisible="type == 'human'">
                            <field name="date_acquisition" />
                            <field name="date_disposal" />
                            <field name="currency_id" invisible="1" />
                            <field name="value_original" />
                        </group>
                    </group>
                    <notebook>
                        <page name="identifiers" string="Identifiers">
                            <field name="identifier_ids">
                                <list editable="bottom">
                                    <field name="type_id" />
                                    <field name="value" />
                                    <field name="valid_until" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="nationalities" string="Nationalities">
                            <field
                                name="nationality_country_ids"
                                widget="many2many_tags"
                                invisible="type != 'human'" />
                            <field name="nationality_ids" invisible="type == 'human'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="country_id" />
                                    <field name="basis" />
                                    <field name="date_acquired" />
                                    <field name="date_lost" optional="hide" />
                                    <field name="identifier_id" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="meters" string="Meters">
                            <field name="meter_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="value" />
                                    <field name="uom_id" />
                                    <field name="date" />
                                    <field name="monotonic" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="relations" string="Members and Dependencies">
                            <field
                                name="relation_ids"
                                context="{'default_parent_id': id}">
                                <list>
                                    <field name="relation_type" />
                                    <field name="member_id" />
                                    <field name="date_start" />
                                    <field name="date_end" />
                                </list>
                            </field>
                        </page>
                        <page name="memberships" string="Memberships">
                            <field name="membership_ids" readonly="1">
                                <list>
                                    <field name="parent_id" />
                                    <field name="relation_type" />
                                    <field name="date_start" />
                                    <field name="date_end" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="resource_resource_tree" model="ir.ui.view">
        <field name="name">resource.resource.list</field>
        <field name="model">resource.resource</field>
        <field name="arch" type="xml">
            <list string="Resources" default_order="name" multi_edit="1">
                <field name="company_id" column_invisible="True" />
                <field
                    name="avatar_128"
                    widget="resource_avatar"
                    width="30"
                    nolabel="1"
                    options="{'size': [24, 24], 'img_class': 'rounded-3'}" />
                <field name="name" />
                <field name="user_id" />
                <field
                    name="company_id"
                    optional="show"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
                <field name="calendar_id" optional="show" />
                <field name="tz" optional="hide" />
                <field name="type" optional="show" />
                <field name="state" optional="hide" />
                <field name="time_efficiency" />
                <field name="capacity" optional="hide" />
                <field name="booking_limit_percentage" optional="hide" />
                <field name="enforce_booking_limit" optional="hide" />
            </list>
        </field>
    </record>

    <record id="action_resource_resource_tree" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">resource.resource</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_resource_resource_search" />
        <field name="context">{}</field>
        <field
            name="help">Resources allow you to create and manage resources that should be
            involved in a specific project phase. You can also set their efficiency level and
            workload based on their weekly working hours.</field>
    </record>

    <record id="resource_resource_action_from_calendar" model="ir.actions.act_window">
        <field name="name">Resources</field>
        <field name="res_model">resource.resource</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_resource_resource_search" />
        <field
            name="context">{
            'default_calendar_id': active_id,
            'search_default_calendar_id': active_id}</field>
        <field
            name="help">Resources allow you to create and manage resources that should be
            involved in a specific project phase. You can also set their efficiency level and
            workload based on their weekly working hours.</field>
    </record>

</odoo>
