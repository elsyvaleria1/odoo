<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_owner_deletes_resource" model="res.groups">
        <field
            name="name">Privilege: deleting what owns a resource deletes the resource</field>
        <field
            name="comment">An employee, an asset or any record that owns its resource takes it along when it is deleted, with its identifiers and meters. The resource still refuses when it has operational history; it is archived instead.</field>
        <field name="is_privilege" eval="True" />
    </record>

    <record id="res_groups_privilege_asset" model="res.groups.privilege">
        <field name="name">Assets</field>
        <field name="category_id" ref="base.module_category_supply_chain" />
    </record>

    <record id="group_asset_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_asset" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_asset_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_asset" />
        <field name="implied_ids" eval="[Command.link(ref('group_asset_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
