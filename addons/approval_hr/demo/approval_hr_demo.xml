            name="step_ids"
            eval="[Command.create({'name': 'Approvers', 'minimum': 1, 'counts_added_approvers': True, 'member_ids': [Command.create({'user_id': ref('user_dept_manager'), 'sequence': 20, 'required': False})]})]" />
