<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_view_list" model="ir.ui.view">
        <field name="name">resource.resource.asset.list</field>
        <field name="model">resource.resource</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list
                string="Assets"
                decoration-muted="state in ('out_of_service', 'disposed')">
                <field name="name" />
                <field name="kind_id" />
                <field name="state" />
                <field name="holder_id" />
                <field name="address_id" optional="hide" />
                <field name="date_acquisition" optional="hide" />
                <field name="calendar_id" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="resource_asset_view_kanban" model="ir.ui.view">
        <field name="name">resource.resource.asset.kanban</field>
        <field name="model">resource.resource</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban sample="1" highlight_color="color">
                <field name="state" />
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5" />
                        <div><field name="kind_id" /></div>
                        <div t-if="record.holder_id.raw_value"><field name="holder_id" /></div>
                        <footer>
                            <field name="state" widget="label_selection" />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="resource_asset_view_form" model="ir.ui.view">
        <field name="name">resource.resource.asset.form</field>
        <field name="model">resource.resource</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button
                        name="action_set_available"
                        type="object"
                        string="Make Available"
                        invisible="state not in ('draft', 'in_service', 'out_of_service')"
                        class="btn-primary" />
                    <button
                        name="action_end_maintenance"
                        type="object"
                        string="End Maintenance"
                        invisible="state != 'maintenance'"
                        class="btn-primary" />
                    <button
                        name="action_set_in_service"
                        type="object"
                        string="Put in Service"
                        invisible="state != 'available'"
                        class="btn-primary" />
                    <button
                        name="action_set_maintenance"
                        type="object"
                        string="Under Maintenance"
                        invisible="state not in ('available', 'in_service')" />
                    <button
                        name="action_set_out_of_service"
                        type="object"
                        string="Take Out of Service"
                        invisible="state not in ('available', 'in_service', 'maintenance')" />
                    <button
                        name="action_dispose"
                        type="object"
                        string="Dispose"
                        confirm="Dispose of this asset? It is archived and its custody ends today."
                        invisible="state == 'disposed'" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,available,in_service,maintenance" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <field name="avatar_128" invisible="1" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Tractor 7" />
                        </h1>
                    </div>
                    <group>
                        <group name="identity">
                            <field name="active" invisible="1" />
                            <field name="kind_id" required="1" />
                            <field name="kind_code" invisible="1" />
                            <field name="parent_id" />
                            <field name="model" />
                            <field name="model_year" options="{'format': false}" />
                            <field
                                name="serial_number"
                                invisible="kind_code not in ('device', 'telecom', 'machinery', 'equipment', 'it')" />
                            <field
                                name="imei"
                                invisible="kind_code not in ('device', 'telecom')" />
                            <field
                                name="cadastral_id"
                                invisible="kind_code != 'property'" />
                            <field
                                name="inventory_tag"
                                invisible="kind_code != 'furniture'" />
                            <field name="date_origin" string="Date Built" />
                            <field
                                name="origin_country_id"
                                string="Country of Production" />
                            <field name="place_origin" string="Place of Production" />
                            <field name="brand_new" />
                        </group>
                        <group name="where">
                            <field name="operator_id" />
                            <field name="future_operator_id" />
                            <field
                                name="date_future_operator"
                                invisible="not future_operator_id" />
                            <field name="manager_id" />
                            <field name="address_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="calendar_id" />
                            <field name="tz" />
                        </group>
                    </group>
                    <field name="properties" columns="2" />
                    <notebook>
                        <page name="identifiers" string="Identifiers">
                            <field name="identifier_ids">
                                <list editable="bottom">
                                    <field name="type_id" />
                                    <field name="value" />
                                    <field name="valid_until" optional="hide" />
                                </list>
                            </field>
                            <field
                                name="missing_identifier_type_ids"
                                widget="many2many_tags"
                                invisible="not missing_identifier_type_ids"
                                readonly="1" />
                        </page>
                        <page name="nationalities" string="Nationalities">
                            <field name="nationality_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="country_id" />
                                    <field name="basis" />
                                    <field name="date_acquired" />
                                    <field name="date_lost" optional="hide" />
                                    <field name="identifier_id" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="meters" string="Meters">
                            <field name="meter_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="kind" />
                                    <field name="value" />
                                    <field name="uom_id" />
                                    <field name="date" />
                                    <field name="monotonic" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="custody" string="Custody">
                            <field
                                name="assignment_ids"
                                context="{'default_resource_id': id}">
                                <list editable="bottom">
                                    <field name="assignee_partner_id" />
                                    <field name="custody_role" />
                                    <field name="date_start" />
                                    <field name="date_end" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page name="lifecycle" string="Lifecycle">
                            <group>
                                <group name="purchase">
                                    <field name="date_acquisition" />
                                    <field name="vendor_id" />
                                    <field name="vendor_ref" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="value_original" />
                                    <field name="warranty_date" />
                                    <field name="date_disposal" />
                                </group>
                                <group>
                                    <field
                                        name="child_ids"
                                        widget="many2many_tags"
                                        readonly="1" />
                                </group>
                            </group>
                            <field name="description" placeholder="Notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="resource_asset_view_search" model="ir.ui.view">
        <field name="name">resource.resource.asset.search</field>
        <field name="model">resource.resource</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="name" />
                <field name="identifier_ids" string="Identifier" />
                <field name="kind_id" />
                <field name="holder_id" />
                <filter
                    name="available"
                    string="Available"
                    domain="[('state', '=', 'available')]" />
                <filter
                    name="in_service"
                    string="In Service"
                    domain="[('state', '=', 'in_service')]" />
                <filter
                    name="maintenance"
                    string="Under Maintenance"
                    domain="[('state', '=', 'maintenance')]" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <separator />
                <filter
                    name="held"
                    string="Held"
                    domain="[('holder_id', '!=', False)]" />
                <filter
                    name="unheld"
                    string="Unassigned"
                    domain="[('holder_id', '=', False)]" />
                <separator />
                <filter
                    name="top_level"
                    string="Whole Assets"
                    domain="[('parent_id', '=', False)]" />
                <filter
                    name="components"
                    string="Components"
                    domain="[('parent_id', '!=', False)]" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <separator />
                <filter
                    name="group_kind"
                    string="Kind"
                    context="{'group_by': 'kind_id'}" />
                <filter
                    name="group_state"
                    string="State"
                    context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>

    <record id="action_resource_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">resource.resource</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="resource_asset_view_search" />
        <field name="domain">[('kind_id', '!=', False)]</field>
        <field
            name="context">{'search_default_top_level': 1, 'default_type': 'material'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register an asset
            </p>
            <p>
                A vehicle, a machine, a tool, a phone, a parcel: one record with its identifiers, meters and custody, schedulable like any other resource.
            </p>
        </field>
        <field
            name="view_ids"
            eval="[                 Command.clear(),                 Command.create({'view_mode': 'kanban', 'view_id': ref('resource_asset_view_kanban')}),                 Command.create({'view_mode': 'list', 'view_id': ref('resource_asset_view_list')}),                 Command.create({'view_mode': 'form', 'view_id': ref('resource_asset_view_form')}),             ]" />
    </record>

</odoo>
