<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="bo_requisition" model="purchase.agreement">
            <field name="user_id" ref="base.user_admin" />
            <field name="partner_id" ref="base.res_partner_1" />
            <field name="agreement_type">blanket_order</field>
        </record>
        <record id="bo_requisition_line" model="purchase.agreement.line">
            <field name="agreement_id" ref="bo_requisition" />
            <field name="product_id" ref="product.product_product_13" />
            <field name="product_uom_id" ref="base.product_uom_unit" />
            <field name="product_qty">100</field>
            <field name="price_unit">60</field>
        </record>
        <function
            model="purchase.agreement"
            name="action_confirm"
            eval="[[ref('bo_requisition')]]" />
        <record id="rfq1" model="purchase.order">
            <field name="partner_id" ref="base.res_partner_1" />
            <field name="user_id" ref="base.user_admin" />
            <field name="agreement_id" ref="bo_requisition" />
        </record>
        <record id="rfq1_line" model="purchase.order.line">
            <field name="order_id" ref="rfq1" />
            <field
                name="name"
                eval="obj().env.ref('product.product_product_13').partner_ref"
                model="purchase.order.line" />
            <field name="date_commitment" eval="time.strftime('%Y-%m-10')" />
            <field name="product_id" ref="product.product_product_13" />
            <field name="product_uom_id" ref="base.product_uom_unit" />
            <field name="price_unit">60</field>
            <field name="product_qty">25</field>
        </record>
        <function model="purchase.order" name="action_confirm" eval="[[ref('rfq1')]]" />
        <record id="rfq2" model="purchase.order">
            <field name="partner_id" ref="base.res_partner_1" />
            <field name="user_id" ref="base.user_admin" />
            <field name="agreement_id" ref="bo_requisition" />
        </record>
        <record id="rfq2_line" model="purchase.order.line">
            <field name="order_id" ref="rfq2" />
            <field
                name="name"
                eval="obj().env.ref('product.product_product_13').partner_ref"
                model="purchase.order.line" />
            <field name="date_commitment" eval="time.strftime('%Y-%m-15')" />
            <field name="product_id" ref="product.product_product_13" />
            <field name="product_uom_id" ref="base.product_uom_unit" />
            <field name="price_unit">60</field>
            <field name="product_qty">10</field>
        </record>
    </data>

</odoo>
