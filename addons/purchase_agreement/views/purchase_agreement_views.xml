<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="action_purchase_agreement_to_so" model="ir.actions.act_window">
            <field name="name">Request for Quotation</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">form,list</field>
            <field name="domain">[('agreement_id','=',active_id)]</field>
            <field
                name="context">{
            "default_agreement_id":active_id,
            }</field>
        </record>
        <record id="action_purchase_agreement_list" model="ir.actions.act_window">
            <field name="name">Request for Quotations</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('agreement_id','=',active_id)]</field>
            <field
                name="context">{
            "default_agreement_id":active_id,
            }</field>
        </record>
        <record id="view_purchase_agreement_form" model="ir.ui.view">
            <field name="name">purchase.agreement.form</field>
            <field name="model">purchase.agreement</field>
            <field name="arch" type="xml">
                <form string="Purchase Agreements">
                <field name="company_id" invisible="1" />
                <field name="currency_id" invisible="1" />
                <field name="active" invisible="1" />
                <header>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <button
                        name="%(action_purchase_agreement_to_so)d"
                        type="action"
                        string="New Quotation"
                        context="{'default_currency_id': currency_id, 'default_user_id': user_id}"
                        invisible="state != 'confirmed'"
                        class="btn-primary" />
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        invisible="state != 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_done"
                        type="object"
                        string="Close"
                        invisible="state != 'confirmed'"
                        class="btn-primary" />
                    <button
                        name="action_renew"
                        type="object"
                        string="Renew"
                        invisible="state not in ('confirmed', 'done')" />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state != 'cancel'" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('draft', 'confirmed')" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(action_purchase_agreement_list)d"
                            type="action"
                            icon="fa-list-alt"
                            context="{'default_currency_id': currency_id}"
                            invisible="state == 'draft'"
                            class="oe_stat_button">
                            <field
                                name="order_count"
                                string="RFQs/Orders"
                                widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_inline" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="partner_id"
                                context="{'res_partner_search_mode': 'supplier'}"
                                readonly="state in ['confirmed', 'done'] and agreement_type == 'blanket_order'"
                                required="agreement_type == 'blanket_order'" />
                            <field
                                name="user_id"
                                string="Buyer"
                                domain="[('share', '=', False)]"
                                readonly="state != 'draft'" />
                            <field
                                name="agreement_type"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" />
                            <field
                                name="currency_id"
                                groups="base.group_multi_currency" />
                            <field name="commitment" readonly="state != 'draft'" />
                            <field
                                name="amount_committed"
                                invisible="commitment != 'value'"
                                readonly="state != 'draft'"
                                required="commitment == 'value'" />
                            <field name="overrelease_policy" />
                            <field
                                name="consumed_percent"
                                widget="progressbar"
                                invisible="commitment == 'price' or state == 'draft'" />
                            <field
                                name="amount_remaining"
                                invisible="commitment != 'value' or state == 'draft'" />
                        </group>
                        <group>
                            <label for="date_start" string="Agreement Validity" />
                            <div class="o_row">
                                <span><strong>From</strong></span>
                                <field
                                    name="date_start"
                                    widget="date"
                                    readonly="state not in ('draft', 'confirmed')" />
                                <span><strong>to</strong></span>
                                <field
                                    name="date_end"
                                    widget="date"
                                    readonly="state not in ('draft', 'confirmed')" />
                            </div>
                            <field name="reference" placeholder="e.g. PO0025" />
                            <field
                                name="previous_agreement_id"
                                invisible="not previous_agreement_id" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page name="products" string="Products">
                            <field name="line_ids" readonly="state == 'done'">
                                <list string="Products" editable="bottom">
                                    <field
                                        name="product_id"
                                        domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" />
                                    <field
                                        name="product_category_id"
                                        optional="show"
                                        required="not product_id" />
                                    <field
                                        name="product_description_variants"
                                        invisible="product_description_variants == ''" />
                                    <field name="product_qty" />
                                    <field name="qty_ordered" optional="show" />
                                    <field
                                        name="qty_remaining"
                                        optional="show"
                                        column_invisible="parent.commitment != 'quantity'" />
                                    <field name="amount_ordered" optional="hide" />
                                    <field
                                        name="product_uom_id"
                                        widget="many2one_uom"
                                        optional="show"
                                        groups="base.group_uom"
                                        required="product_id" />
                                    <field
                                        name="analytic_distribution"
                                        widget="analytic_distribution"
                                        optional="hide"
                                        options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"
                                        groups="analytic.group_analytic_accounting" />
                                    <field
                                        name="price_unit"
                                        invisible="not product_id" />
                                    <field
                                        name="discount"
                                        optional="show"
                                        invisible="product_id" />
                                </list>
                                <form string="Products">
                                    <group>
                                        <field
                                            name="product_id"
                                            domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" />
                                        <field name="product_qty" />
                                        <field name="qty_ordered" />
                                        <field
                                            name="product_uom_id"
                                            widget="many2one_uom"
                                            groups="base.group_uom" />
                                        <field
                                            name="analytic_distribution"
                                            widget="analytic_distribution"
                                            options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"
                                            groups="analytic.group_analytic_accounting" />
                                        <field
                                            name="company_id"
                                            options="{'no_create': True}"
                                            groups="base.group_multi_company" />
                                    </group>
                                </form>
                            </field>
                            <separator string="Terms and Conditions" />
                            <field name="description" class="oe-bordered-editor" />
                        </page>
                        <page name="breaks" string="Quantity Breaks">
                            <field name="break_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="agreement_id" column_invisible="1" />
                                    <field
                                        name="line_id"
                                        options="{'no_create': True}" />
                                    <field name="min_qty" />
                                    <field
                                        name="product_uom_id"
                                        groups="base.group_uom" />
                                    <field name="price_unit" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
                </form>
            </field>
        </record>
        <record id="view_purchase_agreement_tree" model="ir.ui.view">
            <field name="name">purchase.agreement.list</field>
            <field name="model">purchase.agreement</field>
            <field name="arch" type="xml">
                <list string="Purchase Agreements" sample="1">
                    <field name="message_needaction" column_invisible="True" />
                    <field name="name" decoration-bf="1" />
                    <field name="partner_id" optional="show" />
                    <field name="agreement_type" optional="show" />
                    <field
                        name="user_id"
                        widget="many2one_avatar_user"
                        optional="show" />
                    <field
                        name="company_id"
                        optional="show"
                        options="{'no_create': True}"
                        groups="base.group_multi_company" />
                    <field name="date_start" optional="show" />
                    <field
                        name="date_end"
                        widget="remaining_days"
                        optional="show"
                        invisible="state in ('done', 'cancel')"
                        decoration-danger="date_end and date_end&lt;current_date" />
                    <field name="reference" optional="show" />
                    <field name="commitment" optional="hide" />
                    <field
                        name="consumed_percent"
                        widget="progressbar"
                        optional="show" />
                    <field
                        name="state"
                        widget="badge"
                        optional="show"
                        decoration-info="state not in ('done', 'cancel')"
                        decoration-success="state == 'done'" />
                    <field
                        name="activity_exception_decoration"
                        widget="activity_exception" />
                </list>
            </field>
        </record>
        <record id="view_purchase_agreement_kanban" model="ir.ui.view">
            <field name="name">purchase.agreement.kanban</field>
            <field name="model">purchase.agreement</field>
            <field name="arch" type="xml">
                <kanban sample="1" class="o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="d-flex mb-1">
                                <field name="name" class="fw-bolder fs-5" />
                                <field
                                    name="state"
                                    widget="label_selection"
                                    options="{'classes': {'draft': 'default', 'done': 'success', 'close': 'danger'}}"
                                    readonly="1"
                                    class="ms-auto" />
                            </div>
                            <field name="agreement_type" class="text-muted" />
                            <footer>
                                <field name="partner_id" />
                                <field
                                    name="user_id"
                                    widget="many2one_avatar_user"
                                    class="ms-auto" />
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_purchase_agreement_filter" model="ir.ui.view">
            <field name="name">purchase.agreement.list.select</field>
            <field name="model">purchase.agreement</field>
            <field name="arch" type="xml">
                <search string="Search Purchase Agreements">
                    <field name="partner_id" />
                    <field
                        name="name"
                        string="Reference"
                        filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]" />
                    <field name="user_id" />
                    <field name="product_id" />
                    <filter
                        name="my_agreements"
                        string="My Agreements"
                        domain="[('user_id', '=', uid)]" />
                    <separator />
                    <filter
                        name="blanket_order"
                        string="Blanket Orders"
                        domain="[('agreement_type', '=', 'blanket_order')]" />
                    <separator />
                    <filter
                        name="expiring"
                        string="Expiring in 30 Days"
                        domain="[('state', '=', 'confirmed'), ('date_end', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]" />
                    <filter
                        name="nearly_consumed"
                        string="90% Consumed"
                        domain="[('state', '=', 'confirmed'), ('consumed_percent', '&gt;=', 90)]" />
                    <separator />
                    <filter
                        name="draft"
                        string="Draft"
                        help="New Agreements"
                        domain="[('state', '=', 'draft')]" />
                    <filter
                        name="done"
                        string="Done"
                        domain="[('state', '=', 'done')]" />
                    <filter
                        name="inactive"
                        string="Archived"
                        domain="[('active','=',False)]" />
                    <separator />
                    <filter
                        name="filter_activities_my"
                        string="My Activities"
                        domain="[('activity_user_id', '=', uid)]"
                        invisible="1" />
                    <separator invisible="1" />
                    <filter
                        name="activities_overdue"
                        string="Late Activities"
                        help="Show all records whose next activity date is past"
                        domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                        invisible="1" />
                    <filter
                        name="activities_today"
                        string="Today Activities"
                        domain="[('my_activity_date_deadline', '=', 'today')]"
                        invisible="1" />
                    <filter
                        name="activities_upcoming_all"
                        string="Future Activities"
                        domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                        invisible="1" />
                    <group>
                        <filter
                            name="representative"
                            string="Purchase Representative"
                            context="{'group_by': 'user_id'}" />
                        <filter
                            name="status"
                            string="Status"
                            context="{'group_by': 'state'}" />
                        <filter
                            name="date_start"
                            string="Ordering Date"
                            context="{'group_by': 'date_start'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="action_purchase_agreement" model="ir.actions.act_window">
            <field name="name">Purchase Agreements</field>
            <field name="res_model">purchase.agreement</field>
            <field name="path">purchase-agreements</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_purchase_agreement_filter" />
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Start a new purchase agreement
                </p><p>
                    An example of a purchase agreement is a blanket order.
                </p><p>
                    For a blanket order, you can record an agreement for a specific period
                    (e.g. a year) and you order products within this agreement to benefit
                    from the negotiated prices.
                </p>
            </field>
        </record>
    </data>

</odoo>
