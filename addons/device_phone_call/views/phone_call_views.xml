<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="phone_call_view_list" model="ir.ui.view">
        <field name="name">phone.call.view.list.device</field>
        <field name="model">phone.call</field>
        <field name="inherit_id" ref="phone_call.phone_call_view_list" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="device_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="phone_call_view_search" model="ir.ui.view">
        <field name="name">phone.call.view.search.device</field>
        <field name="model">phone.call</field>
        <field name="inherit_id" ref="phone_call.phone_call_view_search" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="device_id" />
            </field>
            <filter name="missed" position="after">
                <filter
                    name="awaits_call_log"
                    string="Awaiting call log"
                    domain="[('awaits_call_log', '=', True)]" />
            </filter>
            <filter name="groupby_user" position="after">
                <filter
                    name="groupby_device"
                    string="Device"
                    context="{'group_by': 'device_id'}" />
            </filter>
        </field>
    </record>

    <record id="phone_call_view_form" model="ir.ui.view">
        <field name="name">phone.call.view.form.device</field>
        <field name="model">phone.call</field>
        <field name="inherit_id" ref="phone_call.phone_call_view_form" />
        <field name="arch" type="xml">
            <field name="channel" position="after">
                <field name="device_id" invisible="not device_id" readonly="True" />
                <field name="awaits_call_log" invisible="not awaits_call_log" />
            </field>
        </field>
    </record>

    <record id="phone_call_action_device" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">phone.call</field>
        <field name="view_mode">list,calendar,graph,pivot,form</field>
        <field name="domain">[("device_id", "!=", False)]</field>
        <field name="context">{"search_default_groupby_device": 1}</field>
    </record>

</odoo>
