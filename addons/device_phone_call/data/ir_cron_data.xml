<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_complete_awaiting_calls" model="ir.cron">
        <field
            name="name">Phone calls: give a waiting recording to the call it belongs to</field>
        <field name="model_id" ref="phone_call.model_phone_call" />
        <field name="state">code</field>
        <field name="code">model._cron_complete_awaiting_calls()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">hour</field>
        <field name="active" eval="True" />
    </record>

</odoo>
