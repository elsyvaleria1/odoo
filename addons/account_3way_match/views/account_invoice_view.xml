<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- The move types below are the literal form of
                AccountMove._release_to_pay_move_types(): a view's `invisible`
                cannot call a model method, so the set is written out here.
                Keep the two in step. -->
            <xpath
                expr="//page[@id='other_tab']//field[@name='fiscal_position_id']"
                position="after">
                <label
                    for="release_to_pay_manual"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')" />
                <div
                    class="o_row"
                    col="4"
                    invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')">
                    <field name="release_to_pay" force_save="1" invisible="True" />
                    <field name="release_to_pay_manual" />
                    <label
                        for="force_release_to_pay"
                        invisible="not force_release_to_pay"
                        class="fw-bold" />
                    <field
                        name="force_release_to_pay"
                        invisible="not force_release_to_pay" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="account_invoice_filter_inherit_account_3way_match" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit.account_3way_match</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator />
                <!-- The payment_state term is not decoration: it is the
                    third leg of _get_draft_sales_purchases_query, which the
                    "To Validate" tile counts. Without it the tile and the
                    list it opens disagreed - a draft bill whose payment was
                    blocked (action_toggle_block_payment works on a draft)
                    was listed but not counted. -->
                <filter
                    name="bills_to_validate"
                    string="Bills to Validate"
                    domain="['&amp;', '&amp;', ('state', '=', 'draft'), ('payment_state', 'in', ('not_paid', 'partial')), '|', ('release_to_pay', '=', 'yes'), ('invoice_date_due', '&lt;', 'today')]" />
                <!-- The move types below are the literal form of
                    AccountMove._release_to_pay_move_types() minus its refund
                    types, i.e. the set _get_to_pay_select() gates on. A view
                    domain cannot call a model method, so the set is written
                    out; keep the two in step. The exemption has to be
                    repeated here because this filter is what the dashboard's
                    "Bills to Pay" tile opens, and without it the tile counted
                    credit notes that the list then refused to show. -->
                <filter
                    name="bills_to_pay"
                    string="Bills to Pay"
                    domain="['&amp;', '&amp;', ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), '|', ('move_type', 'not in', ('in_invoice', 'in_receipt')), ('release_to_pay','in', ('yes', 'exception'))]" />
                <filter
                    name="exception"
                    string="Bills in Exception"
                    domain="[('release_to_pay','=', 'exception')]" />
                <separator />
            </xpath>
        </field>
    </record>

    <!--
        The two actions below are redefined so the vendor-bill views use
        account_invoice_filter_inherit_account_3way_match, which carries the
        release-to-pay filters. Sales invoices share account.move but those
        filters make no sense there, hence a primary search view instead of an
        inherited one.
    -->
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field
            name="search_view_id"
            ref="account_invoice_filter_inherit_account_3way_match" />
    </record>

    <record id="account.action_move_in_refund_type" model="ir.actions.act_window">
        <field
            name="search_view_id"
            ref="account_invoice_filter_inherit_account_3way_match" />
    </record>

</odoo>
