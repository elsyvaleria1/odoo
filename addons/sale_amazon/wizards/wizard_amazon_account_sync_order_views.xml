<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="recover_order_wizard_form" model="ir.ui.view">
        <field name="name">Recover Order Wizard Form</field>
        <field name="model">wizard.amazon.account.sync.order</field>
        <field name="arch" type="xml">
            <form string="Recover Order">
                <group>
                    <field name="amazon_order_ref" />
                </group>
                <footer>
                    <button
                        name="action_recover_order"
                        type="object"
                        string="Recover"
                        class="btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
