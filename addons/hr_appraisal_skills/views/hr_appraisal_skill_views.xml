<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_appraisal_skills_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.skill.view.form</field>
        <field name="model">hr.appraisal.skill</field>
        <field name="arch" type="xml">
            <form string="Skills">
                <sheet>
                    <group>
                        <field
                            name="skill_type_id"
                            string="Category"
                            widget="selection_badge" />
                        <field
                            name="skill_id"
                            widget="selection_badge"
                            domain="[('skill_type_id', '=', skill_type_id)]"
                            context="{'default_skill_type_id': skill_type_id}"
                            invisible="not skill_type_id" />
                        <field
                            name="skill_level_id"
                            widget="selection_badge"
                            context="{'default_skill_type_id': skill_type_id}"
                            options="{'no_open': True, 'no_create': True}"
                            invisible="levels_count &lt;= 1"
                            readonly="not skill_id" />
                        <label
                            for="valid_from"
                            string="Validity"
                            invisible="not is_certification"
                            class="me-1" />
                        <div class="d-flex flex-row" invisible="not is_certification">
                            <field
                                name="valid_from"
                                required="is_certification"
                                class="w-25" />
                            <label for="valid_to" string="To" class="mx-1" />
                            <field
                                name="valid_to"
                                placeholder="indefinite"
                                class="w-25" />
                        </div>
                    </group>
                    <div
                        class="alert alert-warning ps-3"
                        role="alert"
                        invisible="not display_warning_message">
                        The end date must be after the start date.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
