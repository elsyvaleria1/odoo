msgstr "Registrar tu entrada"

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "Record your departure"
msgstr "Registrar tu salida"

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
