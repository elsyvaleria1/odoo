msgstr "Ocurrió un error. Por favor, intenta de nuevo con /entrada"

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "Start your lunch break"
msgstr "Salir a comer"

#. module: hr_attendance_telegram
#: model:ir.model,name:hr_attendance_telegram.model_telegram_binding
