#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
#, python-format
msgid "\n"
"\n"
"%(count)s active work orders were paused automatically."
msgstr "\n"
"\n"
"Se han pausado automáticamente %(count)s órdenes de trabajo activas."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/hr_attendance.py:0
msgid "\"Lunch In\" time cannot be earlier than \"Lunch Out\" time."
msgstr "La hora de \"Regreso de comida\" no puede ser anterior a la de \"Salida a comer\"."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/hr_attendance.py:0
msgid "\"Lunch In\" time cannot be later than \"Check Out\" time."
msgstr "La hora de \"Regreso de comida\" no puede ser posterior a la de \"Salida\"."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/hr_attendance.py:0
msgid "\"Lunch Out\" time cannot be earlier than \"Check In\" time."
msgstr "La hora de \"Salida a comer\" no puede ser anterior a la de \"Entrada\"."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/hr_attendance.py:0
msgid "\"Lunch Out\" time cannot be later than \"Check Out\" time."
msgstr "La hora de \"Salida a comer\" no puede ser posterior a la de \"Salida\"."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "/comida [HH:MM] - Record the start of your lunch. The time is optional."
msgstr "/comida [HH:MM] - Registra el inicio de tu comida. Opcionalmente puedes especificar la hora."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "/entrada [HH:MM] - Record your arrival. The time is optional."
msgstr "/entrada [HH:MM] - Registra tu llegada. Opcionalmente puedes especificar la hora."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "/regresocomida [HH:MM] - Record your return from lunch. The time is optional."
msgstr "/regresocomida [HH:MM] - Registra tu regreso de la comida. Opcionalmente puedes especificar la hora."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
msgid "/salida [HH:MM] - Record your departure. The time is optional."
msgstr "/salida [HH:MM] - Registra tu salida. Opcionalmente puedes especificar la hora."

#. module: hr_attendance_telegram
