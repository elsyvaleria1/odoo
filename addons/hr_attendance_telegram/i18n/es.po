#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/hr_attendance.py:0
msgid "Cannot have a \"Lunch In\" time without a \"Lunch Out\" time."
msgstr "No puede haber una hora de \"Regreso de comida\" sin una de \"Salida a comer\"."

#. module: hr_attendance_telegram
#. odoo-python
#: code:addons/hr_attendance_telegram/models/telegram_handler.py:0
