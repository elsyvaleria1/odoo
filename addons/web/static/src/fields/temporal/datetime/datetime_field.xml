<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.DateTimeField">
        <t t-set="showSeparator" t-value="this.shouldShowSeparator()" />
        <div class="d-flex gap-2 align-items-center" t-ref="this.rootRef">
            <t t-if="this.props.readonly">
                <span t-if="!this.isEmpty(this.startDateField)" class="text-truncate" t-out="this.getFormattedValue(0)" t-att-data-tooltip="this.getFormattedValue(0, true)"/>
            </t>
            <t t-elif="this.props.required or this.props.alwaysRange or !this.isEmpty(this.startDateField) or this.startDateField === this.props.name">
                <t t-if="this.picker.activeInput !== this.startDateField and this.values[0]">
                    <button
                        t-ref="this.startDateRef"
                        t-att-data-tooltip="this.getFormattedValue(0, true)"
                        t-att-id="showSeparator ? this.props.endDateField and this.props.id : this.props.id"
                        t-on-focus="this.onDateButtonFocus"
                        t-on-click="this.onDateButtonClick"
                        t-att-data-field="this.startDateField"
                        t-att-class="'o_input o_daterange_start w-100 text-start ' + (this.props.warnFuture and this.isDateInTheFuture(0) ? 'text-danger' : '')">
                        <t t-out="this.getFormattedValue(0)" />
                    </button>
                </t>
                <t t-else="">
                    <input
                        t-ref="this.startDateRef"
                        type="text"
                        t-att-id="showSeparator ? this.props.endDateField and this.props.id : this.props.id"
                        t-att-class="'o_input cursor-pointer ' + (this.props.warnFuture and this.isDateInTheFuture(0) ? 'text-danger' : '')"
                        autocomplete="off"
                        t-att-placeholder="this.getPlaceholder(this.startDateField)"
                        t-att-data-field="this.startDateField"
                        t-on-input="this.onInput"
                        t-on-focus="() => this.picker.activeInput = this.startDateField"
                        t-att-title="this.props.warnFuture and this.isDateInTheFuture(0) ? this.futureWarningMsg : ''"
                    />
                </t>
            </t>

            <t t-if="showSeparator">
                <i class="fa-solid fa-arrow-right-long" aria-label="Arrow icon" title="Arrow" />
            </t>

            <t t-if="this.endDateField">
                <t t-if="this.props.readonly">
                    <span class="text-truncate" t-out="this.getFormattedValue(1)" t-att-data-tooltip="this.getFormattedValue(1, true)"/>
                </t>
                <t t-elif="this.props.required or this.props.alwaysRange or !this.isEmpty(this.endDateField) or (this.isEmpty(this.startDateField) and this.endDateField === this.props.name)">
                    <t t-if="this.picker.activeInput !== this.endDateField and this.values[1]">
                        <button
                            t-ref="this.endDateRef"
                            t-att-data-tooltip="this.getFormattedValue(1, true)"
                            t-on-focus="this.onDateButtonFocus"
                            t-on-click="this.onDateButtonClick"
                            t-att-id="this.props.startDateField and this.props.id"
                            t-att-data-field="this.endDateField"
                            t-att-class="'o_input o_daterange_end w-100 text-start ' + (this.props.warnFuture and this.isDateInTheFuture(1) ? 'text-danger' : '')">
                            <t t-out="this.getFormattedValue(1)" />
                        </button>
                    </t>
                    <t t-else="">
                        <input
                            t-ref="this.endDateRef"
                            type="text"
                            t-att-id="this.props.startDateField and this.props.id"
                            t-att-class="'o_input cursor-pointer ' + (this.props.warnFuture and this.isDateInTheFuture(1) ? 'text-danger' : '')"
                            autocomplete="off"
                            t-att-placeholder="this.getPlaceholder(this.endDateField)"
                            t-att-data-field="this.endDateField"
                            t-on-input="this.onInput"
                            t-on-focus="() => this.picker.activeInput = this.endDateField"
                            t-att-title="this.props.warnFuture and this.isDateInTheFuture(1) ? this.futureWarningMsg : ''"
                        />
                    </t>
                </t>
            </t>
            <span
                t-if="this.duration"
                class="o_daterange_duration badge rounded-pill text-bg-light fw-normal text-nowrap flex-shrink-0"
                t-att-data-tooltip="this.duration.long"
                t-out="this.duration.short"
            />
        </div>
    </t>
</templates>
