<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.Layout">
        <Portal t-if="this.dialogContext.inDialog" target="'#' + this.dialogContext.dialogId + ' .modal-footer'">
            <t t-call-slot="layout-buttons"/>
        </Portal>
        <t t-component="this.components.ControlPanel" slots="this.controlPanelSlots" t-if="this.props.display.controlPanel" display="this.props.display.controlPanel"/>
        <main t-ref="this.contentRef" class="o_content" t-attf-class="{{this.props.className}}" t-att-class="{ 'o_component_with_search_panel': this.props.display.searchPanel, 'o_chrome_overlay': this.chromeOverlay }" t-att-style="this.contentStyle">
            <t t-component="this.components.SearchPanel" t-if="this.props.display.searchPanel"/>
            <t t-call-slot="default" contentRef="this.contentRef" />
        </main>
    </t>

</templates>
