<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.OverlayContainer">
        <div class="o-overlay-container" t-ref="this.root">
            <t t-foreach="this.sortedOverlays" t-as="overlay" t-key="overlay.id">
                <ErrorHandler onError="(error) => this.handleError(overlay, error)">
                    <OverlayItem pluginManager="overlay.pluginManager" component="overlay.component" props="overlay.props" sequence="overlay.sequence" id="overlay.id"/>
                </ErrorHandler>
            </t>
        </div>
    </t>

    <t t-name="web.OverlayContainer.Item">
        <div t-ref="this.rootRef" class="o-overlay-item">
            <t t-component="this.props.component" t-props="this.props.props" />
        </div>
    </t>

</templates>
