<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="proof.PasswordProof">
        <form class="o_proof_password" t-on-submit="this.onSubmit">
            <label class="form-label" for="o_proof_password_input">Your password</label>
            <div class="input-group">
                <input id="o_proof_password_input" type="password" class="form-control"
                    autocomplete="current-password" t-ref="this.inputRef" t-att-value="this.state.password" t-on-input="this.onInput"
                    t-att-disabled="this.props.busy"/>
                <button type="submit" class="btn btn-primary" t-att-disabled="this.props.busy or !this.state.password">Confirm</button>
            </div>
        </form>
    </t>

</templates>
