<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_inbox_view_list" model="ir.ui.view">
        <field name="name">mail.inbox.list</field>
        <field name="model">mail.inbox</field>
        <field name="arch" type="xml">
            <list string="Inboxes">
                <field name="name" />
                <field name="alias_name" />
                <field name="alias_domain_id" />
                <field name="kind" />
                <field name="user_ids" widget="many2many_avatar_user" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="mail_inbox_view_form" model="ir.ui.view">
        <field name="name">mail.inbox.form</field>
        <field name="model">mail.inbox</field>
        <field name="arch" type="xml">
            <form string="Inbox">
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Billing" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="alias_name" string="Address" />
                            <div class="d-flex">
                                <field name="alias_name" required="1" />
                                <span>@</span>
                                <field
                                    name="alias_domain_id"
                                    options="{'no_create': True}"
                                    required="1" />
                            </div>
                            <field name="kind" widget="radio" />
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_avatar_user" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mail_inbox_action" model="ir.actions.act_window">
        <field name="name">Inboxes</field>
        <field name="res_model">mail.inbox</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
