<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_tool_model_access_view_list" model="ir.ui.view">
        <field name="name">ai.tool.model.access.view.list</field>
        <field name="model">ai.tool.model.access</field>
        <field name="arch" type="xml">
            <list string="AI Tool Model Access" editable="bottom">
                <field name="model_id" />
                <field name="allow_create" />
                <field name="allow_write" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="ai_tool_model_access_action" model="ir.actions.act_window">
        <field name="name">AI Tool Model Access</field>
        <field name="res_model">ai.tool.model.access</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
