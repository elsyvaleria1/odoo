<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MRP.WORKORDER SIMPLIFIED VIEW -->
    <record
        id="mrp_production_workorder_tree_editable_view_inherit_quality"
        model="ir.ui.view">
        <field
            name="name">mrp.production.work.order.list.editable.inherit.quality</field>
        <field name="model">mrp.workorder</field>
        <field
            name="inherit_id"
            ref="mrp.mrp_production_workorder_tree_editable_view" />
        <field name="arch" type="xml">
            <xpath expr="//list/button[@name='button_start']" position="before">
                <field name="quality_state" column_invisible="1" />
                <field name="test_type" column_invisible="1" />
            </xpath>
            <xpath expr="//button[@name='button_finish']" position="attributes">
                <attribute name="invisible">(
                    production_state in ('draft', 'done')
                    or working_state == 'blocked'
                    or not is_user_working
                    or (quality_state == 'none' and test_type not in ['register_consumed_materials', 'register_byproducts', 'instructions'])
                )</attribute>
            </xpath>
            <xpath expr="//button[@name='button_finish']" position="after">
                <button
                    name="button_finish"
                    type="object"
                    title="Done"
                    icon="fa-check"
                    groups="mrp.group_mrp_user"
                    invisible="(                         production_state in ('draft', 'done')                         or working_state == 'blocked'                         or not is_user_working                         or quality_state != 'none'                         or test_type in ['register_consumed_materials', 'register_byproducts', 'instructions']                     )"
                    class="btn-success px-3" />
            </xpath>
        </field>
    </record>

</odoo>
