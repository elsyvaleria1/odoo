<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MRP.WORKCENTER -->
    <record id="mrp_workcenter_view_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.maintenance</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    name="equipment"
                    string="Tools and Components"
                    invisible="not asset_id">
                    <field
                        name="asset_component_ids"
                        context="{'default_parent_id': asset_id, 'default_company_id': company_id}">
                        <list string="Tools and Components">
                            <field name="name" />
                            <field name="kind_id" />
                            <field name="technician_user_id" />
                            <field name="mtbf" />
                            <field name="mttr" />
                            <field
                                name="date_next_failure"
                                string="Est. Next Failure" />
                        </list>
                    </field>
                </page>
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_view_maintenance"
                    type="object"
                    icon="fa-wrench"
                    class="oe_stat_button">
                    <field
                        name="maintenance_open_count"
                        string="Maintenance"
                        widget="statinfo" />
                </button>
            </div>
            <xpath expr="//notebook" position="inside">
                <page name="maintenance" string="Maintenance">
                    <group>
                        <group name="maintenance">
                            <field name="date_in_service" />
                            <field
                                name="maintenance_team_id"
                                context="{'default_company_id':company_id}" />
                            <field
                                name="technician_user_id"
                                domain="[('share', '=', False)]" />
                        </group>
                        <group name="statistics">
                            <label
                                for="expected_mtbf"
                                string="Expected Mean Time Between Failure" />
                            <div class="o_row">
                                <field name="expected_mtbf" /> days
                            </div>
                            <label for="mtbf" string="Mean Time Between Failure" />
                            <div class="o_row">
                                <field name="mtbf" /> days
                            </div>
                            <label
                                for="date_next_failure"
                                string="Estimated Next Failure" />
                            <div class="o_row">
                                <field name="date_next_failure" />
                            </div>
                            <field name="date_last_failure" string="Latest Failure" />
                            <label for="mttr" string="Mean Time To Repair" />
                            <div class="o_row">
                                <field name="mttr" /> days
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_workcenter_view_kanban_inherit_maintenance" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.kanban.inherit.maintenance</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='plan_order']" position="after">
                <div>
                    <a name="%(maintenance.maintenance_order_action)d" type="action">Maintenance</a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- MRP.PRODUCTION -->
    <record id="mrp_production_view_form_inherit_maintenance" model="ir.ui.view">
        <field name="name">mrp.production.view.form.inherit.maintenance</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="open_maintenance_order_mo"
                    type="object"
                    icon="fa-wrench"
                    context="{'search_default_production_id': id}"
                    invisible="maintenance_count == 0"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="maintenance_count" /></span>
                        <span class="o_stat_text">Maintenance</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="action_production_maintenance_order" model="ir.actions.server">
        <field name="name">Maintenance Order</field>
        <field name="model_id" ref="mrp.model_mrp_production" />
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field
            name="code">if records:
                action = records.button_maintenance_req()</field>
    </record>

</odoo>
