<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">resource.asset.form.fleet.fiscal.categories</field>
        <field name="model">resource.asset.vehicle</field>
        <field name="inherit_id" ref="resource_asset_vehicle.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <page name="model" position="after">
                <page name="fiscality" string="Fiscality">
                    <group name="fiscality_first_group" />
                    <div name="disallowed_expense_rate_history">
                        <label for="rate_ids">Deductibility Rates</label>
                        <field name="rate_ids" colspan="2" nolabel="1">
                            <list editable="bottom">
                                <field name="date_from" />
                                <field name="rate" />
                            </list>
                        </field>
                    </div>
                </page>
            </page>
        </field>
    </record>

</odoo>
