<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="cta_wrapper_whatsapp"
        inherit_id="website_sale.cta_wrapper"
        priority="20">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute
                name="t-attf-class"
                add="#{'d-none' if product.website_quote_only else ''}"
                separator=" " />
        </xpath>

        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <t t-if="product.website_quote_only">
                <t t-set="wa_url" t-value="product._get_whatsapp_quote_url(website)" />
                <a
                    id="whatsapp_quote_btn"
                    role="button"
                    t-att-href="wa_url or '#'"
                    target="_blank"
                    rel="noopener noreferrer"
                    t-attf-class="btn btn-success flex-grow-1 #{'' if wa_url else 'disabled'}">
                    <i class="fa-brands fa-whatsapp me-2" />
                    Cotizar por WhatsApp
                </a>
            </t>
        </xpath>
    </template>

    <template
        id="hide_terms_for_quote"
        inherit_id="website_sale.product_terms_and_conditions">
        <xpath expr="//small" position="attributes">
            <attribute name="t-if">not product.website_quote_only</attribute>
        </xpath>
    </template>

    <template id="quote_only_pdp" inherit_id="website_sale.product" priority="20">
        <xpath
            expr="//div[@id='wrap'][hasclass('o_wsale_product_page')]"
            position="attributes">
            <attribute name="t-attf-class">js_sale o_wsale_product_page#{' m-quote-only ecom-zoomable' if product.website_quote_only else ''}</attribute>
            <attribute name="t-att-data-ecom-zoom-click">product.website_quote_only and '1' or False</attribute>
        </xpath>
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]" position="attributes">
            <attribute name="t-if">not product.website_quote_only</attribute>
        </xpath>
        <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]" position="before">
            <a
                t-if="product.website_quote_only"
                href="/vehiculos"
                class="m-vehicle-back">
                <i class="fa fa-arrow-left me-2" role="img" />Volver a Vehículos
            </a>
        </xpath>
    </template>

</odoo>
