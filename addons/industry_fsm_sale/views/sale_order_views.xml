<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_project" model="ir.ui.view">
        <field name="name">sale.order.form.sale.project</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']//list" position="inside">
                <field name="task_id" string="Related Task" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
