<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="industry_fsm_sale_product_catalog_kanban_view" model="ir.ui.view">
        <field name="name">industry_fsm.product.catalog.kanban.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_product_kanban_catalog" />
        <field name="mode">primary</field>
        <!-- make sure it's bigger than existing catalog view -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="js_class">fsm_product_kanban</attribute>
            </kanban>
        </field>
    </record>

    <!-- Material kanban -->
    <record
        id="industry_fsm_sale_product_catalog_inherit_search_view"
        model="ir.ui.view">
        <field name="name">industry.fsm.sale.product.catalog.inherit.search.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_product_search_catalog" />
        <field name="mode">primary</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='favorites']" position="before">
                <filter
                    name="fsm_quantity"
                    string="Added Products"
                    domain="[('fsm_quantity', '&gt;', 0)]" />
                <separator />
            </xpath>
            <xpath
                expr="//filter[@name='products_in_sale_order']"
                position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
