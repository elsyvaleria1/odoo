<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="batch_error_wizard_form" model="ir.ui.view">
            <field name="name">account.batch.error.wizard.form</field>
            <field name="model">wizard.account.batch.payment.validate.error</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div invisible="not error_line_ids">
                            <div role="alert" class="alert alert-danger">
                                The batch could not be validated
                            </div>

                            <strong>The following errors occurred</strong>

                            <field name="error_line_ids" />

                            <strong invisible="not warning_line_ids">The following warnings were also raised; they do not impeach validation</strong>
                        </div>

                        <div invisible="error_line_ids">
                            <div role="alert" class="alert alert-success">
                                The batch cannot be validated.
                            </div>

                            <strong>Please first consider the following warnings</strong>
                        </div>

                        <field
                            name="warning_line_ids"
                            invisible="not warning_line_ids" />
                    </sheet>
                    <footer>
                        <button
                            special="cancel"
                            string="Close"
                            class="btn-secondary"
                            data-hotkey="x" />
                        <button
                            name="proceed_with_validation"
                            type="object"
                            string="Proceed with validation"
                            invisible="error_line_ids"
                            class="btn btn-primary"
                            data-hotkey="q" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="batch_error_wizard_line_tree" model="ir.ui.view">
            <field name="name">account.batch.error.wizard.line.list</field>
            <field name="model">wizard.account.batch.payment.validate.error.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="0" delete="0">
                    <field name="show_remove_button" column_invisible="True" />
                    <field name="description" readonly="1" />
                    <field name="help_message" readonly="1" />
                    <button
                        name="open_payments"
                        type="object"
                        string="Show"
                        class="btn-link" />
                    <button
                        name="remove_payments_from_batch"
                        type="object"
                        string="Exclude Payments"
                        invisible="not show_remove_button"
                        class="oe_highlight" />
                </list>
            </field>
        </record>
    </data>

</odoo>
