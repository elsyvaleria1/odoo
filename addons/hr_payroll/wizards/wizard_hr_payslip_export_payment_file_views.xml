<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payroll_payment_report_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.payment.report.wizard.form</field>
        <field name="model">wizard.hr.payslip.export.payment.file</field>
        <field name="arch" type="xml">
            <form string="Payment Report">
                <group id="payment_report_group">
                    <field name="export_format" />
                    <field name="date_effective" />
                    <field name="include_partners" />
                </group>
                <footer>
                    <button
                        name="generate_payment_report"
                        type="object"
                        string="Generate"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
