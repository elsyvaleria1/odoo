<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="mail_template_new_payslip" model="mail.template">
            <field name="name">Payroll: New Payslip</field>
            <field
                name="description">Sent to employee to notify them about their new payslip</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip" />
            <field
                name="subject">{{ object.employee_id.name }}, a new payslip is available for you</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.employee_id.partner_id.id }}</field>
            <field name="use_default_to" eval="False" />
            <field name="lang">{{ object.employee_id.lang }}</field>
            <field name="auto_delete" eval="True" />
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0px auto;"><tbody>
                    <tr><td valign="top" style="text-align: left; font-size: 14px;">
                        Dear <t t-out="object.employee_id.name" />, a new payslip is available for you.<br /><br />
                        Please find the PDF in your employee portal.<br /><br />
                        Have a nice day,<br />
                        The HR Team
                    </td></tr>
                </tbody></table>
            </field>
        </record>
    </data>

</odoo>
