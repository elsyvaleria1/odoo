<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!--
            Deliberately company_id=False (global): next_by_code() only ever
            matches ('company_id', 'in', [current_company_id, False]), so a
            per-company sequence would leave any company without its own
            record unable to number payslips at all. Sharing one global
            counter guarantees every company always has a working sequence,
            at the cost of non-contiguous per-company numbering.
        -->
        <record id="seq_salary_slip" model="ir.sequence">
            <field name="name">Salary Slip</field>
            <field name="code">salary.slip</field>
            <field name="prefix">SLIP/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False" />
        </record>
    </data>

</odoo>
