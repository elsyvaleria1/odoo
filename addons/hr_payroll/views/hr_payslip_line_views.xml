<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payslip Line -->
    <record id="view_hr_payslip_line_tree" model="ir.ui.view">
        <field name="name">hr.payslip.line.list</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <list
                string="Salary Structure"
                editable="bottom"
                decoration-info="total == 0">
                <field name="category_id" />
                <field name="employee_id" column_invisible="True" />
                <field name="sequence" />
                <field name="name" />
                <field name="code" />
                <field
                    name="company_id"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
                <field name="quantity" />
                <field name="rate" />
                <field name="amount" />
                <field name="total" />
                <field name="amount_select" column_invisible="True" />
                <field name="partner_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="view_hr_payslip_line_tree_register" model="ir.ui.view">
        <field name="name">hr.payslip.line.list.register</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <list
                string="Salary Structure"
                create="0"
                edit="0"
                decoration-info="total == 0">
                <field name="employee_id" column_invisible="True" />
                <field name="amount_select" column_invisible="True" />
                <field name="code" />
                <field name="partner_id" />
                <field name="slip_id" />
                <field name="total" />
            </list>
        </field>
    </record>

    <record id="view_hr_payslip_line_form" model="ir.ui.view">
        <field name="name">hr.payslip.line.form</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <form string="Payslip Line">
                <group>
                    <group>
                        <field name="partner_id" />
                        <field name="name" string="Line Name" />
                        <field name="code" />
                        <field name="slip_id" />
                        <field name="employee_id" widget="many2one_avatar_employee" />
                    </group>
                    <group string="Calculations">
                        <field name="category_id" />
                        <field name="amount_select" />
                        <field name="amount_fix" readonly="amount_select != 'fix'" />
                        <field
                            name="amount_percentage"
                            readonly="amount_select != 'percentage'" />
                        <field name="sequence" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="view_hr_payslip_line_filter" model="ir.ui.view">
        <field name="name">hr.payslip.line.select</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <search string="Search Payslip Lines">
                <field
                    name="name"
                    string="Payslip Lines"
                    filter_domain="['|',('name','ilike',self),('code','ilike',self)]" />
                <field name="amount_select" />
                <field name="slip_id" />
                <group col="8" colspan="4">
                    <filter
                        name="category_id"
                        string="Salary Rule Category"
                        context="{'group_by':'category_id'}" />
                    <filter
                        name="partner_id"
                        string="Contribution Register"
                        context="{'group_by':'partner_id'}" />
                    <filter
                        name="employee_id"
                        string="Employees"
                        context="{'group_by':'employee_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="hr_payslip_line_view_search_register" model="ir.ui.view">
        <field name="name">hr.payslip.line.search.view</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <search string="Search Payslip Lines">
                <field
                    name="name"
                    string="Payslip Lines"
                    filter_domain="['|',('name','ilike',self),('code','ilike',self)]" />
                <field name="partner_id" />
                <field name="amount_select" />
                <field name="slip_id" />
                <field name="date_from" />
                <filter
                    name="has_partner"
                    string="Is Register"
                    domain="[('partner_id', '!=', False)]" />
                <separator />
                <filter
                    name="last_month"
                    string="Last Month"
                    domain="[('date_from', '&gt;=', 'today -1m')]" />
                <filter
                    name="last_quarter"
                    string="Last Quarter"
                    domain="[('date_from', '&gt;=', 'today -3m')]" />
                <group col="8" colspan="4">
                    <filter
                        name="category_id"
                        string="Salary Rule Category"
                        context="{'group_by':'category_id'}" />
                    <filter
                        name="group_by_partner_id"
                        string="Contribution Register"
                        context="{'group_by':'partner_id'}" />
                    <filter
                        name="employee_id"
                        string="Employees"
                        context="{'group_by':'employee_id'}" />
                    <filter
                        name="group_by_date_from"
                        string="Date"
                        context="{'group_by': 'date_from'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_contribution_registers" model="ir.actions.act_window">
        <field name="name">Contribution Registers</field>
        <field name="res_model">hr.payslip.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hr_payslip_line_tree_register" />
        <field name="search_view_id" ref="hr_payslip_line_view_search_register" />
        <field
            name="context">{'search_default_group_by_partner_id': 1, 'search_default_has_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Nothing to show
            </p><p>
                To see something in this report, compute a payslip.
            </p>
        </field>
    </record>

    <record
        id="action_contribution_registers_view_list"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hr_payslip_line_tree_register" />
        <field name="act_window_id" ref="action_contribution_registers" />
    </record>

    <record
        id="action_contribution_registers_view_form"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_payslip_line_form" />
        <field name="act_window_id" ref="action_contribution_registers" />
    </record>

    <record id="act_contribution_reg_payslip_lines" model="ir.actions.act_window">
        <field name="name">Payslip Lines</field>
        <field name="res_model">hr.payslip.line</field>
        <field name="domain">[('partner_id', '=', active_id)]</field>
        <field name="context">{'default_partner_id': active_id}</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">form</field>
    </record>

    <record id="hr_payslip_line_view_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.line.pivot</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Analysis" sample="1" disable_linking="True">
                <field name="salary_rule_id" type="row" />
                <field name="date_from" type="col" interval="month" />
                <field name="amount" type="measure" />

            </pivot>
        </field>
    </record>

    <record id="hr_payslip_line_view_list_report" model="ir.ui.view">
        <field name="name">hr.payslip.line.list.report</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <list string="Payslip Lines" create="false" edit="false">
                <field name="employee_id" widget="many2one_avatar_employee" />
                <field name="name" />
                <field name="code" optional="show" />
                <field name="category_id" optional="show" />
                <field name="sequence" optional="hide" />
                <field name="quantity" optional="show" />
                <field name="rate" optional="show" />
                <field name="amount" optional="show" />
                <field name="total" />
                <field
                    name="company_id"
                    optional="show"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="hr_payslip_line_view_search_report" model="ir.ui.view">
        <field name="name">hr.payslip.line.search.report</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <search string="Search Payslip Lines">
                <field
                    name="employee_id"
                    domain="[('company_id', 'in', allowed_company_ids)]" />
                <field
                    name="name"
                    string="Payslip Lines"
                    filter_domain="['|',('name','ilike',self),('code','ilike',self)]" />
                <field name="slip_id" string="Payslip Name" />
                <filter
                    name="is_paid"
                    string="Paid"
                    domain="[('slip_id.state', '=', 'paid')]" />
                <filter
                    name="is_validated"
                    string="Validated"
                    domain="[('slip_id.state', '=', 'validated')]" />
                <filter
                    name="is_draft"
                    string="Draft"
                    domain="[('slip_id.state', '=', 'draft')]" />
                <separator />
                <filter
                    name="date_from"
                    string="Date"
                    date="date_from"
                    default_period="year" />
                <filter
                    name="category_id"
                    string="Salary Rule Category"
                    context="{'group_by':'category_id'}" />
                <filter
                    name="salary_rule_id"
                    string="Salary Rule"
                    context="{'group_by': 'salary_rule_id'}" />
                <filter
                    name="struct_id"
                    string="Salary Structure"
                    context="{'group_by': 'struct_id'}" />
            </search>
        </field>
    </record>

    <record id="hr_payslip_line_action_report" model="ir.actions.act_window">
        <field name="name">Payslip Lines Report</field>
        <field name="res_model">hr.payslip.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="hr_payslip_line_view_search_report" />
        <field
            name="context">{
            'search_default_is_paid': 1,
            'search_default_is_done': 1,
            'search_default_date_from': 1
        }</field>
    </record>

    <record
        id="hr_payslip_line_action_report_view_pivot"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="hr_payslip_line_view_pivot" />
        <field name="act_window_id" ref="hr_payslip_line_action_report" />
    </record>

    <record
        id="hr_payslip_line_action_report_view_list"
        model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="hr_payslip_line_view_list_report" />
        <field name="act_window_id" ref="hr_payslip_line_action_report" />
    </record>

</odoo>
