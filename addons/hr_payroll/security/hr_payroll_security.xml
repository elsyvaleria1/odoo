<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="res_groups_privilege_payroll" model="res.groups.privilege">
            <field name="name">Payroll</field>
            <field name="sequence">16</field>
            <field name="category_id" ref="base.module_category_human_resources" />
        </record>
        <record id="group_hr_payroll_user" model="res.groups">
            <field name="name">Officer: Manage all contracts</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_payroll" />
            <field
                name="comment">User can manage all contracts, work entries and create payslips.</field>
            <field name="implied_ids" eval="[Command.link(ref('hr.group_hr_user'))]" />
        </record>
        <record id="group_hr_payroll_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_payroll" />
            <field name="comment">User have full access on the application.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('hr_payroll.group_hr_payroll_user')), Command.link(ref('hr.group_hr_manager'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
        <record id="group_payslip_display" model="res.groups">
            <field name="name">Display payslip PDF</field>
        </record>
        <!--
            group_payslip_display only gates a widget on hr.payslip's form, which
            ir.access.csv already restricts to group_hr_payroll_user/manager;
            implying it onto every internal user (base.group_user) was a no-op for
            anyone outside those groups, since they can never open the form.
        -->
        <record id="group_hr_payroll_user" model="res.groups">
            <field
                name="implied_ids"
                eval="[Command.link(ref('hr_payroll.group_payslip_display'))]" />
        </record>
    </data>

</odoo>
