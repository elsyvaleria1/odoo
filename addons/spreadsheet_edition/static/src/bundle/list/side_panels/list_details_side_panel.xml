<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div
        t-name="spreadsheet_edition.ListDetailsSidePanel"
        class="o-listing-details-side-panel"
        t-att="this.env.model.getters.isReadonly() ? ['inert', 1] : []"
        t-att-class="{ 'pe-none opacity-50': this.env.model.getters.isReadonly() }">
        <t t-if="this.isModelValid">
            <Section class="'o-section'">
                <t t-set-slot="title">
                    <div class="d-flex flex-row justify-content-between align-items-center">
                        List Name
                        <CogWheelMenu items="this.cogWheelMenuItems"/>
                    </div>
                </t>
                <TextInput
                    value="this.env.model.getters.getListName(this.props.listId)"
                    onChange.bind="this.onNameChanged"
                />
            </Section>
            <t t-set="def" t-value="this.listDefinition"/>
            <div class="o-section">
                <div class="o-section-title">Model</div>
                <div class="o_model_name"><t t-out="def.modelDisplayName"/> (<t t-out="def.model"/>)</div>
            </div>
            <Section class="'o-section'">
                <div class="o-section-title">
                    Columns
                </div>
                <div class="columns-list" t-foreach="this.getColumnFields()" t-as="field" t-key="field.name">
                    <div t-out="field.string" t-att-title="field.name"/>
                </div>
            </Section>
            <SidePanelDomain
                resModel="def.model"
                domain="def.domain"
                onUpdate.bind="this.onDomainUpdate"
            />
            <EditListSortingSection
                resModel="def.model"
                orderBy="def.orderBy"
                fields="this.listFields"
                onUpdateSorting.bind="this.onUpdateSorting"
            />
            <RelatedFiltersSection
                resModel="def.model"
                dataSourceId="this.props.listId"
                dataSourceType="'list'"
            />
            <Section class="'o-section pt-0'">
                <div class="o_pivot_last_update text-muted"><i>Last updated at <t t-out="this.getLastUpdate()"/></i></div>
            </Section>
            <div class="o-section py-1" t-if="this.env.model.getters.isListUnused(this.props.listId)">
                <ValidationMessages messages="[this.unusedListWarning]" msgType="'warning'"/>
            </div>
        </t>
        <Section t-else="1">
            <ValidationMessages messages="[this.invalidListModel]" msgType="'error'"/>
            <button class="mx o-button o-button-primary mt-2 m-1" t-on-click="this.delete">Delete List</button>
        </Section>
    </div>
</templates>
