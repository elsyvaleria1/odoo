<?xml version="1.0" encoding="utf-8"?>
<templates>
<div t-name="spreadsheet_edition.CellThread"
    t-key="this.props.threadId"
    class="o-cell-thread"
    t-on-wheel.stop=""
    t-on-click.prevent="">
    <!-- the prevent on click is necessary because we cannot benefit from the
    scroller service event listener -->
    <div class="o-cell-thread-body">
        <t t-if="this.state.thread.id">
            <Thread 
                thread="this.state.thread"
                t-key="this.state.thread.localId"
                showJumpPresent="false"
                showEmptyMessage="false"
                showDates="false" />
            <Composer
                t-if="!this.env.model.getters.isReadonly() and this.props.edit"
                t-key="this.state.thread.localId"
                composer="this.state.thread.composer"
                type="'note'"
                placeholder.translate="Add a comment..."
                showFullComposer="false"
            />
        </t>
    </div>
</div>
</templates>
