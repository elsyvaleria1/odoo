<?xml version="1.0" encoding="utf-8"?>
<templates>

<div t-name="spreadsheet_edition.VersionHistoryAction" class="o_spreadsheet_action">
    <SpreadsheetNavbar spreadsheetName="this.spreadsheetName" isReadonly="true" model="this.model"/>
    <div class="o_spreadsheet_container d-flex">
        <SpreadsheetComponent model="this.model" t-key="this.state.currentRevisionId" />
        <VersionHistorySidePanel t-props="this.historyPanelProps"/>
    </div>
</div>

</templates>
