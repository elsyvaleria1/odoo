<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_device_device_form_asset" model="ir.ui.view">
        <field name="name">device.device.form.asset</field>
        <field name="model">device.device</field>
        <field name="inherit_id" ref="device.view_device_device_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_own_asset"
                    type="object"
                    icon="fa-tag"
                    invisible="not own_asset_id"
                    class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Asset</span>
                        <span class="o_stat_text">Record</span>
                    </div>
                </button>
            </xpath>
            <xpath
                expr="//div[hasclass('oe_title')]//field[@name='identifier']"
                position="before">
                <field name="own_asset_id" options="{'no_create': True}" />
                <field name="own_asset_kind_code" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_device_device_list_asset" model="ir.ui.view">
        <field name="name">device.device.list.asset</field>
        <field name="model">device.device</field>
        <field name="inherit_id" ref="device.view_device_device_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="own_asset_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_device_device_search_asset" model="ir.ui.view">
        <field name="name">device.device.search.asset</field>
        <field name="model">device.device</field>
        <field name="inherit_id" ref="device.view_device_device_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="own_asset_id" />
            </field>
        </field>
    </record>

</odoo>
