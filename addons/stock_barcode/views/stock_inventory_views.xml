<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_quant_barcode" model="ir.ui.view">
        <field name="name">stock.quant.barcode</field>
        <field name="model">stock.quant</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form class="o_barcode_line_form flex-column">
                <field name="inventory_date" invisible="1" />
                <field name="location_id" invisible="1" />
                <field name="quantity" invisible="1" />
                <field name="user_id" invisible="1" />
                <div name="product" class="row my-2">
                    <div class="col d-flex align-items-baseline">
                        <div class="flex-column lh-1">
                            <div invisible="not product_reference_code">
                                <i class="fa-solid fa-tags fs-4 me-1" title="Product" />
                                <field name="product_reference_code" />
                            </div>
                            <div class="fs-5">
                                <field
                                    name="product_id"
                                    placeholder="Product"
                                    domain="[('is_storable', '=', True), '|', ('company_id', '=', False), ('company_id', 'parent_of', company_id)]"
                                    context="{'default_is_storable': True}"
                                    readonly="id and product_id"
                                    required="1" />
                            </div>
                        </div>
                    </div>
                    <div class="col-3" invisible="not image_1920">
                        <field
                            name="image_1920"
                            widget="image_preview"
                            class="oe_avatar" />
                    </div>
                </div>
                <div name="quantity" class="row my-2">
                    <div class="col">
                        <field
                            name="inventory_quantity"
                            placeholder="Counted Quantity"
                            options="{'type': 'number'}"
                            class="text-end" />
                    </div>
                    <div
                        class="col-3 ps-0"
                        groups="uom.group_uom"
                        invisible="not product_uom_id">
                        <field
                            name="product_uom_id"
                            widget="many2one_uom"
                            options="{'no_open': True}"
                            groups="uom.group_uom" />
                    </div>
                </div>
                <div name="digipad" class="row">
                    <widget
                        name="digipad"
                        field_to_edit="inventory_quantity"
                        fulfilled_at="quantity" />
                </div>
                <div
                    name="location_src"
                    class="row"
                    groups="stock.group_stock_multi_locations">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-location-dot me-1" />
                        <label for="location_id" string="Location" class="p-0" />
                    </div>
                    <field
                        name="location_id"
                        placeholder="Location"
                        options="{'no_create': True, 'no_open': True}"
                        readonly="id" />
                </div>
                <div name="package" class="row" groups="stock.group_tracking_lot">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-archive me-1" />
                        <label for="package_id" string="Package" class="p-0" />
                    </div>
                    <field name="package_id" placeholder="Package" />
                </div>
                <div name="owner" class="row" groups="stock.group_tracking_owner">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-user me-1" />
                        <label for="owner_id" string="Owner" class="p-0" />
                    </div>
                    <field name="owner_id" placeholder="Owner" />
                </div>
                <div
                    name="tracking_number"
                    class="row"
                    groups="stock.group_production_lot"
                    invisible="tracking == 'none' or (id and not trace_id)">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-barcode me-1" />
                        <label for="trace_id" string="Serial/Lot Number" class="p-0" />
                    </div>
                    <field
                        name="trace_id"
                        placeholder="Serial/Lot Number"
                        context="{'default_product_id': product_id}"
                        readonly="id" />
                </div>
                <div
                    name="properties"
                    class="row"
                    groups="stock.group_production_lot"
                    invisible="tracking == 'none' or (id and not trace_id)">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-puzzle-piece me-1" />
                        <label for="lot_properties" string="Properties" class="p-0" />
                    </div>
                    <field name="lot_properties" widget="properties" readonly="1" />
                </div>
                <div class="fixed-bottom">
                    <div
                        class="o_barcode_control d-flex justify-content-between p-2 gap-2">
                        <button
                            special="cancel"
                            string="Discard"
                            class="btn btn-secondary o_discard" />
                        <button
                            special="save"
                            string="Confirm"
                            class="btn btn-primary o_save" />
                    </div>
                </div>
            </form>
        </field>
    </record>

</odoo>
