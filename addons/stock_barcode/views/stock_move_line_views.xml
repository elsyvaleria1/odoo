<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_move_line_product_selector" model="ir.ui.view">
        <field name="name">stock.product.selector</field>
        <field name="model">stock.move.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form
                string="Select a Product"
                class="o_barcode_line_form flex-column"
                js_class="stock_barcode_sml_form">
                <field name="id" invisible="1" />
                <field name="location_id" invisible="1" />
                <field name="company_id" force_save="1" invisible="1" />
                <field name="move_id" invisible="1" />
                <field name="picked" invisible="1" />
                <field name="picking_code" invisible="1" />
                <field name="picking_id" invisible="1" />
                <field name="picking_type_use_create_lots" invisible="1" />
                <field name="picking_type_use_existing_lots" invisible="1" />
                <field name="quantity" invisible="1" />
                <field name="quant_id" invisible="1" />
                <div name="product" class="row my-2">
                    <div class="col d-flex align-items-baseline">
                        <div class="flex-column lh-1">
                            <div invisible="not product_reference_code">
                                <i class="fa-solid fa-tags fs-4 me-1" title="Product" />
                                <field name="product_reference_code" />
                            </div>
                            <div class="fs-5">
                                <field
                                    name="product_id"
                                    placeholder="Product"
                                    domain="[('type', '=', 'consu'), '|', ('company_id', '=', False), ('company_id', 'parent_of', company_id)]"
                                    context="{'default_is_storable': True}"
                                    readonly="state == 'done' or move_id"
                                    required="1" />
                            </div>
                            <div class="text-muted">
                                <field
                                    name="formatted_product_barcode"
                                    invisible="not product_id" />
                            </div>
                        </div>
                    </div>
                    <div class="col-3" invisible="not image_1920">
                        <field
                            name="image_1920"
                            widget="image_preview"
                            class="oe_avatar" />
                    </div>
                </div>
                <div name="quantity" class="row my-2">
                    <div class="col">
                        <field
                            name="qty_done"
                            placeholder="Quantity"
                            options="{'type': 'number'}"
                            class="text-end" />
                    </div>
                    <div class="col-3 ps-0" groups="uom.group_uom">
                        <field
                            name="product_uom_id"
                            widget="many2one_uom"
                            options="{'no_open': True}"
                            groups="uom.group_uom" />
                    </div>
                </div>
                <div name="digipad" class="row">
                    <widget
                        name="digipad"
                        invisible="tracking == 'serial' and (not hide_lot_name or not hide_lot)"
                        field_to_edit="qty_done"
                        fulfilled_at="quantity" />
                </div>
                <div
                    name="location_src"
                    class="row"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_code == 'incoming'">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-location-dot me-1" />
                        <label for="location_id" string="Source Location" class="p-0" />
                    </div>
                    <field
                        name="location_id"
                        placeholder="Source Location"
                        domain="[('id', 'child_of', parent_location_id)]"
                        options="{'no_create': True, 'no_open': True}" />
                </div>
                <div
                    name="location_dest"
                    class="row"
                    groups="stock.group_stock_multi_locations"
                    invisible="picking_code == 'outgoing'">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-location-dot me-1" />
                        <label
                            for="location_dest_id"
                            string="Destination Location"
                            class="p-0" />
                    </div>
                    <field
                        name="location_dest_id"
                        placeholder="Destination Location"
                        domain="[('id', 'child_of', parent_location_dest_id)]"
                        options="{'no_create': True, 'no_open': True}" />
                </div>
                <div name="package" class="row" groups="stock.group_tracking_lot">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-archive me-1" />
                        <label for="package_id" string="Source Package" class="p-0" />
                    </div>
                    <field name="package_id" placeholder="Source Package" />
                </div>
                <div
                    name="result_package"
                    class="row"
                    groups="stock.group_tracking_lot">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-archive me-1" />
                        <label
                            for="result_package_id"
                            string="Destination Package"
                            class="p-0" />
                    </div>
                    <field
                        name="result_package_id"
                        placeholder="Destination Package"
                        context="{'picking_id': picking_id}" />
                </div>
                <div
                    name="outermost_package"
                    class="row"
                    groups="stock.group_tracking_lot">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-archive me-1" />
                        <label
                            for="outermost_result_package_id"
                            string="Destination Container Package"
                            class="p-0" />
                    </div>
                    <field
                        name="outermost_result_package_id"
                        placeholder="Destination Container Package" />
                </div>
                <div name="owner" class="row" groups="stock.group_tracking_owner">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-user me-1" />
                        <label for="owner_id" string="Owner" class="p-0" />
                    </div>
                    <field name="owner_id" placeholder="Owner" />
                </div>
                <div
                    name="tracking_number"
                    class="row"
                    groups="stock.group_production_lot"
                    invisible="hide_lot_name and hide_lot">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-barcode me-1" />
                        <label
                            for="lot_name"
                            string="Serial/Lot Number"
                            invisible="hide_lot_name"
                            class="p-0" />
                        <label
                            for="trace_id"
                            string="Serial/Lot Number"
                            invisible="hide_lot"
                            class="p-0" />
                    </div>
                    <field
                        name="lot_name"
                        placeholder="Serial/Lot Number"
                        invisible="hide_lot_name" />
                    <field
                        name="trace_id"
                        placeholder="Serial/Lot Number"
                        context="{'default_product_id': product_id, 'active_picking_id': picking_id}"
                        invisible="hide_lot" />
                </div>
                <div
                    name="properties"
                    class="row"
                    groups="stock.group_production_lot"
                    invisible="tracking == 'none' or not trace_id">
                    <div class="text-black-50 mt-2 fs-5">
                        <span class="fa-solid fa-puzzle-piece me-1" />
                        <label for="lot_properties" string="Properties" class="p-0" />
                    </div>
                    <field name="lot_properties" widget="properties" readonly="1" />
                </div>
                <div class="row mb-5" invisible="not product_stock_quant_ids">
                    <div class="col-12 d-flex mt-2 ms-0 justify-contents-center">
                        <hr class="flex-grow-1" />
                        <div class="d-flex flex-column">
                            <p class="fw-bold text-center text-black-25 m-0">
                                Quantity in Stock
                            </p>
                            <p
                                class="fw-bold text-center text-black-25 px-1"
                                groups="stock.group_stock_multi_locations,stock.group_production_lot,stock.group_tracking_owner">
                                Select where else to pick the product from
                            </p>
                        </div>
                        <hr class="flex-grow-1" />
                    </div>
                    <div class="col-12 mb-5 d-flex">
                        <field
                            name="product_stock_quant_ids"
                            widget="stock_barcode_quant_one2many"
                            mode="kanban"
                            context="{                             'kanban_view_ref': 'stock_barcode.stock_quant_barcode_kanban_2',                             'list_view_ref': 'stock_barcode.view_stock_quant_list'}" />
                    </div>
                </div>
                <div class="fixed-bottom">
                    <div
                        class="o_barcode_control d-flex justify-content-between p-2 gap-2">
                        <button
                            special="cancel"
                            string="Discard"
                            class="btn btn-secondary o_discard" />
                        <button
                            special="save"
                            string="Confirm"
                            class="btn btn-primary o_save" />
                    </div>
                    <widget
                        name="stock_barcode_unlink_button"
                        invisible="context.get('hide_unlink_button')"
                        class="o_barcode_control d-flex px-2 pb-2" />
                </div>
            </form>
        </field>
    </record>

    <record id="stock_quant_barcode_kanban" model="ir.ui.view">
        <field name="name">stock.barcode.quant.kanban</field>
        <field name="model">stock.quant</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <kanban can_open="0" draggable="0">
                <templates>
                    <t t-name="card">
                        <field name="product_id" class="fw-bold" />
                        <field
                            name="trace_id"
                            groups="stock.group_production_lot"
                            invisible="not trace_id"
                            class="d-block" />
                        <div>
                            <field name="quantity" string="Quantity Done" />
                            <field
                                name="product_uom_id"
                                groups="uom.group_uom"
                                class="ms-1" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_quant_barcode_kanban_2" model="ir.ui.view">
        <field name="name">stock.quant.kanban.barcode</field>
        <field name="model">stock.quant</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <kanban create="0" class="o_kanban_mobile">
                <field name="id" />
                <templates>
                    <t t-name="card">
                        <field name="location_id" class="fw-bolder" />
                        <div class="d-flex">
                            <p class="m-0 me-2">Available: </p>
                            <div>
                                <field name="available_quantity" />
                                <span invisible="not quantity"> / <field name="quantity" /></span>
                                <span> <field name="product_uom_id" groups="uom.group_uom" /></span>
                            </div>
                        </div>
                        <div
                            class="mb2"
                            invisible="not trace_id"
                            groups="stock.group_production_lot">
                            <field name="trace_id" />
                        </div>
                        <div
                            class="mb4"
                            invisible="not package_id"
                            groups="stock.group_tracking_lot">
                            <i class="fa-solid fa-archive fa-lg me-2" title="Package" /><field name="package_id" context="{'show_src_package': True}" />
                        </div>
                        <div
                            class="mb4"
                            invisible="not owner_id"
                            groups="stock.group_tracking_owner">
                            <i class="fa-regular fa-user fa-lg me-2" title="Owner" /><field name="owner_id" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_quant_list" model="ir.ui.view">
        <field name="name">stock_barcode.quant.list.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_list" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="string">UoM</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='available_quantity']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

</odoo>
