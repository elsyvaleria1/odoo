<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban view used by the Barcode app (Operations) -->
    <record id="view_stock_picking_type_kanban" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban</field>
        <field name="model">stock.picking.type</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban
                type="object"
                create="0"
                sample="1"
                class="o_kanban_mobile o_stock_barcode_operations_kanban_view"
                action="action_view_pickings_ready_kanban"
                group_create="false"
                highlight_color="color"
                js_class="stock_barcode_operations_kanban">
                <field name="color" />
                <field name="code" />
                <field name="is_barcode_picking_type" />
                <templates>
                    <t t-name="card" class="o_barcode_picking_type">
                        <div
                            t-if="record.is_barcode_picking_type.raw_value"
                            class="d-flex justify-content-between py-3">
                            <div name="o_kanban_record_title" class="fw-bold fs-5">
                                <field name="name" class="text-uppercase" />
                                <br />
                                <field
                                    name="warehouse_id"
                                    groups="stock.group_stock_multi_warehouses"
                                    readonly="1"
                                    class="text-muted" />
                            </div>
                            <div
                                class="badge rounded-pill bg-secondary float-end align-self-center p-1 px-2 fs-6"
                                t-attf-class="{{ record.count_picking_ready.value == 0 ? 'text-muted' : 'fw-bold' }}"
                                name="action_view_pickings_ready_kanban"
                                type="object">
                                <span name="pickings_count"><field name="count_picking_ready" /></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="stock_picking_type_action_kanban" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">stock.picking.type</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_stock_picking_type_kanban" />
        <field name="target">fullscreen</field>
        <field
            name="domain">[('code', 'in', ('incoming', 'outgoing', 'internal'))]</field>
    </record>

    <!-- Add barcode settings for picking types -->
    <record id="stock_barcode_view_stock_picking_type_form" model="ir.ui.view">
        <field name="name">Operation Types</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_stock_picking_type_form" />
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="barcode" />
            </field>
            <xpath expr="//page[@name='hardware']" position="after">
                <field name="is_barcode_picking_type" invisible="1" />
                <page
                    name="barcode_app"
                    string="Barcode App"
                    invisible="not is_barcode_picking_type">
                    <group>
                        <field
                            name="show_reserved_sns"
                            groups="stock.group_production_lot" />
                        <field
                            name="show_entire_packs"
                            groups="stock.group_tracking_lot" />
                    </group>
                    <group>
                        <group name="restrict_scan_settings" string="Mandatory Scan">
                            <field
                                name="restrict_scan_source_location"
                                string="Source Location"
                                groups="stock.group_stock_multi_locations"
                                invisible="code == 'incoming'" />
                            <field name="restrict_scan_product" string="Product" />
                            <field
                                name="restrict_scan_tracking_number"
                                string="Lot/Serial"
                                groups="stock.group_production_lot"
                                invisible="not use_create_lots and not use_existing_lots" />
                            <field
                                name="restrict_put_in_pack"
                                string="Put in Pack"
                                groups="stock.group_tracking_lot" />
                            <field
                                name="restrict_scan_dest_location"
                                string="Destination Location"
                                groups="stock.group_stock_multi_locations"
                                invisible="code == 'outgoing'" />
                        </group>
                        <group name="barcode_options" string="Options">
                            <field name="barcode_allow_extra_product" />
                        </group>
                    </group>
                    <field name="show_barcode_validation" invisible="1" />
                    <group
                        name="barcode_validation"
                        string="Final Validation"
                        invisible="not show_barcode_validation">
                        <!-- show_barcode_validation handles combined groups/invisible complexity -->
                        <field
                            name="barcode_validation_full"
                            invisible="restrict_scan_product" />
                        <field
                            name="barcode_validation_all_product_packed"
                            groups="stock.group_tracking_lot"
                            invisible="restrict_put_in_pack != 'optional'" />
                        <field
                            name="barcode_validation_after_dest_location"
                            groups="stock.group_stock_multi_locations"
                            invisible="code == 'outgoing' or restrict_scan_dest_location != 'optional'" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[@name='first']/group[last()]" position="inside">
                <field
                    name="color"
                    string="Card Color"
                    help="Add colors to operation cards to help users differentiate them."
                    widget="color_picker" />
            </xpath>
        </field>
    </record>

</odoo>
