<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="competitor_offer_view_form_sale" model="ir.ui.view">
        <field name="name">competitor.offer.form.sale</field>
        <field name="model">competitor.offer</field>
        <field name="inherit_id" ref="trade_competition.competitor_offer_view_form" />
        <field name="arch" type="xml">
            <field name="is_winner" position="before">
                <field
                    name="sale_order_id"
                    domain="[('partner_id', 'child_of', partner_id)]"
                    invisible="direction != 'sale'" />
            </field>
        </field>
    </record>

    <record id="competitor_offer_action_sale" model="ir.actions.act_window">
        <field name="name">Competitor Offers</field>
        <field name="res_model">competitor.offer</field>
        <field name="path">competitor-offers</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('direction', '=', 'sale')]</field>
        <field name="context">{'default_direction': 'sale'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record what a competitor offered one of your customers
            </p><p>
                Price, terms, source and confidence: every offer feeds the market
                price your quotations are compared with.
            </p>
        </field>
    </record>

    <record id="competitor_action_sale" model="ir.actions.act_window">
        <field name="name">Competitors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_competitor', '=', True)]</field>
        <field
            name="context">{'default_is_competitor': True, 'default_is_company': True}</field>
    </record>

    <record id="market_price_action_sale" model="ir.actions.act_window">
        <field name="name">Market Prices</field>
        <field name="res_model">competitor.offer.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="domain">[('direction', '=', 'sale')]</field>
        <field name="context">{'search_default_group_product': 1}</field>
    </record>

    <record id="win_loss_action_sale" model="ir.actions.act_window">
        <field name="name">Win/Loss Analysis</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('outcome', 'in', ['won', 'lost'])]</field>
        <field
            name="context">{'pivot_row_groupby': ['lost_to_id'], 'pivot_column_groupby': ['outcome'], 'pivot_measures': ['__count', 'price_gap_at_close'], 'graph_groupbys': ['competitor_ids', 'outcome']}</field>
    </record>

</odoo>
