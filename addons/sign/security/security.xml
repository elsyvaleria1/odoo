<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="manage_template_access" model="res.groups">
            <field name="name">Manage template access</field>
        </record>
        <record id="res_groups_privilege_sign" model="res.groups.privilege">
            <field name="name">Sign</field>
            <field name="category_id" ref="base.module_category_productivity" />
        </record>
        <record id="group_sign_user" model="res.groups">
            <field name="name">User: Own Templates</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_sign" />
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        </record>
        <record id="group_sign_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_sign" />
            <field
                name="implied_ids"
                eval="[Command.link(ref('sign.group_sign_user'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
    </data>

</odoo>
