<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sign_request_share_view_form" model="ir.ui.view">
        <field name="name">sign.request.share.view.form</field>
        <field name="model">wizard.sign.template.share</field>
        <field name="arch" type="xml">
            <form string="Multiple Signature Requests">
                <field name="share_link" invisible="1" />
                <group col="3" invisible="not share_link">
                    <group colspan="3">
                        <field
                            name="share_link"
                            widget="CopyClipboardChar"
                            readonly="1" />
                    </group>
                    <group colspan="1">
                        <field name="validity" options="{'min_date': 'today'}" />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_stop_sharing"
                        type="object"
                        string="Stop sharing"
                        invisible="not is_shared"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_copy_and_close"
                        type="object"
                        string="Copy link"
                        invisible="not is_shared"
                        class="btn-primary"
                        data-hotkey="x" />
                    <button
                        name="action_close_request"
                        type="object"
                        string="Close"
                        data-hotkey="q" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
