<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignTemplateControlPanel">
        <ControlPanel display="this.controlPanelDisplay">
            <t t-set-slot="control-panel-always-buttons">
                <button t-if="['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-primary o_sign_template_send" t-on-click="this.onSendClick">Send</button>
                <button t-if="['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-primary o_sign_template_sign_now text-nowrap" t-on-click="this.onSignNowClick">Sign Now</button>
                <button t-if="this.showShareButton and ['', 'sign_send_request'].includes(this.props.actionType)" type="button" class="btn btn-secondary o_sign_template_share" t-on-click="this.onShareClick">Share</button>
                <button t-if="this.props.actionType === 'sign_template_edit'" type="button" class="btn btn-primary o_sign_template_save" t-on-click="this.props.goBackToKanban">Save</button>
                <button t-if="this.nextTemplate and this.props.actionType === 'sign_template_edit'" type="button" class="btn btn-primary o_sign_template_next" t-on-click="this.onNextDocumentClick">
                    Next Document
                </button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <SignTemplateCustomCogMenu t-props="this.customCogMenuProps"/>
                <SignStatusIndicator signStatus="this.props.signStatus"/>
                <SignTemplateHeaderTags t-props="this.templateHeaderTagsProps"/>
            </t>
        </ControlPanel>
    </t>
</templates>
