<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ActivityListPopoverItem" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-ActivityListPopoverItem-markAsDone')]" position="after">
            <button t-if="this.props.activity.activity_category === 'sign_request'"
                    class="o-mail-ActivityListPopoverItem-requestSign btn btn-sm btn-success btn-link"
                    t-on-click="this.onClickRequestSign">
                <i class="fa-regular fa-pen-to-square"/>
            </button>
        </xpath>
    </t>
</templates>
