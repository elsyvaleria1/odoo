<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mail.Activity" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Activity-markDone')]" position="attributes">
            <attribute name="t-if">this.props.activity.activity_category != "sign_request"</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Activity-markDone')]" position="after">
            <button
                t-if="this.props.activity.activity_category == 'sign_request'"
                class="btn btn-link p-0 me-3"
                t-att-data-chaining-type-activity="this.props.activity.chaining_type"
                t-att-data-previous-activity-type-id="this.props.activity.activity_type_id[0]"
                t-att-data-activity-id="this.props.activity.id"
                t-on-click="this.onClickRequestSign"
            >
                <i class="fa-regular fa-pen-to-square"/> Request Signature
            </button>
        </xpath>
    </t>

</templates>
