<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_renderer')]" position="attributes">
            <attribute name="class" add="o_sign_view" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_list_renderer')]" position="before">
            <div t-if="this.dragState.showDragZone" class="o_dropzone">
                <i class="fa-solid fa-upload fa-10x"></i>
            </div>
        </xpath>
        <EmptyState position="replace">
            <t t-if="this.showNoContentHelper">
                <SignActionHelper resModel="this.props.list.resModel"/>
            </t>
        </EmptyState>
    </t>
</templates>
