<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tour template -->
    <record id="attachment_sign_tour" model="ir.attachment">
        <field name="name">Sample Contract.pdf</field>
        <field name="datas" type="base64" file="sign/static/demo/sample_contract.pdf" />
        <field name="mimetype">application/pdf</field>
    </record>

    <record id="template_sign_tour" model="sign.template">
        <field name="active" eval="False" />
        <field name="group_ids" eval="[Command.link(ref('sign.group_sign_user'))]" />
    </record>

    <record id="attachment_sign_tour_document" model="sign.document">
        <field name="attachment_id" ref="attachment_sign_tour" />
        <field name="template_id" ref="template_sign_tour" />
    </record>

    <!-- Reminder CRON -->
    <record id="sign_reminder_cron" model="ir.cron">
        <field name="name">Sign: Send mail reminder</field>
        <field name="model_id" ref="sign.model_sign_request" />
        <field name="state">code</field>
        <field name="code">model._cron_reminder()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
        <field
            name="nextcall"
            eval="(DateTime.today() + relativedelta(days=1)).strftime('%Y-%m-%d 10:00:00')" />
    </record>

    <!-- Item types -->
    <record id="sign_item_type_signature" model="sign.item.type">
        <field name="name">Signature</field>
        <field name="item_type">signature</field>
        <field name="tip">Sign it</field>
        <field name="placeholder">Signature</field>
        <field name="icon">fa-pencil-square-o</field>
    </record>

    <record id="sign_item_type_initial" model="sign.item.type">
        <field name="name">Initials</field>
        <field name="item_type">initial</field>
        <field name="tip">Mark it</field>
        <field name="placeholder">Initials</field>
        <field name="icon">fa-pencil-square-o</field>
    </record>

    <record id="sign_item_type_name" model="sign.item.type">
        <field name="name">Name</field>
        <field name="placeholder">Name</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="auto_field">name</field>
        <field name="icon">fa-user</field>
    </record>

    <record id="sign_item_type_email" model="sign.item.type">
        <field name="name">Email</field>
        <field name="placeholder">Email</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="auto_field">email</field>
        <field name="icon">fa-envelope-o</field>
    </record>

    <record id="sign_item_type_phone" model="sign.item.type">
        <field name="name">Phone</field>
        <field name="placeholder">Phone</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="auto_field">phone_ids.number</field>
        <field name="icon">fa-phone</field>
    </record>

    <record id="sign_item_type_company" model="sign.item.type">
        <field name="name">Company</field>
        <field name="placeholder">Company</field>
        <field name="icon">fa-building-o</field>
    </record>

    <record id="sign_item_type_text" model="sign.item.type">
        <field name="name">Text</field>
        <!-- default: type 'text', tip 'fill in', empty placeholder, default_width and default_height, no auto_field -->
        <field name="placeholder">Text</field>
        <field name="icon">fa-font</field>
    </record>

    <record id="sign_item_type_multiline_text" model="sign.item.type">
        <field name="name">Multiline</field>
        <field name="placeholder">Multiline</field>
        <field name="item_type">textarea</field>
        <field name="icon">fa-bars</field>
    </record>

    <record id="sign_item_type_checkbox" model="sign.item.type">
        <field name="name">Checkbox</field>
        <field name="placeholder">☑</field>
        <field name="item_type">checkbox</field>
        <field name="icon">fa-check-square-o</field>
    </record>

    <record id="sign_item_type_radio" model="sign.item.type">
        <field name="name">Radio</field>
        <field name="placeholder">◉</field>
        <field name="item_type">radio</field>
        <field name="icon">fa-dot-circle-o</field>
    </record>

    <record id="sign_item_type_selection" model="sign.item.type">
        <field name="name">Selection</field>
        <field name="item_type">selection</field>
        <field name="placeholder">Selection</field>
        <field name="tip">Select an option</field>
        <field name="icon">fa-angle-down</field>
    </record>

    <record id="sign_item_type_date" model="sign.item.type">
        <field name="name">Date</field>
        <field name="placeholder">Date</field>
        <field name="icon">fa-calendar</field>
    </record>

    <record id="sign_item_type_strikethrough" model="sign.item.type">
        <field name="name">Strikethrough</field>
        <field name="item_type">strikethrough</field>
        <field name="placeholder">Strikethrough</field>
        <field name="tip">Strikethrough the highlighted area</field>
        <field name="icon">fa-strikethrough</field>
    </record>

    <record id="sign_item_type_stamp" model="sign.item.type">
        <field name="name">Stamp</field>
        <field name="placeholder">Company Name
Company Address
Company Phone</field>
        <field name="item_type">stamp</field>
        <field name="auto_field">stamp</field>
        <field name="tip">Stamp it</field>
        <field name="icon">fa-pencil-square-o</field>
    </record>

    <record id="sign_item_role_default" model="sign.item.role">
        <field name="name">Signer 1</field>
        <field name="default" eval="True" />
    </record>

    <!-- Template tags -->
    <record id="sign_template_tag_1" model="sign.template.tag">
        <field name="name">HR</field>
        <field name="color">2</field>
    </record>

    <record id="sign_template_tag_2" model="sign.template.tag">
        <field name="name">NDA</field>
        <field name="color">3</field>
    </record>

    <record id="sign_template_tag_3" model="sign.template.tag">
        <field name="name">Sales</field>
        <field name="color">4</field>
    </record>

    <!-- Item options For Selection Type -->
    <record id="sign_item_option_1" model="sign.item.option">
        <field name="value">Option A</field>
    </record>

    <record id="sign_item_option_2" model="sign.item.option">
        <field name="value">Option B</field>
    </record>

    <record id="sign_item_option_3" model="sign.item.option">
        <field name="value">Option C</field>
    </record>

</odoo>
