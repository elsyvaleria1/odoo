<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_sale_order" model="approval.category">
        <field name="name">Sale Order Approval</field>
        <field name="company_id" eval="False" />
        <field name="approval_type">sale</field>
        <field name="description">Approval workflow for existing sale orders</field>
        <field name="sequence" eval="10" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">SOA</field>
        <field name="so_approval_mode">amount</field>
        <!--
            `order_amount_min` stays 0 ("no floor") for the mirror of the
            reason below. An order asks for approval whenever
            `_is_approval_required_by_rule` says so, and it says so for every
            order a non-manager creates below `so_validation_amount` — not only
            under the "Advanced Approval Workflow" level. With a floor of
            5 000 the only shipped sale category then matched nothing, and
            `action_confirm` raised "No approval category matches this sales
            order" on an ordinary small order with nothing the salesperson
            could do about it, because category configuration is manager-only.
            The smaller the order, the less it needs a floor to keep it out.
        -->
        <field name="order_amount_min">0.00</field>
        <!--
            `order_amount_max` stays 0 ("no limit"): `_is_matching_amount` reads
            a zero maximum as "no ceiling", and a ceiling here is a dead end.
            `so_validation_amount` defaults to 10 000, so every order at or
            above it needs approval, and this is the only sale category
            shipped; a maximum of 50 000 therefore made an order of 100 000
            both approval-required and unmatchable, and `action_confirm`
            raised "No approval category matches this sales order" with
            nothing the user could do about it. The larger the order, the more
            it needs approving.
        -->
        <field name="order_amount_max">0.00</field>
        <field name="has_amount">required</field>
        <field name="has_partner">required</field>
        <field name="has_date">required</field>
        <field name="has_reference">optional</field>
        <field name="has_document">optional</field>
    </record>

    <record
        id="approval_category_sale_order_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_sale_order" />
        <field name="name">Sales Managers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
        <field name="group_id" ref="sale.group_sale_manager" />
    </record>

    <record id="approval_category_sale_request" model="approval.category">
        <field name="name">Sale Order Request</field>
        <field name="company_id" eval="False" />
        <field name="approval_type">sale</field>
        <field name="target_model">sale.order</field>
        <field name="description">Create sale order from approval request</field>
        <field name="sequence" eval="20" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">SALEREQ</field>
        <field name="has_product">required</field>
        <field name="has_amount">optional</field>
        <field name="has_partner">optional</field>
        <field name="has_reference">optional</field>
        <field name="has_document">optional</field>
    </record>

    <record
        id="approval_category_sale_request_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_sale_request" />
        <field name="name">Sales Managers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
        <field name="group_id" ref="sale.group_sale_manager" />
    </record>

</odoo>
