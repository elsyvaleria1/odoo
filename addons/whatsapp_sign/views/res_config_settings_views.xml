<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp.sign</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sign.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sign']" position="inside">
                <setting
                    id="sign_whatsapp"
                    string="Send Requests through WhatsApp"
                    groups="base.group_no_one">
                    <div class="content-group">
                        <div class="row mt16">
                            <label
                                for="send_request_wa_template_id"
                                string="Request template"
                                class="o_light_label col-lg-3" />
                            <field
                                name="send_request_wa_template_id"
                                class="col-lg-9" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="request_completion_wa_template_id"
                                string="Completed template"
                                class="o_light_label col-lg-3" />
                            <field
                                name="request_completion_wa_template_id"
                                class="col-lg-9" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="request_refusal_wa_template_id"
                                string="Refusal template"
                                class="o_light_label col-lg-3" />
                            <field
                                name="request_refusal_wa_template_id"
                                class="col-lg-9" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
