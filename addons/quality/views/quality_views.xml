<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="quality_check_view_activity" model="ir.ui.view">
        <field name="name">quality.check.activity</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <activity string="Activity view">
                <templates>
                    <div t-name="activity-box" class="d-block">
                        <field
                            name="name"
                            display="full"
                            class="o_text_block o_text_bold" />
                        <field name="control_date" class="d-block" />
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <!-- USED IN MRP_WORKORDER -->
    <record id="quality_point_view_form" model="ir.ui.view">
        <field name="name">quality.point.view.form</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <h2><field name="name" readonly="1" /></h2>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="company_id" invisible="1" />
                            <field name="title" />
                            <field name="product_ids" widget="many2many_tags" />
                            <field
                                name="product_category_ids"
                                widget="many2many_tags" />
                            <field
                                name="picking_type_ids"
                                string="Operations"
                                widget="many2many_tags" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="user_id" widget="many2one_avatar_user" />
                        </group>
                        <group>
                            <field name="test_type" invisible="1" />
                            <field
                                name="test_type_id"
                                string="Type"
                                options="{'no_open': True, 'no_create': True}" />
                            <field
                                name="team_id"
                                options="{'no_open': True, 'no_create': True}" />
                            <field
                                name="failure_location_ids"
                                widget="many2many_tags"
                                groups="stock.group_stock_multi_locations"
                                invisible="not show_failure_location" />
                        </group>
                    </group>
                    <notebook>
                        <page name="instructions" string="Instructions">
                            <field
                                name="note"
                                placeholder="Describe the quality check to do..." />
                        </page>
                        <page name="Notes" string="Notes">
                            <field
                                name="reason"
                                string="Note"
                                placeholder="Describe why you need to perform this quality check..." />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="quality_alert_view_tree" model="ir.ui.view">
        <field name="name">quality.alert.view.list</field>
        <field name="model">quality.alert</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="name" decoration-bf="1" />
                <field name="product_tmpl_id" optional="show" />
                <field name="product_id" optional="hide" />
                <field
                    name="trace_ids"
                    widget="many2many_tags"
                    optional="hide"
                    groups="stock.group_production_lot" />
                <field name="team_id" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="tag_ids" widget="many2many_tags" optional="hide" />
                <field name="reason_id" optional="hide" />
                <field name="priority" optional="hide" />
                <field name="date_assign" optional="show" />
                <field name="partner_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="quality_alert_view_search" model="ir.ui.view">
        <field name="name">quality.alert.view.search</field>
        <field name="model">quality.alert</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Quality Alert"
                    filter_domain="[                     '|', '|', '|', ('name', 'ilike', self), ('product_id', 'ilike', self), ('product_tmpl_id', 'ilike', self), ('trace_ids', 'ilike', self)]" />
                <field
                    name="product_id"
                    string="Product"
                    filter_domain="[                     '|', '|', ('product_id', 'ilike', self), ('product_tmpl_id', 'ilike', self), ('trace_ids', 'ilike', self)]" />
                <field name="tag_ids" />
                <field name="user_id" />
                <filter
                    name="myalerts"
                    string="My Alerts"
                    domain="[('user_id', '=', uid)]" />
                <separator />
                <filter
                    name="inprogress"
                    string="In Progress"
                    domain="[('stage_id.done', '=', False)]" />
                <filter
                    name="done"
                    string="Done"
                    domain="[('stage_id.done', '=', True)]" />
                <separator />
                <filter name="filter_date_assign" date="date_assign" />
                <filter name="filter_date_close" date="date_close" />
                <separator />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    domain="[('activity_user_id', '=', uid)]" />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    help="Show all records whose next activity date is past"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]" />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    domain="[('my_activity_date_deadline', '=', 'today')]" />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]" />
                <group>
                    <filter
                        name="groupby_stage"
                        string="Stage"
                        context="{'group_by': 'stage_id'}" />
                    <filter
                        name="groupby_user"
                        string="Responsible"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="groupby_reason"
                        string="Root Cause"
                        context="{'group_by': 'reason_id'}" />
                    <filter
                        name="groupby_createmonth"
                        string="Creation Date"
                        context="{'group_by': 'create_date'}" />
                    <filter
                        name="groupby_team_id"
                        string="Quality Team"
                        context="{'group_by': 'team_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="quality_point_view_tree" model="ir.ui.view">
        <field name="name">quality.point.view.list</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" decoration-bf="1" />
                <field name="title" optional="show" />
                <field name="product_ids" widget="many2many_tags" optional="show" />
                <field
                    name="product_category_ids"
                    widget="many2many_tags"
                    optional="hide" />
                <field
                    name="picking_type_ids"
                    string="Operations"
                    widget="many2many_tags"
                    optional="show" />
                <field name="test_type_id" string="Type" optional="show" />
                <field name="team_id" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="hide" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <!-- js stuff -->

</odoo>
