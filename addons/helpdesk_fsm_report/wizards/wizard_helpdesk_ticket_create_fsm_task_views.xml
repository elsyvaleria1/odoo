<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="create_fsm_task_view_form" model="ir.ui.view">
            <field name="model">wizard.helpdesk.ticket.create.fsm.task</field>
            <field name="inherit_id" ref="helpdesk_fsm.create_fsm_task_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_id']" position="after">
                    <field name="allow_worksheets" invisible="1" />
                    <field
                        name="worksheet_template_id"
                        options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"
                        invisible="not allow_worksheets" />
                </xpath>
            </field>
        </record>
    </data>

</odoo>
