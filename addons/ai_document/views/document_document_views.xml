<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="documents_document_view_kanban" model="ir.ui.view">
        <field name="name">document.document.view.kanban.inherit.ai</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.document_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_record_body')]" position="before">
                <field name="ai_sortable" invisible="1"/> <!-- Used by @document_controller_mixin.js -->
                <field name="ai_sort_prompt" invisible="1"/> <!-- Used by @document_cog_menu_item_ai_auto_sort -->
                <widget
                    name="web_ribbon"
                    title="AI To Sort"
                    invisible="not ai_to_sort"
                    bg_color="bg-info" />
            </xpath>
        </field>
    </record>

    <record id="documents_document_view_list" model="ir.ui.view">
        <field name="name">document.document.view.list.inherit.ai</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.documents_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="ai_sortable" column_invisible="True"/> <!-- Used by @document_controller_mixin.js -->
                <field name="ai_sort_prompt" column_invisible="True"/> <!-- Used by @document_cog_menu_item_ai_auto_sort -->
            </xpath>
        </field>
    </record>

    <record id="documents_document_view_activity" model="ir.ui.view">
        <field name="name">document.document.view.activity.inherit.ai</field>
        <field name="model">document.document</field>
        <field name="inherit_id" ref="document.documents_view_activity" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="ai_sortable" invisible="1"/> <!-- Used by @document_controller_mixin.js -->
                <field name="ai_sort_prompt" invisible="1"/> <!-- Used by @document_cog_menu_item_ai_auto_sort -->
            </xpath>
        </field>
    </record>

</odoo>
