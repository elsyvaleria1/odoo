<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_documents_sort_view_form" model="ir.ui.view">
        <field name="name">ai_document.sort.view.form</field>
        <field name="model">wizard.document.document.setup.ai.sort</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="AI Sort">
                <sheet>
                    <button
                        special="cancel"
                        class="btn-close float-end"
                        aria-label="Close"
                        close="1" />
                    <div class="d-flex flex-column o_ai_documents_sort pb-4">
                        <strong>
                            What do you want the AI to do?
                        </strong>
                        <field name="folder_id" force_save="1" invisible="1"/>  <!-- Force saving -->
                        <field name="model" invisible="1"/>  <!-- Used by the `ai_prompt` widget -->
                        <field name="relation" invisible="1"/>  <!-- Used by the `ai_prompt` widget -->
                            <field
                                name="ai_sort_prompt"
                                placeholder="eg:                                     If the documents is an invoice, move it to Finance,                                     if it's an image, move it to Photos,                                     otherwise, create an activity 'Document to sort' for Admin                                 "
                                widget="ai_sort_documents_prompt"
                                options="{                                     'model_reference_field': 'model',                                     'record_selector_relation_field': 'relation',                                     'record_selector_domain': '[(\'type\', \'=\', \'folder\')]',                                     'show_missing_records_warning': 'true'                                 }" />
                            <strong class="mt-3">What actions can the AI take?</strong>
                            <field
                                name="ai_tool_ids"
                                widget="many2many_tags"
                                context="{'default_model_id': context.get('default_model_id'), 'default_use_in_ai': True}"
                                options="{'no_quick_create': True, 'edit_tags': True}" />
                        </div>
                    </sheet>
                <footer>
                    <button name="action_setup_folder" type="object" class="btn btn-primary" close="1">Save</button>
                    <button special="cancel" class="btn btn-secondary" close="1">Discard</button>
                    <button name="action_delete" type="object" icon="fa-trash" invisible="not is_ai_sort_prompt_set" class="btn btn-secondary float-end ms-auto" close="1">Delete</button>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_documents_sort_action" model="ir.actions.act_window">
        <field name="name">AI Sort</field>
        <field name="res_model">wizard.document.document.setup.ai.sort</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ai_documents_sort_view_form" />
        <field name="target">new</field>
        <field
            name="context"
            eval="{             'header': False,             'default_model_id': ref('document.model_document_document'),         }" />
    </record>

</odoo>
