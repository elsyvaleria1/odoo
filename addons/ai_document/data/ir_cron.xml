<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- Used only when documents are sent by email to not block the email cron -->
        <record id="ir_cron_ai_documents_sort" model="ir.cron">
            <field name="name">AI Documents: Sort documents with AI</field>
            <field name="model_id" ref="ai_document.model_document_document" />
            <field name="state">code</field>
            <field name="code">model._cron_ai_sort()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="repeat_interval">1</field>
            <field name="repeat_unit">day</field>
        </record>
    </data>

</odoo>
