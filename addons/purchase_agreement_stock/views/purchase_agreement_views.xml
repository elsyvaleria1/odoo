<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_purchase_agreement_form_inherit" model="ir.ui.view">
            <field name="name">purchase.agreement.form.inherit</field>
            <field name="model">purchase.agreement</field>
            <field
                name="inherit_id"
                ref="purchase_agreement.view_purchase_agreement_form" />
            <field name="arch" type="xml">
                <field name="reference" position="after">
                    <field
                        name="picking_type_id"
                        options="{'no_open': True, 'no_create': True}"
                        groups="stock.group_adv_location"
                        readonly="state != 'draft'" />
                </field>
            </field>
        </record>
    </data>

</odoo>
