<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fsm_stock_tracking_line_view_form" model="ir.ui.view">
        <field name="name">fsm.stock.tracking.view.form</field>
        <field name="model">wizard.project.task.update.product.lot</field>
        <field name="arch" type="xml">
            <form string="Track Stock">
                <div class="oe_title">
                    <h1><field name="product_id" options="{'no_open': True}" readonly="1" /></h1>
                </div>
                <field name="company_id" invisible="1" />
                <field name="task_id" invisible="1" />
                <field name="tracking" invisible="1" />
                <field name="is_same_warehouse" invisible="1" />
                <field
                    name="tracking_line_ids"
                    context="{'default_product_id': product_id, 'default_company_id': company_id}">
                    <list editable="bottom" decoration-muted="not is_same_warehouse">
                        <field
                            name="trace_id"
                            context="{'default_product_id': product_id}"
                            groups="stock.group_production_lot"
                            readonly="not is_same_warehouse" />
                        <field
                            name="warehouse_id"
                            column_invisible="parent.is_same_warehouse" />
                        <field
                            name="quantity"
                            column_invisible="parent.tracking == 'serial'"
                            readonly="not is_same_warehouse" />
                        <field name="product_id" column_invisible="True" />
                        <field name="company_id" column_invisible="True" />
                        <field name="sale_order_line_id" column_invisible="True" />
                        <field name="is_same_warehouse" column_invisible="True" />
                    </list>
                </field>

                <separator
                    string="Already Delivered"
                    invisible="not tracking_validated_line_ids" />
                <field
                    name="tracking_validated_line_ids"
                    invisible="not tracking_validated_line_ids"
                    readonly="1">
                    <list>
                        <field name="trace_id" groups="stock.group_production_lot" />
                        <field
                            name="quantity"
                            column_invisible="parent.tracking == 'serial'" />
                        <field name="product_id" column_invisible="True" />
                        <field name="sale_order_line_id" column_invisible="True" />
                        <field name="company_id" column_invisible="True" />
                    </list>
                </field>

                <footer>
                    <button
                        name="action_generate_lot"
                        type="object"
                        string="Validate"
                        class="oe_highlight"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

    <record id="fsm_stock_tracking_line_line_view_form" model="ir.ui.view">
        <field name="name">fsm.stock.tracking.line.view.form</field>
        <field name="model">wizard.project.task.update.product.lot.line</field>
        <field name="arch" type="xml">
            <form string="Track Stock">
                <group>
                    <group>
                        <field
                            name="trace_id"
                            groups="stock.group_production_lot"
                            readonly="1" />
                        <field name="quantity" readonly="1" />
                        <field name="product_id" invisible="1" />
                        <field name="sale_order_line_id" invisible="1" />
                    </group>
                </group>
            </form>
        </field>
    </record>

</odoo>
