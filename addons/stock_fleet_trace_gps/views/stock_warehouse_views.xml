<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_warehouse_view_form_trip_gps" model="ir.ui.view">
        <field name="name">stock.warehouse.form.trip.gps</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_stock_warehouse_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='warehouse_config']" position="after">
                <page name="trip_gps" string="Trip GPS">
                    <group>
                        <group string="Warehouse Geofence">
                            <field name="trip_geofence_radius" />
                        </group>
                        <group string="Route Rules">
                            <field name="trip_stop_radius" />
                            <field name="trip_stop_min_minutes" />
                            <field name="trip_unplanned_stop_minutes" />
                            <field name="trip_gps_silence_minutes" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_form_trip_gps" model="ir.ui.view">
        <field name="name">resource.asset.vehicle.form.trip.gps</field>
        <field name="model">resource.asset.vehicle</field>
        <field name="inherit_id" ref="resource_asset_vehicle.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <field name="kind_id" position="after">
                <field name="trip_delivery_vehicle" />
                <field name="trip_gps_cursor" invisible="not trip_gps_cursor" />
            </field>
        </field>
    </record>

</odoo>
