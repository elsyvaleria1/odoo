<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_trip_gps_sync" model="ir.cron">
        <field name="name">Trips: read the vehicles' GPS</field>
        <field name="model_id" ref="stock.model_stock_picking_batch" />
        <field name="state">code</field>
        <field name="code">model._cron_trip_gps_sync()</field>
        <field name="repeat_interval" eval="5" />
        <field name="repeat_unit">minute</field>
        <field name="active" eval="True" />
    </record>

</odoo>
