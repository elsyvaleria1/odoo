<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="res_config_settings_view_form_inherit_address_autocomplete"
        model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.address.autocomplete</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='address_autocomplete_setting']"
                position="inside">
                <div>
                    <div class="content-group row mt16">
                        <label
                            for="website_address_autocomplete_key"
                            string="API Key"
                            class="col-4" />
                        <field name="website_address_autocomplete_key" class="col-6" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
