<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_mrp_picking_type_kanban" model="ir.ui.view">
        <field name="name">stock.mrp.picking.type.kanban</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock_barcode.view_stock_picking_type_kanban" />
        <field name="arch" type="xml">
            <div name="action_view_pickings_ready_kanban" position="attributes">
                <attribute name="t-attf-class">
                    {{ record.count_picking_ready.value == 0 and record.count_mo_confirmed.value == 0 ? 'text-muted' : 'fw-bold' }}
                </attribute>
            </div>
            <field name="count_picking_ready" position="replace">
                <field
                    name="count_mo_confirmed"
                    t-if="record.code.raw_value == 'mrp_operation'" />
                <field name="count_picking_ready" t-else="" />
            </field>
        </field>
    </record>

    <record
        id="stock_barcode.stock_picking_type_action_kanban"
        model="ir.actions.act_window">
        <field
            name="domain">[('code', 'in', ('incoming', 'outgoing', 'internal', 'mrp_operation'))]</field>
    </record>

    <record id="view_stock_picking_type_form" model="ir.ui.view">
        <field name="name">Operation Types</field>
        <field name="model">stock.picking.type</field>
        <field
            name="inherit_id"
            ref="stock_barcode.stock_barcode_view_stock_picking_type_form" />
        <field name="arch" type="xml">
            <field name="restrict_put_in_pack" position="attributes">
                <attribute name="invisible">code == 'mrp_operation'</attribute>
            </field>
            <field name="barcode_validation_all_product_packed" position="attributes">
                <attribute name="invisible">code == 'mrp_operation'</attribute>
            </field>
            <field name="barcode_validation_full" position="replace">
                <field
                    name="barcode_validation_full"
                    invisible="restrict_scan_product or code == 'mrp_operation'" />
                <field
                    name="barcode_validation_full"
                    string="Allow full order validation"
                    help="Allow user to produce all even if no components were scanned"
                    invisible="restrict_scan_product or code != 'mrp_operation'" />
            </field>
        </field>
    </record>

</odoo>
