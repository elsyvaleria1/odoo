<templates>
    <t t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension" t-translation="off">
        <xpath expr="//header" position="inside">
            <t t-if="this.model.resModel=='mrp.production' and this.state.view === 'barcodeLines' and this.model.record.product_id and !this.state.displayByProduct">
                <Header line="this.model.record" displayUOM="this.groups.group_uom" openDetails.bind="this.toggleHeaderView"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_barcode_lines_header')]" position="attributes">
             <attribute name="t-if">!this.state.displayByProduct</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_barcode_lines')]" position="after">
            <div t-elif="this.state.view === 'headerProductPage'"> <!-- MRP Header Edit Form View -->
                <View t-props="this.headerFormViewProps"/>
            </div>
            <div t-elif="this.state.view === 'scrapProductPage'"> <!-- Scrap Create Form View -->
                <View t-props="this.scrapViewProps"/>
            </div>
        </xpath>
        <xpath expr="//footer[hasclass('o_action_buttons')]" position="inside">
            <button t-if="this.model.displayRegisterByProduct"
                    class="o_by_products btn btn-secondary" t-on-click.prevent.stop="this.openByProductLines">
                Register By-Product
            </button>
        </xpath>
        <!-- By products page buttons -->
        <xpath expr="//footer[hasclass('o_action_buttons')]" position="after">
            <footer t-if="this.state.displayByProduct and this.state.view == 'barcodeLines'"
                    class="o_barcode_control o_action_buttons d-flex justify-content-between p-2 gap-2">
                <button class="o_add_byproduct btn btn-secondary" t-on-click="this.onOpenProductPage">
                    <i class="fa-solid fa-plus me-1"/> Add By Product
                </button>
                <button class="o_save_byproduct btn btn-secondary" t-on-click="this.onValidateByProduct">
                    <i class="fa-solid fa-check me-1"/> Validate
                </button>
            </footer>

        </xpath>
    </t>
</templates>
