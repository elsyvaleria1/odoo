<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_view_form_inherit_expense" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.expense</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_expenses"
                    type="object"
                    icon="fa-dollar"
                    invisible="expenses_count == 0"
                    class="oe_stat_button">
                    <field name="expenses_count" string="Expenses" widget="statinfo" />
                </button>
            </div>
            <field name="country_id" position="after">
                <field
                    name="expense_ids"
                    invisible="1"
                    readonly="state in ['cancel', 'validated']" />
            </field>
        </field>
    </record>

</odoo>
