#. module: product_trace
#: model:ir.model.fields,help:product_trace.field_product_product__serial_prefix_format
#: model:ir.model.fields,help:product_trace.field_product_template__serial_prefix_format
msgid ""
"\n"
"            If multiple products share the same prefix, they will share the same sequence, otherwise the sequence will be dedicated to the product.\n"
"\n"
"            * Legend (for prefix):\n"
"            - Current Year with Century: %(year)s\n"
"            - Current Year without Century: %(y)s\n"
"            - Month: %(month)s\n"
"            - Day: %(day)s\n"
"            - Day of the Year: %(doy)s\n"
"            - Week of the Year: %(woy)s\n"
"            - Day of the Week (0:Monday): %(weekday)s\n"
"            - Hour 00->24: %(h24)s\n"
"            - Hour 00->12: %(h12)s\n"
"            - Minute: %(min)s\n"
"            - Second: %(sec)s\n"
"        "
msgstr ""
"\n"
"            Se più prodotti condividono lo stesso prefisso, condivideranno la stessa sequenza, altrimenti la sequenza sarà dedicata al prodotto.\n"
"\n"
"            * Legenda (per prefisso):\n"
"            - anno in corso con secolo: %(year)s\n"
"            - anno in corso senza secolo: %(y)s\n"
"            - mese: %(month)s\n"
"            - giorno: %(day)s\n"
"            - giorno dell'anno: %(doy)s\n"
"            - settimana dell'anno: %(woy)s\n"
"            - giorno della settimana (0:lunedì): %(weekday)s\n"
"            - ora 00->24: %(h24)s\n"
"            - ora 00->12: %(h12)s\n"
"            - minuto: %(min)s\n"
"            - secondo: %(sec)s\n"
"        "

