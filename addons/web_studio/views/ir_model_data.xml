<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="studio_customizations_filter" model="ir.ui.view">
        <field name="name">web_studio.customizations_filter</field>
        <field name="model">ir.model.data</field>
        <field name="inherit_id" ref="base.view_model_data_search" />
        <field name="arch" type="xml">
            <field name="module" position="after">
                <filter
                    name="studio_customiz"
                    string="Studio Customizations"
                    domain="[('studio', '=', True)]" />
            </field>
        </field>
    </record>

</odoo>
