<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="reset_view_arch_wizard_view" model="ir.ui.view">
        <field name="model">wizard.ir.ui.view.reset.arch</field>
        <field name="inherit_id" ref="base.reset_view_arch_wizard_view" />
        <field name="arch" type="xml">
            <xpath expr="/form" position="inside">
                <div name="button_box">
                    <button
                        name="reset_view_button"
                        type="object"
                        string="Reset View"
                        icon="fa-eraser"
                        invisible="not has_diff or not context.get('studio_report_diff')"
                        class="oe_stat_button"
                        data-hotkey="q" />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
