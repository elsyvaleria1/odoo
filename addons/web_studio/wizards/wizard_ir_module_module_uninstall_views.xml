<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_base_module_uninstall_studio" model="ir.ui.view">
            <field name="name">base.module.uninstall.view.form.studio</field>
            <field name="model">wizard.ir.module.module.uninstall</field>
            <field name="inherit_id" ref="base.view_base_module_uninstall" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='model_ids']" position="after">
                    <field name="is_studio" invisible="1" />
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="not is_studio or custom_models == 0 and custom_fields == 0 and custom_views == 0 and custom_reports == 0">
                        <h3 class="text-danger">Customization made with Studio will be permanently lost</h3>
                        <group>
                            <field name="custom_models" string="Custom models:" />
                            <field name="custom_fields" string="Custom fields:" />
                            <field name="custom_views" string="Custom views:" />
                            <field name="custom_reports" string="Custom reports:" />
                        </group>
                    </div>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
