<templates>

<t t-name="web_studio.ViewEditor.InteractiveEditorProperties.Button">
    <ViewStructureProperties>
        <ModifiersProperties node="this.props.node" availableOptions="this.availableOptions"/>
        <div t-if="this.showApprovals" class="o_web_studio_sidebar_approval border-bottom border-secondary pb-4 mb-3">
            <div class="d-flex align-items-center mb-1">
                <h6 class="mb-0">Approvals</h6>
                <button class="ms-auto btn btn-custom" title="Open kanban view of approvals" t-on-click="this.openKanbanApprovalRules">
                    <i class="fs-4 oi oi-view-kanban" />
                </button>
            </div>
            <t t-foreach="this.state.approvalSteps" t-as="rule" t-key="rule.id">
                <t t-call="web_studio.ViewEditorSidebar.ApprovalRule"/>
            </t>
            <div>
                <a href="#" role="button" class="o_web_studio_sidebar_btn_link" name="create_approval_rule" t-on-click="this.createApprovalRule">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>Add an approval step
                </a>
            </div>
        </div>
        <t t-if="this.showRainbowMan">
            <RainbowEffect effect="this.props.node.attrs.effect" onChange.bind="this.onChangeAttribute" />
        </t>
        <Property
            name="'string'"
            type="'string'"
            value="this.props.node.attrs.string"
            onChange.bind="this.onChangeAttribute"
            autofocus="true"
        >
            Label
        </Property>
        <ClassAttribute
            value="this.props.node.attrs.class"
            onChange.bind="this.onChangeAttribute"
        />
        <Property
            name="'title'"
            type="'string'"
            value="this.props.node.attrs.title"
            onChange.bind="this.onChangeAttribute"
        >
            Help Tooltip
        </Property>
        <Property
            name="'type'"
            type="'selection'"
            value="this.props.node.attrs.type"
            childProps="{ choices: this.types }"
            onChange.bind="this.onChangeAttribute"
        >
            What should the button do
        </Property>
        <t t-if="this.props.node.attrs.type === 'action'">
            <Property
                name="'name'"
                type="'selection'"
                value="this.currentActionValue"
                childProps="{ choices: this.actionsForModel }"
                onChange.bind="this.onChangeAttribute"
            >
                Action
            </Property>
        </t>
        <t t-else="">
            <Property
                name="'name'"
                type="'string'"
                value="this.props.node.attrs.name"
                onChange.bind="this.onChangeAttribute"
            >
                Method
            </Property>
        </t>
    </ViewStructureProperties>
</t>

<div t-name="web_studio.ViewEditorSidebar.ApprovalRule" class="o_studio_sidebar_approval_rule position-relative border-start border-secondary ps-2 mb-3">
    <Record t-props="this.recordProps" hooks="{ lifecycle: { onRecordChanged: (r, c) => this.onChangeApprovalRecord(r, c, rule.id) } }" values="rule" t-slot-scope="data">
        <t t-set="record" t-value="data.record" />
        <div>
            <div>
                <div class="d-flex">
                    <label t-attf-for="rule_responsible_{{rule.id}}">
                        Approvers
                        <sup class="text-info p-1" data-tooltip="These users are able to approve or reject the step and will be assigned to an activity when their approval is requested." t-out="'?'"/>
                    </label>
                    <div class="ms-auto">
                        <button
                                t-attf-class="btn btn-sm btn-dark o_approval_domain {{rule.subject_domain ? '' : 'opacity-50'}}"
                                t-att-data-tooltip="rule.subject_domain ? 'Edit rule condition' : 'Set condition on rule'"
                                t-on-click="() => this.onApprovalSelectDomain(rule.id)">
                                <i class="fa-solid fa-filter"/>
                        </button>
                        <button
                            class="btn btn-sm btn-dark o_approval_archive opacity-50"
                            data-tooltip="Remove rule"
                            t-on-click="() => this.onApprovalArchive(rule.id)">
                            <i class="fa-solid fa-trash-can"/>
                        </button>
                    </div>
                </div>
                <div class="o_field_widget o_field_many2one o_web_studio_sidebar_tags" t-attf-class="{{ !this.isValid('user_ids', record) ? 'border border-danger' : ''}}" name="user_ids">
                    <Many2ManyTagsField id="'approver_ids'" name="'user_ids'" record="data.record" canCreate="false" canQuickCreate="false" canCreateEdit="false" domain="this.domainResUsers"/>
                </div>
            </div>
            <label t-attf-for="rule_group_{{rule.id}}">
                Approver Group
                <sup class="text-info p-1" data-tooltip="The users in this group are able to approve or reject the step." t-out="'?'"/>
            </label>
            <div class="o_approval_group">
                <div class="o_field_widget o_field_many2one" name="group_id" t-attf-class="{{ !this.isValid('group_id', record) ? 'border border-danger' : ''}}">
                    <Many2OneField id="'approval_group_id'" name="'group_id'" record="data.record" canOpen="false" canCreate="false" canQuickCreate="false" canCreateEdit="false" domain="this.domainResUsers"/>
                </div>
            </div>
        </div>
        <div class="o_web_studio_sidebar_tags">
            <div>
                <label t-attf-for="users_to_notify_{{rule.id}}">
                    Users to Notify
                    <sup class="text-info p-1" data-tooltip="These users will receive a notification via internal note when the step is approved or rejected" t-out="'?'"/>
                </label>
                <div class="o_field_widget o_field_many2one" name="notify_user_ids">
                    <Many2ManyTagsField id="'users_to_notify'" name="'notify_user_ids'" record="data.record"/>
                </div>
            </div>
        </div>
        <div class="o_web_studio_sidebar_text">
            <label t-attf-for="approval_message_{{rule.id}}">
                Description
                <sup class="text-info p-1" data-tooltip="The step description will be displayed on the button on which an approval is requested." t-out="'?'"/>
            </label>
            <input t-attf-id="approval_message_{{rule.id}}" t-attf-name="approval_message_{{rule.id}}" type="text"
                t-att-value="rule.name || null" t-on-change="(ev) => this.onApprovalEdit('operation_approval_message', rule.id, ev.target.value)"/>
        </div>
        <div class="d-flex">
            <div class="o_web_studio_sidebar_text">
                <label t-attf-for="notification_order{{rule.id}}">
                    Approval Order
                    <sup class="text-info p-1" data-tooltip="Defines the sequential order in which the approvals are requested." t-out="'?'"/>
                </label>
                <select t-attf-id="notification_order{{rule.id}}" t-on-change="(ev) => this.onChangeNotificationOrder(ev, rule.id)" class="form-select">
                    <option t-att-selected="!rule.sequence || rule.sequence === 1">1</option>
                    <option t-att-selected="rule.sequence === 2">2</option>
                    <option t-att-selected="rule.sequence === 3">3</option>
                    <option t-att-selected="rule.sequence === 4">4</option>
                    <option t-att-selected="rule.sequence === 5">5</option>
                    <option t-att-selected="rule.sequence === 6">6</option>
                    <option t-att-selected="rule.sequence === 7">7</option>
                    <option t-att-selected="rule.sequence === 8">8</option>
                    <option t-att-selected="rule.sequence === 9">9</option>
                </select>
            </div>
            <div class="o_web_studio_sidebar_checkbox align-self-end ms-2" name="">
                <div data-tooltip="The user who approves this step will not be able to approve other steps for the same record.">
                    <CheckBox value="rule.exclusive" onChange="(value) => this.onApprovalEdit('operation_different_users', rule.id, value)" id="'exclusive_user_' + rule.id">
                        Exclusive Approval
                    </CheckBox>
                </div>
            </div>
        </div>
    </Record>
</div>

</templates>
