<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_get_result" model="ir.cron">
        <field name="name">Website Generator: Get website scraper results</field>
        <field
            name="model_id"
            ref="website_generator.model_website_generator_request" />
        <field name="state">code</field>
        <field name="code">model.get_result_waiting_requests()</field>
        <field name="repeat_interval">15</field>
        <field name="repeat_unit">minute</field>
        <field name="active" eval="False" />
    </record>

</odoo>
