msgstr "Token enmascarado"

#. module: telegram
#: model:ir.model.constraint,message:telegram.constraint_telegram_bot_token_hash_uniq
msgid "Token hash must be unique (duplicate bot token detected)!"
msgstr ""
"¡El hash del token debe ser único (se detectó un token de bot duplicado)!"

#. module: telegram
#: model:ir.model.fields,field_description:telegram.field_telegram_message__thread_uid
msgid "Topic"
msgstr "Tema"

