msgstr "✓ Tu número %(phone)s quedó registrado."

#. module: telegram
#. odoo-python
#: code:addons/telegram/models/telegram_bot.py:0
msgid "📱 Share my phone number"
msgstr "📱 Compartir mi número de teléfono"

#. module: telegram
#. odoo-python
#: code:addons/telegram/models/telegram_router.py:0
