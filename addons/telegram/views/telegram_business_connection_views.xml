<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="telegram_business_connection_view_list" model="ir.ui.view">
        <field name="name">telegram.business.connection.list</field>
        <field name="model">telegram.business.connection</field>
        <field name="arch" type="xml">
            <list create="False" edit="False">
                <field name="bot_id" />
                <field name="account_id" />
                <field name="user_id" />
                <field name="is_enabled" />
                <field name="can_reply" />
                <field name="connection_uid" optional="hide" />
            </list>
        </field>
    </record>

    <record id="telegram_business_connection_view_form" model="ir.ui.view">
        <field name="name">telegram.business.connection.form</field>
        <field name="model">telegram.business.connection</field>
        <field name="arch" type="xml">
            <form create="False" edit="False">
                <sheet>
                    <group>
                        <group>
                            <field name="bot_id" />
                            <field name="account_id" />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="is_enabled" />
                            <field name="can_reply" />
                            <field name="connection_uid" />
                        </group>
                    </group>
                    <field name="chat_ids">
                        <list>
                            <field name="chat_id" />
                            <field name="account_id" />
                            <field name="last_message_time" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_business_connection" model="ir.actions.act_window">
        <field name="name">Business Connections</field>
        <field name="res_model">telegram.business.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Telegram Business account manages its chats through a bot yet</p>
            <p>An owner connects a bot in Telegram, under Settings, Telegram Business, Chatbots.</p>
        </field>
    </record>

</odoo>
