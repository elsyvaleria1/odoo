<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telegram_bot_list" model="ir.ui.view">
        <field name="name">telegram.bot.list</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <list string="Telegram Bots">
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company"
                    optional="show" />
            </list>
        </field>
    </record>

    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot">
                <header>
                    <button
                        name="action_register_webhook"
                        type="object"
                        string="Register Webhook"
                        groups="base.group_system" />
                </header>
                <sheet>
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not legacy_secretless_webhook"
                        groups="base.group_system">
                        This bot has no <b>Webhook Secret</b>. Without it the bot token in the
                        webhook URL is the only credential, and that URL is written to every
                        proxy access log it passes through. <b>Register Webhook</b> generates
                        a secret and tells Telegram to send it with every update.
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                groups="base.group_multi_company" />
                            <field
                                name="credential_id"
                                context="{                                     'default_endpoint_id': %(telegram.service_telegram)d,                                     'default_category_id': %(credential.credential_category_bearer_token)d,                                     'default_company_id': company_id,                                 }" />
                            <field name="lang" />
                            <field name="answer_in_bot_lang" />
                            <field name="moved_to_id" />
                            <field name="token_masked" groups="base.group_system" />
                            <field name="bot_username" />
                            <field name="can_read_all_group_messages" />
                        </group>
                        <group>
                            <field
                                name="webhook_receiver_id"
                                groups="base.group_system" />
                            <field name="legacy_secretless_webhook" invisible="1" />
                            <field
                                name="command_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Linked Chats">
                            <field name="chat_ids">
                                <list create="False">
                                    <field name="chat_id" />
                                    <field name="chat_type" />
                                    <field name="account_id" />
                                    <field name="partner_id" />
                                    <field name="last_message_time" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_bot" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
