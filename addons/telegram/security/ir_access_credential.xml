<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credential_privilege_operate" model="ir.access">
        <field
            name="name">Credential: the bot reads whether a Telegram credential is on the air</field>
        <field name="model_id" ref="credential.model_credential_credential" />
        <field name="group_id" ref="privilege_operate_bot" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field name="domain">[('endpoint_id.code', '=', 'telegram')]</field>
    </record>

</odoo>
