<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_journal_view_form" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.point_of_sale</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="tax_policy" position="attributes">
                <attribute name="invisible">type not in ['sale', 'purchase', 'general']</attribute>
            </field>
        </field>
    </record>

</odoo>
