<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account.access_account_bank_statement_crud" model="ir.access">
        <field name="active" eval="False" />
    </record>

    <record
        id="account.access_account_bank_statement_group_invoice_r"
        model="ir.access">
        <field name="active" eval="False" />
    </record>

    <record id="account.access_account_bank_statement_line_crud" model="ir.access">
        <field name="active" eval="False" />
    </record>

    <record
        id="account.access_account_bank_statement_line_group_invoice_r"
        model="ir.access">
        <field name="active" eval="False" />
    </record>

    <record id="access_pos_session_choose_balancing_account" model="ir.access">
        <field
            name="name">pos.session: an accounting reader picks the account that balances a session closed by force</field>
        <field name="model_id" ref="model_pos_session" />
        <field name="group_id" ref="account.group_account_readonly" />
        <field name="kind">permission</field>
        <field name="verbs">choose_balancing_account</field>
    </record>

    <record id="access_class_receipt_text" model="ir.access.class">
        <field name="name">point_of_sale.receipt_text</field>
        <field
            name="description">The custom header and footer a point of sale prints on every receipt. Everyone who reads the point of sale reads them; only access administrators change them.</field>
    </record>

    <record id="access_receipt_text_erp_manager" model="ir.access">
        <field name="name">point_of_sale.receipt_text: access administrators</field>
        <field name="group_id" ref="base.group_erp_manager" />
        <field name="kind">permission</field>
        <field name="operation">u</field>
        <field name="class_id" ref="access_class_receipt_text" />
    </record>

    <record id="access_class_terminal_credential" model="ir.access.class">
        <field name="name">point_of_sale.terminal_credential</field>
        <field
            name="description">The secrets a point of sale reaches a payment terminal, a cash machine or a delivery platform with. Its managers and the system administrators read and change them, as they do every secret.credential; a till's own requests spend them through privilege_spend_terminal_credentials, and a cashier reads none.</field>
    </record>

    <record id="access_terminal_credential_manager" model="ir.access">
        <field
            name="name">point_of_sale.terminal_credential: point of sale managers</field>
        <field name="group_id" ref="group_pos_manager" />
        <field name="kind">permission</field>
        <field name="operation">ru</field>
        <field name="class_id" ref="access_class_terminal_credential" />
    </record>

    <record id="access_terminal_credential_system" model="ir.access">
        <field
            name="name">point_of_sale.terminal_credential: system administrators</field>
        <field name="group_id" ref="base.group_system" />
        <field name="kind">permission</field>
        <field name="operation">ru</field>
        <field name="class_id" ref="access_class_terminal_credential" />
    </record>

    <record id="privilege_spend_terminal_credentials" model="res.groups">
        <field
            name="name">Privilege: spend a terminal's secrets on a till's request</field>
        <field name="is_privilege" eval="True" />
    </record>

    <record id="access_terminal_credential_spend" model="ir.access">
        <field
            name="name">point_of_sale.terminal_credential: a till's request to its terminal</field>
        <field name="group_id" ref="privilege_spend_terminal_credentials" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field name="class_id" ref="access_class_terminal_credential" />
    </record>

    <record id="access_pos_config_load_demo_data" model="ir.access">
        <field
            name="name">pos.config: an administrator creates a sample point of sale or fills one with sample data</field>
        <field name="model_id" ref="model_pos_config" />
        <field name="group_id" ref="base.group_system" />
        <field name="kind">permission</field>
        <field name="verbs">load_demo_data</field>
    </record>

</odoo>
