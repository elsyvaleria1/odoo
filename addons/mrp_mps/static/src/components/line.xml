<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mrp_mps.MpsLineComponent">
        <tbody class="o_mps_content" t-att-data-id="this.productionSchedule.id" t-att-data-warehouse_id="'warehouse_id' in this.productionSchedule and this.productionSchedule.warehouse_id[0]">
            <tr class="bg-light">
                <th>
                    <CheckBox value='this.isSelected' onChange.bind="(ev) => this.toggleSelection(ev, this.productionSchedule.id)"/>
                </th>
                <th scope="col">
                    <a href="#" class="o_mrp_mps_record_url" t-att-data-res-id="this.productionSchedule.product_id[0]" t-att-data-model="'product.product'" t-on-click.prevent="this._onClickForecastReport"><t t-out="this.productionSchedule.product_id[1]"/></a>
                    <span t-if="'product_uom_id' in this.productionSchedule" class="text-muted"> by <t t-out="this.productionSchedule.product_uom_id[1]"/></span>
                    <span t-if="'warehouse_id' in this.productionSchedule"> - <t t-out="this.productionSchedule.warehouse_id[1]"/></span>
                    <span> </span>
                    <button type="button" t-attf-class="{{'btn btn-link text-muted o_no_padding o_mrp_mps_edit'}}" t-on-click.stop="(ev) => this._onClickEdit(ev, this.productionSchedule.id)">
                        <span class="fa-solid fa-pencil text-muted" role="img" aria-label="Forecasted" title="Forecasted"/>
                    </button>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th class="text-end">
                        <span t-attf-class="{{! this.groups.mrp_mps_show_starting_inventory and 'o_hidden' or 'text-end'}} {{forecast.starting_inventory_qty ? '' : 'o_zero_qty'}}" t-out="this.formatFloat(forecast.starting_inventory_qty)" data-tooltip="The forecasted quantity in stock at the beginning of the period." data-tooltip-position="bottom"/>
                    </th>
                </t>
            </tr>
            <tr name="demand_forecast_year_minus_2" t-attf-class="{{! this.groups.mrp_mps_show_actual_demand_year_minus_2 and 'o_hidden' or ''}}">
                <th/>
                <th scope="row">
                    <span>Actual Demand Y-2</span>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th class="text-end">
                        <span t-out="this.formatFloat(forecast.outgoing_qty_year_minus_2)"/>
                    </th>
                </t>
            </tr>
            <tr name="demand_forecast_year_minus_1" t-attf-class="{{! this.groups.mrp_mps_show_actual_demand_year_minus_1 and 'o_hidden' or ''}}">
                <th/>
                <th scope="row">
                    <span>Actual Demand Y-1</span>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th class="text-end">
                        <span t-out="this.formatFloat(forecast.outgoing_qty_year_minus_1)"/>
                    </th>
                </t>
            </tr>
            <tr t-ref="this.forecastRow" name="demand_forecast" t-attf-class="{{! (this.groups.mrp_mps_show_demand_forecast or this.groups.mrp_mps_show_actual_demand) and 'o_hidden' or ''}}">
                <th class="o_text_align"> - </th>
                <th scope="row">
                    <span t-attf-class="{{! this.groups.mrp_mps_show_actual_demand and 'o_hidden' or ''}}" data-tooltip="The confirmed demand, based on the confirmed sales orders." data-tooltip-position="bottom">Actual</span>
                    <span t-attf-class="{{! (this.groups.mrp_mps_show_actual_demand and this.groups.mrp_mps_show_demand_forecast) and 'o_hidden' or ''}}"> / </span>
                    <span t-attf-class="{{! this.groups.mrp_mps_show_demand_forecast and 'o_hidden' or ''}}" data-tooltip="The forecasted demand. This value has to be entered manually." data-tooltip-position="bottom">Forecasted Demand</span>
                    <span> </span>
                    <button type="button" t-attf-class="{{! this.groups.mrp_mps_show_safety_stock and 'o_hidden' or 'btn btn-link text-muted o_no_padding o_mrp_mps_edit'}}" t-on-click.stop="(ev) => this._onClickSuggestForecastedDemand(ev, this.productionSchedule.id)">
                        <span class="fa-solid fa-pencil text-muted" role="img" aria-label="Suggest Forecasted Demand" title="Suggest Forecasted Demand"/>
                    </button>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th>
                        <div class="o_mps_inline">
                            <a href="#"
                            name="actual_demand"
                            t-on-click="this._onClickOpenDetails"
                            data-action="action_view_actual_demand_details"
                            t-att-data-date_index="forecast_index"
                            t-att-data-date_start="forecast.date_start"
                            t-att-data-date_stop="forecast.date_stop"
                            t-attf-class="{{! this.groups.mrp_mps_show_actual_demand and 'o_hidden' or 'o_mrp_mps_open_details'}} {{forecast.qty_outgoing ? '' : 'o_zero_qty'}} {{forecast.qty_outgoing > forecast.forecast_qty ? 'text-danger' : ''}}">
                                <t t-out="this.formatFloat(forecast.qty_outgoing)"/>
                            </a>
                            <span t-attf-class="{{! (this.groups.mrp_mps_show_actual_demand and this.groups.mrp_mps_show_demand_forecast) and 'o_hidden' or ''}}"> / </span>
                            <input type="text"
                            t-att-data-date_index="forecast_index"
                            t-attf-class="text-end o_highlight form-control
                            {{! this.groups.mrp_mps_show_demand_forecast and 'o_hidden' or ''}}
                            {{forecast.forecast_qty ? '' : 'o_zero_qty'}}"
                            t-att-value="this.formatFloat(forecast.forecast_qty)"
                            t-on-change.stop="(ev) => this._onChangeForecast(ev, this.productionSchedule.id)"
                            t-on-focus.prevent="this._onFocusInput"/>
                        </div>
                    </th>
                </t>
            </tr>
            <tr name="indirect_demand" t-attf-class="{{! (this.groups.mrp_mps_show_indirect_demand and this.productionSchedule.has_indirect_demand) and ! (this.groups.mrp_mps_show_indirect_actual_demand and this.productionSchedule.has_indirect_actual_demand) and 'o_hidden' or ''}}">
                <th class="o_text_align"> - </th>
                 <th scope="row">
                    <span t-attf-class="{{! this.groups.mrp_mps_show_indirect_actual_demand and 'o_hidden' or ''}}" data-tooltip="The confirmed demand, based on the manufacturing orders." data-tooltip-position="bottom">Actual</span>
                    <span t-attf-class="{{! (this.groups.mrp_mps_show_indirect_actual_demand and this.groups.mrp_mps_show_indirect_demand) and 'o_hidden' or ''}}"> / </span>
                    <span t-attf-class="{{! this.groups.mrp_mps_show_indirect_demand and 'o_hidden' or ''}}" data-tooltip="The forecasted demand to fulfill the needs in components of the Manufacturing Orders." data-tooltip-position="bottom">Indirect Demand Forecast</span>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th>
                        <div class="o_mps_inline">
                            <span t-attf-class="text-end {{! this.groups.mrp_mps_show_indirect_actual_demand and 'o_hidden' or ''}} {{forecast.indirect_outgoing_qty ? 'text-muted' : 'o_zero_qty'}} {{forecast.indirect_outgoing_qty > forecast.indirect_demand_qty ? 'text-danger' : ''}}">
                                <t t-out="this.formatFloat(forecast.indirect_outgoing_qty)"/>
                            </span>
                            <span t-attf-class="{{! (this.groups.mrp_mps_show_indirect_actual_demand and this.groups.mrp_mps_show_indirect_demand) and 'o_hidden' or ''}}"> / </span>
                            <span t-attf-class="text-end {{! this.groups.mrp_mps_show_indirect_demand and 'o_hidden' or ''}} {{forecast.indirect_demand_qty ? 'text-muted' : 'o_zero_qty'}}">
                                <t t-out="this.formatFloat(forecast.indirect_demand_qty)"/>
                            </span>
                        </div>
                    </th>
                </t>
            </tr>
            <tr t-ref="this.replenishRow" name="to_replenish" t-attf-class="{{! (this.groups.mrp_mps_show_to_replenish or this.groups.mrp_mps_show_actual_replenishment) and 'o_hidden' or ''}}">
                <th class="o_text_align"> + </th>
                <th scope="row">
                    <span t-attf-class="{{! this.groups.mrp_mps_show_actual_replenishment and 'o_hidden' or ''}}" data-tooltip="The quantity being replenished, based on the Requests for Quotation and the Manufacturing Orders." data-tooltip-position="bottom">Actual</span>
                    <span t-attf-class="{{! (this.groups.mrp_mps_show_actual_replenishment and this.groups.mrp_mps_show_to_replenish) and 'o_hidden' or ''}}"> / </span>
                    <span t-attf-class="{{! this.groups.mrp_mps_show_to_replenish and 'o_hidden' or ''}}"
                          data-tooltip="The quantity to replenish through Purchase Orders or Manufacturing Orders.&#10;Color code: Green if to replenish now, Red if existing replenishment is too high for the period, Orange if current replenishment is too low."
                          data-tooltip-position="bottom">Replenishment: </span>
                    <button type="button" title="Replenish" t-attf-class="{{! this.groups.mrp_mps_show_to_replenish and 'o_hidden' or 'btn btn-secondary o_mrp_mps_procurement'}}"
                            t-if="this.forecastToReplenish"
                            t-on-click.stop="() => this._onClickReplenish(this.productionSchedule.id)"
                            t-on-mouseover.stop="this._onMouseOverReplenish"
                            t-on-mouseout.stop="this._onMouseOutReplenish">
                        Order
                    </button>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th t-attf-class="o_forecast_stock {{
                        forecast.to_replenish and 'o_mrp_mps_to_replenish' or ''
                        }} {{
                        forecast.forced_replenish and 'o_mrp_mps_forced_replenish' or ''
                        }}">
                        <div class="o_mps_inline">
                            <a href="#"
                            name="actual_replenishment"
                            t-on-click.prevent="this._onClickOpenDetails"
                            data-action="action_view_actual_replenishment_details"
                            t-att-data-date_index="forecast_index"
                            t-att-data-date_start="forecast.date_start"
                            t-att-data-date_stop="forecast.date_stop"
                            t-attf-class="o_mrp_mps_open_details {{
                                ! this.groups.mrp_mps_show_actual_replenishment and 'o_hidden'
                                }}">
                                <t t-out="this.formatFloat(forecast.qty_incoming)"/>
                            </a>
                            <span t-attf-class="{{! (this.groups.mrp_mps_show_actual_replenishment and this.groups.mrp_mps_show_to_replenish) and 'o_hidden' or ''}}"> / </span>
                            <button type="button"
                                t-if="forecast.replenish_qty_updated"
                                t-on-click.stop="(ev) => this._onClickAutomaticMode(ev, this.productionSchedule.id)"
                                t-att-data-date_index="forecast_index"
                                t-attf-class="btn btn-link input-group-addon
                                o_mrp_mps_automatic_mode fa-solid fa-xmark o_no_padding
                                {{! this.groups.mrp_mps_show_to_replenish and 'o_hidden' or ''}}"/>
                            <input type="text"
                            t-att-data-date_index="forecast_index"
                            t-attf-class="form-control text-end
                                o_mrp_mps_input_replenish_qty
                                {{! this.groups.mrp_mps_show_to_replenish and 'o_hidden' or ''}}
                                {{(!this.isReadonly and forecast.state == 'launched') and 'bg-secondary' or
                                (!this.isReadonly and forecast.state == 'to_relaunch') and 'bg-warning-subtle' or
                                (!this.isReadonly and forecast.state == 'to_correct') and 'bg-danger-subtle' or
                                (!this.isReadonly and forecast.to_replenish) and 'bg-success-subtle' or
                                (forecast.replenish_qty_updated and this.props.data.replenish_trigger != 'never') and 'bg-info-subtle' or ''
                                }} {{
                                forecast.replenish_qty ? '' : 'o_zero_qty'
                                }}"
                            t-att-value="this.formatFloat(forecast.replenish_qty)"
                            t-on-change.stop="(ev) => this._onChangeToReplenish(ev, this.productionSchedule.id)"
                            t-on-focus="this._onFocusInput"
                            t-att-readonly="this.isReadonly"/>
                        </div>
                    </th>
                </t>
            </tr>
            <tr name="safety_stock" t-attf-class="{{! (this.groups.mrp_mps_show_safety_stock or this.groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}">
                <th class="o_text_align"> = </th>
                <th scope="row">
                    <span t-attf-class="{{! this.groups.mrp_mps_show_available_to_promise and 'o_hidden' or ''}}" data-tooltip="Quantity predicted to be available for sale at the end of the period (= to replenish - actual demand)." data-tooltip-position="bottom">ATP</span>
                    <span t-attf-class="{{! (this.groups.mrp_mps_show_safety_stock and this.groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}"> / </span>
                    <span t-attf-class="{{! this.groups.mrp_mps_show_safety_stock and 'o_hidden' or ''}}" data-tooltip="The forecasted quantity in stock at the end of the period." data-tooltip-position="bottom">Forecasted Stock</span>
                </th>
                <t t-foreach="this.productionSchedule.forecast_ids" t-as="forecast" t-key="forecast_index">
                    <th class="text-end">
                        <span t-attf-class="{{! this.groups.mrp_mps_show_available_to_promise and 'o_hidden' or ''}} {{(forecast.starting_inventory_qty - forecast.qty_outgoing - forecast.indirect_outgoing_qty + (forecast.qty_incoming > forecast.replenish_qty ? forecast.qty_incoming : forecast.replenish_qty)) ? '' : 'o_zero_qty'}}" t-out="this.formatFloat(forecast.starting_inventory_qty - forecast.qty_outgoing - forecast.indirect_outgoing_qty + (forecast.qty_incoming > forecast.replenish_qty ? forecast.qty_incoming : forecast.replenish_qty))"/>
                        <span t-attf-class="{{! (this.groups.mrp_mps_show_safety_stock and this.groups.mrp_mps_show_available_to_promise) and 'o_hidden' or ''}}"> / </span>
                        <span t-attf-class="{{forecast.safety_stock_qty &lt; 0 and 'text-danger' or ''}} {{! this.groups.mrp_mps_show_safety_stock and 'o_hidden' or ''}} {{forecast.safety_stock_qty ? '' : 'o_zero_qty'}}" t-out="this.formatFloat(forecast.safety_stock_qty)"/>
                    </th>
                </t>
            </tr>
        </tbody>
    </t>

</templates>
