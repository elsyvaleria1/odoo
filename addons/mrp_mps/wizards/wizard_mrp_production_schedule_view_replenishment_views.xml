<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_mps_forecast_details_form_view" model="ir.ui.view">
        <field name="name">mrp.mps.forecast.details.form</field>
        <field name="model">wizard.mrp.production.schedule.view.replenishment</field>
        <field name="arch" type="xml">
            <form>
                <field name="move_ids" invisible="1" />
                <field name="purchase_order_line_ids" invisible="1" />
                <field name="rfq_qty" invisible="1" />
                <field name="moves_qty" invisible="1" />
                <field name="manufacture_qty" invisible="1" />
                <div class="row">
                    <div class="d-grid col-md-4">
                        <button
                            name="action_view_rfq_details"
                            type="object"
                            invisible="not rfq_qty"
                            class="btn btn-primary">
                            <field name="rfq_string" />
                        </button>
                        <button
                            name="action_view_rfq_details"
                            type="object"
                            string="Requests for quotation"
                            invisible="rfq_qty"
                            class="btn btn-secondary" />
                    </div>
                    <div class="d-grid col-md-4">
                        <button
                            name="action_view_incoming_moves_details"
                            type="object"
                            invisible="not moves_qty"
                            class="btn btn-primary">
                            <field name="moves_string" />
                        </button>
                        <button
                            name="action_view_incoming_moves_details"
                            type="object"
                            string="Receipts"
                            invisible="moves_qty"
                            class="btn btn-secondary" />
                    </div>
                    <div class="d-grid col-md-4">
                        <button
                            name="action_view_mo_details"
                            type="object"
                            invisible="not manufacture_qty"
                            class="btn btn-primary">
                            <field name="manufacture_string" />
                        </button>
                        <button
                            name="action_view_mo_details"
                            type="object"
                            string="Manufacturing Orders"
                            invisible="manufacture_qty"
                            class="btn btn-secondary" />
                    </div>
                </div>
                <footer>
                    <button
                        special="cancel"
                        string="Close"
                        class="btn btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
