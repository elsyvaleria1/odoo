<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_mps_forecast_suggestion_form_view" model="ir.ui.view">
        <field name="name">mrp.mps.forecast.suggestion.form</field>
        <field name="model">wizard.mrp.production.schedule.update.forecast</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <div class="text-muted">
                        <p>Forecast Quantity for <field name="product_id" options="{'no_open': True}" readonly="mrp_mps_id" class="oe_inline fw-bold" /> based on historical date or actual demand.</p>
                    </div>
                </group>
                <group>
                    <label for="period" />
                    <div>
                        <field
                            name="period"
                            widget="mps_selection"
                            class="oe_inline me-2" />
                    </div>
                    <label for="based_on" />
                    <div>
                        <field
                            name="based_on"
                            invisible="period"
                            class="oe_inline me-1" />
                        <field
                            name="based_on_readonly"
                            invisible="not period"
                            class="oe_inline me-1" />
                        x <field name="percent_factor" class="o_small oe_inline me-1 text-center" /> %
                    </div>
                </group>
                <footer>
                    <button
                        name="apply_forecast_quantity_suggestion"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn btn-secondary"
                        data-hotkey="x" />
                    <div
                        class="position-absolute end-0 pe-3 text-end text-info fw-bold"
                        invisible="not period and based_on not in ['30_days', 'three_months', 'one_year']">
                        <field name="quantity_before_scale" class="oe_inline" /> units x 
                        <field name="percent_factor" readonly="True" class="o_small oe_inline me-1" />% = 
                        <field name="quantity" class="oe_inline" /> units
                    </div>
                </footer>
            </form>
        </field>
    </record>

</odoo>
