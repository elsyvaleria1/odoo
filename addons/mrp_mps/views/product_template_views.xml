<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_only_mps" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.mrp.mps</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_form_only" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_mps_view"
                    type="object"
                    icon="fa-area-chart"
                    groups="mrp.group_mrp_manager"
                    invisible="schedule_count == 0"
                    class="oe_stat_button">
                    <field name="schedule_count" string="Schedules" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
