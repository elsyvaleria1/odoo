<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_form_view_pricers" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit.pricers</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_product_form_normal" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_sale']" position="after">
                <group
                    name="description"
                    string="Pricer"
                    groups="point_of_sale.group_pos_manager">
                    <field name="pricer_store_id" />
                    <!-- Use product id and its pricer store id as default values for its pricer tags -->
                    <field
                        name="pricer_tag_ids"
                        widget="many2many_tags"
                        context="{                         'default_product_id': id,                         'default_pricer_store_id': pricer_store_id,                     }"
                        invisible="not pricer_store_id" />
                </group>
            </xpath>

            <xpath expr="//label[@id='standard_price_label']" position="before">
                <field
                    name="on_sale_price"
                    widget="monetary"
                    invisible="not pricer_sale_pricelist_id"
                    readonly="1" />
                <field
                    name="pricer_sale_pricelist_id"
                    widget="many2one"
                    options="{'no_create':True}" />
            </xpath>
        </field>
    </record>

</odoo>
