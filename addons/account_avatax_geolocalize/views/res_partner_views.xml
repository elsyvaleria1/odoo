<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='geo_localize_button']" position="replace">
                <field name="is_avatax_valid" invisible="1" />
                <button
                    name="geo_localize"
                    type="object"
                    string="Compute based on address"
                    title="Compute Localization"
                    icon="fa-gear"
                    invisible="partner_latitude != 0 or partner_longitude != 0"
                    class="btn btn-link p-0" />
                <button
                    name="geo_localize"
                    type="object"
                    string="Refresh"
                    title="Refresh Localization"
                    icon="fa-refresh"
                    invisible="is_avatax_valid or partner_latitude == 0 and partner_longitude == 0"
                    class="btn btn-link p-0" />
            </xpath>
        </field>
    </record>

</odoo>
