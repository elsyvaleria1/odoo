<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.planning.field.service</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="planning.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="planning" position="after">
                <block name="field_service" title="Field Service">
                    <setting
                        help="Log where the phone was when a visit is started and completed">
                        <field name="group_field_service_allow_geolocation" />
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
