<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_databases" model="res.groups.privilege">
        <field name="name">Databases</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_services" />
    </record>

    <record id="group_databases_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_databases" />
        <field name="comment">User can access the client databases</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('project.group_project_user'))]" />
    </record>

    <record id="group_databases_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_databases" />
        <field name="comment">Administrator can manage the client databases</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('databases.group_databases_user')), Command.link(ref('project.group_project_manager'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
