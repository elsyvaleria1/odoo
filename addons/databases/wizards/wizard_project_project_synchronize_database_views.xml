<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="databases_synchronization_wizard_view_form" model="ir.ui.view">
            <field name="name">databases.synchronization.wizard.view.form</field>
            <field name="model">wizard.project.project.synchronize.database</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div>
                            <field name="summary_message" colspan="2" readonly="1" />
                        </div>
                        <div invisible="not error_message">
                            <field
                                name="error_message"
                                widget="text"
                                colspan="2"
                                readonly="1"
                                decoration-danger="1" />
                        </div>
                        <group invisible="not new_properties">
                            <div>
                                <label
                                    for="new_properties"
                                    class="fw-normal mt-3 mb-1" />
                                <field
                                    name="new_properties"
                                    widget="json_checkboxes"
                                    options="{'stacked': True}"
                                    class="ms-3" />
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button
                            name="action_add_metrics_to_dashboard"
                            type="object"
                            string="Continue"
                            class="oe_highlight"
                            data-hotkey="q" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
