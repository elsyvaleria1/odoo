<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_account_budget" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.account.budget</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="action_budget"
                    type="object"
                    string="Budget"
                    icon="fa-bar-chart"
                    invisible="not is_analytic or is_above_budget" />
                <button
                    name="action_budget"
                    type="object"
                    string="Budget"
                    icon="fa-bar-chart"
                    invisible="not is_analytic or not is_above_budget"
                    class="text-danger" />
            </xpath>
            <xpath
                expr="//page[@name='order_lines']/field[@name='line_ids']/list"
                position="attributes">
                <attribute name="decoration-danger">is_above_budget</attribute>
            </xpath>
        </field>
    </record>

</odoo>
