<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_integration_twilio_config_update_view_form" model="ir.ui.view">
        <field name="name">wizard.integration.twilio.config.update.view.form</field>
        <field name="model">wizard.integration.twilio.config.update</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Twilio Account">
                <group string="Credentials">
                    <field name="company_id" invisible="1" />
                    <label for="twilio_account_sid" />
                    <div class="d-flex align-items-center">
                        <field
                            name="twilio_account_sid"
                            placeholder="ACabcde12345abcde12345abcde12345ab"
                            required="1" />
                        <a
                            target="_blank"
                            class="btn btn-link ms-1 w-25"
                            role="button"
                            href="https://www.twilio.com/docs/iam/api/account">
                            Need help ?
                            <i
                                class="fa-solid fa-up-right-from-square"
                                aria-hidden="true" />
                        </a>
                    </div>
                    <field
                        name="twilio_auth_token"
                        placeholder="abcde12345abcde12345abcde12345ab"
                        password="True"
                        required="1" />
                </group>
                <group string="Account">
                    <field name="twilio_account_status" />
                    <field name="twilio_account_type" />
                    <field name="twilio_currency_id" invisible="1" />
                    <field name="amount_twilio_balance" />
                    <field name="amount_twilio_balance_alert" />
                    <field name="twilio_alert_user_id" />
                    <label for="date_twilio_checked" />
                    <div class="d-flex align-items-center">
                        <field name="date_twilio_checked" />
                        <button
                            name="action_check_account"
                            type="object"
                            string="Check Now"
                            icon="fa-heartbeat"
                            class="btn btn-link ms-1" />
                    </div>
                </group>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not is_automated_sms_blocked">
                    No number here may send automated SMS (notifications, mass SMS,
                    marketing automation): they will fail. Send them through Odoo, or
                    add a number that is not limited to conversations.
                </div>
                <group string="SMS">
                    <field
                        name="sms_provider"
                        widget="radio"
                        options="{'horizontal': true}" />
                    <label for="test_number" />
                    <div class="d-flex align-items-center">
                        <field name="test_number" placeholder="+1 555-123-4567" />
                        <button
                            name="action_send_test"
                            type="object"
                            string="Send test SMS"
                            icon="fa-send"
                            class="btn btn-link w-25 ms-1" />
                    </div>
                </group>
                <group string="Phone Numbers">
                    <div colspan="2" class="d-flex gap-2">
                        <button
                            name="action_sync_numbers"
                            type="object"
                            string="Sync Numbers from Twilio"
                            icon="fa-refresh"
                            class="btn btn-secondary" />
                        <button
                            name="action_route_sms"
                            type="object"
                            string="Receive SMS in Odoo"
                            icon="fa-inbox"
                            class="btn btn-secondary" />
                    </div>
                    <field name="twilio_number_ids" colspan="2" nolabel="1">
                        <list editable="bottom" delete="0">
                            <field name="sequence" widget="handle" />
                            <field name="country_id" />
                            <field name="number" placeholder="+1 555-123-4567" />
                            <field name="is_sms_capable" />
                            <field name="is_voice_capable" />
                            <field name="is_conversation_only" />
                            <field name="is_sms_routed" />
                            <field name="user_ids" widget="many2many_tags" />
                            <button
                                name="action_unlink"
                                type="object"
                                title="Delete"
                                icon="fa-solid fa-trash-can" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="action_save"
                        type="object"
                        string="Update Account"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
