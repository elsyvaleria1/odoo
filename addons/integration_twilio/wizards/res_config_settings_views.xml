<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field
                name="name">res.config.settings.view.form.inherit.integration.twilio</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sms.res_config_settings_view_form" />
            <field name="priority" eval="0" />
            <field name="arch" type="xml">
                <xpath expr="//widget[@service_name='sms']" position="before">
                    <field
                        name="sms_provider"
                        widget="radio"
                        options="{'horizontal': true}"
                        required="True"
                        class="o_light_label" />
                    <div class="content-group">
                        <button
                            name="action_view_integration_twilio_config"
                            type="object"
                            string="Configure Twilio Account"
                            icon="oi-arrow-right"
                            class="btn-link" />
                    </div>
                </xpath>
                <xpath expr="//widget[@service_name='sms']" position="attributes">
                    <attribute name="invisible">sms_provider == 'twilio'</attribute>
                </xpath>
            </field>
        </record>
        <record id="res_config_settings_view_form_mail" model="ir.ui.view">
            <field
                name="name">res.config.settings.view.form.inherit.integration.twilio.mail</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="mail.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@id='mail_twilio_sid']" position="before">
                    <div
                        class="text-muted"
                        invisible="twilio_account_sid or twilio_account_token">
                        Left empty, calls use the company's Twilio account.
                    </div>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
