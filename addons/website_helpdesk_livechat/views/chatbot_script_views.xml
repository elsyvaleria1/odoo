<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="chatbot_script_view_form" model="ir.ui.view">
            <field
                name="name">chatbot.script.view.form.inherit.helpdesk.livechat</field>
            <field name="model">chatbot.script</field>
            <field name="inherit_id" ref="im_livechat.chatbot_script_view_form" />
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button
                        name="action_view_tickets"
                        type="object"
                        icon="fa-life-ring"
                        invisible="ticket_count == 0"
                        class="oe_stat_button">
                        <field name="ticket_count" string="Tickets" widget="statinfo" />
                    </button>
                </div>
            </field>
        </record>
    </data>

</odoo>
