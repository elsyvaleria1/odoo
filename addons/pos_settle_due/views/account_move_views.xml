<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="due_account_move_list_view" model="ir.ui.view">
        <field name="name">account.move.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Invoices">
                <field name="currency_id" column_invisible="True"/>  <!-- Monetary field -->
                <field name="name" />
                <field name="invoice_date" string="Invoice Date" />
                <field
                    name="invoice_date_due"
                    widget="remaining_days"
                    optional="show"
                    invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'" />
                <field
                    name="amount_total"
                    widget="monetary"
                    sum="Amount total"
                    decoration-bf="1" />
                <field
                    name="pos_amount_unsettled"
                    string="Due"
                    widget="monetary"
                    sum="Total due" />
                <field
                    name="payment_state"
                    widget="badge"
                    optional="show"
                    invisible="state in ['draft', 'submit', 'cancel']"
                    decoration-danger="payment_state in ('reversed','not_paid')"
                    decoration-info="payment_state in ('partial','in_payment')"
                    decoration-success="payment_state == 'paid'" />
            </list>
        </field>
    </record>

</odoo>
