<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="training_simulator_view_kanban" model="ir.ui.view">
        <field name="name">training.simulator.view.kanban</field>
        <field name="model">training.simulator</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="area"
                group_create="false"
                records_draggable="false">
                <field name="session_count" />
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fs-1 lh-1"><field name="icon" /></div>
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold fs-5" />
                                <field
                                    name="description"
                                    class="text-muted small d-block" />
                                <div class="mt-2 d-flex gap-2 align-items-center">
                                    <button
                                        name="action_play"
                                        type="object"
                                        class="btn btn-primary btn-sm">
                                        Play
                                    </button>
                                    <button
                                        name="action_view_sessions"
                                        type="object"
                                        class="btn btn-link btn-sm">
                                        <field name="session_count" /> sessions
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="training_simulator_view_list" model="ir.ui.view">
        <field name="name">training.simulator.view.list</field>
        <field name="model">training.simulator</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="icon" />
                <field name="name" />
                <field name="area" />
                <field name="code" groups="base.group_no_one" />
                <field name="session_count" />
            </list>
        </field>
    </record>

    <record id="training_simulator_view_form" model="ir.ui.view">
        <field name="name">training.simulator.view.form</field>
        <field name="model">training.simulator</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_play"
                        type="object"
                        string="Play"
                        class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_sessions"
                            type="object"
                            icon="fa-trophy"
                            class="oe_stat_button">
                            <field
                                name="session_count"
                                string="Sessions"
                                widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="icon" class="oe_inline me-2" /><field name="name" class="oe_inline" /></h1>
                    </div>
                    <group name="main">
                        <group>
                            <field name="area" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="play_route" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <field
                            name="tagline"
                            placeholder="e.g. Run a real delivery trip from start to finish, without any risk." />
                        <field
                            name="flow_steps"
                            placeholder="e.g. Sale order, Picking, Delivery" />
                    </group>
                    <field name="description" placeholder="What the player learns" />
                    <notebook>
                        <page name="game" string="Game" />
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_training_simulator" model="ir.actions.act_window">
        <field name="name">Simulators</field>
        <field name="res_model">training.simulator</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
