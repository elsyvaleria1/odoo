<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="training_simulator_session_view_list" model="ir.ui.view">
        <field name="name">training.simulator.session.view.list</field>
        <field name="model">training.simulator.session</field>
        <field name="arch" type="xml">
            <list
                create="false"
                decoration-muted="state == 'running'"
                decoration-success="passed">
                <field name="date_start" />
                <field name="user_id" widget="many2one_avatar_user" />
                <field name="simulator_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="variant" />
                <field name="scenario" />
                <field name="mode" optional="show" />
                <field name="duration" string="Minutes" widget="float_time" />
                <field name="error_count" />
                <field name="passed" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'running'"
                    decoration-success="state == 'done'" />
            </list>
        </field>
    </record>

    <record id="training_simulator_session_view_form" model="ir.ui.view">
        <field name="name">training.simulator.session.view.form</field>
        <field name="model">training.simulator.session</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="simulator_id" />
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="variant" />
                            <field name="scenario" />
                            <field name="mode" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field
                                name="duration"
                                string="Minutes"
                                widget="float_time" />
                            <field name="error_count" />
                            <field name="passed" />
                        </group>
                    </group>
                    <notebook>
                        <page name="summary" string="Summary">
                            <field name="summary" />
                        </page>
                        <page
                            name="snapshot"
                            string="Data used"
                            groups="training_simulator.group_training_instructor">
                            <field name="snapshot" widget="json" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="training_simulator_session_view_search" model="ir.ui.view">
        <field name="name">training.simulator.session.view.search</field>
        <field name="model">training.simulator.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id" />
                <field name="simulator_id" />
                <filter
                    name="my"
                    string="My sessions"
                    domain="[('user_id', '=', uid)]" />
                <filter
                    name="passed"
                    string="Passed"
                    domain="[('passed', '=', True)]" />
                <separator />
                <filter
                    name="group_user"
                    string="Player"
                    context="{'group_by': 'user_id'}" />
                <filter
                    name="group_simulator"
                    string="Simulator"
                    context="{'group_by': 'simulator_id'}" />
                <filter
                    name="group_area"
                    string="Area"
                    context="{'group_by': 'area'}" />
            </search>
        </field>
    </record>

    <record id="action_training_simulator_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">training.simulator.session</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
