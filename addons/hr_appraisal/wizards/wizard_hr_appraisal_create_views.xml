<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_appraisal_campaign_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.campaign.wizard.form</field>
        <field name="model">wizard.hr.appraisal.create</field>
        <field name="arch" type="xml">
            <form string="Appraisal Campaign">
                <group>
                    <field name="mode" />
                    <field
                        name="employee_ids"
                        placeholder="All Employees"
                        widget="many2many_avatar_employee"
                        invisible="mode != 'employee'" />
                    <field
                        name="company_id"
                        invisible="mode != 'company'"
                        required="mode == 'company'" />
                    <field
                        name="department_id"
                        invisible="mode != 'department'"
                        required="mode == 'department'" />
                    <field
                        name="tag_id"
                        invisible="mode != 'category'"
                        required="mode == 'category'" />
                    <field
                        name="manager"
                        string="Manager"
                        widget="radio"
                        class="o_appraisal_radio_button" />
                    <field
                        name="manager_ids"
                        string="Other"
                        placeholder="Type Employee's Name"
                        widget="many2many_avatar_employee"
                        invisible="manager != 'person'"
                        required="manager == 'person'" />
                    <field name="appraisal_template_id" />
                    <field
                        name="appraisal_date"
                        widget="datetime"
                        options="{'min_date':'today'}" />
                </group>
                <group>
                    <field
                        name="warning"
                        nolabel="1"
                        invisible="not warning"
                        class="alert alert-warning"
                        style="white-space: pre-wrap"
                        role="alert" />
                </group> 
                <footer>
                    <button
                        name="action_generate_appraisals"
                        type="object"
                        string="Schedule"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
