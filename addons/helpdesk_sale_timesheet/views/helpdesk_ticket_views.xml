<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="helpdesk_ticket_view_form_inherit_helpdesk_sale_timesheet"
        model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.sale.timesheet</field>
        <field name="model">helpdesk.ticket</field>
        <field
            name="inherit_id"
            ref="helpdesk_timesheet.helpdesk_ticket_view_form_inherit_helpdesk_timesheet" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_ids']/list" position="inside">
                <field name="timesheet_invoice_id" column_invisible="True" />
                <field name="is_so_line_edited" column_invisible="True" />
                <field name="helpdesk_ticket_id" column_invisible="True" />
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']"
                position="before">
                <field
                    name="so_line"
                    widget="so_line_field"
                    optional="show"
                    domain="[('is_service', '=', True), ('partner_id', 'child_of', parent.commercial_partner_id), ('is_expense', '=', False), ('state', '=', 'done'), ('is_downpayment', '=', False)]"
                    options="{'no_create': True, 'no_open': True}"
                    groups="!sale.group_sale_salesman"
                    column_invisible="not parent.use_helpdesk_sale_timesheet or not parent.partner_id"
                    readonly="readonly_timesheet" />
                <field
                    name="so_line"
                    widget="so_line_field"
                    optional="hide"
                    domain="[('is_service', '=', True), ('partner_id', 'child_of', parent.commercial_partner_id), ('is_expense', '=', False), ('state', '=', 'done'), ('is_downpayment', '=', False)]"
                    context="{'with_remaining_hours': True, 'with_price_unit': True}"
                    options="{'no_create': True, 'no_open': True}"
                    groups="sale.group_sale_salesman"
                    column_invisible="not parent.use_helpdesk_sale_timesheet or not parent.partner_id"
                    readonly="readonly_timesheet" />
            </xpath>
            <xpath expr="//field[@name='project_id']" position="before">
                <field name="use_helpdesk_sale_timesheet" invisible="1" />
                <field name="display_invoice_button" invisible="1" />
            </xpath>
            <xpath
                expr="//button[@name='action_view_helpdesk_ticket']"
                position="before">
                <button
                    name="action_view_so"
                    type="object"
                    icon="fa-dollar"
                    groups="sale.group_sale_salesman"
                    invisible="not use_helpdesk_sale_timesheet or not sale_order_id and not sale_line_id"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sales Order</span>
                    </div>
                </button>
                <button
                    name="action_view_invoices"
                    type="object"
                    string="Invoices"
                    icon="fa-pencil-square-o"
                    groups="account.group_account_readonly,account.group_account_invoice,account.group_account_manager,sale.group_sale_salesman_all_leads"
                    invisible="not display_invoice_button"
                    class="oe_stat_button">
                    <field name="invoice_count" string="Invoices" widget="statinfo" />
                </button>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="sale_order_state" invisible="1" />
                <label
                    for="sale_line_id"
                    invisible="not use_helpdesk_sale_timesheet or not partner_id" />
                <div
                    class="o_row"
                    invisible="not use_helpdesk_sale_timesheet or not partner_id">
                    <field
                        name="sale_line_id"
                        placeholder="Non-billable"
                        options="{'no_open': True}"
                        groups="!sale.group_sale_salesman"
                        readonly="True" />
                    <field
                        name="sale_line_id"
                        placeholder="Non-billable"
                        widget="so_line_create_button"
                        context="{                             'so_form_view_ref': 'sale_project.view_order_simple_form',                             'create_for_ticket_id': id,                             'default_partner_id': partner_id,                             'default_company_id': company_id,                             'default_project_id': project_id,                             'with_remaining_hours': True,                             'with_price_unit': True,                             'is_downpayment': False,                             'dialog_size': 'large',                          }"
                        options="{'no_create': True}"
                        groups="sale.group_sale_salesman" />
                    <span
                        class="fa-solid fa-exclamation-triangle text-warning"
                        title="The sales order associated with this ticket has been cancelled. We recommend either updating the sales order item or cancelling this ticket in alignment with the cancellation of the sales order."
                        invisible="sale_order_state != 'cancel'" />
                </div>
            </xpath>
            <xpath expr="//field[@name='total_hours_spent']" position="after">
                <t groups="sale.group_sale_salesman">
                    <field name="remaining_hours_available" invisible="1" />
                    <span
                        id="remaining_hours_so_label"
                        invisible="not sale_order_id or not use_helpdesk_sale_timesheet or not partner_id or not sale_line_id or not remaining_hours_available">
                        <label
                            for="remaining_hours_so"
                            invisible="remaining_hours_so &lt; 0"
                            class="fw-bold" />
                        <label
                            for="remaining_hours_so"
                            invisible="remaining_hours_so &gt;= 0"
                            class="fw-bold text-danger" />
                    </span>
                    <field
                        name="remaining_hours_so"
                        widget="timesheet_uom"
                        nolabel="1"
                        invisible="not sale_order_id or not use_helpdesk_sale_timesheet or not partner_id or not sale_line_id or not remaining_hours_available"
                        decoration-danger="remaining_hours_so &lt; 0" />
                </t>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_ticket_view_tree_inherit_sale_timesheet" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list.inherit.sale.timesheet</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree" />
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field
                    name="sale_line_id"
                    optional="hide"
                    groups="helpdesk_sale.group_use_helpdesk_sale_timesheet"
                    readonly="1" />
            </field>
        </field>
    </record>

</odoo>
