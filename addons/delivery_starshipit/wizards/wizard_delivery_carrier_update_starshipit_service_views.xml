<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shipping_method_starshipit" model="ir.ui.view">
        <field name="name">Starshipit Shipping Wizard</field>
        <field name="model">wizard.delivery.carrier.update.starshipit.service</field>
        <field name="arch" type="xml">
            <form string="Shipping Product">
                <field name="available_services" invisible="1" />
                <field name="carrier_id" invisible="1" />
                <div colspan="2" class="alert alert-info" role="status">
                    <p><i class="fa-solid fa-info-circle" /> Available shipping services depend on enabled carriers in your Starshipit account.</p>
                </div>
                <div class="g-col-sm-2"><div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">Delivery Service</div></div>
                <field
                    name="selected_service_code"
                    widget="starshipit_service_selection" />
                <footer>
                    <button
                        name="action_validate"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Cancel"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
