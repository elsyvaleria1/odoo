<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="task_to_ticket_wizard" model="wizard.project.task.convert.ticket">
            <field name="team_id" ref="helpdesk.helpdesk_team1" />
            <field name="stage_id" ref="helpdesk.stage_new" />
        </record>
        <function
            model="wizard.project.task.convert.ticket"
            name="action_convert"
            context="{'to_convert': [ref('project_helpdesk_task_1')]}">
            <value
                model="wizard.project.task.convert.ticket"
                eval="obj().env.ref('project_helpdesk.task_to_ticket_wizard').id" />
        </function>
    </data>

</odoo>
