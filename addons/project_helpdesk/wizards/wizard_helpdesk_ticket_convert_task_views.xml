<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record
            id="helpdesk_ticket_convert_to_task_wizard_view_form"
            model="ir.ui.view">
            <field name="name">helpdesk.ticket.convert.wizard.form</field>
            <field name="model">wizard.helpdesk.ticket.convert.task</field>
            <field name="arch" type="xml">
                <form string="Convert to Task">
                    <sheet>
                        <group>
                            <field
                                name="project_id"
                                options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}"
                                required="1" />
                            <field
                                name="step_id"
                                domain="[('project_ids', 'in', project_id)]"
                                options="{'no_create': 1, 'no_edit': 1, 'no_open': 1}" />
                        </group>
                    </sheet>
                    <footer>
                        <button
                            name="action_convert"
                            type="object"
                            string="Convert"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            name="cancel"
                            special="cancel"
                            string="Discard"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
