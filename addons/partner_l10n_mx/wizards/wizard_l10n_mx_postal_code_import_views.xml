<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_l10n_mx_postal_code_import_form" model="ir.ui.view">
        <field name="name">wizard.l10n_mx.postal_code.import.form</field>
        <field name="model">wizard.l10n_mx.postal_code.import</field>
        <field name="arch" type="xml">
            <form string="Import the SEPOMEX catalogue">
                <p>
                    Download <code>cpdescarga.txt</code> from Correos de México and upload it
                    as it comes. Each settlement is linked to its municipality by its INEGI key,
                    and importing a newer catalogue over an older one adds what is new.
                </p>
                <group>
                    <field name="sepomex_file" filename="sepomex_filename" />
                    <field name="sepomex_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Import"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_l10n_mx_postal_code_import" model="ir.actions.act_window">
        <field name="name">Import SEPOMEX Catalogue…</field>
        <field name="res_model">wizard.l10n_mx.postal_code.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_l10n_mx_postal_code" />
    </record>

</odoo>
