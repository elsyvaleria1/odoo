<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hr_expense_stripe_test_shipping_wizard_form" model="ir.ui.view">
            <field name="name">hr.expense.stripe.test.shipping.wizard.form</field>
            <field name="model">wizard.hr.expense.stripe.card.simulate.shipping</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field
                                name="card_shipping_status"
                                string="Current Shipping Status"
                                readonly="True" />
                            <field name="new_shipping_status" widget="selection" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_update_shipping_status" type="object" class="btn btn-primary">Simulate Shipping</button>
                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
