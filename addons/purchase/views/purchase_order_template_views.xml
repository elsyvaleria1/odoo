<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_template_view_search" model="ir.ui.view">
        <field name="name">purchase.order.template.search</field>
        <field name="model">purchase.order.template</field>
        <field name="arch" type="xml">
            <search string="Search RFQ Template">
                <field name="name" />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="company_id"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="purchase_order_template_view_form" model="ir.ui.view">
        <field name="name">purchase.order.template.form</field>
        <field name="model">purchase.order.template</field>
        <field name="arch" type="xml">
            <form string="RFQ Template">
                <sheet>
                    <div name="button_box" class="oe_button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Weekly fertilizer order"
                                class="d-block" />
                        </h1>
                    </div>
                    <group>
                        <group name="purchase_info">
                            <field name="active" invisible="1" />
                            <label for="number_of_days" string="RFQ Validity" />
                            <div id="number_of_days">
                                <field name="number_of_days" style="width: 3rem;" />
                                <div class="d-inline-block">days</div>
                            </div>
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook name="main_book">
                        <page name="order_lines" string="Lines">
                            <field
                                name="line_ids"
                                widget="section_and_note_one2many"
                                options="{'subsections': True}">
                                <list string="RFQ Template Lines" editable="bottom">
                                    <control>
                                        <create
                                            name="add_product_control"
                                            string="Add a product" />
                                        <create
                                            name="add_section_control"
                                            string="Add a section"
                                            context="{'default_display_type': 'line_section'}" />
                                        <create
                                            name="add_note_control"
                                            string="Add a note"
                                            context="{'default_display_type': 'line_note'}" />
                                    </control>
                                    <field
                                        name="display_type"
                                        column_invisible="True" />
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="product_id"
                                        required="not display_type" />
                                    <field name="name" widget="section_and_note_text" />
                                    <field name="product_qty" />
                                    <field
                                        name="product_uom_id"
                                        groups="uom.group_uom"
                                        required="not display_type" />
                                </list>
                            </field>
                        </page>
                        <page
                            name="terms_and_conditions"
                            string="Terms &amp; Conditions">
                            <field
                                name="note"
                                placeholder="Terms set here show up on every request for quotation made from this template." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_order_template_view_list" model="ir.ui.view">
        <field name="name">purchase.order.template.list</field>
        <field name="model">purchase.order.template</field>
        <field name="arch" type="xml">
            <list string="RFQ Templates">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="purchase_order_template_action" model="ir.actions.act_window">
        <field name="name">RFQ Templates</field>
        <field name="res_model">purchase.order.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your request for quotation template
            </p><p>
                Use templates for the purchases you repeat: the same products,
                quantities and terms, ready in one click.
            </p>
        </field>
    </record>

</odoo>
