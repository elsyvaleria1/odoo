<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="appointment_type_view_form" model="ir.ui.view">
        <field
            name="name">appointment.type.view.form.inherit.appointment.google.calendar</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="calendar.appointment_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div
                    class="alert alert-warning mb-2 d-flex flex-wrap align-items-center"
                    role="alert"
                    invisible="connectors_displayed or not users_wo_google_calendar_msg">
                    <field name="users_wo_google_calendar_msg" />
                    <button
                        name="%(calendar.calendar_settings_action)d"
                        type="action"
                        groups="base.group_system"
                        invisible="connector_google"
                        class="btn btn-link">
                        <i class="oi oi-fw o_button_icon oi-arrow-right" /> Settings
                    </button>
                </div>
            </xpath>
            <xpath
                expr="//div[hasclass('o_appointment_cal_sync_alert')]"
                position="inside">
                <widget
                    name="appointment_sync_button"
                    invisible="not connector_google"
                    calendarName="Google"
                    iconSrc="/calendar/static/src/booking/img/google-calendar.svg" />
            </xpath>
        </field>
    </record>

</odoo>
