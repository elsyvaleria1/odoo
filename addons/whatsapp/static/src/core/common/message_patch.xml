<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="whatsapp.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-header')]" position="inside">
            <t t-if="this.message.message_type === 'whatsapp_message'">
                <span class="fa-brands fa-whatsapp ms-1" t-att-class="this.getWhatsappStatusClass()" t-att-title="this.getWhatsappStatusTitle()" />
            </t>
        </xpath>
    </t>

</templates>
