<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="whatsapp.PhoneField" t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]//a" position="after">
            <t t-if="this.props.enableWhatsAppButton and this.props.record.data[this.props.name].length > 0">
                <SendWhatsAppButton t-props="this.props" />
            </t>
        </xpath>
    </t>

    <t t-name="whatsapp.FormPhoneField" t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-if="this.props.enableWhatsAppButton and  this.props.record.data[this.props.name].length > 0">
                <SendWhatsAppButton t-props="this.props" />
            </t>
        </xpath>
    </t>

</templates>
