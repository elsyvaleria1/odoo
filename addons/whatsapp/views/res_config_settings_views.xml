<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="web.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting position="before" id="tenor_api_key">
                <setting
                    id="module_whatsapp"
                    string="WhatsApp"
                    help="Send and receive message through your WhatsApp Business account."
                    documentation="/applications/productivity/whatsapp.html">
                    <div class="mt16">
                        <button
                            name="%(whatsapp.whatsapp_account_action)d"
                            type="action"
                            string="Configure Meta Accounts"
                            icon="oi-arrow-right"
                            class="oe_link" />
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
