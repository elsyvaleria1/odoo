<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="ir_cron_send_whatsapp_queue" model="ir.cron">
            <field name="name">WhatsApp : Send In Queue Messages</field>
            <field name="model_id" ref="whatsapp.model_whatsapp_message" />
