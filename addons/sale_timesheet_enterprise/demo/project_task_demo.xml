<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- set task date_start and date_end -->
        <function model="project.task" name="write">
            <value
                model="project.task"
                search="[('sale_line_id', '=', ref('sale_timesheet.sale_line_construction_44'))]" />
            <value
                eval="{                 'date_start': (DateTime.today() - relativedelta(days=4)).strftime('%Y-%m-%d %H:%M'),                 'date_end': (DateTime.today() - relativedelta(days=2)).strftime('%Y-%m-%d %H:%M'),             }" />
        </function>
        <function model="project.task" name="write">
            <value
                model="project.task"
                search="[('sale_line_id', '=', ref('sale_timesheet.sale_line_construction_42'))]" />
            <value
                eval="{                 'date_start': (DateTime.today() - relativedelta(days=2)).strftime('%Y-%m-%d %H:%M'),                 'date_end': (DateTime.today() - relativedelta(days=1)).strftime('%Y-%m-%d %H:%M'),             }" />
        </function>
    </data>

</odoo>
