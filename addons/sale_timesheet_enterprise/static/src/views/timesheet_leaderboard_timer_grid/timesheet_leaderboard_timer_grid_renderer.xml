<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="sale_timesheet_enterprise.LeaderboardTimerGridRenderer" t-inherit="timesheet_grid.TimerGridRenderer" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='this.showTimer']" position="inside">
            <div t-if="this.timesheetLeaderboardService.showIndicators and !this.timerState.timerRunning" class="position-relative w-100 pe-3 py-2 py-sm-1 d-flex justify-content-end">
                <TimesheetLeaderboard
                    model="this.props.model"
                    date="this.leaderboardMonth"
                />
            </div>
        </xpath>
        <xpath expr="//div[@t-if='this.showTimer']/GridTimesheetTimerHeader" position="attributes">
            <attribute name="t-if">this.showTimer</attribute>
        </xpath>
        <xpath expr="//div[@t-if='this.showTimer']" position="attributes">
            <attribute name="t-if" add="this.timesheetLeaderboardService.showLeaderboard or this.timesheetLeaderboardService.showIndicators" separator=" or "/>
        </xpath>
    </t>

</templates>
