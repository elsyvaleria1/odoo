<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telegram_bot_form_inherit_approval" model="ir.ui.view">
        <field name="name">telegram.bot.form.inherit.approval</field>
        <field name="model">telegram.bot</field>
        <field name="inherit_id" ref="telegram.view_telegram_bot_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='command_ids']" position="after">
                <field name="has_pago_command" invisible="1" />
                <field
                    name="payment_approval_category_id"
                    invisible="not has_pago_command" />
                <field name="has_especie_command" invisible="1" />
                <field
                    name="especie_approval_category_id"
                    invisible="not has_especie_command" />
            </xpath>
        </field>
    </record>

</odoo>
