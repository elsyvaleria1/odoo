<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telegram_payment_report_log_list" model="ir.ui.view">
        <field name="name">telegram.payment.report.log.list</field>
        <field name="model">telegram.payment.report.log</field>
        <field name="arch" type="xml">
            <list
                string="Pay Approval Bot Reports"
                create="false"
                edit="false"
                delete="false">
                <field name="date" />
                <field name="user_id" string="Registered By" />
                <field name="partner_id" string="Contact" optional="hide" />
                <field name="approval_subject" />
                <field name="amount" widget="monetary" />
                <field
                    name="approval_state"
                    widget="badge"
                    decoration-danger="approval_state == 'refused'"
                    decoration-info="approval_state == 'new'"
                    decoration-success="approval_state == 'approved'"
                    decoration-warning="approval_state == 'pending'" />
            </list>
        </field>
    </record>

    <record id="view_telegram_payment_report_log_form" model="ir.ui.view">
        <field name="name">telegram.payment.report.log.form</field>
        <field name="model">telegram.payment.report.log</field>
        <field name="arch" type="xml">
            <form string="Payment Log" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(base.action_partner_form)d"
                            type="action"
                            icon="fa-user"
                            context="{'default_id': partner_id}"
                            invisible="not partner_id"
                            class="oe_stat_button">
                            <field
                                name="partner_id"
                                string="Contact"
                                widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group string="Request Information">
                            <field name="date" />
                            <field name="user_id" />
                            <field name="partner_id" />
                            <field name="amount" />
                        </group>
                        <group string="Approval Status">
                            <field name="approval_request_id" />
                            <field name="approval_subject" />
                            <field
                                name="approval_state"
                                widget="badge"
                                decoration-danger="approval_state == 'refused'"
                                decoration-success="approval_state == 'approved'"
                                decoration-warning="approval_state == 'pending'" />
                        </group>
                    </group>
                    <group string="Payment Details">
                        <field name="payment_details_display" colspan="2" nolabel="1" />
                    </group>
                    <group string="Telegram Details" groups="base.group_system">
                        <field name="chat_id" />
                        <field name="telegram_chat_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_payment_report_log_search" model="ir.ui.view">
        <field name="name">telegram.payment.report.log.search</field>
        <field name="model">telegram.payment.report.log</field>
        <field name="arch" type="xml">
            <search string="Search Payment Logs">
                <field name="user_id" />
                <field name="partner_id" />
                <field name="approval_subject" />
                <field name="telegram_chat_id" />
                <separator />
                <filter
                    name="filter_approved"
                    string="Approved"
                    domain="[('approval_state', '=', 'approved')]" />
                <filter
                    name="filter_refused"
                    string="Refused"
                    domain="[('approval_state', '=', 'refused')]" />
                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('approval_state', '=', 'pending')]" />
                <separator />
                <filter
                    name="group_user"
                    string="Registered By"
                    context="{'group_by': 'user_id'}" />
                <filter
                    name="group_state"
                    string="Status"
                    context="{'group_by': 'approval_state'}" />
                <filter
                    name="group_date"
                    string="Date"
                    context="{'group_by': 'date:day'}" />
            </search>
        </field>
    </record>

    <record id="action_telegram_payment_report_log" model="ir.actions.act_window">
        <field name="name">Pay Approval Bot Reports</field>
        <field name="res_model">telegram.payment.report.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payment registrations yet
            </p>
            <p>
                This view shows all payment approval requests created via the Telegram Pay Approval Bot.
            </p>
        </field>
    </record>

</odoo>
