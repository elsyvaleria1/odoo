#. module: trade_agreement_competition
#: model:ir.model.fields,field_description:trade_agreement_competition.field_mixin_agreement_line__display_name
msgid "Display Name"
msgstr "Nombre para mostrar"

#. module: trade_agreement_competition
#: model:ir.model.fields,field_description:trade_agreement_competition.field_mixin_agreement_line__price_gap
msgid "Gap to Market (%)"
msgstr "Diferencia con el mercado (%)"

#. module: trade_agreement_competition
#: model:ir.model.fields,help:trade_agreement_competition.field_mixin_agreement_line__price_gap
msgid ""
"How far the agreed price sits above (positive) or below (negative) the "
"market price."
msgstr ""
"Qué tan por encima (positivo) o por debajo (negativo) del precio de mercado "
"está el precio acordado."

#. module: trade_agreement_competition
#: model:ir.model.fields,field_description:trade_agreement_competition.field_mixin_agreement_line__id
msgid "ID"
msgstr "ID"

#. module: trade_agreement_competition
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__mixin_agreement_line__market_scope__segment
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__purchase_agreement_line__market_scope__segment
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__sale_agreement_line__market_scope__segment
msgid "Its Industry"
msgstr "Su industria"

#. module: trade_agreement_competition
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__mixin_agreement_line__market_scope__market
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__purchase_agreement_line__market_scope__market
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__sale_agreement_line__market_scope__market
msgid "Market"
msgstr "Mercado"

#. module: trade_agreement_competition
#: model:ir.model.fields,field_description:trade_agreement_competition.field_mixin_agreement_line__market_price
msgid "Market Price"
msgstr "Precio de mercado"

#. module: trade_agreement_competition
#: model:ir.model.fields,field_description:trade_agreement_competition.field_mixin_agreement_line__market_scope
msgid "Market Scope"
msgstr "Alcance del mercado"

#. module: trade_agreement_competition
#: model:ir.model.fields,help:trade_agreement_competition.field_mixin_agreement_line__market_price
msgid ""
"The best comparable price competitors offer this product today: to the "
"agreement's partner when known, else to its industry, else to the market. "
"Per this line's unit, in the agreement's currency."
msgstr ""
"El mejor precio comparable que la competencia ofrece hoy por este producto: "
"al contacto del acuerdo cuando se conoce, si no, a su industria, si no, al "
"mercado. Por la unidad de esta línea, en la moneda del acuerdo."

#. module: trade_agreement_competition
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__mixin_agreement_line__market_scope__partner
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__purchase_agreement_line__market_scope__partner
#: model:ir.model.fields.selection,name:trade_agreement_competition.selection__sale_agreement_line__market_scope__partner
msgid "This Partner"
msgstr "Este contacto"

#. module: trade_agreement_competition
#: model:ir.model,name:trade_agreement_competition.model_mixin_agreement_line
msgid "Trade Agreement Line"
msgstr "Línea de acuerdo comercial"
