<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record
            id="ai_prompt_transcription_summarize_recruitment_call"
            model="ai.prompt.button">
            <field name="name">Summarize this recruitment call</field>
        </record>
        <record
            id="ai_prompt_transcription_summarize_prospect_call"
            model="ai.prompt.button">
            <field name="name">Summarize this prospect call</field>
        </record>
        <record id="ai_prompt_transcription_write_email_recap" model="ai.prompt.button">
            <field name="name">Write an email recap</field>
        </record>
        <record id="ai_voice_transcription" model="ai.composer">
            <field name="name">Summarize Voice Transcription</field>
            <field name="interface_key">voice_transcription_component</field>
            <field name="ai_agent" ref="ai.ai_default_agent" />
            <field
                name="default_prompt">Summarize the transcript below.

Your summary should be structured in a way that is easy to skim. It should only contain the essential information.
It must be in markdown format. Do NOT put the main markup inside code blocks.</field>
            <field name="is_system_default">True</field>
            <field
                name="available_prompts"
                eval="[Command.link(ref('ai_speech.ai_prompt_transcription_summarize_recruitment_call')), Command.link(ref('ai_speech.ai_prompt_transcription_summarize_prospect_call')), Command.link(ref('ai_speech.ai_prompt_transcription_write_email_recap'))]" />
        </record>
    </data>

</odoo>
