<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="res_config_settings_view_form_inherit_stock_approval"
        model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="priority" eval="90" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']" position="after">
                <block name="stock_approval_settings" title="Stock Transfer Approvals">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="stock_auto_validate_on_approval" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="stock_auto_validate_on_approval" />
                            <div class="text-muted">
                                Automatically validate transfers when all approvals are granted
                            </div>
                            <div class="text-muted mt16">
                                Configure which transfers need approval at:
                                <a
                                    href="/web#action=approval.approval_category_action"
                                    class="btn-link"
                                    role="button">
                                    Approvals → Configuration → Approval Types
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
