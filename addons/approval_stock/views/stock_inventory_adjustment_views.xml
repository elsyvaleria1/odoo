<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_inventory_adjustment_list" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.list</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="reason" />
                <field name="date_counted" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="approval_state" widget="badge" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-muted="state == 'cancelled'"
                    decoration-success="state == 'applied'" />
            </list>
        </field>
    </record>

    <record id="view_stock_inventory_adjustment_form" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.form</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_create_approval_request"
                        type="object"
                        string="Request Approval"
                        invisible="state != 'draft' or approval_request_id"
                        class="btn-primary" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,applied" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_approval_request"
                            type="object"
                            string="Approval"
                            icon="fa-check-square-o"
                            invisible="not approval_request_id"
                            class="oe_stat_button" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="reason"
                                readonly="state != 'draft' or approval_state == 'pending'" />
                            <field
                                name="date_counted"
                                readonly="state != 'draft' or approval_state == 'pending'" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field
                                name="approval_request_id"
                                invisible="not approval_request_id" />
                            <field
                                name="approval_state"
                                invisible="not approval_request_id" />
                            <field name="date_applied" invisible="not date_applied" />
                        </group>
                    </group>
                    <field
                        name="line_ids"
                        readonly="state != 'draft' or approval_state == 'pending'">
                        <list editable="bottom" create="0">
                            <field name="product_id" />
                            <field name="location_id" />
                            <field
                                name="trace_id"
                                optional="show"
                                groups="stock.group_production_lot" />
                            <field
                                name="package_id"
                                optional="hide"
                                groups="stock.group_tracking_lot" />
                            <field
                                name="owner_id"
                                optional="hide"
                                groups="stock.group_tracking_owner" />
                            <field name="quantity_on_hand" />
                            <field name="quantity_counted" />
                            <field
                                name="quantity_difference"
                                decoration-danger="quantity_difference &lt; 0"
                                decoration-success="quantity_difference &gt; 0" />
                            <field
                                name="product_uom_id"
                                optional="show"
                                groups="uom.group_uom" />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_stock_inventory_adjustment_search" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.search</field>
        <field name="model">stock.inventory.adjustment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field
                    name="line_ids"
                    string="Product"
                    filter_domain="[('line_ids.product_id', 'ilike', self)]" />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="approval_pending"
                    string="Waiting Approval"
                    domain="[('approval_state', '=', 'pending')]" />
                <filter
                    name="applied"
                    string="Applied"
                    domain="[('state', '=', 'applied')]" />
                <group>
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Adjustment Approvals</field>
        <field name="res_model">stock.inventory.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
