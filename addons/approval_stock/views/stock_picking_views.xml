<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_inherit_approval" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="approval_state" invisible="1" />
                <field name="approval_required" invisible="1" />
                <field name="approval_request_id" invisible="1" />
            </xpath>

            <xpath expr="//header/button[@name='action_confirm']" position="before">
                <button
                    name="action_create_approval_request"
                    type="object"
                    string="Request Approval"
                    groups="stock.group_stock_user"
                    invisible="not approval_required or approval_state in ['pending', 'approved']"
                    class="oe_highlight" />

                <field
                    name="approval_state"
                    widget="badge"
                    invisible="not approval_required or approval_state == 'new'"
                    decoration-danger="approval_state == 'refused'"
                    decoration-success="approval_state == 'approved'"
                    decoration-warning="approval_state == 'pending'" />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_approval_request"
                    type="object"
                    icon="fa-check-square-o"
                    groups="stock.group_stock_user"
                    invisible="not approval_request_id"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <field
                            name="approval_state"
                            string="Approval"
                            widget="statinfo" />
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='extra']" position="after">
                <page
                    name="approval_info"
                    string="Approval Info"
                    groups="stock.group_stock_user"
                    invisible="not approval_required and not approval_request_id">
                    <group>
                        <group>
                            <field name="approval_required" />
                            <field name="approval_request_id" readonly="1" />
                        </group>
                        <group>
                            <field name="approval_state" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree_inherit_approval" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.approval</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_list_vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="approval_required" optional="hide" />
                <field name="approval_state" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_stock_location_form_inherit_approval" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.approval</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_stock_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="stock_approval_required" />
            </xpath>
        </field>
    </record>

    <record id="view_product_category_form_inherit_stock_approval" model="ir.ui.view">
        <field name="name">product.category.form.inherit.stock.approval</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.view_product_category_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="stock_approval_required" />
            </xpath>
        </field>
    </record>

</odoo>
