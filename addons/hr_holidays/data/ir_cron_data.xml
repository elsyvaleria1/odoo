<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_allocation_cron_accrual" model="ir.cron">
        <field name="name">Accrual Time Off: Updates the number of time off</field>
        <field name="model_id" ref="model_hr_leave_allocation" />
        <field name="state">code</field>
        <field name="code">model._update_accrual()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
    </record>

    <record id="hr_leave_cron_cancel_invalid" model="ir.cron">
        <field name="name">Time Off: Cancel invalid leaves</field>
        <field name="model_id" ref="model_hr_leave" />
        <field name="state">code</field>
        <field name="code">model._cancel_invalid_leaves()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
    </record>

    <record id="ir_cron_resource_state_from_leaves" model="ir.cron">
        <field name="name">Time Off: Put people on leave and back</field>
        <field name="model_id" ref="base.model_resource_resource" />
        <field name="state">code</field>
        <field name="code">model._cron_sync_state_from_leaves()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">hour</field>
    </record>

</odoo>
