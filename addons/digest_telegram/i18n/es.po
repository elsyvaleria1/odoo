#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Choose Send Mode:</strong> Replace email entirely or\n"
"                                    send both Telegram + Email"
msgstr ""
"<strong>Elige el modo de envío:</strong> reemplazar el correo por completo o\n"
"                                    enviar por Telegram y por correo"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Configure Telegram Bot:</strong> Go to Telegram Bot menu\n"
"                                    and create/configure a bot"
msgstr ""
"<strong>Configura el bot de Telegram:</strong> ve al menú Bot de Telegram\n"
"                                    y crea o configura un bot"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Link User to Telegram:</strong> Each user must be linked\n"
"                                    to a Telegram chat via the Telegram Bot menu"
msgstr ""
"<strong>Vincula al usuario con Telegram:</strong> cada usuario debe estar vinculado\n"
"                                    a un chat de Telegram desde el menú Bot de Telegram"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Linking Users:</strong> Go to Telegram Bot → Chats to manage\n"
"                                user-chat associations."
msgstr ""
"<strong>Vinculación de usuarios:</strong> ve a Bot de Telegram → Chats para administrar\n"
"                                las asociaciones entre usuarios y chats."

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Note:</strong> This module uses the existing <code>\n"
"                                telegram</code> infrastructure. Users are linked to Telegram\n"
"                                chats via <code>telegram.chat</code> records that reference their <code>\n"
"                                res.partner</code>."
msgstr ""
"<strong>Nota:</strong> este módulo usa la infraestructura existente de <code>\n"
"                                telegram</code>. Los usuarios se vinculan a chats de Telegram\n"
"                                mediante registros de <code>telegram.chat</code> que hacen referencia a su <code>\n"
"                                res.partner</code>."

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Select Bot (optional):</strong> Leave empty to use\n"
"                                    each user's registered chat bot automatically, or choose an\n"
"                                    explicit override bot for this digest"
msgstr ""
"<strong>Selecciona el bot (opcional):</strong> déjalo vacío para usar\n"
"                                    automáticamente el bot con el que cada usuario registró su chat, o elige\n"
"                                    un bot específico que lo reemplace en este resumen"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid ""
"<strong>Test:</strong> Click \"Send Test Message to Me\" to verify\n"
"                                    your configuration"
msgstr ""
"<strong>Prueba:</strong> haz clic en \"Enviarme un mensaje de prueba\" para verificar\n"
"                                    tu configuración"

#. module: digest_telegram
#: model:ir.model.fields.selection,name:digest_telegram.selection__digest_digest__telegram_send_mode__complement
msgid "Complement Email (Both Telegram + Email)"
msgstr "Complementar el correo (Telegram + correo)"

#. module: digest_telegram
#: model:ir.model,name:digest_telegram.model_digest_digest
msgid "Digest"
msgstr "Resumen"

#. module: digest_telegram
#: model:ir.model.fields,field_description:digest_telegram.field_digest_digest__display_name
msgid "Display Name"
msgstr "Nombre mostrado"

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid ""
"Failed to send test message: %s\n"
"\n"
"Check bot configuration and ensure you have a Telegram chat linked."
msgstr ""
"No se pudo enviar el mensaje de prueba: %s\n"
"\n"
"Revisa la configuración del bot y asegúrate de tener un chat de Telegram vinculado."

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid "Generated by Odoo Digest"
msgstr "Generado por el resumen de Odoo"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid "How to send digests via Telegram:"
msgstr "Cómo enviar resúmenes por Telegram:"

#. module: digest_telegram
#: model:ir.model.fields,field_description:digest_telegram.field_digest_digest__id
msgid "ID"
msgstr "ID"

#. module: digest_telegram
#: model:ir.model.fields,help:digest_telegram.field_digest_digest__telegram_bot_id
msgid ""
"Override bot used for this digest. If not set, the bot that registered the "
"user's chat is used automatically."
msgstr "Bot que se usa para este resumen en lugar del predeterminado. Si no se establece, se usa automáticamente el bot con el que se registró el chat del usuario."

#. module: digest_telegram
#: model:ir.model.fields.selection,name:digest_telegram.selection__digest_digest__telegram_send_mode__replace
msgid "Replace Email (Telegram Only)"
msgstr "Reemplazar el correo (solo Telegram)"

#. module: digest_telegram
#: model:ir.model.fields,help:digest_telegram.field_digest_digest__telegram_send_mode
msgid ""
"Replace: Only send via Telegram. Complement: Send via both Telegram and "
"Email."
msgstr "Reemplazar: enviar solo por Telegram. Complementar: enviar por Telegram y por correo."

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid "Send Test Message to Me"
msgstr "Enviarme un mensaje de prueba"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid "Send a test digest message to your Telegram"
msgstr "Envía un resumen de prueba a tu Telegram"

#. module: digest_telegram
#: model:ir.model.fields,help:digest_telegram.field_digest_digest__telegram_enabled
msgid "Send digest reports via Telegram bot instead of email"
msgstr "Enviar los resúmenes mediante el bot de Telegram en lugar de por correo"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid "Setup Instructions"
msgstr "Instrucciones de configuración"

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid "Success"
msgstr "Éxito"

#. module: digest_telegram
#: model_terms:ir.ui.view,arch_db:digest_telegram.digest_digest_view_form_inherit_telegram
msgid "Telegram"
msgstr "Telegram"

#. module: digest_telegram
#: model:ir.model.fields,field_description:digest_telegram.field_digest_digest__telegram_bot_id
msgid "Telegram Bot"
msgstr "Bot de Telegram"

#. module: digest_telegram
#: model:ir.model.fields,field_description:digest_telegram.field_digest_digest__telegram_enabled
msgid "Telegram Enabled"
msgstr "Telegram habilitado"

#. module: digest_telegram
#: model:ir.model.fields,field_description:digest_telegram.field_digest_digest__telegram_send_mode
msgid "Telegram Send Mode"
msgstr "Modo de envío por Telegram"

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid "Telegram is not enabled for this digest"
msgstr "Telegram no está habilitado para este resumen"

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid "Test message sent successfully to your Telegram!"
msgstr "¡Mensaje de prueba enviado correctamente a tu Telegram!"

#. module: digest_telegram
#. odoo-python
#: code:addons/digest_telegram/models/digest.py:0
msgid ""
"You do not have a Telegram chat configured. Please link your Telegram "
"account first in Telegram Bot menu."
msgstr "No tienes un chat de Telegram configurado. Primero vincula tu cuenta de Telegram en el menú Bot de Telegram."
