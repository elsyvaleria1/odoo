<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="hr_expense_stripe_issuing_status_cron" model="ir.cron">
            <field name="name">Expense Stripe issuing: Update account status</field>
            <field name="model_id" ref="model_res_company" />
            <field name="state">code</field>
            <field name="code">model._cron_refresh_stripe_account()</field>
            <field name="repeat_interval">1</field>
            <field name="repeat_unit">day</field>
            <field name="active" eval="False" />
            <!-- Set to True when an account is created -->
        </record>
    </data>

</odoo>
