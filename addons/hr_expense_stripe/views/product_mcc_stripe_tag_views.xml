<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_mcc_stripe_tag_form" model="ir.ui.view">
        <field name="name">product.mcc.stripe.tag.view.form</field>
        <field name="model">product.mcc.stripe.tag</field>
        <field name="arch" type="xml">
            <form string="Stripe Issuing Merchant Category Codes">
                <sheet>
                    <group>
                        <field name="code" readonly="True" />
                        <field name="name" />
                        <field
                            name="stripe_name"
                            string="Stripe Technical Name"
                            groups="base.group_no_one"
                            readonly="True" />
                        <field
                            name="product_id"
                            placeholder="Always refuse transactions" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_mcc_stripe_tag_list" model="ir.ui.view">
        <field name="name">product.mcc.stripe.tag.view.list</field>
        <field name="model">product.mcc.stripe.tag</field>
        <field name="arch" type="xml">
            <list string="Stripe Issuing Merchant Category Codes" multi_edit="True">
                <field name="code" readonly="True" />
                <field name="name" readonly="True" />
                <field name="product_id" placeholder="Always refuse transactions" />
            </list>
        </field>
    </record>

    <record id="view_product_mcc_stripe_tag_search" model="ir.ui.view">
        <field name="name">product.mcc.stripe.tag.view.search</field>
        <field name="model">product.mcc.stripe.tag</field>
        <field name="arch" type="xml">
            <search string="MCCs">
                <!-- Search -->
                <field
                    name="name"
                    string="Name"
                    filter_domain="[('name', 'ilike', self)]" />
                <field
                    name="code"
                    string="Code"
                    filter_domain="[('code', 'ilike', self + '%')]" />
                <field
                    name="product_name"
                    string="Expense Category to Use"
                    filter_domain="[('product_name', 'ilike', self)]" />

                <!-- Filters -->
                <filter
                    name="allowed"
                    string="Allowed codes"
                    help="Merchant codes that will be accepted when used by a vendor"
                    domain="[('product_id', '!=', False)]" />
                <filter
                    name="disallowed"
                    string="Disallowed codes"
                    help="Merchant codes that will always be refused when used by a vendor"
                    domain="[('product_id', '=', False)]" />
                <separator />
                <filter
                    name="agricultural"
                    string="Agricultural services"
                    domain="[('code', '&lt;', '1500')]" />
                <filter
                    name="contracted"
                    string="Contracted services"
                    domain="[('code', '&gt;=', '1500'), ('code', '&lt;', '3000')]" />
                <filter
                    name="transportation"
                    string="Transportation services"
                    domain="[('code', '&gt;=', '4000'), ('code', '&lt;', '4800')]" />
                <filter
                    name="utility"
                    string="Utility services"
                    domain="[('code', '&gt;=', '4800'), ('code', '&lt;', '5000')]" />
                <filter
                    name="retail"
                    string="Retail outlet services"
                    domain="[('code', '&gt;=', '5000'), ('code', '&lt;', '5600')]" />
                <filter
                    name="clothing"
                    string="Clothing shops"
                    domain="[('code', '&gt;=', '5600'), ('code', '&lt;', '5700')]" />
                <filter
                    name="misc"
                    string="Miscellaneous shops"
                    domain="[('code', '&gt;=', '5700'), ('code', '&lt;', '7300')]" />
                <filter
                    name="business"
                    string="Business services"
                    domain="[('code', '&gt;=', '7300'), ('code', '&lt;', '8000')]" />
                <filter
                    name="membership"
                    string="Professional services and membership organisations"
                    domain="[('code', '&gt;=', '8000'), ('code', '&lt;', '9000')]" />
                <filter
                    name="government"
                    string="Government services"
                    domain="[('code', '&gt;=', '9000')]" />
                <!-- Group bys -->
                <group name="group_filters">
                    <filter
                        name="product_id"
                        string="Expense Category to Use"
                        context="{'group_by': 'product_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="product_mcc_stripe_tag" model="ir.actions.act_window">
        <field name="name">Stripe Merchant Category Codes</field>
        <field name="res_model">product.mcc.stripe.tag</field>
        <field name="path">stripe-mcc</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
