<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hr_expense_stripe_cardholder_wizard_form" model="ir.ui.view">
            <field name="name">hr.expense.stripe.cardholder.wizard.form</field>
            <field name="model">wizard.hr.expense.stripe.card.update.cardholder</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_open': True}" />
                            <field name="firstname" required="1" />
                            <field name="lastname" required="1" />
                            <field name="birthday" required="1" />
                        </group>
                        <group>
                            <field name="phone_number" required="1" />
                            <field name="email" required="1" />
                            <field name="billing_street" required="1" />
                            <field name="billing_street2" />
                            <field
                                name="billing_city"
                                options="{'no_create': True, 'no_create_edit': True}"
                                required="1" />
                            <field
                                name="billing_state_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                                required="company_country_code == 'US'" />
                            <field name="billing_zip" required="1" />
                            <field name="billing_country_id" required="1" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_save_cardholder" type="object" class="btn btn-primary">Save</button>
                        <button special="cancel" string="Cancel" data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
