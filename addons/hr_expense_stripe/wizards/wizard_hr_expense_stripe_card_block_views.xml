<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="hr_expense_stripe_card_block_wizard_form" model="ir.ui.view">
            <field name="name">hr.expense.stripe.card.block.wizard.form</field>
            <field name="model">wizard.hr.expense.stripe.card.block</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="cancellation_reason" />
                            <field
                                name="other_reason_text"
                                invisible="cancellation_reason != 'none'" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_block_card" type="object" class="btn btn-primary">Block</button>
                        <button special="cancel" string="Cancel" data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

</odoo>
