<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.address.autocomplete</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="web.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting position="after" id="address_autocomplete_google">
                <setting
                    id="address_autocomplete_provider"
                    string="Address Autocomplete Provider"
                    help="Which installed provider suggests addresses. Without one, nothing is suggested.">
                    <field name="address_autocomplete_provider" />
                </setting>
            </setting>
        </field>
    </record>

</odoo>
