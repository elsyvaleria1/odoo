<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_carrier_tracking" model="ir.ui.view">
        <field name="name">stock.picking.type.form.carrier.tracking</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_stock_picking_type_form" />
        <field name="arch" type="xml">
            <field name="create_backorder" position="after">
                <field
                    name="auto_validation_carrier_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    invisible="code != 'outgoing'" />
            </field>
        </field>
    </record>
</odoo>
