<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_fetch_carrier_tracking" model="ir.cron">
        <field name="name">Transfers: read carrier tracking status</field>
        <field name="model_id" ref="stock.model_stock_picking" />
