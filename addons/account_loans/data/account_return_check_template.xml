<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record
            id="account_return_check_template_loans_recording"
            model="account.return.check.template">
            <field name="name">Loans recording</field>
            <field
                name="description">Confirm that all loans recorded in the accounts actually exist and match the loan agreements.</field>
            <field name="type">check</field>
            <field name="model" eval="False" />
            <field name="cycle">treasury_financing</field>
            <field name="return_type" ref="account.default_audit_return_type" />
            <field name="code">_account_return_check_template_loans_recording</field>
            <field name="action_id" ref="account_loans.action_view_account_loans" />
        </record>
        <record
            id="account_return_check_template_loans_classification"
            model="account.return.check.template">
            <field name="name">Loans classification</field>
            <field
                name="description">Ensure every loan splits its outstanding principal between the current and non-current liability accounts: the portion falling due within twelve months of the reporting date belongs to the current account, the remainder to the non-current one. Odoo reclassifies that portion each period from the loan's Long Term Account to its Short Term Account; check that both accounts are the ones your chart of accounts reserves for the purpose.</field>
            <field name="type">check</field>
            <field name="model" eval="False" />
            <field name="cycle">treasury_financing</field>
            <field name="return_type" ref="account.default_audit_return_type" />
            <field
                name="code">_account_return_check_template_loans_classification</field>
            <field name="action_id" ref="account_loans.action_view_account_loans" />
        </record>
    </data>

</odoo>
