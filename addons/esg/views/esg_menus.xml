<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_actions_esg_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">action_esg_dashboard</field>
        <field name="path">esg</field>
    </record>

    <menuitem
        id="esg_main_menu"
        name="ESG"
        sequence="63"
        groups="esg.esg_group_user"
        web_icon="esg,static/description/icon.png">
        <menuitem
            id="menu_esg_dashboard"
            name="Dashboard"
            action="ir_actions_esg_dashboard_action"
            sequence="10" />
        <menuitem id="menu_esg_collect" name="Collect" sequence="20">
            <menuitem
                id="menu_esg_collect_carbon_emissions"
                name="Carbon Emissions"
                sequence="10">
                <menuitem
                    id="menu_esg_emitted_emissions"
                    name="Emitted Emissions"
                    action="action_emitted_emission_report_views"
                    sequence="10" />
                <menuitem
                    id="menu_esg_offset_emissions"
                    name="Offset Emissions"
                    action="action_offset_emission_report_views"
                    sequence="20" />
            </menuitem>
        </menuitem>
        <menuitem id="menu_esg_measure" name="Measure" sequence="30">
            <menuitem id="menu_esg_environment" name="Environment" sequence="10">
                <menuitem
                    id="menu_esg_carbon_analytics"
                    name="Carbon Analytics"
                    action="action_carbon_emission_report_analytics_views"
                    sequence="10" />
                <!-- TODO: move it in master -->
                <menuitem
                    id="menu_esg_carbon_report"
                    name="Carbon Footprint"
                    action="action_view_carbon_report"
                    sequence="20" />
            </menuitem>
        </menuitem>
        <menuitem
            id="menu_esg_configuration"
            name="Configuration"
            sequence="40"
            groups="esg_group_manager">
            <menuitem id="menu_esg_settings" name="Settings" sequence="10" />
            <menuitem
                id="menu_esg_carbon_emissions"
                name="Carbon Emissions"
                sequence="20">
                <menuitem
                    id="menu_esg_emission_factors"
                    name="Emission Factors"
                    action="action_view_emission_factor"
                    sequence="30" />
                <menuitem
                    id="menu_esg_type_of_emissions"
                    name="Emission Sources"
                    action="action_view_emission_source"
                    sequence="40" />
                <menuitem
                    id="menu_esg_configuration_carbon_emissions_gasses"
                    name="Gases"
                    action="action_esg_gasses_list"
                    sequence="50" />
                <menuitem
                    id="menu_esg_source_databases"
                    name="Source Databases"
                    action="action_view_database"
                    sequence="60" />
            </menuitem>
        </menuitem>
    </menuitem>

</odoo>
