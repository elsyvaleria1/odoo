<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="res_groups_privilege_esg" model="res.groups.privilege">
            <field name="name">ESG</field>
            <field name="category_id" ref="base.module_category_esg" />
            <field
                name="description">Helps you track, manage, and improve your environmental, social, and governance (ESG) impact.</field>
        </record>
        <record id="esg_group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_esg" />
            <field
                name="comment">Access to ESG features including viewing data, reporting, and mapping emissions with emissions factors, but without configuration rights.</field>
            <field
                name="implied_ids"
                eval="[Command.link(ref('account.group_account_invoice'))]" />
        </record>
        <record id="esg_group_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_esg" />
            <field
                name="comment">Full access to all ESG features including configuration rights.</field>
            <field name="implied_ids" eval="[Command.link(ref('esg_group_user'))]" />
            <field
                name="user_ids"
                eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        </record>
    </data>

</odoo>
