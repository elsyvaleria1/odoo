<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="esg.carbonEmissionPivotView" t-inherit="web.PivotView" t-inherit-mode="primary">
        <xpath expr="//ViewLayout" position="inside">
            <t t-set-slot="no-content">
                <t t-if="!this.model.hasData() or this.model.useSampleModel and this.props.info.noContentHelp">
                    <t t-call="esg.noContentHelper"
                        reportName="this.title"
                        accountantInstalled="this.accountantInstalled"/>
                </t>
            </t>
        </xpath>
    </t>
</odoo>
