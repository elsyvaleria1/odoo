<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form.wallet</field>
        <field name="model">telegram.bot</field>
        <field name="inherit_id" ref="telegram.view_telegram_bot_form" />
        <field name="arch" type="xml">
            <field name="command_ids" position="after">
                <field
                    name="wallet_account_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}" />
            </field>
        </field>
    </record>

</odoo>
