    <!--
        A document is attached to its asset, not to the serial; the asset
        created beside each demo lot carries no xml id, so the records above
        name the lot and are moved here.
    -->
    <function
        model="document.document"
        name="write"
        eval="[[ref('document_fuel_card_civic_001'), ref('document_highway_pass_civic_001'), ref('document_insurance_civic_001'), ref('document_plate_civic_001'), ref('document_invoice_civic')], {'res_model': 'resource.asset', 'res_id': obj().env['product.trace'].browse(ref('asset_ledger.stock_lot_civic_001')).asset_id.id}]" />

