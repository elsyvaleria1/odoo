<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="frontdesk_visitor_print_badge" model="ir.actions.report">
        <field name="name">Visitor Badge</field>
        <field name="model">frontdesk.visitor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">frontdesk.print_visitor_badge</field>
        <field name="report_file">frontdesk.print_visitor_badge</field>
        <field
            name="print_report_name">'Badge - %s' % (object.name).replace('/', '')</field>
        <field name="paperformat_id" ref="hr.paperformat_hr_employee_badge" />
        <field name="binding_model_id" ref="model_frontdesk_visitor" />
        <field name="binding_type">report</field>
    </record>

    <record id="frontdesk_visitor_view_tree" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.list</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state=='planned' and check_in&lt;datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"
                decoration-muted="state=='checked_out'">
                <field name="served" column_invisible="True" />
                <field name="name" />
                <field name="company" optional="show" />
                <field name="phone_ids" widget="many2many_tags" optional="show" />
                <field name="drink_ids" widget="many2many_tags" optional="hide" />
                <field
                    name="host_ids"
                    string="Host"
                    widget="many2many_avatar_employee"
                    optional="show" />
                <field name="check_in" string="CheckIn" />
                <field name="check_out" string="Checkout" optional="hide" />
                <field name="visitor_properties" string="Properties" optional="hide" />
                <field name="duration" widget="float_time" optional="show" />
                <field name="station_id" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    optional="show"
                    decoration-danger="state == 'canceled'"
                    decoration-info="state in ('checked_out')"
                    decoration-success="state in ('checked_in')"
                    decoration-warning="state == 'planned'" />
                <field name="email" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
                <button
                    name="action_check_in"
                    type="object"
                    string="Check in"
                    invisible="state != 'planned'"
                    class="btn-primary" />
                <button
                    name="action_check_out"
                    type="object"
                    string="Check out"
                    invisible="state not in ('checked_in')"
                    class="btn-secondary" />
                <button
                    name="action_served"
                    type="object"
                    string="Drink Served"
                    invisible="served or not drink_ids or state == 'canceled'"
                    class="btn-muted" />
                <button
                    name="%(frontdesk_visitor_print_badge)d"
                    type="action"
                    string="Print Badge"
                    invisible="state != 'planned'"
                    class="btn btn-link" />
            </list>
        </field>
    </record>

    <record id="frontdesk_visitor_view_form" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.form</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_check_in"
                        type="object"
                        string="Check in"
                        invisible="state != 'planned'"
                        class="btn-primary" />
                    <button
                        name="action_canceled"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('planned')"
                        class="btn-muted" />
                    <button
                        name="action_check_out"
                        type="object"
                        string="Check out"
                        invisible="state not in ('checked_in')"
                        class="btn-secondary" />
                    <button
                        name="action_planned"
                        type="object"
                        string="Set as Planned"
                        invisible="state != 'canceled'"
                        class="btn-secondary" />
                    <field
                        name="state"
                        widget="statusbar"
                        invisible="state != 'canceled'"
                        statusbar_visible="planned,checked_in,checked_out,canceled" />
                    <field
                        name="state"
                        widget="statusbar"
                        invisible="state == 'canceled'"
                        statusbar_visible="planned,checked_in,checked_out" />
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group>
                        <group>
                            <field
                                name="name"
                                placeholder="E.g. What's your Name"
                                readonly="state == 'canceled'" />
                            <field
                                name="phone_ids"
                                widget="many2many_tags"
                                readonly="state == 'canceled'" />
                            <field
                                name="email"
                                widget="email"
                                readonly="state == 'canceled'" />
                            <field name="company" readonly="state == 'canceled'" />
                            <field
                                name="drink_ids"
                                widget="many2many_tags"
                                readonly="state == 'canceled'" />
                            <field
                                name="served"
                                invisible="not drink_ids"
                                readonly="state == 'canceled'" />
                        </group>
                        <group>
                            <field name="station_id" readonly="state == 'canceled'" />
                            <field
                                name="host_ids"
                                widget="many2many_avatar_employee"
                                readonly="state == 'canceled'" />
                            <field name="check_in" readonly="state == 'canceled'" />
                            <field
                                name="duration"
                                widget="float_time"
                                readonly="state == 'canceled'" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state == 'canceled'" />
                        </group>
                    </group>
                    <div class="d-flex" readonly="state == 'canceled'">
                        <field
                            name="visitor_properties"
                            columns="2"
                            hideAddButton="1"
                            hideKanbanOption="1" />
                    </div>
                    <notebook>
                        <page string="Message">
                            <field name="message" readonly="state == 'canceled'" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="frontdesk_visitor_view_kanban" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.kanban</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex mb-1">
                            <field name="name" class="fw-bolder fs-5" />
                            <field
                                name="state"
                                widget="label_selection"
                                options="{'classes': {'checked_out': 'info',                                 'checked_in': 'success', 'planned': 'warning', 'canceled': 'danger'}}"
                                class="ms-auto" />
                        </div>
                        <field name="station_id" />
                        <footer>
                            <field name="check_in" />
                            <field
                                name="host_ids"
                                widget="many2many_avatar_employee"
                                class="ms-auto" />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="frontdesk_visitor_view_graph" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.graph</field>
        <field name="model">frontdesk.visitor</field>
        <field name="priority">14</field>
        <field name="arch" type="xml">
            <graph string="Visitors" sample="1">
                <field name="duration" invisible="1" />
                <field name="station_id" />
            </graph>
        </field>
    </record>

    <record id="frontdesk_visitor_view_pivot" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.pivot</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <pivot string="Visitors">
                <field name="drink_ids" type="row" />
                <field name="station_id" type="col" />
            </pivot>
        </field>
    </record>

    <record id="frontdesk_visitor_view_calendar" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.calendar</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <calendar color="state" date_start="check_in">
                <field name="name" />
            </calendar>
        </field>
    </record>

    <record id="frontdesk_visitor_view_gantt" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.gantt</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <gantt
                default_group_by="state"
                date_start="check_in"
                date_stop="check_out"
                default_scale="week">
                <field name="name" />
            </gantt>
        </field>
    </record>

    <record id="frontdesk_visitor_view_search" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.search</field>
        <field name="model">frontdesk.visitor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Visitor" />
                <field name="host_ids" string="Host" />
                <field name="station_id" string="CheckIn Station" />
                <filter
                    name="state_is_planned"
                    string="Planned"
                    domain="[('state', '=', 'planned')]" />
                <filter
                    name="state_is_checked_in"
                    string="Checked-In"
                    domain="[('state', '=', 'checked_in')]" />
                <filter
                    name="state_is_checked_out"
                    string="Checked-out"
                    domain="[('state', '=', 'checked_out')]" />
                <separator />
                <filter
                    name="drink_to_serve"
                    string="Drink to Serve"
                    domain="[('drink_ids', '!=', False), ('served', '=', False), ('state', '!=', 'canceled')]" />
                <filter
                    name="today"
                    string="Today"
                    domain="[('check_in', '&gt;=', 'today'), ('check_in', '&lt;', 'today +1d')]" />
                <filter name="check_in" string="Date" date="check_in" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_by_station"
                        string="Station"
                        context="{'group_by': 'station_id'}" />
                    <filter
                        name="group_by_date"
                        string="Date"
                        context="{'group_by': 'check_in'}" />
                    <filter
                        name="group_by_host"
                        string="Host"
                        context="{'group_by': 'host_ids'}" />
                    <filter
                        name="group_by_status"
                        string="Status"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_by_visitor_properties"
                        string="Properties"
                        context="{'group_by': 'visitor_properties'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_frontdesk_visitor" model="ir.actions.act_window">
        <field name="name">Visitors</field>
        <field name="res_model">frontdesk.visitor</field>
        <field name="view_mode">list,form,kanban,graph,pivot,calendar,gantt</field>
        <field
            name="context">{
            "search_default_state_is_planned": 1,
            "search_default_state_is_checked_in": 1,
            "search_default_today": 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visitors yet. Let's add one!
            </p><p>
                Odoo helps you to track all information related to your visitors.
            </p>
        </field>
    </record>

    <record id="action_open_station_visitor" model="ir.actions.act_window">
        <field name="name">Station Visitors</field>
        <field name="res_model">frontdesk.visitor</field>
        <field name="view_mode">list,form,kanban,graph,pivot,calendar,gantt</field>
        <field name="domain">[("station_id", "=", active_id)]</field>
        <field name="context">{'default_station_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No visitors yet. Let's add one!
            </p><p>
                Odoo helps you to track all information related to your visitors.
            </p>
        </field>
    </record>

