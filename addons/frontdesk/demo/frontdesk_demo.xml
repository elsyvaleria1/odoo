<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="base.user_demo" model="res.users">
            <field
                name="group_ids"
                eval="[Command.unlink(ref('frontdesk.frontdesk_group_user')), Command.unlink(ref('frontdesk.frontdesk_group_administrator'))]" />
        </record>
        <record id="base.default_user_group" model="res.groups">
            <field
                name="implied_ids"
                eval="[Command.link(ref('frontdesk.frontdesk_group_administrator'))]" />
        </record>
    </data>

    <data noupdate="0">
        <!-- Stations -->
        <record id="frontdesk_frontdesk_1" model="frontdesk.frontdesk">
            <field name="name">Frontdesk</field>
            <field
                name="responsible_ids"
                eval="[Command.link(ref('base.user_admin'))]" />
            <field name="self_check_in">True</field>
            <field name="drink_offer">True</field>
            <field name="host_selection">True</field>
            <field
                name="drink_ids"
                eval="[Command.link(ref('frontdesk.frontdesk_drink_1')), Command.link(ref('frontdesk.frontdesk_drink_2'))]" />
            <field name="description" type="html">
                <p>Enjoy our Wi-fi!</p>
                <p>
                    <span>Connect with:- my company</span>
                    <br />
                    <span>Password:- My@1234</span>
                </p>
            </field>
        </record>
        <!-- Visitors  -->
        <record id="frontdesk_visitor_1" model="frontdesk.visitor">
            <field name="name">John Smith</field>
            <field
                name="phone_ids"
                eval="[Command.create({'number': '(644)-169-1353', 'type': 'mobile'})]" />
            <field
                name="drink_ids"
                eval="[Command.link(ref('frontdesk.frontdesk_drink_1'))]" />
            <field name="email">johnsmith@example.com</field>
            <field name="check_in" eval="datetime.now()" />
            <field name="host_ids" eval="[Command.link(ref('hr.employee_qdp'))]" />
            <field name="company">Smith LLP</field>
            <field name="state">planned</field>
            <field name="station_id" ref="frontdesk.frontdesk_frontdesk_1" />
        </record>
    </data>

</odoo>
