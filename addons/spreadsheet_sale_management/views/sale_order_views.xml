<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_sale_order_spreadsheet"
                    type="object"
                    icon="fa-th"
                    invisible="not spreadsheet_template_id or spreadsheet_id"
                    class="oe_stat_button">
                    <field name="spreadsheet_template_id" widget="statinfo" />
                </button>
                <button
                    name="action_view_sale_order_spreadsheet"
                    type="object"
                    icon="fa-th"
                    invisible="not spreadsheet_id"
                    class="oe_stat_button">
                    <field
                        name="spreadsheet_id"
                        string="Quote calculator"
                        widget="statinfo" />
                </button>
            </div>
        </field>
    </record>

</odoo>
