<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record
        id="account_analytic_account_view_inherit_project_sale_subscription"
        model="ir.ui.view">
        <field
            name="name">account.analytic.account.view.buttons.subscription_count</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="priority" eval="22" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="subscriptions_action"
                    type="object"
                    icon="fa-book"
                    groups="sale.group_sale_salesman"
                    invisible="subscription_count == 0"
                    class="oe_stat_button">
                    <field name="subscription_count" string="Sales" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>

</odoo>
