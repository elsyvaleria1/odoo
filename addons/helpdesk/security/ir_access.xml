<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_team_user_privacy_guard" model="ir.access">
        <field
            name="name">Helpdesk teams: a helpdesk user reads the invited-only teams they follow</field>
        <field name="model_id" ref="team.model_team_team" />
        <field name="group_id" ref="group_helpdesk_user" />
        <field name="kind">guard</field>
        <field name="guard_scope">members</field>
        <field name="operation">r</field>
        <field
            name="domain">[] if user.has_group('helpdesk.group_helpdesk_manager') else ['|', '|', ('use_helpdesk', '=', False), ('helpdesk_privacy_visibility', '!=', 'invited_internal'), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>

</odoo>
