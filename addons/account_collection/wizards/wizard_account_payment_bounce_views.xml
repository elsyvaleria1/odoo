<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_account_payment_bounce_form" model="ir.ui.view">
        <field name="name">wizard.account.payment.bounce.form</field>
        <field name="model">wizard.account.payment.bounce</field>
        <field name="arch" type="xml">
            <form string="Check Bounced">
                <p>
                    The invoices this check paid open again, the check is charged back where it was deposited and the collector is asked to collect again.
                </p>
                <group>
                    <field name="payment_id" />
                    <field name="currency_id" invisible="1" />
                    <field name="amount" />
                    <field name="date" />
                    <field name="reason" />
                    <field name="fee" />
                </group>
                <footer>
                    <button
                        name="action_bounce"
                        type="object"
                        string="Record Bounce"
                        class="btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
