<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_template_collection_receipt" model="mail.template">
        <field name="name">Field Collections: Collection Receipt</field>
        <field
            name="description">Sent to the customer as soon as a collector records what the customer paid them</field>
        <field name="model_id" ref="account.model_account_payment" />
        <field
            name="subject">{{ object.company_id.name }}: receipt {{ object.name }} for {{ format_amount(object.amount, object.currency_id) }}</field>
        <field name="partner_to" eval="False" />
        <field name="use_default_to" eval="True" />
        <field
            name="report_template_ids"
            eval="[Command.link(ref('account.action_report_payment_receipt'))]" />
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.partner_id.name or ''">Agricola El Sauce</t>,<br /><br />
                    <t t-out="object.collector_id.name or ''">Juan Perez</t> received your payment of
                    <span style="font-weight:bold;" t-out="format_amount(object.amount, object.currency_id) or ''">$ 1,000.00</span>
                    on <t t-out="format_date(object.date) or ''">10/02/2026</t>, on behalf of
                    <t t-out="object.company_id.name or ''">YourCompany</t>.
                    Your receipt <span style="font-weight:bold;" t-out="object.name or ''">COB01/2026/00001</span> is attached.
                    <br /><br />
                    Check it, and tell us right away if anything is wrong:
                    <br /><br />
                    <a
                        t-att-href="object.get_collection_receipt_url()"
                        style="background-color: #875A7B; padding: 8px 16px; color: #ffffff; border-radius: 5px;">
                        Verify my receipt
                    </a>
                </p>
            </div>
        </field>
    </record>

</odoo>
