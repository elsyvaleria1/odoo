"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear <t t-out=\"object.partner_id.name or ''\">Agricola El Sauce</t>,<br/><br/>\n"
"                    <t t-out=\"object.collector_id.name or ''\">Juan Perez</t> received your payment of\n"
"                    <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount, object.currency_id) or ''\">$ 1,000.00</span>\n"
"                    on <t t-out=\"format_date(object.date) or ''\">10/02/2026</t>, on behalf of\n"
"                    <t t-out=\"object.company_id.name or ''\">YourCompany</t>.\n"
"                    Your receipt <span style=\"font-weight:bold;\" t-out=\"object.name or ''\">COB01/2026/00001</span> is attached.\n"
