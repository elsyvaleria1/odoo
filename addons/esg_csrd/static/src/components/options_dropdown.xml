<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="esg_csrd.OptionsDropdown" t-inherit="knowledge.OptionsDropdown" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[@onSelected.bind='this.exportAuditReportToPDF']" position="after">
            <DropdownItem t-if="this.props.record.data.inherited_esg_report_id?.records.length" onSelected.bind="this.exportAuditReportToPDF">
                <i class="fa-regular fa-file-pdf fa-lg me-2"/>Download ESG Report
            </DropdownItem>
        </xpath>
    </t>
</templates>
