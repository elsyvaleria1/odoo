<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="esg_metric_ask_feedback_view_form" model="ir.ui.view">
            <field name="name">egs.metric.ask.feedback.view.form</field>
            <field name="model">wizard.esg.metric.send.review.survey</field>
            <field name="arch" type="xml">
                <form string="Ask Review">
                    <sheet>
                        <group>
                            <field name="deadline" options="{'min_date': 'today'}" />
                            <field
                                name="partner_ids"
                                placeholder="Add stakeholders..."
                                widget="many2many_tags_email"
                                domain="[('company_id', 'in', allowed_company_ids)]"
                                context="{'show_email': True}"
                                options="{'no_create': 1, 'no_quick_create': 1}" />
                            <field name="subject" placeholder="Subject..." />
                        </group>
                        <div>
                            <field
                                name="body"
                                placeholder="Optional message"
                                widget="html_mail"
                                class="oe-bordered-editor" />
                        </div>
                    </sheet>

                    <footer>
                        <button
                            name="action_send"
                            type="object"
                            string="Send"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="esg_metric_ask_feedback_action" model="ir.actions.act_window">
            <field name="name">Stakeholder Review</field>
            <field name="res_model">wizard.esg.metric.send.review.survey</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="esg_metric_ask_feedback_view_form" />
            <field name="target">new</field>
        </record>
    </data>

</odoo>
