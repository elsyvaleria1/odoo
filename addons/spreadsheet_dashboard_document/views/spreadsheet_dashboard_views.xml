<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="spreadsheet_dashboard_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.dashboard.list.view</field>
        <field name="model">spreadsheet.dashboard</field>
        <field
            name="inherit_id"
            ref="spreadsheet_dashboard_edition.spreadsheet_dashboard_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <control>
                    <button
                        name="action_add_document_spreadsheet_to_dashboard"
                        type="object"
                        string="Add a spreadsheet"
                        context="{'dashboard_group_id': parent.id}"
                        class="btn-link" />
                </control>
            </xpath>
        </field>
    </record>

</odoo>
