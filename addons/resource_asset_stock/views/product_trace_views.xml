<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_lot_view_form_asset" model="ir.ui.view">
        <field name="name">stock.lot.form.asset</field>
        <field name="model">product.trace</field>
        <field name="inherit_id" ref="stock.view_product_trace_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_asset"
                    type="object"
                    string="Asset"
                    icon="fa-truck"
                    invisible="not asset_id"
                    class="oe_stat_button" />
            </div>
        </field>
    </record>

</odoo>
