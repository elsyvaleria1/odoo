<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="phone_call_view_form_inherit" model="ir.ui.view">
        <field name="name">phone.call.form.inherit</field>
        <field name="model">phone.call</field>
        <field name="inherit_id" ref="phone_call.phone_call_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button
                    name="voip_action_view_subscription"
                    type="object"
                    icon="fa-refresh"
                    groups="sale.group_sale_salesman"
                    invisible="subscription_count == 0"
                    class="oe_stat_button">
                    <field
                        name="subscription_count"
                        string="Subscriptions"
                        widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
