<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.social.push.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting position="after" id="livechat">
                <setting
                    string="Push Notifications"
                    help="Configure Push Notifications">
                    <field name="firebase_enable_push_notifications" />
                    <div
                        class="content-group"
                        invisible="not firebase_enable_push_notifications">
                        <div class="mt16">
                            <label
                                for="notification_request_title"
                                string="Title"
                                class="o_form_label" />
                            <field
                                name="notification_request_title"
                                placeholder="Want to discover new versions?"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="notification_request_body"
                                string="Body"
                                class="o_form_label align-top" />
                            <field
                                name="notification_request_body"
                                placeholder="Enable push notifications to be notified about new features."
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="notification_request_delay"
                                string="Delay"
                                class="o_form_label pe-2" />
                            <field
                                name="notification_request_delay"
                                class="oe_inline" />
                            <span class="ps-2">seconds</span>
                        </div>
                        <div class="mt16">
                            <label
                                for="notification_request_icon"
                                string="Icon"
                                class="o_form_label pe-2" />
                            <field name="notification_request_icon" class="oe_inline" />
                        </div>
                    </div>
                </setting>
                <setting
                    help="Use your own Firebase Account for this website's push notifications"
                    groups="base.group_no_one"
                    invisible="not firebase_enable_push_notifications">
                    <field name="firebase_use_own_account" />
                    <div class="content-group" invisible="not firebase_use_own_account">
                        <div class="mt16">
                            <label
                                for="firebase_project_id"
                                string="Project ID"
                                class="o_form_label" />
                            <field
                                name="firebase_project_id"
                                placeholder="e.g. &quot;my-project-id&quot;"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="firebase_web_app_id"
                                string="App ID"
                                class="o_form_label" />
                            <field
                                name="firebase_web_app_id"
                                placeholder="e.g. &quot;1:280765099157:web:7c7b7d7b7d7b7d7b7d7b7d&quot;"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="firebase_web_api_key"
                                string="Web API Key"
                                class="o_form_label" />
                            <field
                                name="firebase_web_api_key"
                                placeholder="e.g. &quot;BIzbSyXhhsFHEgphW55CSg5cV7h7c_S-AuTMKc9&quot;"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="firebase_push_certificate_key"
                                string="Push Certificate Key ID"
                                class="o_form_label" />
                            <field
                                name="firebase_push_certificate_key"
                                placeholder="e.g. &quot;CCSc77KP_LX8dTAogFakOoJ_VqNP15u0-43psDJe__a9B...&quot;"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="firebase_sender_id"
                                string="Sender ID"
                                class="o_form_label" />
                            <field
                                name="firebase_sender_id"
                                placeholder="e.g. &quot;280765099157&quot;"
                                class="w-100" />
                        </div>
                        <div class="mt16">
                            <label
                                for="firebase_admin_key_file"
                                string="Key File"
                                class="o_form_label pe-2" />
                            <field name="firebase_admin_key_file" />
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
