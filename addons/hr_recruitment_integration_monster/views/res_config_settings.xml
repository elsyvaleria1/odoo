<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.hr.recruitment.integration.monster</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="priority" eval="75" />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='online_posting_setting_container']//setting[@id='publish_available_jobs_setting']"
                position="after">
                <setting id="monster_creds" string="Monster Credentials">
                    <div class="mt-8">
                        <div class="row" style="margin-top: -1.5em;">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label
                                        for="sfu_server_url"
                                        string="Username"
                                        class="col-lg-3" />
                                    <field name="hr_recruitment_monster_username" />
                                </div>
                                <div class="row mt16">
                                    <label
                                        for="sfu_server_key"
                                        string="Password"
                                        class="col-lg-3" />
                                    <field
                                        name="hr_recruitment_monster_password"
                                        password="True" />
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
