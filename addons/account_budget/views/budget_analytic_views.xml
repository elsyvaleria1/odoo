<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_analytic_form" model="ir.ui.view">
        <field name="name">budget.analytic.view.form</field>
        <field name="model">budget.analytic</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button
                        name="action_budget_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state == 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_budget_confirm"
                        type="object"
                        string="Open"
                        invisible="state != 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_create_revision"
                        type="object"
                        string="Revise"
                        invisible="state != 'confirmed'"
                        class="btn-secondary" />
                    <button
                        name="action_budget_done"
                        type="object"
                        string="Done"
                        invisible="state != 'confirmed'"
                        class="btn-secondary" />
                    <button
                        name="action_budget_cancel"
                        type="object"
                        string="Cancel Budget"
                        invisible="state != 'draft'"
                        class="btn-secondary" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,confirmed,done" />
                </header>
                <sheet string="Budget">
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_budget_report"
                            type="object"
                            icon="fa-bar-chart"
                            class="oe_stat_button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Budget Report</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Budget 2023"
                                readonly="state != 'draft'" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="user_id"
                                widget="many2one_avatar"
                                domain="[('share', '=', False)]"
                                options="{'no_create': True}"
                                readonly="state != 'draft'" />
                            <field
                                name="parent_id"
                                invisible="not parent_id"
                                readonly="state != 'draft'" />
                            <field name="budget_type" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field
                                name="date_from"
                                string="Period"
                                widget="daterange"
                                options="{'end_date_field': 'date_to'}"
                                readonly="state != 'draft'" />
                            <field
                                name="company_id"
                                options="{'no_create': True, 'no_open': True}"
                                groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="budget_lines" string="Budget Lines">
                            <field
                                name="budget_line_ids"
                                colspan="4"
                                readonly="state != 'draft'">
                                <list string="Budget Lines" editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="account_id" optional="show" />
                                    <field name="currency_id" column_invisible="True" />
                                    <field name="budget_amount" sum="Budget" />
                                    <field
                                        name="achieved_amount"
                                        sum="Achieved"
                                        column_invisible="parent.state in ('draft','canceled')"
                                        decoration-danger="(achieved_amount &gt; budget_amount) and parent.budget_type in ('expense', 'both')" />
                                    <field
                                        name="theoretical_amount"
                                        optional="hide"
                                        sum="Theoretical"
                                        column_invisible="parent.state in ('draft','canceled')" />
                                    <field
                                        name="achieved_percentage"
                                        widget="percentage"
                                        optional="hide"
                                        column_invisible="parent.state in ('draft','canceled')" />
                                    <field
                                        name="theoretical_percentage"
                                        widget="percentage"
                                        optional="hide"
                                        column_invisible="parent.state in ('draft','canceled')" />
                                    <button
                                        name="action_view_budget_entries"
                                        type="object"
                                        string="Audit"
                                        width="60px"
                                        column_invisible="parent.state in ('draft','canceled')" />
                                    <field name="company_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_budget_analytic_tree" model="ir.ui.view">
        <field name="name">budget.analytic.view.list</field>
        <field name="model">budget.analytic</field>
        <field name="arch" type="xml">
            <list
                string="Budget"
                decoration-info="state == 'draft'"
                decoration-muted="state in ('done','canceled', 'revised')">
                <header>
                    <button
                        name="%(account_budget.budget_split_wizard_action)d"
                        type="action"
                        string="Generate"
                        display="always"
                        class="btn btn-secondary" />
                    <button
                        name="action_view_budget_lines"
                        type="object"
                        string="Budget Lines"
                        groups="analytic.group_analytic_accounting"
                        class="oe_highlight" />
                </header>
                <field name="name" colspan="1" readonly="state == 'done'" />
                <field name="date_from" optional="show" readonly="state == 'done'" />
                <field name="date_to" optional="hide" readonly="state == 'done'" />
                <field
                    name="company_id"
                    optional="hide"
                    options="{'no_create': True}"
                    groups="base.group_multi_company" />
                <field name="user_id" options="{'no_create': True}" />
                <field name="activity_ids" widget="list_activity" optional="show" />
                <field name="state" />
                <field
                    name="activity_exception_decoration"
                    widget="activity_exception" />
            </list>
        </field>
    </record>

    <record id="view_budget_analytic_kanban" model="ir.ui.view">
        <field name="name">budget.analytic.kanban</field>
        <field name="model">budget.analytic</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="row mb4">
                            <field
                                name="name"
                                readonly="state == 'done'"
                                class="fw-bold fs-5 col-8" />
                            <div class="col-4">
                                <field
                                    name="state"
                                    widget="label_selection"
                                    options="{'classes': {'draft': 'default', 'done': 'success'}}"
                                    class="float-end" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-10">
                                <i
                                    class="fa-regular fa-clock me-1"
                                    role="img"
                                    aria-label="Period"
                                    title="Period" />
                                <field name="date_from" /> -
                                <field name="date_to" />
                            </div>
                            <div class="col-2">
                                <field
                                    name="user_id"
                                    widget="many2one_avatar_user"
                                    class="float-end" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_budget_analytic_search" model="ir.ui.view">
        <field name="name">budget.analytic.search</field>
        <field name="model">budget.analytic</field>
        <field name="arch" type="xml">
            <search string="Budget">
                <field name="name" string="Budget" />
                <field name="date_from" />
                <field name="date_to" />
                <filter
                    name="draft"
                    string="Draft"
                    help="Draft Budgets"
                    domain="[('state', '=', 'draft')]" />
                <separator />
                <filter
                    name="filter_activities_my"
                    string="My Activities"
                    domain="[('activity_user_id', '=', uid)]"
                    invisible="1" />
                <separator invisible="1" />
                <filter
                    name="activities_overdue"
                    string="Late Activities"
                    help="Show all records whose next activity date is past"
                    domain="[('my_activity_date_deadline', '&lt;', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_today"
                    string="Today Activities"
                    domain="[('my_activity_date_deadline', '=', 'today')]"
                    invisible="1" />
                <filter
                    name="activities_upcoming_all"
                    string="Future Activities"
                    domain="[('my_activity_date_deadline', '&gt;', 'today')]"
                    invisible="1" />
            </search>
        </field>
    </record>

    <record id="act_budget_analytic_view" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">budget.analytic</field>
        <field name="path">analytic-budgets</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="view_budget_analytic_tree" />
        <field name="search_view_id" ref="view_budget_analytic_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new budget.
            </p>
            <p>
                Use budgets to compare actual with expected revenues and costs
            </p>
        </field>
    </record>

</odoo>
