<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The driver scans the trip sheet at the warehouse with the phone camera. -->
    <template
        id="report_picking_batch_route"
        inherit_id="stock_fleet_trace.report_picking_batch_trace">
        <xpath expr="//div[hasclass('page')]/div[hasclass('d-flex')]" position="inside">
            <div class="ms-auto">
                <img
                    t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=140&amp;height=140' % quote_plus(o.name)"
                    style="width: 28mm; height: 28mm;"
                    alt="QR" />
            </div>
        </xpath>
    </template>

</odoo>
