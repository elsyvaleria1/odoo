<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="service_tomtom_routing" model="integration.service">
        <field name="name">TomTom Routing</field>
        <field name="code">tomtom_routing</field>
        <field name="category">geocoding</field>
        <field name="provider">TomTom</field>
        <field name="website">https://www.tomtom.com</field>
        <field
            name="documentation_url">https://docs.tomtom.com/routing-api/documentation/tomtom-maps/v1/calculate-route</field>
        <field name="endpoint_url">https://api.tomtom.com</field>
        <field name="auth_type">api_key</field>
        <field name="environment">production</field>
        <field name="timeout_read">15</field>
        <field name="health_check_enabled" eval="False" />
        <field
            name="description">TomTom Routing API v1 for delivery trips. The API key travels in the query string (?key=), so the trip reads it from the credential itself; nothing is sent in a header.</field>
    </record>

</odoo>
