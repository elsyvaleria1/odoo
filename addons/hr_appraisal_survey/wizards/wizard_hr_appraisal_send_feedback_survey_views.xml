<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="appraisal_ask_feedback_view_form" model="ir.ui.view">
            <field name="name">appraisal.ask.feedback.view.form</field>
            <field name="model">wizard.hr.appraisal.send.feedback.survey</field>
            <field name="arch" type="xml">
                <form string="Ask Feedback">
                    <sheet>
                        <field name="appraisal_id" invisible="1" />
                        <field name="author_id" invisible="1" />
                        <field name="employee_id" invisible="1" />
                        <field name="lang" invisible="1" />
                        <field name="render_model" invisible="1" />
                        <group col="2">
                            <group>
                                <field
                                    name="survey_template_id"
                                    options="{'no_create':1,'no_quick_create':1}" />
                            </group>
                            <group>
                                <field
                                    name="deadline"
                                    options="{'min_date': 'today'}" />
                            </group>
                        </group>
                        <group>
                            <field
                                name="employee_ids"
                                placeholder="Add employees..."
                                widget="many2many_avatar_employee"
                                domain="[('company_id', 'in', allowed_company_ids)]"
                                context="{'show_email': True}"
                                options="{'no_create': 1, 'no_quick_create': 1}" />
                            <field name="subject" placeholder="Subject..." />
                        </group>
                        <div>
                            <field
                                name="user_body"
                                placeholder="Optional comment..."
                                class="note-wizard" />
                        </div>
                    </sheet>

                    <footer>
                        <button
                            name="action_send"
                            type="object"
                            string="Send"
                            class="btn-primary"
                            data-hotkey="q" />
                        <button
                            special="cancel"
                            string="Cancel"
                            class="btn-secondary"
                            data-hotkey="x" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="appraisal_ask_feedback_action" model="ir.actions.act_window">
            <field name="name">Ask Feedback</field>
            <field name="res_model">wizard.hr.appraisal.send.feedback.survey</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="appraisal_ask_feedback_view_form" />
            <field name="target">new</field>
        </record>
    </data>

</odoo>
