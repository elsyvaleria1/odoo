#. module: project_task_description_template
#: model:ir.model.fields,help:project_task_description_template.field_project_task__description_template_id
msgid ""
"Templates of other companies are not offered here. A task with no company is"
" offered only company-less templates, while the server accepts any template "
"on it: such a task belongs to a shared project and is deliberately not tied "
"to one company's templates."
msgstr ""
"Aquí no se ofrecen plantillas de otras compañías. A una tarea sin compañía "
"solo se le ofrecen plantillas sin compañía, aunque el servidor acepta "
"cualquier plantilla en ella: esa tarea pertenece a un proyecto compartido y "
"deliberadamente no está atada a las plantillas de una sola compañía."

#. module: project_task_description_template
#. odoo-python
#: code:addons/project_task_description_template/models/project_task.py:0
msgid "The template %(template)s belongs to company %(company)s."
msgstr "La plantilla %(template)s pertenece a la compañía %(company)s."

#. module: project_task_description_template
#. odoo-python
#: code:addons/project_task_description_template/models/project_task.py:0
msgid ""
"The template %(template)s is not available for the project %(project)s, so "
"it was removed. The current description was left unchanged."
msgstr ""
"La plantilla %(template)s no está disponible para el proyecto %(project)s, "
"por lo que se eliminó. La descripción actual no se modificó."

#. module: project_task_description_template
#. odoo-python
#: code:addons/project_task_description_template/models/project_task.py:0
msgid ""
"The template %(template)s is not available for the project %(project)s."
msgstr ""
"La plantilla %(template)s no está disponible para el proyecto %(project)s."

#. module: project_task_description_template
#. odoo-python
#: code:addons/project_task_description_template/models/project_task_description_template.py:0
msgid ""
"The template %(template)s is still used by %(tasks)s, which this change "
"would leave invalid."
msgstr ""
"La plantilla %(template)s sigue en uso en %(tasks)s, y este cambio dejaría "
"esas tareas inválidas."

