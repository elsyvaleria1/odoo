<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_iot_config_view_form" model="ir.ui.view">
        <field name="name">pos.iot.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('pos_iot_config')]" position="replace">
                <!-- The domain declared for iface_scale_id uses `company_id`. -->
                <field name="company_id" invisible="1" />
                <div
                    class="content-group pos_iot_config ms-3"
                    invisible="not is_posbox">
                    <div class="row">
                        <label
                            for="iface_printer_id"
                            string="Receipt Printer"
                            class="col-lg-5 o_light_label" />
                        <field name="iface_printer_id" placeholder="none" />
                        <field name="iface_print_via_proxy" invisible="1" />
                    </div>
                    <div class="row" invisible="not iface_printer_id">
                        <label
                            for="iface_cashdrawer"
                            string="Cashdrawer"
                            class="col-lg-5 o_light_label" />
                        <div class="col-lg-7">
                            <field name="iface_cashdrawer" />
                        </div>
                    </div>
                    <div class="row">
                        <label
                            for="iface_display_id"
                            string="Customer Display"
                            class="col-lg-5 o_light_label" />
                        <field name="iface_display_id" placeholder="none" />
                    </div>
                    <div class="row iot_barcode_scanner">
                        <label
                            for="iface_scanner_ids"
                            string="Scanner"
                            class="col-lg-5 o_light_label" />
                        <field
                            name="iface_scanner_ids"
                            placeholder="none"
                            widget="many2many_tags" />
                    </div>
                    <div class="row" name="row_scale">
                        <label
                            for="iface_scale_id"
                            string="Electronic Scale"
                            class="col-lg-5 o_light_label" />
                        <field name="iface_scale_id" placeholder="none" />
                    </div>
                    <div>
                        <button
                            name="%(iot.iot_device_action)d"
                            type="action"
                            string="IoT Devices"
                            icon="oi-arrow-right"
                            class="btn-link mt8" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
