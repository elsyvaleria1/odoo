<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_view_form_inherit_pos_iot" model="ir.ui.view">
        <field name="name">res.config.form.inherit.pos.iot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('pos_iot_config')]" position="replace">
                <div class="content-group pos_iot_config" invisible="not pos_is_posbox">
                    <div class="row">
                        <label
                            for="pos_iface_printer_id"
                            string="Receipt Printer"
                            class="col-lg-5 o_light_label" />
                        <field name="pos_iface_printer_id" placeholder="none" />
                    </div>
                    <div class="row" invisible="not pos_iface_printer_id">
                        <label
                            for="pos_iface_cashdrawer"
                            string="Cashdrawer"
                            class="col-lg-5 o_light_label" />
                        <div class="col-lg-7">
                            <field name="pos_iface_cashdrawer" />
                        </div>
                    </div>
                    <div class="row">
                        <label
                            for="pos_iface_display_id"
                            string="Customer Display"
                            class="col-lg-5 o_light_label" />
                        <field name="pos_iface_display_id" placeholder="none" />
                    </div>
                    <div class="row iot_barcode_scanner">
                        <label
                            for="pos_iface_scanner_ids"
                            string="Barcode Scanners/Card Readers"
                            class="col-lg-5 o_light_label" />
                        <field
                            name="pos_iface_scanner_ids"
                            placeholder="none"
                            widget="many2many_tags" />
                    </div>
                    <div class="row" name="row_scale">
                        <label
                            for="pos_iface_scale_id"
                            string="Electronic Scale"
                            class="col-lg-5 o_light_label" />
                        <field name="pos_iface_scale_id" placeholder="none" />
                    </div>
                    <div>
                        <button
                            name="%(iot.iot_device_action)d"
                            type="action"
                            string="IoT Devices"
                            icon="oi-arrow-right"
                            class="btn-link mt8" />
                    </div>
                </div>
            </xpath>
            <block position="inside" id="pos_payment_terminals_section">
                <setting
                    string="Ingenico (BENELUX)"
                    title="The transactions are processed by Ingenico via an IoT box. Setup your terminal on the related payment method."
                    help="Accept payments with an Ingenico payment terminal"
                    documentation="/applications/sales/point_of_sale/payment_methods/terminals/ingenico.html">
                    <field name="module_pos_iot_ingenico" />
                    <button
                        name="action_open_payment_method_form"
                        type="object"
                        string="Payment method"
                        icon="oi-arrow-right"
                        context="{'selection': 'ingenico', 'config_ids': [pos_config_id], 'provider_name': 'Ingenico'}"
                        invisible="not module_pos_iot_ingenico"
                        class="btn-link" />
                </setting>
                <setting
                    string="Worldline (BENELUX)"
                    title="The transactions are processed by Worldline via an IoT box. Setup your terminal on the related payment method."
                    help="Accept payments with a Worldline payment terminal"
                    documentation="/applications/sales/point_of_sale/payment_methods/terminals/worldline.html">
                    <field name="module_pos_iot_worldline" />
                    <button
                        name="action_open_payment_method_form"
                        type="object"
                        string="Payment method"
                        icon="oi-arrow-right"
                        context="{'selection': 'worldline', 'config_ids': [pos_config_id], 'provider_name': 'Worldline'}"
                        invisible="not module_pos_iot_worldline"
                        class="btn-link" />
                </setting>
                <setting
                    string="Six"
                    title="The transactions are processed by Six via an IoT box. Setup your terminal on the related payment method."
                    help="Accept payments with a Six payment terminal"
                    documentation="/applications/sales/point_of_sale/payment_methods/terminals/six.html">
                    <field name="module_pos_iot_six" />
                    <button
                        name="action_open_payment_method_form"
                        type="object"
                        string="Payment method"
                        icon="oi-arrow-right"
                        context="{'selection': 'six_iot', 'config_ids': [pos_config_id], 'provider_name': 'SIX'}"
                        invisible="not module_pos_iot_six"
                        class="btn-link" />
                </setting>
            </block>
        </field>
    </record>

</odoo>
