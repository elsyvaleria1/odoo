<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="metrics_ai_suggestion_wizard_form_view" model="ir.ui.view">
        <field name="name">metrics.ai.suggestion.wizard.form</field>
        <field name="model">wizard.esg.metric.create.from.suggestion</field>
        <field name="arch" type="xml">
            <form>
                <field name="suggestion_line_ids">
                    <list editable="bottom" create="0" delete="0" no_open="1">
                        <field name="is_selected" nolabel="1" />
                        <field name="name" />
                        <field name="code" />
                        <field name="type" />
                        <field name="category" />
                        <field name="detail" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_add_suggestions"
                        type="object"
                        string="Add"
                        invisible="not has_one_or_more_selected"
                        class="btn btn-primary"
                        data-hotkey="q" />
                    <button
                        name="action_add_suggestions"
                        type="object"
                        string="Add All"
                        context="{'add_all_suggestions': True}"
                        class="btn btn-primary"
                        data-hotkey="q" />
                    <button
                        special="cancel"
                        string="Close"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
