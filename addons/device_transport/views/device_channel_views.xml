<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="device_channel_list" model="ir.ui.view">
        <field name="name">device.channel.list</field>
        <field name="model">device.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="enrollment_id" />
                <field name="external_identifier" />
                <field name="purpose" />
                <field name="active" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="device_channel_form" model="ir.ui.view">
        <field name="name">device.channel.form</field>
        <field name="model">device.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="enrollment_id" readonly="id" />
                        <field name="external_identifier" readonly="id" />
                        <field name="purpose" readonly="id" />
                        <field name="active" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group string="Inbound Policy">
                        <field name="ip_whitelist" />
                        <field name="max_payload_size" />
                        <field name="rate_limit_enabled" />
                        <field name="rate_limit_requests" />
                        <field name="rate_limit_window_seconds" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_channel_action" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">device.channel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
