<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="device_transport_event_list" model="ir.ui.view">
        <field name="name">device.transport.event.list</field>
        <field name="model">device.transport.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="occurred_at" />
                <field name="subject_kind" />
                <field name="channel_id" />
                <field name="channel_ref" />
                <field name="event" />
                <field name="enrollment_id" />
                <field name="enrollment_ref" />
                <field name="actor_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="device_transport_event_form" model="ir.ui.view">
        <field name="name">device.transport.event.form</field>
        <field name="model">device.transport.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="subject_kind" />
                <field name="channel_id" />
                <field name="channel_ref" />
                <field name="event" />
                    <field name="occurred_at" />
                    <field name="enrollment_id" />
                    <field name="enrollment_ref" />
                    <field name="actor_id" />
                    <field name="actor_ref" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="correlation_id" />
                    </group>
                    <group string="Security Configuration">
                        <field name="before" />
                        <field name="after" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_transport_event_action" model="ir.actions.act_window">
        <field name="name">Transport History</field>
        <field name="res_model">device.transport.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
