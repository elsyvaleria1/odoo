<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_device_gps_user" model="res.groups">
        <field name="name">Remote GPS User</field>
        <field name="privilege_id" ref="device.res_groups_privilege_device_device" />
        <field
            name="comment">User can view GPS tracking data and device positions</field>
        <field
            name="implied_ids"
            eval="[             Command.link(ref('base.group_user')),             Command.link(ref('device.group_device_user'))         ]" />
    </record>

    <record id="group_device_gps_manager" model="res.groups">
        <field name="name">Remote GPS Manager</field>
        <field name="privilege_id" ref="device.res_groups_privilege_device_device" />
        <field
            name="comment">Manager can configure GPS devices and manage tracking data</field>
        <field
            name="implied_ids"
            eval="[             Command.link(ref('group_device_gps_user')),             Command.link(ref('device.group_device_manager'))         ]" />
    </record>

    <record id="base.group_system" model="res.groups">
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_device_gps_manager'))]" />
    </record>

    <record id="privilege_read_resource_odometer" model="res.groups">
        <field name="name">Privilege: a resource reads its own GPS odometer</field>
        <field name="is_privilege" eval="True" />
    </record>

</odoo>
