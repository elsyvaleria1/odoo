    <record id="view_device_data_log_gps_report_list" model="ir.ui.view">
        <field name="name">device.data.log.gps.report.list</field>
        <field name="model">device.data.log.gps.report</field>
        <field name="arch" type="xml">
            <list
                string="GPS Daily Report"
                default_order="date desc"
                create="false"
                delete="false">
                <field name="date" />
                <field name="device_id" />
                <field name="distance_best" string="Distance (km)" sum="Total" />
                <field name="driving_hours" string="Driving (hrs)" sum="Total" />
                <field name="fuel_consumed_total" string="Fuel (L)" sum="Total" />
                <field
                    name="idling_hours"
                    string="Idling (hrs)"
                    optional="show"
                    sum="Total"
                    decoration-danger="idling_hours &gt; 1" />
                <field
                    name="parked_hours"
                    string="Parked (hrs)"
                    optional="hide"
                    sum="Total" />
                <field
                    name="tracked_hours"
                    string="Tracked (hrs)"
                    optional="hide"
                    sum="Total" />
                <field
                    name="driving_pct"
                    string="Driving %"
                    optional="show"
                    decoration-muted="driving_pct &lt; 20"
                    decoration-success="driving_pct &gt;= 50"
                    decoration-warning="driving_pct &gt;= 20 and driving_pct &lt; 50" />
                <field
                    name="idling_pct"
                    string="Idling %"
                    optional="hide"
                    decoration-danger="idling_pct &gt; 20" />
                <field
                    name="fuel_efficiency"
                    string="Efficiency (km/L)"
                    optional="show"
                    decoration-danger="fuel_efficiency &lt; 5 and fuel_efficiency &gt; 0"
                    decoration-success="fuel_efficiency &gt;= 8"
                    decoration-warning="fuel_efficiency &gt;= 5 and fuel_efficiency &lt; 8" />
                <field name="speed_avg" string="Avg Speed" optional="show" />
                <field
                    name="speed_max"
                    string="Max Speed"
                    optional="show"
                    decoration-danger="speed_max &gt; 120" />
                <field
                    name="speed_over_warning_events"
                    string="⚠ Warning"
                    optional="show"
                    sum="Total"
                    decoration-warning="speed_over_warning_events &gt; 0" />
                <field
                    name="speed_over_alert_events"
                    string="⚡ Alert"
                    optional="show"
                    sum="Total"
                    decoration-danger="speed_over_alert_events &gt; 0" />
                <field
                    name="speed_over_critical_events"
                    string="🔴 Critical"
                    optional="show"
                    sum="Total"
                    decoration-danger="speed_over_critical_events &gt; 0" />
                <field
                    name="speed_wheel_discrepancy_avg"
                    string="GPS/Wheel Δ"
                    optional="hide"
                    decoration-danger="speed_wheel_discrepancy_avg &gt; 10"
                    decoration-warning="speed_wheel_discrepancy_avg &gt; 5" />
                <field
                    name="quality_pct"
                    string="GPS Quality %"
                    optional="hide"
                    decoration-danger="quality_pct &lt; 50"
                    decoration-success="quality_pct &gt;= 80"
                    decoration-warning="quality_pct &gt;= 50 and quality_pct &lt; 80" />
                <field
                    name="log_count"
                    string="GPS Points"
                    optional="hide"
                    sum="Total" />
                <field
                    name="movement_count"
                    string="Moving Points"
                    optional="hide"
                    sum="Total" />
                <field
                    name="ignition_on_count"
                    string="Ignition On"
                    optional="hide"
                    sum="Total" />
                <field
                    name="engine_temp_max"
                    string="Max Temp (°C)"
                    optional="hide"
                    decoration-danger="engine_temp_max &gt; 100" />
                <field
                    name="battery_voltage_min"
                    string="Min Battery (V)"
                    optional="hide"
                    decoration-danger="battery_voltage_min &lt; 11.5" />
                <field name="distance_source" string="Dist. Source" optional="hide" />
            </list>
        </field>
    </record>

