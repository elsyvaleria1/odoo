    <record id="action_device_data_log_gps_report" model="ir.actions.act_window">
        <field name="name">GPS Overview</field>
        <field name="res_model">device.data.log.gps.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="view_device_data_log_gps_report_search" />
        <field
            name="context">{
            'search_default_filter_today': 1,
            'search_default_group_by_device': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No GPS data available
            </p>
            <p>
                <strong>GPS Overview</strong>
            </p>
            <p> Real-time summary of your fleet's daily performance. <br /><br />
                <strong>Key
                Question:</strong> "How is my fleet performing today?" <br /><br />
                <strong>Shows:</strong>
                <ul>
                    <li>Total kilometers traveled per vehicle</li>
                    <li>Total active hours per vehicle</li>
                    <li>Fuel consumed and efficiency (km/L)</li>
                    <li>Speed violations and safety events</li>
                    <li>Fleet utilization percentage</li>
                </ul>
                <br />
                <strong>Note:</strong>
                Data updates as GPS points are received. Use "Yesterday" filter for complete day
                comparison. </p>
        </field>
    </record>

    <record
        id="action_device_data_log_gps_report_distance"
        model="ir.actions.act_window">
        <field name="name">Distance Analysis</field>
        <field name="res_model">device.data.log.gps.report</field>
        <field name="view_mode">graph,list</field>
        <field name="view_id" ref="view_device_data_log_gps_report_graph_distance" />
        <field
            name="search_view_id"
            ref="view_device_data_log_gps_report_search_by_vehicle" />
        <field
            name="context">{
            'search_default_filter_today': 1,
            'search_default_group_by_device': 1,
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No distance data available
            </p>
            <p>
                <strong>Distance Analysis</strong>
            </p>
            <p> Compare kilometers traveled by each vehicle today. <br /><br />
                <strong>Key Question:</strong>
                "Which vehicles traveled the most today?" <br /><br />
                <strong>Value:</strong>
                <ul>
                    <li>Identify high-mileage vehicles for maintenance</li>
                    <li>Compare vehicle usage across fleet</li>
                    <li>Spot underutilized vehicles</li>
                </ul>
                <br />
                <strong>Data
                Source:</strong> Uses odometer when available, GPS otherwise. Check "Dist. Source"
                column in list view for details. </p>
        </field>
    </record>

