<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="param_min_required_satellites_count" model="ir.config_parameter">
        <field name="key">device_gps.min_required_satellites_count</field>
        <field name="value">4</field>
    </record>

    <record id="param_max_hdop_threshold" model="ir.config_parameter">
        <field name="key">device_gps.max_hdop_threshold</field>
        <field name="value">5.0</field>
    </record>

    <record id="param_min_allowed_latitude_degrees" model="ir.config_parameter">
        <field name="key">device_gps.min_allowed_latitude_degrees</field>
