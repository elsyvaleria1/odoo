<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rule_script_test_list" model="ir.ui.view">
        <field name="name">rule.script.test.list</field>
        <field name="model">rule.script.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="script_id" />
                <field name="name" />
                <field name="date_on" />
                <field name="origin" />
                <field name="last_result" />
            </list>
        </field>
    </record>

    <record id="action_rule_script_test" model="ir.actions.act_window">
        <field name="name">Rule Tests</field>
        <field name="res_model">rule.script.test</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
