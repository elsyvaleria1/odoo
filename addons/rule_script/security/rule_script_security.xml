<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_rule_script" model="res.groups.privilege">
        <field name="name">Rule Scripts</field>
        <field name="category_id" ref="base.module_category_administration" />
        <field
            name="description">Writing and activating the rules other modules evaluate</field>
        <field name="sequence" eval="40" />
    </record>

    <record id="group_rule_script_author" model="res.groups">
        <field name="name">Author</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="res_groups_privilege_rule_script" />
        <field name="comment">Writes draft versions and tests of rules.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_rule_script_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="res_groups_privilege_rule_script" />
        <field name="comment">Activates and retires the versions others wrote.</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_rule_script_author'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
