<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="preparation_display_delete_cron" model="ir.cron">
            <field name="name">delete_preparation_order</field>
            <field name="model_id" ref="pos_enterprise.model_pos_prep_order" />
            <field name="state">code</field>
            <field name="code">model._clean_preparation_data()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="repeat_interval">1</field>
            <field name="repeat_unit">day</field>
            <field
                name="nextcall"
                eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="active" eval="True" />
        </record>
    </data>

</odoo>
