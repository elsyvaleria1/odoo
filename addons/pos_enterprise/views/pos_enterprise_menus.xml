<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Owned by pos_enterprise, so the xml_id lives in this module's namespace.
        Recorded under point_of_sale it was garbage-collected by
        ir.model.data._process_end() on the first `-u point_of_sale` that did
        not also load pos_enterprise, since point_of_sale never declares it.
    -->
    <menuitem
        id="menu_pos_preparation_display"
        name="Preparation Display"
        parent="point_of_sale.menu_point_of_sale"
        action="action_preparation_display"
        sequence="100" />

    <menuitem
        id="menu_point_kitchen_display_root"
        name="Kitchen Display"
        action="action_pos_preparation_display_kitchen_display"
        sequence="51"
        groups="point_of_sale.group_pos_manager"
        web_icon="pos_enterprise,static/description/icon.png"
        active="False" />

    <menuitem
        id="menu_report_preparation_time"
        name="Preparation Time"
        parent="point_of_sale.menu_point_rep"
        action="pos_preparation_time_report_action"
        sequence="6" />

</odoo>
