<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_loss_view_form" model="ir.ui.view">
        <field name="name">sale.order.loss.form.crm</field>
        <field name="model">wizard.sale.order.mark.lost</field>
        <field name="inherit_id" ref="sale.sale_order_loss_view_form" />
        <field name="arch" type="xml">
            <field name="loss_note" position="after">
                <field name="opportunity_ids" invisible="1" />
                <field name="close_opportunities" invisible="not opportunity_ids" />
            </field>
        </field>
    </record>

</odoo>
