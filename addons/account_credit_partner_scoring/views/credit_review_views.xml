<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_review_form_inherit_partner_scoring" model="ir.ui.view">
        <field name="name">credit.review.form.inherit.partner.scoring</field>
        <field name="model">credit.review</field>
        <field name="inherit_id" ref="account_credit.view_credit_review_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='grade_proposed_id']" position="after">
                <field name="tier_id" invisible="not tier_id" />
            </xpath>
        </field>
    </record>

</odoo>
