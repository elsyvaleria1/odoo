<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_conversation" model="res.groups.privilege">
        <field name="name">Conversations</field>
        <field name="sequence" eval="60" />
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="res_groups_privilege_conversation" />
        <field
            name="comment">Sees the conversations they are responsible for or took part in.</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_leader" model="res.groups">
        <field name="name">Leader</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="res_groups_privilege_conversation" />
        <field name="comment">Sees every conversation of their company.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence" eval="30" />
        <field name="privilege_id" ref="res_groups_privilege_conversation" />
        <field
            name="comment">Configures vocabulary, retention, the analysis context and the conversation tools.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_leader'))]" />
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]" />
    </record>

</odoo>
