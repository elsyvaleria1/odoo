<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_mx_municipality_search" model="ir.ui.view">
        <field name="name">l10n_mx.municipality.search</field>
        <field name="model">l10n_mx.municipality</field>
        <field name="arch" type="xml">
            <search string="Search Municipalities">
                <field name="name" />
                <field name="code" />
                <field name="state_id" />
                <filter
                    name="with_partners"
                    string="With Partners"
                    domain="[('partner_ids', '!=', False)]" />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_l10n_mx_municipality_list" model="ir.ui.view">
        <field name="name">l10n_mx.municipality.list</field>
        <field name="model">l10n_mx.municipality</field>
        <field name="arch" type="xml">
            <list string="Mexican Municipalities">
                <field name="name" />
                <field name="code" />
                <field name="state_id" />
                <field name="partner_count" />
            </list>
        </field>
    </record>

    <record id="view_l10n_mx_municipality_form" model="ir.ui.view">
        <field name="name">l10n_mx.municipality.form</field>
        <field name="model">l10n_mx.municipality</field>
        <field name="arch" type="xml">
            <form string="Mexican Municipality">
                <header>
                    <button
                        name="action_view_partners"
                        type="object"
                        string="View Partners"
                        invisible="partner_count == 0"
                        class="oe_highlight" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_partners"
                            type="object"
                            icon="fa-users"
                            invisible="partner_count == 0"
                            class="oe_stat_button">
                            <field
                                name="partner_count"
                                string="Partners"
                                widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                        </group>
                        <group>
                            <field name="state_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_mx_municipality" model="ir.actions.act_window">
        <field name="name">Municipalities</field>
        <field name="res_model">l10n_mx.municipality</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_mx_municipality_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No municipalities loaded yet
            </p>
            <p>
                Mexican municipalities are the second-level administrative divisions.
                Filter them by state and see which contacts are located in each one.
            </p>
        </field>
    </record>

</odoo>
