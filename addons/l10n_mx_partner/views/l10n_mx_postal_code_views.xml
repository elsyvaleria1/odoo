<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_mx_postal_code_search" model="ir.ui.view">
        <field name="name">l10n_mx.postal.code.search</field>
        <field name="model">l10n_mx.postal_code</field>
        <field name="arch" type="xml">
            <search string="Search Postal Codes">
                <field name="code" />
                <field name="name" />
                <field name="city" />
                <field name="state_id" />
                <field name="municipality_id" />
                <filter
                    name="urban"
                    string="Urban"
                    domain="[('zone_type', '=', 'urban')]" />
                <filter
                    name="rural"
                    string="Rural"
                    domain="[('zone_type', '=', 'rural')]" />
                <separator />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state_id'}" />
                    <filter
                        name="group_by_municipality"
                        string="Municipality"
                        context="{'group_by': 'municipality_id'}" />
                    <filter
                        name="group_by_zone"
                        string="Zone Type"
                        context="{'group_by': 'zone_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_l10n_mx_postal_code_list" model="ir.ui.view">
        <field name="name">l10n_mx.postal.code.list</field>
        <field name="model">l10n_mx.postal_code</field>
        <field name="arch" type="xml">
            <list string="Postal Codes" create="false" delete="false">
                <field name="code" />
                <field name="name" />
                <field name="city" />
                <field name="municipality_id" />
                <field name="state_id" />
                <field name="zone_type" />
                <field name="partner_count" />
            </list>
        </field>
    </record>

    <record id="view_l10n_mx_postal_code_form" model="ir.ui.view">
        <field name="name">l10n_mx.postal.code.form</field>
        <field name="model">l10n_mx.postal_code</field>
        <field name="arch" type="xml">
            <form string="Postal Code" create="false" delete="false">
                <header>
                    <button
                        name="action_view_partners"
                        type="object"
                        string="View Partners"
                        invisible="partner_count == 0"
                        class="btn-primary" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_partners"
                            type="object"
                            icon="fa-users"
                            invisible="partner_count == 0"
                            class="oe_stat_button">
                            <field
                                name="partner_count"
                                string="Partners"
                                widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="city" />
                            <field name="zone_type" />
                        </group>
                        <group>
                            <field name="state_id" />
                            <field name="municipality_id" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_mx_postal_code" model="ir.actions.act_window">
        <field name="name">Postal Codes</field>
        <field name="res_model">l10n_mx.postal_code</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No postal codes loaded yet
            </p>
            <p>
                Import the SEPOMEX catalogue from Settings: each database downloads
                cpdescarga.txt from Correos de México itself.
            </p>
        </field>
    </record>

</odoo>
