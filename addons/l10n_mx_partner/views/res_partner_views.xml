<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_form_inherit_l10n_mx" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_mx</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="zip" position="before">
                <field name="country_code" invisible="1" />
                <field
                    name="l10n_mx_postal_code_id"
                    placeholder="Search postal code..."
                    context="{'default_state_id': state_id}"
                    options="{'no_create': True, 'no_open': True}"
                    invisible="country_code != 'MX'" />
            </field>

            <field name="state_id" position="after">
                <field
                    name="l10n_mx_municipality_id"
                    context="{'default_state_id': state_id}"
                    options="{'no_create': True}"
                    invisible="country_code != 'MX'" />
            </field>
        </field>
    </record>

</odoo>
