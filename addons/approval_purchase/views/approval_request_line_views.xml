<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_request_line_view_tree_purchase" model="ir.ui.view">
        <field name="name">approval.request.line.list.purchase</field>
        <field name="model">approval.request.line</field>
        <field
            name="inherit_id"
            ref="approval_product.approval_request_line_view_tree" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id']" position="after">
                <field
                    name="seller_id"
                    string="Vendor"
                    optional="hide"
                    domain="[                         ('product_tmpl_id.product_variant_ids', 'in', product_id),                         '|',                         ('product_id', '=', False),                         ('product_id', '=', product_id),                     ]"
                    options="{'no_create': True}"
                    column_invisible="parent.target_model != 'purchase.order'" />
            </xpath>
        </field>
    </record>

</odoo>
