<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_search_purchase_approval" model="ir.ui.view">
        <field name="name">product.template.search.purchase.approval</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter
                    name="po_approval_required"
                    string="Requires PO Approval"
                    help="Products that require purchase order approval"
                    domain="[('po_approval_required', '=', True)]"
                    groups="purchase.group_purchase_manager" />
                <group groups="purchase.group_purchase_manager">
                    <filter
                        name="group_by_approval"
                        string="Approval Required"
                        context="{'group_by': 'po_approval_required'}" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list_purchase_approval" model="ir.ui.view">
        <field name="name">product.template.list.purchase.approval</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="po_approval_required"
                    string="PO Approval"
                    widget="boolean_toggle"
                    optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_purchase_approval" model="ir.ui.view">
        <field name="name">product.template.form.purchase.approval</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="inside">
                <group name="purchase_approval" string="Purchase Approval">
                    <group>
                        <field name="po_approval_required" widget="boolean_toggle" />
                        <div
                            class="text-muted"
                            invisible="not po_approval_required"
                            groups="purchase.group_purchase_manager">
                            When enabled, all purchase orders containing this product
                            will require approval regardless of other settings.
                        </div>
                    </group>
                </group>
                <group
                    name="approval_notes"
                    string="Approval Notes"
                    groups="purchase.group_purchase_manager"
                    invisible="not po_approval_required">
                    <field
                        name="po_approval_notes"
                        placeholder="Add special instructions or notes for approvers...&#10;&#10;Example: 'Specialized equipment - verify technical requirements before approving'"
                        nolabel="1" />
                </group>
                <div
                    class="alert alert-warning"
                    invisible="not po_approval_required"
                    groups="purchase.group_purchase_manager"
                    role="alert">
                    <strong>Approval Required:</strong> This product is flagged for purchase order
                    approval. All purchase orders containing this product will require approval
                    through the configured approval workflow. </div>
            </xpath>
        </field>
    </record>

</odoo>
