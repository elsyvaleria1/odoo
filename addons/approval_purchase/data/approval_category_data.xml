<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_purchase_order" model="approval.category">
        <field name="name">Purchase Order Approval</field>
        <field name="company_id" eval="False" />
        <field name="approval_type">purchase</field>
        <field name="description">Approval workflow for existing purchase orders</field>
        <field name="sequence" eval="10" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">POA</field>
        <field name="order_approval_mode">amount</field>
        <field name="order_amount_min">1000.00</field>
        <field name="order_amount_max">0.00</field>
        <field name="has_amount">required</field>
        <field name="has_partner">required</field>
        <field name="has_date">required</field>
        <field name="has_reference">optional</field>
        <field name="has_document">optional</field>
    </record>

    <record
        id="approval_category_purchase_order_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_purchase_order" />
        <field name="name">Purchase Managers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
        <field name="group_id" ref="purchase.group_purchase_manager" />
    </record>

    <record id="approval_category_purchase_request" model="approval.category">
        <field name="name">Purchase Order Request</field>
        <field name="company_id" eval="False" />
        <field name="approval_type">purchase</field>
        <field name="target_model">purchase.order</field>
        <field name="description">Create purchase order from approval request</field>
        <field name="sequence" eval="20" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">PR</field>
        <field name="has_product">required</field>
        <field name="has_amount">optional</field>
        <field name="has_partner">optional</field>
        <field name="has_reference">optional</field>
        <field name="has_document">optional</field>
    </record>

    <record
        id="approval_category_purchase_request_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_purchase_request" />
        <field name="name">Purchase Managers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
        <field name="group_id" ref="purchase.group_purchase_manager" />
    </record>

</odoo>
