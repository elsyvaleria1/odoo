<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mt_purchase_approved" model="mail.message.subtype">
        <field name="name">Approved</field>
        <field name="description">Purchase order approved</field>
        <field name="res_model">purchase.order</field>
        <field name="sequence" eval="20" />
        <field name="default" eval="True" />
    </record>

    <record id="mt_purchase_refused" model="mail.message.subtype">
        <field name="name">Refused</field>
        <field name="description">Purchase order approval refused</field>
        <field name="res_model">purchase.order</field>
        <field name="sequence" eval="30" />
        <field name="default" eval="True" />
    </record>

</odoo>
