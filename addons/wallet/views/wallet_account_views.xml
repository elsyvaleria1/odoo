<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wallet_account_form" model="ir.ui.view">
        <field name="name">wallet.account.form</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_cards"
                            type="object"
                            icon="fa-credit-card"
                            class="oe_stat_button">
                            <field name="count_card" string="Cards" widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        invisible="active"
                        bg_color="text-bg-danger"
                        text="Archived" />
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Wallet account" /></h1>
                    </div>
                    <group name="main">
                        <group name="left_col">
                            <field name="kind" />
                            <field name="issuer_id" />
                            <field name="reference" />
                            <field name="tz" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="right_col">
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="currency_id" invisible="1" />
                            <field name="account_id" />
                            <field name="amount_threshold_low" widget="monetary" />
                            <field name="amount_balance" widget="monetary" />
                            <field name="count_card_low" />
                        </group>
                    </group>
                    <notebook>
                        <page name="cards" string="Cards">
                            <field name="card_ids">
                                <list>
                                    <field name="number" />
                                    <field name="holder_id" />
                                    <field name="amount_balance" widget="monetary" />
                                    <field name="date_balance" />
                                    <field name="is_low_balance" />
                                    <field name="active" widget="boolean_toggle" />
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_wallet_account_list" model="ir.ui.view">
        <field name="name">wallet.account.list</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="kind" />
                <field name="issuer_id" />
                <field name="account_id" optional="show" />
                <field name="count_card" />
                <field name="count_card_low" />
                <field name="amount_balance" widget="monetary" sum="Total" />
                <field name="currency_id" column_invisible="True" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_wallet_account_search" model="ir.ui.view">
        <field name="name">wallet.account.search</field>
        <field name="model">wallet.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="issuer_id" />
                <field name="reference" />
                <filter name="fuel" string="Fuel" domain="[('kind', '=', 'fuel')]" />
                <filter name="toll" string="Toll" domain="[('kind', '=', 'toll')]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_by_kind"
                        string="Kind"
                        context="{'group_by': 'kind'}" />
                    <filter
                        name="group_by_issuer"
                        string="Issuer"
                        context="{'group_by': 'issuer_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_wallet_account" model="ir.actions.act_window">
        <field name="name">Wallet Accounts</field>
        <field name="res_model">wallet.account</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wallet_account_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No wallet account yet</p>
            <p>A wallet account is a prepaid balance held with an issuer: a fuel-card scheme, a toll operator.</p>
        </field>
    </record>

</odoo>
