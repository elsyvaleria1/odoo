<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wallet_card_form" model="ir.ui.view">
        <field name="name">wallet.card.form</field>
        <field name="model">wallet.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_transactions"
                            type="object"
                            icon="fa-exchange"
                            class="oe_stat_button">
                            <field
                                name="count_transaction"
                                string="Transactions"
                                widget="statinfo" />
                        </button>
                        <button
                            name="action_view_balances"
                            type="object"
                            icon="fa-line-chart"
                            class="oe_stat_button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="amount_balance" widget="monetary" />
                                </span>
                                <span class="o_stat_text">Balance</span>
                            </div>
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        invisible="active"
                        bg_color="text-bg-danger"
                        text="Archived" />
                    <widget
                        name="web_ribbon"
                        invisible="not is_low_balance or not active"
                        bg_color="text-bg-warning"
                        text="Low balance" />
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group name="main">
                        <group name="left_col">
                            <field name="number" />
                            <field name="account_id" />
                            <field name="kind" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="right_col">
                            <field name="holder_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="date_balance" />
                            <field name="amount_threshold_low" widget="monetary" />
                            <field name="amount_spent" widget="monetary" />
                            <field name="is_low_balance" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="notes" string="Notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_wallet_card_list" model="ir.ui.view">
        <field name="name">wallet.card.list</field>
        <field name="model">wallet.card</field>
        <field name="arch" type="xml">
            <list decoration-warning="is_low_balance">
                <field name="number" />
                <field name="account_id" />
                <field name="kind" optional="hide" />
                <field name="holder_id" />
                <field name="amount_balance" widget="monetary" sum="Total" />
                <field name="date_balance" optional="show" />
                <field name="is_low_balance" column_invisible="True" />
                <field name="currency_id" column_invisible="True" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_wallet_card_kanban" model="ir.ui.view">
        <field name="name">wallet.card.kanban</field>
        <field name="model">wallet.card</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_low_balance" />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="{{ record.is_low_balance.raw_value ? 'border-warning' : '' }}">
                            <strong><field name="name" /></strong>
                            <div><field name="holder_id" /></div>
                            <div>
                                <field name="amount_balance" widget="monetary" />
                                <span t-if="record.is_low_balance.raw_value" class="badge text-bg-warning ms-1">Low</span>
                            </div>
                            <div class="text-muted small"><field name="date_balance" /></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_wallet_card_search" model="ir.ui.view">
        <field name="name">wallet.card.search</field>
        <field name="model">wallet.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="number" />
                <field name="account_id" />
                <field name="holder_id" />
                <filter
                    name="low_balance"
                    string="Low balance"
                    domain="[('is_low_balance', '=', True)]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_by_account"
                        string="Account"
                        context="{'group_by': 'account_id'}" />
                    <filter
                        name="group_by_holder"
                        string="Holder"
                        context="{'group_by': 'holder_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_wallet_card" model="ir.actions.act_window">
        <field name="name">Cards</field>
        <field name="res_model">wallet.card</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_wallet_card_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No card yet</p>
            <p>A card or tag the issuer handed out, with its number, holder and latest balance.</p>
        </field>
    </record>

</odoo>
