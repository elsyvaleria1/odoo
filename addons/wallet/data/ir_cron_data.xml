<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_downsample_wallet_balances" model="ir.cron">
        <field name="name">Wallets: downsample old balance snapshots</field>
        <field name="model_id" ref="model_wallet_balance" />
        <field name="state">code</field>
        <field name="code">model._cron_downsample_old_balances()</field>
        <field name="repeat_interval" eval="1" />
