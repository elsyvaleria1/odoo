<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.documents</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="priority" eval="1" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_versions']" position="before">
                <button
                    name="action_view_documents"
                    type="object"
                    icon="fa-file-text"
                    groups="document.group_documents_user"
                    class="oe_stat_button">
                    <field name="document_count" string="Documents" widget="statinfo" />
                </button>
                <button
                    name="action_see_documents"
                    type="object"
                    icon="fa-file-text"
                    invisible="not is_user"
                    class="oe_stat_button">
                    <field name="is_user" invisible="1" />
                    <field
                        name="partner_document_count"
                        string="My Documents"
                        widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
