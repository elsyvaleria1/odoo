<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_activity_type_view_form_fleet_exit" model="ir.ui.view">
        <field name="name">mail.activity.type.form.fleet.route</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_form" />
        <field name="arch" type="xml">
            <field name="res_model" position="after">
                <field
                    name="fleet_exit_role"
                    invisible="res_model != 'stock.picking.batch'" />
                <field
                    name="fleet_exit_group"
                    invisible="fleet_exit_role != 'destination'" />
            </field>
        </field>
    </record>

    <record id="action_fleet_exit_activity_type" model="ir.actions.act_window">
        <field name="name">Route Activity Types</field>
        <field name="res_model">mail.activity.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('fleet_exit_role', '=', 'destination')]</field>
        <field
            name="context">{'default_res_model': 'stock.picking.batch', 'default_fleet_exit_role': 'destination'}</field>
    </record>

</odoo>
