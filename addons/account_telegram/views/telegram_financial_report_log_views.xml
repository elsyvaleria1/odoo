<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_telegram_financial_report_log_list" model="ir.ui.view">
        <field name="name">telegram.financial.report.log.list</field>
        <field name="model">telegram.financial.report.log</field>
        <field name="arch" type="xml">
            <list
                string="Customer Portal Bot Reports"
                create="false"
                edit="false"
                delete="false">
                <field name="date" />
                <field name="requester_partner_id" string="Requested By" />
                <field name="target_partner_id" string="Report For" />
                <field name="telegram_chat_id" />
                <field name="date_from" optional="show" />
                <field name="date_to" optional="show" />
                <field name="requester_role" optional="show" />
                <field name="is_self_request" optional="hide" />
                <field
                    name="success"
                    widget="boolean"
                    decoration-danger="not success"
                    decoration-success="success" />
            </list>
        </field>
    </record>

    <record id="view_telegram_financial_report_log_form" model="ir.ui.view">
        <field name="name">telegram.financial.report.log.form</field>
        <field name="model">telegram.financial.report.log</field>
        <field name="arch" type="xml">
            <form string="Report Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Request Information">
                            <field name="date" />
                            <field name="requester_partner_id" />
                            <field name="requester_role" />
                            <field name="is_self_request" />
                        </group>
                        <group string="Report Details">
                            <field name="target_partner_id" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="success" />
                        </group>
                    </group>
                    <group string="Telegram Details">
                        <field name="chat_id" />
                        <field name="telegram_chat_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_financial_report_log_search" model="ir.ui.view">
        <field name="name">telegram.financial.report.log.search</field>
        <field name="model">telegram.financial.report.log</field>
        <field name="arch" type="xml">
            <search string="Search Reports">
                <field name="requester_partner_id" />
                <field name="target_partner_id" />
                <field name="telegram_chat_id" />
                <separator />
                <filter
                    name="filter_success"
                    string="Delivered"
                    domain="[('success', '=', True)]" />
                <filter
                    name="filter_failed"
                    string="Failed"
                    domain="[('success', '=', False)]" />
                <separator />
                <filter
                    name="filter_self"
                    string="Self Requests"
                    domain="[('is_self_request', '=', True)]" />
                <filter
                    name="filter_manager"
                    string="Manager Requests"
                    domain="[('requester_role', '=', 'manager')]" />
                <separator />
                <filter
                    name="group_requester"
                    string="Requester"
                    context="{'group_by': 'requester_partner_id'}" />
                <filter
                    name="group_target"
                    string="Report Subject"
                    context="{'group_by': 'target_partner_id'}" />
                <filter
                    name="group_date"
                    string="Date"
                    context="{'group_by': 'date:day'}" />
                <filter
                    name="group_role"
                    string="Role"
                    context="{'group_by': 'requester_role'}" />
            </search>
        </field>
    </record>

    <record id="action_telegram_financial_report_log" model="ir.actions.act_window">
        <field name="name">Customer Portal Bot Reports</field>
        <field name="res_model">telegram.financial.report.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_success': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No reports generated yet
            </p>
            <p>
                This view shows all Partner Ledger reports sent via the Telegram Customer Portal Bot.
            </p>
        </field>
    </record>

</odoo>
