<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_inter_change_inherit_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field
            name="inherit_id"
            ref="account_inter_company_rules.view_company_inter_change_inherit_form" />
        <field name="arch" type="xml">
            <field name="intercompany_generate_purchase_orders" position="after">
                <field
                    name="intercompany_warehouse_id"
                    domain="[('company_id', '=', id)]"
                    options="{'no_create_edit': True}"
                    invisible="not intercompany_generate_sales_orders and not intercompany_generate_purchase_orders" />
                <field
                    name="intercompany_receipt_type_id"
                    domain="[('warehouse_id', '=', intercompany_warehouse_id), ('code', '=', 'incoming')]"
                    invisible="not intercompany_generate_purchase_orders" />
                <field name="intercompany_sync_delivery_receipt" />
            </field>
        </field>
    </record>

</odoo>
