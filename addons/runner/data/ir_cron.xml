<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_reap_expired_leases" model="ir.cron">
        <field name="name">Runners: Re-queue Expired Leases</field>
        <field name="model_id" ref="model_runner_job" />
        <field name="state">code</field>
        <field name="code">model._reap_expired_leases()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="repeat_interval" eval="1" />
        <field name="repeat_unit">minute</field>
        <field name="priority" eval="20" />
        <field name="active" eval="True" />
    </record>

</odoo>
