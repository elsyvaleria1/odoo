<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="device_gps_visit_rebuild_wizard_view_form" model="ir.ui.view">
        <field name="name">device.client.visit.rebuild.wizard.form</field>
        <field name="model">wizard.device.gps.visit.rebuild</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Replays the stored GPS positions through the parcel proximity rule and rewrites the client visits of the selected days. Use it to fill the history before the live tracker was installed, or after an outage. Visits still ongoing are left untouched.</p>
                <group>
                    <field name="tz" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="device_ids" widget="many2many_tags" />
                </group>
                <footer>
                    <button
                        name="action_rebuild"
                        type="object"
                        string="Rebuild"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_device_gps_visit_rebuild_wizard" model="ir.actions.act_window">
        <field name="name">Rebuild GPS Parcel Visits</field>
        <field name="res_model">wizard.device.gps.visit.rebuild</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
