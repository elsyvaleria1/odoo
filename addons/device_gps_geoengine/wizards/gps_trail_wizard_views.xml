<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_device_device_search_gps_trail" model="ir.ui.view">
        <field name="name">device.device.search.gps.trail</field>
        <field name="model">device.device</field>
        <field name="arch" type="xml">
            <search string="Search GPS Devices for Trail">
                <field
                    name="name"
                    string="Device"
                    filter_domain="[                         '|',                         ('name', 'ilike', self),                         ('imei', 'ilike', self)                     ]" />
                <field name="imei" />
                <separator />
                <filter
                    name="connected"
                    string="Connected"
                    domain="[('connection_state', '=', 'connected')]" />
                <filter
                    name="tracking_enabled"
                    string="Tracking Enabled"
                    domain="[('gps_tracking_enabled', '=', True)]" />
                <group>
                    <filter
                        name="group_by_connection"
                        string="Connection State"
                        context="{'group_by': 'connection_state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_gps_trail_wizard_form" model="ir.ui.view">
        <field name="name">gps.trail.wizard.form</field>
        <field name="model">wizard.device.device.view.trail</field>
        <field name="arch" type="xml">
            <form string="View GPS Trails">
                <group>
                    <group string="Selection Mode" colspan="2">
                        <field
                            name="selection_mode"
                            widget="radio"
                            options="{'horizontal': true}" />
                    </group>
                </group>

                <group>
                    <group
                        name="select_devices"
                        string="Select GPS Devices"
                        invisible="selection_mode != 'device'">
                        <field
                            name="device_ids"
                            placeholder="Search by device or IMEI..."
                            widget="many2many_tags"
                            context="{'search_view_ref': 'device_gps_geoengine.view_device_device_search_gps_trail'}"
                            options="{'no_create': true}" />
                    </group>

                    <group string="Date Range">
                        <field name="date_from" />
                        <field name="date_to" />
                    </group>
                </group>

                <group>
                    <group string="Trail Options">
                        <field name="group_by" widget="radio" />
                    </group>

                    <group string="Styling">
                        <field name="trail_color" widget="color" />
                    </group>
                </group>

                <group invisible="not selection_summary">
                    <div class="alert alert-info" role="alert">
                        <strong>Selection:</strong>
                        <field name="selection_summary" />
                    </div>
                </group>

                <footer>
                    <button
                        name="action_generate_trails"
                        type="object"
                        string="View Trails"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gps_trail_wizard" model="ir.actions.act_window">
        <field name="name">View GPS Trails</field>
        <field name="res_model">wizard.device.device.view.trail</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_gps_trail_result_search" model="ir.ui.view">
        <field name="name">gps.trail.result.search</field>
        <field name="model">wizard.device.device.view.trail.result</field>
        <field name="arch" type="xml">
            <search string="GPS Trails">
                <field
                    name="name"
                    string="Trail"
                    filter_domain="[                         '|',                         ('name', 'ilike', self),                         ('device_name', 'ilike', self)                     ]" />
                <field name="device_id" string="Device" />
                <separator />
                <group>
                    <filter
                        name="group_by_device"
                        string="Device"
                        context="{'group_by': 'device_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_gps_trail_result_list" model="ir.ui.view">
        <field name="name">gps.trail.result.list</field>
        <field name="model">wizard.device.device.view.trail.result</field>
        <field name="arch" type="xml">
            <list string="GPS Trails">
                <field name="name" />
                <field name="length_km" string="Dist (km)" />
                <field name="duration_hours" string="Duration" optional="show" />
                <field name="driving_hours" string="Driving" optional="hide" />
                <field name="speed_avg" optional="show" />
                <field name="speed_max" optional="show" />
                <field name="fuel_consumed" optional="hide" />
                <field name="fuel_efficiency" optional="hide" />
                <field name="stop_count" optional="hide" />
                <field name="date_from" optional="show" />
                <field name="date_to" optional="show" />
                <field name="point_count" optional="hide" />
                <field name="device_name" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_gps_trail_result_form" model="ir.ui.view">
        <field name="name">gps.trail.result.form</field>
        <field name="model">wizard.device.device.view.trail.result</field>
        <field name="arch" type="xml">
            <form string="GPS Trail">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>

                    <group>
                        <group string="Source Information">
                            <field name="device_id" />
                        </group>

                        <group string="Time Range">
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="duration_hours" />
                            <field name="point_count" />
                        </group>
                    </group>

                    <group>
                        <group string="Distance">
                            <field name="length_km" string="GPS Distance (km)" />
                            <field name="distance_odo" invisible="not distance_odo" />
                            <field
                                name="odometer_start"
                                invisible="not odometer_start" />
                            <field name="odometer_end" invisible="not odometer_end" />
                        </group>

                        <group string="Time Breakdown">
                            <field name="driving_hours" />
                            <field name="idling_hours" />
                            <field name="parked_hours" />
                            <field name="stop_count" />
                        </group>
                    </group>

                    <group>
                        <group string="Speed">
                            <field name="speed_avg" />
                            <field name="speed_max" />
                        </group>

                        <group string="Fuel" invisible="not fuel_start">
                            <field name="fuel_start" />
                            <field name="fuel_end" />
                            <field name="fuel_consumed" />
                            <field name="fuel_efficiency" />
                        </group>
                    </group>

                    <group>
                        <group string="Display">
                            <field name="trail_color" widget="color" />
                        </group>
                    </group>

                    <group string="Trail Geometry" invisible="1">
                        <field name="the_trail" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gps_trail_result_geoengine" model="ir.ui.view">
        <field name="name">gps.trail.result.geoengine</field>
        <field name="model">wizard.device.device.view.trail.result</field>
        <field name="arch" type="xml">
            <geoengine webgl_trail="true">
                <field name="name" />
                <field name="the_trail" />
                <field name="trail_color" />
                <field name="trail_timestamps" />

                <field name="device_name" />

                <field name="point_count" />
                <field name="length_km" />
                <field name="date_from" />
                <field name="date_to" />

                <field name="duration_hours" />
                <field name="driving_hours" />
                <field name="idling_hours" />
                <field name="speed_avg" />
                <field name="speed_max" />
                <field name="fuel_consumed" />
                <field name="stop_count" />

                <templates>
                    <t t-name="info_box">
                        <div class="o_gps_trail_info">
                            <h4
                                style="margin: 0 0 8px 0; border-bottom: 1px solid #ddd; padding-bottom: 6px;">
                                <t t-out="record.name.value" />
                            </h4>

                            <table style="font-size: 12px; width: 100%;">
                                <tr>
                                    <td style="padding: 2px 8px 2px 0; color: #666;">Distance:</td>
                                    <td style="padding: 2px 0; font-weight: bold;"><t t-out="record.length_km.value" /> km</td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 8px 2px 0; color: #666;">Duration:</td>
                                    <td style="padding: 2px 0;"><t t-out="record.duration_hours.value" /> hrs</td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 8px 2px 0; color: #666;">Avg Speed:</td>
                                    <td style="padding: 2px 0;"><t t-out="record.speed_avg.value" /> km/h</td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 8px 2px 0; color: #666;">Max Speed:</td>
                                    <td style="padding: 2px 0;"><t t-out="record.speed_max.value" /> km/h</td>
                                </tr>
                            </table>

                            <div
                                style="margin-top: 8px; padding-top: 6px; border-top: 1px solid #eee;">
                                <table style="font-size: 11px; width: 100%;">
                                    <tr>
                                        <td style="padding: 1px 6px 1px 0; color: #666;">Driving:</td>
                                        <td style="padding: 1px 0;"><t t-out="record.driving_hours.value" /> hrs</td>
                                        <td style="padding: 1px 6px 1px 0; color: #666;">Idling:</td>
                                        <td style="padding: 1px 0;"><t t-out="record.idling_hours.value" /> hrs</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 1px 6px 1px 0; color: #666;">Stops:</td>
                                        <td style="padding: 1px 0;"><t t-out="record.stop_count.value" /></td>
                                        <td style="padding: 1px 6px 1px 0; color: #666;">Fuel:</td>
                                        <td style="padding: 1px 0;"><t t-out="record.fuel_consumed.value" /> L</td>
                                    </tr>
                                </table>
                            </div>

                            <div
                                style="margin-top: 8px; padding-top: 6px; border-top: 1px solid #eee; font-size: 10px; color: #888;">
                                <t t-out="record.date_from.value" /> → <t t-out="record.date_to.value" />
                            </div>

                            <div
                                t-if="record.device_name.value"
                                style="margin-top: 4px; font-size: 10px; color: #aaa;">
                                GPS: <t t-out="record.device_name.value" />
                            </div>
                        </div>
                    </t>
                </templates>
            </geoengine>
        </field>
    </record>

    <record id="raster_layer_gps_trail_result_osm" model="geoengine.raster.layer">
        <field name="name">OpenStreetMap</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">osm</field>
        <field name="overlay">0</field>
        <field name="url">https://tile.openstreetmap.org/{z}/{x}/{y}.png</field>
        <field name="sequence" eval="1" />
    </record>

    <record
        id="raster_layer_gps_trail_result_google_sat"
        model="geoengine.raster.layer">
        <field name="name">Google Satellite</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://mt1.google.com/vt/lyrs=s&amp;x={x}&amp;y={y}&amp;z={z}</field>
        <field name="sequence" eval="2" />
    </record>

    <record
        id="raster_layer_gps_trail_result_google_hybrid"
        model="geoengine.raster.layer">
        <field name="name">Google Hybrid</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://mt1.google.com/vt/lyrs=y&amp;x={x}&amp;y={y}&amp;z={z}</field>
        <field name="sequence" eval="3" />
    </record>

    <record
        id="raster_layer_gps_trail_result_google_terrain"
        model="geoengine.raster.layer">
        <field name="name">Google Terrain</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://mt1.google.com/vt/lyrs=p&amp;x={x}&amp;y={y}&amp;z={z}</field>
        <field name="sequence" eval="4" />
    </record>

    <record
        id="raster_layer_gps_trail_result_esri_satellite"
        model="geoengine.raster.layer">
        <field name="name">ESRI Satellite</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}</field>
        <field name="sequence" eval="5" />
    </record>

    <record
        id="raster_layer_gps_trail_result_carto_light"
        model="geoengine.raster.layer">
        <field name="name">CartoDB Light</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://cartodb-basemaps-a.global.ssl.fastly.net/light_all/{z}/{x}/{y}.png</field>
        <field name="sequence" eval="6" />
    </record>

    <record
        id="raster_layer_gps_trail_result_carto_dark"
        model="geoengine.raster.layer">
        <field name="name">CartoDB Dark</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field
            name="url">https://cartodb-basemaps-a.global.ssl.fastly.net/dark_all/{z}/{x}/{y}.png</field>
        <field name="sequence" eval="7" />
    </record>

    <record id="raster_layer_gps_trail_result_topo" model="geoengine.raster.layer">
        <field name="name">OpenTopoMap</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field name="raster_type">xyz</field>
        <field name="overlay">0</field>
        <field name="url">https://tile.opentopomap.org/{z}/{x}/{y}.png</field>
        <field name="sequence" eval="8" />
    </record>

    <record id="vector_layer_gps_trail_result_lines" model="geoengine.vector.layer">
        <field name="name">GPS Trails</field>
        <field name="view_id" ref="view_gps_trail_result_geoengine" />
        <field
            name="geo_field_id"
            ref="device_gps_geoengine.field_wizard_device_device_view_trail_result__the_trail" />
        <field name="geo_repr">colored_field</field>
        <field
            name="color_field_id"
            ref="device_gps_geoengine.field_wizard_device_device_view_trail_result__trail_color" />
        <field name="begin_color">#3366FF</field>
        <field name="sequence" eval="1" />
        <field name="active_on_startup" eval="True" />
        <field name="layer_opacity">0.9</field>
    </record>

</odoo>
