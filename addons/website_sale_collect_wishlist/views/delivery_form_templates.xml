<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="unavailable_products_warning"
        inherit_id="website_sale_collect.unavailable_products_warning">
        <xpath expr="//form[hasclass('o_wsc_update_qty_form')]" position="inside">
            <t t-if="not available_qty">
                <t
                    t-set="in_wishlist"
                    t-value="line_ids.product_id._is_in_wishlist()" />
                <button
                    t-if="not in_wishlist"
                    type="submit"
                    formaction="/shop/wishlist/save_for_later"
                    title="Add to Wishlist"
                    class="o_wsc_save_for_later btn btn-link alert-link border-start ps-2 py-0 pe-0 small align-baseline">
                    <i
                        class="fa-regular fa-heart"
                        role="presentation"
                        aria-label="Add to Wishlist" />
                        Wishlist
                </button>
                <span t-else="" class="alert-link border-start ps-2 small">
                    <i class="fa-solid fa-heart" /> In wishlist
                </span>
            </t>
        </xpath>
    </template>

</odoo>
