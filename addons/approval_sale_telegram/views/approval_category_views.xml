<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_approval_category_form_telegram_sale_confirm" model="ir.ui.view">
        <field name="name">approval.category.form.telegram.sale.confirm</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approval_sale.view_approval_category_form_sale" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sale_config']" position="inside">
                <group name="telegram_sale_confirm" string="Telegram">
                    <field name="telegram_confirm_user_ids" widget="many2many_tags" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
