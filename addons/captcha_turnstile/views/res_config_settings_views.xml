<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.captcha.turnstile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="web.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="captcha_turnstile_warning" position="replace">
                <div
                    class="content-group"
                    id="captcha_turnstile_configuration"
                    invisible="not module_captcha_turnstile">
                    <div class="mt16 row">
                        <label
                            for="captcha_turnstile_site_key"
                            class="col-3 o_light_label" />
                        <field name="captcha_turnstile_site_key" />
                    </div>
                    <div class="mt16 row">
                        <label
                            for="captcha_turnstile_secret_key"
                            class="col-3 o_light_label" />
                        <field name="captcha_turnstile_secret_key" />
                    </div>
                    <div>
                        <a
                            href="https://developers.cloudflare.com/turnstile/get-started/"
                            class="oe_link"
                            target="_blank">
                            <i class="oi oi-arrow-right" /> Get Turnstile keys
                        </a>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
