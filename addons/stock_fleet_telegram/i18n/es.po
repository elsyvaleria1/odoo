msgstr "%(picking)s (%(partner)s) entregada: la validé y le guardé la remisión firmada."

#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_delivery_slip.py:0
msgid "%(picking)s (%(partner)s) delivered: I validated it with the signed slip it already had."
msgstr "%(picking)s (%(partner)s) entregada: la validé con la remisión firmada que ya tenía."

#. module: stock_fleet_telegram
#. odoo-python
