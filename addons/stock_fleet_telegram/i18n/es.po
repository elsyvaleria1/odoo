#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_handler.py:0
msgid "%(command)s - Send the photos or PDFs of the delivery slips the customer signed, then press Finish to hand the papers to administration."
msgstr "%(command)s - Envía las fotos o PDF de las remisiones que firmó el cliente y toca Terminar para entregar los papeles a administración."

#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_handler.py:0
msgid "%(file)s weighs more than 20 MB, the most Telegram lets a bot download. Send a photo of the slip instead."
msgstr "%(file)s pesa más de 20 MB, lo máximo que Telegram deja descargar a un bot. Mejor envía una foto de la remisión."

#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_delivery_slip.py:0
