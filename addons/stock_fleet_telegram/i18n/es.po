#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_handler.py:0
msgid "%(command)s - Send the photo of a delivery slip the customer signed."
msgstr "%(command)s - Envía la foto de una remisión firmada por el cliente."

#. module: stock_fleet_telegram
#. odoo-python
#: code:addons/stock_fleet_telegram/models/telegram_handler.py:0
msgid "%(picking)s for %(customer)s. %(action)s"
