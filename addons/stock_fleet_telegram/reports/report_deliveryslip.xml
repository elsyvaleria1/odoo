<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The signed slip of a delivery order is confirmed by this code. -->
    <template
        id="report_delivery_document_slip_qr"
        inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@id='informations']" position="before">
            <div
                t-if="o.picking_type_id.code == 'outgoing' and o.state not in ('draft', 'cancel')"
                class="text-end">
                <img
                    t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=200&amp;height=200' % quote_plus(o._get_delivery_slip_qr_value())"
                    style="width: 32mm; height: 32mm;"
                    alt="QR" />
            </div>
        </xpath>
    </template>

</odoo>
