<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_delivery_slip_receipt_form" model="ir.ui.view">
        <field name="name">stock.delivery.slip.receipt.form</field>
        <field name="model">stock.delivery.slip.receipt</field>
        <field name="arch" type="xml">
            <form string="Signed Delivery Slip Receipt">
                <header>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Receipt"
                        invisible="state not in ('draft', 'submitted')"
                        class="btn-primary" />
                    <button
                        name="action_print"
                        type="object"
                        string="Print Receipt"
                        invisible="state != 'done'" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        confirm="Cancelling a confirmed batch marks its papers as not received again. Continue?"
                        invisible="state == 'cancel'" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="delivered_by_id"
                                widget="many2one_avatar_user"
                                readonly="state not in ('draft', 'submitted')" />
                            <field
                                name="received_by_id"
                                widget="many2one_avatar_user"
                                readonly="state not in ('draft', 'submitted')" />
                        </group>
                        <group>
                            <field
                                name="date_receipt"
                                invisible="state in ('draft', 'submitted')" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="1" />
                            <field name="slip_count" />
                        </group>
                    </group>
                    <div
                        class="alert alert-warning"
                        role="status"
                        invisible="state != 'submitted'">
                        Sent from Telegram by whoever delivered the goods. Check each
                        delivery slip against the paper received; remove the lines whose
                        paper did not arrive, then confirm.
                    </div>
                    <field
                        name="slip_ids"
                        readonly="state not in ('draft', 'submitted')">
                        <list create="0" delete="0">
                            <field name="create_date" string="Delivered On" />
                            <field name="picking_id" />
                            <field name="origin" optional="show" />
                            <field name="partner_id" />
                            <field name="date_done" optional="show" />
                            <field name="found_by" optional="hide" />
                            <button
                                name="action_open_picking"
                                type="object"
                                string="Delivery Order"
                                title="Open delivery order"
                                icon="fa-external-link"
                                class="btn-link" />
                            <button
                                name="action_remove_from_receipt"
                                type="object"
                                string="Not Arrived"
                                title="Paper did not arrive"
                                icon="fa-times"
                                column_invisible="parent.state not in ('draft', 'submitted')"
                                class="btn-link text-danger" />
                        </list>
                    </field>
                    <field name="note" placeholder="Notes..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_stock_delivery_slip_receipt_list" model="ir.ui.view">
        <field name="name">stock.delivery.slip.receipt.list</field>
        <field name="model">stock.delivery.slip.receipt</field>
        <field name="arch" type="xml">
            <list
                string="Signed Delivery Slip Receipts"
                decoration-info="state == 'draft'"
                decoration-muted="state == 'cancel'"
                decoration-warning="state == 'submitted'">
                <field name="name" />
                <field name="date_receipt" />
                <field name="delivered_by_id" widget="many2one_avatar_user" />
                <field name="received_by_id" widget="many2one_avatar_user" />
                <field name="slip_count" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'done'"
                    decoration-warning="state == 'submitted'" />
            </list>
        </field>
    </record>

    <record id="view_stock_delivery_slip_receipt_search" model="ir.ui.view">
        <field name="name">stock.delivery.slip.receipt.search</field>
        <field name="model">stock.delivery.slip.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="delivered_by_id" />
                <field
                    name="slip_ids"
                    string="Delivery Order"
                    filter_domain="[('slip_ids.picking_id.name', 'ilike', self)]" />
                <filter
                    name="draft"
                    string="In Progress"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="submitted"
                    string="To Receive"
                    domain="[('state', '=', 'submitted')]" />
                <filter
                    name="done"
                    string="Received"
                    domain="[('state', '=', 'done')]" />
                <separator />
                <filter name="date_receipt" string="Received On" date="date_receipt" />
                <group>
                    <filter
                        name="groupby_delivered_by"
                        string="Delivered By"
                        context="{'group_by': 'delivered_by_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_delivery_slip_receipt" model="ir.actions.act_window">
        <field name="name">Delivery Slip Reception</field>
        <field name="res_model">stock.delivery.slip.receipt</field>
        <field name="view_mode">list,form</field>
        <field
            name="context">{'search_default_draft': 1, 'search_default_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No delivery slips to receive</p>
            <p>
                Whoever delivers sends the signed slips through Telegram with
                /entrega and closes the list with its Finish button; the list lands
                here to be confirmed against the paper.
            </p>
        </field>
    </record>

</odoo>
