<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_referral_friend_form" model="ir.ui.view">
        <field name="name">hr.referral.friend.form</field>
        <field name="model">hr.referral.friend</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="name_details">
                            <field name="name" />
                            <field name="position" widget="radio" />
                        </group>
                        <group name="image_header">
                            <field
                                name="image_head"
                                widget="image"
                                nolabel="1"
                                class="oe_avatar referral-rounded-circle" />
                        </group>
                        <group name="image">
                            <field name="image" widget="image" nolabel="0" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_referral_friend_tree" model="ir.ui.view">
        <field name="name">hr.referral.friend.list</field>
        <field name="model">hr.referral.friend</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" class="oe_avatar o_referral_img" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_hr_referral_friend_configuration" model="ir.actions.act_window">
        <field name="name">Friends</field>
        <field name="res_model">hr.referral.friend</field>
        <field name="view_mode">list,form</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('hr_referral.group_hr_referral_manager'))]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new friend
            </p>
        </field>
    </record>

</odoo>
