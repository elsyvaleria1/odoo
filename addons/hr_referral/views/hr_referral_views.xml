<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_hr_referral_points_filter" model="ir.ui.view">
            <field name="name">hr.referral.points.filter</field>
            <field name="model">hr.referral.points</field>
            <field name="arch" type="xml">
                <search string="Search Points / Gifts">
                    <field name="ref_user_id" />
                    <filter
                        name="filter_gifts"
                        string="Gifts"
                        domain="[('hr_referral_reward_id', '!=', False)]" />
                    <filter
                        name="filter_points"
                        string="Points"
                        domain="[('hr_referral_reward_id', '=', False), ('points', '!=', 0)]" />
                    <group>
                        <filter
                            name="group_by_user_id"
                            string="User"
                            context="{'group_by':'ref_user_id'}" />
                        <filter
                            name="group_by_applicant_id"
                            string="Applicant"
                            context="{'group_by':'applicant_id'}" />
                    </group>
                </search>
            </field>
        </record>
        <record id="view_hr_referral_points_tree" model="ir.ui.view">
            <field name="name">hr.referral.points.list</field>
            <field name="model">hr.referral.points</field>
            <field name="arch" type="xml">
                <list>
                    <field name="ref_user_id" widget="many2one_avatar_user" />
                    <field name="applicant_id" column_invisible="True" />
                    <field name="applicant_name" string="Applicant" optional="show" />
                    <field name="stage_id" optional="show" />
                    <field
                        name="points"
                        decoration-danger="0 &gt; points"
                        decoration-success="points &gt; 0" />
                    <field name="write_date" optional="hide" />
                    <field name="hr_referral_reward_id" optional="hide" />
                    <field
                        name="company_id"
                        optional="hide"
                        groups="base.group_multi_company" />
                </list>
            </field>
        </record>
        <record id="view_hr_referral_gift_tree" model="ir.ui.view">
            <field name="name">hr.referral.points.list</field>
            <field name="model">hr.referral.points</field>
            <field name="arch" type="xml">
                <list>
                    <field name="ref_user_id" widget="many2one_avatar_user" />
                    <field name="points" />
                    <field name="hr_referral_reward_id" />
                    <field name="company_id" groups="base.group_multi_company" />
                </list>
            </field>
        </record>
        <record id="view_hr_referral_points_form" model="ir.ui.view">
            <field name="name">hr.referral.points.form</field>
            <field name="model">hr.referral.points</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group name="main_details">
                                <field
                                    name="ref_user_id"
                                    widget="many2one_avatar_user" />
                                <field name="points" />
                                <field
                                    name="company_id"
                                    groups="base.group_multi_company" />
                            </group>
                            <group name="configuration_details">
                                <field
                                    name="hr_referral_reward_id"
                                    invisible="not hr_referral_reward_id" />
                                <field
                                    name="applicant_id"
                                    invisible="not applicant_id" />
                                <field name="stage_id" invisible="not applicant_id" />
                                <field name="sequence_stage" invisible="1" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_hr_referral_points" model="ir.actions.act_window">
            <field name="name">Points</field>
            <field name="res_model">hr.referral.points</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_hr_referral_points_tree" />
            <field name="context">{'search_default_group_by_user_id': 1}</field>
            <field
                name="group_ids"
                eval="[Command.set([ref('hr_referral.group_hr_recruitment_referral_user')])]" />
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    Create new reward points
                </p>
            </field>
        </record>
        <record id="action_hr_referral_welcome_screen" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">hr_referral_welcome</field>
            <field name="target">main</field>
            <field name="path">referrals</field>
        </record>
    </data>

</odoo>
