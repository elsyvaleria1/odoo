<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_applicant_view_form_inherit_referral" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.inherit.referral</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="before">
                <field
                    name="ref_user_id"
                    placeholder="Select the user that send us the applicant"
                    widget="many2one_avatar"
                    domain="[('share', '=', False), ('company_id', 'in', allowed_company_ids)]" />
                <field name="is_accessible_to_current_user" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="hr_applicant_view_search_bis_inherit_referral" model="ir.ui.view">
        <field name="name">hr.applicant.view.search.inherit.referral</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search_bis" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email_from']" position="after">
                <field
                    name="ref_user_id"
                    string="Referred By"
                    widget="many2one_avatar_user" />
            </xpath>
            <xpath expr="//filter[@name='last_stage_update']" position="after">
                <filter
                    name="ref_by_user_id"
                    string="Referred By"
                    context="{'group_by':'ref_user_id'}" />
            </xpath>
        </field>
    </record>

    <record id="hr_recruitment.crm_case_categ0_act_job" model="ir.actions.act_window">
        <field name="domain">[('is_accessible_to_current_user', '=', True)]</field>
    </record>

    <record
        id="hr_recruitment.action_hr_job_applications"
        model="ir.actions.act_window">
        <field name="domain">[('is_accessible_to_current_user', '=', True)]</field>
    </record>

    <record id="view_hr_applicant_employee_referral_kanban" model="ir.ui.view">
        <field name="name">hr.applicant.employee.referral.kanban</field>
        <field name="model">hr.applicant</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <kanban create="false" can_open="0" js_class="referral_kanban">
                <field name="shared_item_infos" />
                <field name="referral_state" />
                <field name="friend_id" />
                <templates>
                    <t t-name="card" class="px-3">
                        <widget
                            name="web_ribbon"
                            title="Ongoing"
                            bg_color="text-bg-primary" />
                        <widget
                            name="web_ribbon"
                            title="Hired"
                            invisible="referral_state != 'hired'"
                            class="z-1"
                            bg_color="text-bg-success" />
                        <widget
                            name="web_ribbon"
                            title="Not Hired"
                            invisible="referral_state != 'closed'"
                            bg_color="text-bg-danger" />
                        <div class="d-flex" t-if="record.partner_name.value">
                            <div class="d-flex flex-column">
                                <field name="partner_name" class="fw-bold fs-4" />
                                <field name="job_id" class="text-muted mb-3" />
                            </div>
                            <div
                                t-if="record.friend_id.raw_value"
                                class="o_head_friend ms-auto me-2 mt-3 z-0">
                                <field
                                    name="friend_id"
                                    widget="image"
                                    options="{'preview_image': 'image_head'}" />
                            </div>
                        </div>
                        <div t-else="">
                            <div
                                t-if="record.friend_id.raw_value"
                                class="o_head_friend ms-auto me-2 mt-3 z-0">
                                <field
                                    name="friend_id"
                                    widget="image"
                                    options="{'preview_image': 'image_head'}" />
                            </div>
                        </div>
                        <div t-if="record.user_id.value"><b>Responsible: </b><field name="user_id" /></div>
                        <h5>
                            <div t-if="record.referral_state.raw_value == 'progress'">
                                <field name="earned_points" /> / <field name="max_points" /> Points
                            </div>
                            <span t-else="">
                                You earned <field name="earned_points" /> Points
                            </span>
                        </h5>
                        <div class="progress z-0">
                            <div
                                class="progress-bar"
                                role="progressbar"
                                t-att-style="'width: ' + record.earned_points.value / record.max_points.value * 100 + '%;'"
                                t-att-aria-valuenow="record.earned_points.value"
                                aria-valuemin="0"
                                t-att-aria-valuemax="record.max_points.value" />
                        </div>
                        <table class="table">
                            <tr
                                t-foreach="JSON.parse(record.shared_item_infos.raw_value)"
                                t-as="stage"
                                t-key="stage_index">
                                <td>
                                    <t t-if="stage.done"><i class="text-success fa-solid fa-check" title="Done" /></t>
                                    <t t-elif="record.referral_state.raw_value == 'closed'"><i class="text-danger fa-solid fa-xmark" title="Closed" /></t>
                                    <t t-else=""><i class="fa-regular fa-square" title="Open" /></t>
                                </td>
                                <td><t t-out="stage.name" /></td>
                                <td t-if="stage.done">+<t t-out="stage.points" /> Points</td>
                                <td
                                    t-elif="record.referral_state.raw_value == 'closed'" />
                                <td t-else="" class="text-muted">+<t t-out="stage.points" /> Points</td>
                            </tr>
                        </table>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_referral_filter" model="ir.ui.view">
        <field name="name">hr.referral.filter</field>
        <field name="model">hr.applicant</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <search string="Search Referral">
                <filter
                    name="filter_progress"
                    string="In Progress"
                    domain="[('referral_state', '=', 'progress')]" />
                <filter
                    name="filter_hired"
                    string="Hired"
                    domain="[('referral_state', '=', 'hired')]" />
                <filter
                    name="filter_closed"
                    string="Not Hired"
                    domain="[('referral_state', '=', 'closed'), ('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_hr_applicant_employee_referral" model="ir.actions.act_window">
        <field name="name">My Referral</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">kanban,form</field>
        <field
            name="view_id"
            ref="hr_referral.view_hr_applicant_employee_referral_kanban" />
        <field name="search_view_id" ref="view_hr_referral_filter" />
        <field name="domain">[('ref_user_id','=',uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_referral_kanban">
                Ready to receive points?
            </p><p>
                Let's share a job position.
            </p>
        </field>
    </record>

    <record
        id="action_hr_refused_applicant_employee_referral"
        model="ir.actions.act_window">
        <field name="name">My Referral</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">kanban,form</field>
        <field
            name="view_id"
            ref="hr_referral.view_hr_applicant_employee_referral_kanban" />
        <field name="search_view_id" ref="view_hr_referral_filter" />
        <field name="domain">[('ref_user_id','=',uid)]</field>
        <field name="context">{"search_default_filter_closed": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_referral_kanban">
                Ready to receive points?
            </p><p>
                Let's share a job position.
            </p>
        </field>
    </record>

</odoo>
