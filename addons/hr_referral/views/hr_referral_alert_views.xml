<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_referral_alert_form" model="ir.ui.view">
        <field name="name">hr.referral.alert.form</field>
        <field name="model">hr.referral.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="%(hr_referral_alert_mail_wizard_action)d"
                        type="action"
                        string="Send Mail" />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        invisible="active"
                        bg_color="text-bg-danger" />
                    <group>
                        <group name="duration_details">
                            <field name="date_from" />
                            <field name="active" invisible="1" />
                            <field name="date_to" />
                            <field
                                name="company_id"
                                placeholder="Visible to all"
                                options="{'no_create': True}"
                                groups="base.group_multi_company" />
                        </group>
                        <group name="alert_type">
                            <field name="onclick" widget="radio" />
                            <field
                                name="url"
                                placeholder="https://www.google.com"
                                invisible="onclick != 'url'"
                                required="onclick == 'url'" />
                        </group>
                    </group>
                    <group col="1">
                        <group name="name_details">
                            <field name="name" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_referral_alert_tree" model="ir.ui.view">
        <field name="name">hr.referral.alert.list</field>
        <field name="model">hr.referral.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
            </list>
        </field>
    </record>

    <record id="hr_referral_alert_view_search" model="ir.ui.view">
        <field name="name">hr.referral.alert.view.search</field>
        <field name="model">hr.referral.alert</field>
        <field name="arch" type="xml">
            <search string="HR Referral Alert Search">
                <field name="name" />
                <separator />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]" />
            </search>
        </field>
    </record>

    <record id="action_hr_referral_alert_configuration" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">hr.referral.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_referral_alert_view_search" />
        <field
            name="group_ids"
            eval="[Command.link(ref('hr_referral.group_hr_referral_manager'))]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new alerts
            </p>
            <p>
                Alerts will appear on the main screen to provide information or redirect employees.
            </p>
        </field>
    </record>

</odoo>
