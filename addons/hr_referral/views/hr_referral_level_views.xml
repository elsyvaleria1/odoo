<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_referral_level_form" model="ir.ui.view">
        <field name="name">hr.referral.level.form</field>
        <field name="model">hr.referral.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group name="name_details">
                            <field name="name" />
                        </group>
                        <group name="requirements">
                            <label for="points" string="Requirements" />
                            <div>
                                <field name="points" class="oe_inline" />
                                <span class="ml8">Points</span>
                            </div>
                        </group>
                    </group>
                    <group name="image">
                        <field name="image" widget="image" nolabel="0" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_referral_level_tree" model="ir.ui.view">
        <field name="name">hr.referral.level.list</field>
        <field name="model">hr.referral.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="image" widget="image" class="oe_avatar o_referral_img" />
                <field name="name" />
                <field name="points" />
            </list>
        </field>
    </record>

    <record id="action_hr_referral_level_configuration" model="ir.actions.act_window">
        <field name="name">Levels</field>
        <field name="res_model">hr.referral.level</field>
        <field name="view_mode">list,form</field>
        <field
            name="group_ids"
            eval="[Command.link(ref('hr_referral.group_hr_referral_manager'))]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new level
            </p>
        </field>
    </record>

</odoo>
