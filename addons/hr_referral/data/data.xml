<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Onbording Screens -->
        <record id="welcome1" model="hr.referral.onboarding">
            <field
                name="text">Oh no!
Villains are lurking the city!
Help us recruit a team of superheroes to save the day!</field>
            <field name="sequence">1</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/villains.png" />
        </record>
        <record id="welcome2" model="hr.referral.onboarding">
            <field
                name="text">Browse through open job positions, promote them on social media, or refer friends.</field>
            <field name="sequence">2</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/refer-friends.png" />
        </record>
        <record id="welcome3" model="hr.referral.onboarding">
            <field
                name="text">Collect points and exchange them for awesome gifts in the shop.</field>
            <field name="sequence">3</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/points-gift.png" />
        </record>
        <record id="welcome4" model="hr.referral.onboarding">
            <field
                name="text">Compete against your colleagues to build the best justice league!</field>
            <field name="sequence">4</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/leaderboard.png" />
        </record>
        <!-- Referral Levels -->
        <record id="employee_referral_level_1" model="hr.referral.level">
            <field name="name">1</field>
            <field name="points">0</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/level-1.png" />
        </record>
        <record id="employee_referral_level_2" model="hr.referral.level">
            <field name="name">2</field>
            <field name="points">50</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/level-2.png" />
        </record>
        <record id="employee_referral_level_3" model="hr.referral.level">
            <field name="name">3</field>
            <field name="points">100</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/level-3.png" />
        </record>
        <record id="employee_referral_level_4" model="hr.referral.level">
            <field name="name">4</field>
            <field name="points">350</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/level-4.png" />
        </record>
        <record id="employee_referral_level_5" model="hr.referral.level">
            <field name="name">5</field>
            <field name="points">800</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/level-5.png" />
        </record>
        <!-- Referral Friends -->
        <record id="employee_referral_friend_1" model="hr.referral.friend">
            <field name="name">Hero 1</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/mystic.png" />
            <field
                name="image_head"
                type="base64"
                file="hr_referral/static/src/img/mystic-head.png" />
        </record>
        <record id="employee_referral_friend_2" model="hr.referral.friend">
            <field name="name">Hero 2</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/aborigen.png" />
            <field
                name="image_head"
                type="base64"
                file="hr_referral/static/src/img/aborigen-head.png" />
        </record>
        <record id="employee_referral_friend_3" model="hr.referral.friend">
            <field name="name">Hero 3</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/cyborg.png" />
            <field
                name="image_head"
                type="base64"
                file="hr_referral/static/src/img/cyborg-head.png" />
        </record>
        <record id="employee_referral_friend_4" model="hr.referral.friend">
            <field name="name">Hero 4</field>
            <field name="position">front</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/dog.png" />
            <field
                name="image_head"
                type="base64"
                file="hr_referral/static/src/img/dog-head.png" />
        </record>
        <record id="employee_referral_friend_5" model="hr.referral.friend">
            <field name="name">Hero 5</field>
            <field
                name="image"
                type="base64"
                file="hr_referral/static/src/img/girl.png" />
            <field
                name="image_head"
                type="base64"
                file="hr_referral/static/src/img/girl-head.png" />
        </record>
        <!-- Recruitment Stage -->
        <record
            id="hr_recruitment.stage_job0"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record
            id="hr_recruitment.stage_job1"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record
            id="hr_recruitment.stage_job2"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record
            id="hr_recruitment.stage_job3"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record
            id="hr_recruitment.stage_job4"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
        <record
            id="hr_recruitment.stage_job5"
            model="hr.recruitment.stage"
            forcecreate="0">
            <field name="use_in_referral">True</field>
        </record>
    </data>

    <data noupdate="0">
        <function model="res.company" name="_init_default_background">
            <value
                model="res.company"
                eval="obj().search([('hr_referral_background', '=', False)]).ids" />
        </function>
    </data>

</odoo>
