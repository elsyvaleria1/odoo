<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="speech_vocabulary_view_list" model="ir.ui.view">
        <field name="name">speech.vocabulary.view.list</field>
        <field name="model">speech.vocabulary</field>
        <field name="arch" type="xml">
            <list string="Vocabulary" editable="bottom" open_form_view="True">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="kind" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="speech_vocabulary_view_form" model="ir.ui.view">
        <field name="name">speech.vocabulary.view.form</field>
        <field name="model">speech.vocabulary</field>
        <field name="arch" type="xml">
            <form string="Vocabulary">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="kind" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                    <field name="form_ids" context="{'default_company_id': company_id}">
                        <list editable="bottom">
                            <field name="phrases" />
                            <field name="pronunciation" />
                            <field name="source" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="active" widget="boolean_toggle" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="speech_vocabulary_action" model="ir.actions.act_window">
        <field name="name">Speech Vocabulary</field>
        <field name="res_model">speech.vocabulary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a term</p>
            <p>Brands, places and names a transcriber must spell right. The first hundred, in order, travel with every transcription.</p>
        </field>
    </record>

</odoo>
