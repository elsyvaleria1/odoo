<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_form_whatsapp_pos_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.whatsapp.pos</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone_ids']" position="after">
                <button
                    name="action_send_whatsapp"
                    type="object"
                    title="Whatsapp"
                    icon="fa-brands fa-whatsapp fa-lg"
                    invisible="not phone_ids"
                    class="btn-link" />
            </xpath>
        </field>
    </record>

</odoo>
