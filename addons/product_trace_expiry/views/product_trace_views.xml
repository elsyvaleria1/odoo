<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_trace_form" model="ir.ui.view">
        <field name="name">product.trace.form.expiry</field>
        <field name="model">product.trace</field>
        <field name="inherit_id" ref="product_trace.view_product_trace_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page
                    name="expiration_dates"
                    string="Dates"
                    invisible="not use_expiration_date">
                    <field name="use_expiration_date" invisible="1" />
                    <group>
                        <group>
                            <field name="expiration_date" string="Expiration" />
                            <field name="removal_date" string="Removal Date" />
                        </group>
                        <group>
                            <field name="use_date" string="Best before" />
                            <field name="alert_date" string="Alert from" />
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="product_expiry_alert" invisible="1" />
                <span class="badge rounded-pill float-end text-bg-warning" invisible="not use_expiration_date or not (alert_date &lt;= time.strftime('%Y-%m-%d %H:%M:%S') &lt; expiration_date)">Expiring</span>
                <span class="badge rounded-pill float-end text-bg-danger" invisible="not use_expiration_date or not product_expiry_alert">Expired</span>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field
                    name="expiration_date"
                    invisible="not use_expiration_date or display_complete" />
            </xpath>
        </field>
    </record>

</odoo>
