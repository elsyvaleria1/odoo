<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_trip_offline_event_view_list" model="ir.ui.view">
        <field name="name">stock.trip.offline.event.list</field>
        <field name="model">stock.trip.offline.event</field>
        <field name="arch" type="xml">
            <list
                create="0"
                edit="0"
                decoration-danger="state == 'review'"
                decoration-muted="state == 'dismissed'">
                <field name="captured_at" />
                <field name="batch_id" />
                <field name="event_type" />
                <field name="picking_id" optional="show" />
                <field name="user_id" optional="show" />
                <field name="device_uuid" optional="hide" />
                <field name="client_uuid" optional="hide" />
                <field name="prev_hash" optional="hide" />
                <field name="event_hash" optional="hide" />
                <field name="applied_at" optional="hide" />
                <field name="error" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-danger="state == 'review'"
                    decoration-info="state == 'pending'"
                    decoration-success="state == 'applied'" />
                <button
                    name="action_dismiss"
                    type="object"
                    string="Dismiss"
                    icon="fa-check"
                    invisible="state != 'review'" />
            </list>
        </field>
    </record>

    <record id="stock_trip_offline_event_view_form" model="ir.ui.view">
        <field name="name">stock.trip.offline.event.form</field>
        <field name="model">stock.trip.offline.event</field>
        <field name="arch" type="xml">
            <form string="Offline Event" create="0" edit="0">
                <header>
                    <button
                        name="action_dismiss"
                        type="object"
                        string="Dismiss"
                        invisible="state != 'review'"
                        class="oe_highlight" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" />
                            <field name="event_type" />
                            <field name="picking_id" />
                            <field name="captured_at" />
                            <field name="applied_at" invisible="not applied_at" />
                        </group>
                        <group>
                            <field name="latitude" />
                            <field name="longitude" />
                            <field name="user_id" />
                            <field name="device_uuid" />
                            <field name="client_uuid" />
                            <field name="prev_hash" />
                            <field name="event_hash" />
                        </group>
                    </group>
                    <field name="error" invisible="not error" />
                    <field name="payload_display" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_trip_offline_event_view_search" model="ir.ui.view">
        <field name="name">stock.trip.offline.event.search</field>
        <field name="model">stock.trip.offline.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_id" />
                <field name="picking_id" />
                <field name="client_uuid" />
                <filter
                    name="to_review"
                    string="To Review"
                    domain="[('state', '=', 'review')]" />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]" />
                <group>
                    <filter
                        name="group_trip"
                        string="Trip"
                        context="{'group_by': 'batch_id'}" />
                    <filter
                        name="group_type"
                        string="Event"
                        context="{'group_by': 'event_type'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_trip_offline_event" model="ir.actions.act_window">
        <field name="name">Offline Events</field>
        <field name="res_model">stock.trip.offline.event</field>
        <field name="path">trip-offline-events</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_review': 1}</field>
    </record>

    <record id="stock_picking_batch_form_trace_offline" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.trace.offline</field>
        <field name="model">stock.picking.batch</field>
        <field
            name="inherit_id"
            ref="stock_fleet_trace.stock_picking_batch_form_trace" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='trip_incidents']" position="after">
                <page
                    name="trip_offline_events"
                    string="Offline Events"
                    invisible="not trip_offline_event_ids">
                    <group>
                        <field
                            name="trip_offline_chain_broken"
                            invisible="not trip_offline_chain_broken" />
                        <field
                            name="trip_offline_phone_head"
                            invisible="not trip_offline_phone_head" />
                    </group>
                    <field name="trip_offline_event_ids" readonly="1">
                        <list
                            create="0"
                            delete="0"
                            decoration-danger="state == 'review'"
                            decoration-muted="state == 'dismissed'">
                            <field name="captured_at" />
                            <field name="event_type" />
                            <field name="picking_id" />
                            <field name="user_id" optional="hide" />
                            <field name="client_uuid" optional="hide" />
                            <field name="error" />
                            <field
                                name="state"
                                widget="badge"
                                decoration-danger="state == 'review'"
                                decoration-info="state == 'pending'"
                                decoration-success="state == 'applied'" />
                            <button
                                name="action_dismiss"
                                type="object"
                                string="Dismiss"
                                icon="fa-check"
                                invisible="state != 'review'" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
