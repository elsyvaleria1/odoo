<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_warehouse_view_form_trace" model="ir.ui.view">
        <field name="name">stock.warehouse.form.trace</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_stock_warehouse_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="trip" string="Delivery Trips">
                    <group name="trip_origin">
                        <field name="trip_origin_latitude" />
                        <field name="trip_origin_longitude" />
                    </group>
                    <group name="trip_rules" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
