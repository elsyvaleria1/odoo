<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_view_form_trace" model="ir.ui.view">
        <field name="name">stock.picking.form.trace</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="inside">
                <group
                    name="trip_trace"
                    string="Trip"
                    invisible="not trip_delivery_result and not trip_arrival_date and not trip_support_batch_id and not trip_partial_review">
                    <field name="trip_arrival_date" />
                    <field name="trip_delivery_result" />
                    <field
                        name="trip_support_batch_id"
                        invisible="not trip_support_batch_id" />
                    <field name="trip_support_kind" invisible="not trip_support_kind" />
                    <field
                        name="trip_partial_review"
                        invisible="not trip_partial_review"
                        readonly="1" />
                    <field
                        name="trip_receiver_name"
                        invisible="not trip_receiver_name" />
                    <field
                        name="signature"
                        string="Signature"
                        widget="image"
                        options="{'size': [0, 120]}"
                        invisible="not signature"
                        readonly="1" />
                </group>
            </xpath>
            <!-- Seeing who signed without printing the slip. -->
            <xpath expr="//header" position="inside">
                <button
                    name="action_trip_view_signature"
                    type="object"
                    string="View Signature"
                    icon="fa-pencil-square-o"
                    invisible="not signature" />
            </xpath>
        </field>
    </record>

    <record id="stock_picking_view_form_signature" model="ir.ui.view">
        <field name="name">stock.picking.form.signature</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Delivery Signature" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="partner_id" readonly="1" />
                        <field name="trip_receiver_name" readonly="1" />
                        <field name="date_done" readonly="1" />
                    </group>
                    <field name="signature" widget="image" readonly="1" />
                </sheet>
                <footer>
                    <button special="cancel" string="Close" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
