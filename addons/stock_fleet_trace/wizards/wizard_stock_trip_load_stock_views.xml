<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_stock_trip_load_stock_form" model="ir.ui.view">
        <field name="name">wizard.stock.trip.load.stock.form</field>
        <field name="model">wizard.stock.trip.load.stock</field>
        <field name="arch" type="xml">
            <form string="Load Stock to Sell">
                <p>
                    What the vehicle takes besides its deliveries, to sell on the route. What it does not sell comes back with the unloading.
                </p>
                <field name="batch_id" invisible="1" />
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" />
                        <field name="quantity" />
                        <field name="uom_id" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_load"
                        type="object"
                        string="Load"
                        class="btn-primary" />
                    <button special="cancel" string="Discard" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
