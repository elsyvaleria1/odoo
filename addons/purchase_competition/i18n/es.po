#: model:ir.model.fields,field_description:purchase_competition.field_res_config_settings__purchase_competition_leader_gap
msgid "Purchase Leader Gap (%)"
msgstr "Diferencia de liderazgo en compras (%)"

#. module: purchase_competition
#: model:ir.model.fields,field_description:purchase_competition.field_res_config_settings__purchase_competition_min_margin
