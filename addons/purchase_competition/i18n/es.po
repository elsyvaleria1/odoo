msgstr "Nuestra posición"

#. module: purchase_competition
#: model:ir.model.fields,help:purchase_competition.field_competitor_offer__purchase_order_id
msgid "Our request for quotation this offer competes with."
msgstr "Nuestra solicitud de cotización con la que compite esta oferta."

#. module: purchase_competition
#: model:ir.model.fields,help:purchase_competition.field_purchase_order_line__limit_price
msgid "Our resale price less the minimum margin: the highest price to pay."
msgstr ""
"Nuestro precio de reventa menos el margen mínimo: el precio más alto que se "
"puede pagar."

#. module: purchase_competition
#: model:ir.model.fields,field_description:purchase_competition.field_purchase_config__competition_overbid
#: model:ir.model.fields,field_description:purchase_competition.field_res_config_settings__purchase_competition_overbid
msgid "Overbid (%)"
msgstr "Sobreoferta (%)"

#. module: purchase_competition
#: model_terms:ir.actions.act_window,help:purchase_competition.competitor_offer_action_purchase
msgid ""
"Price, terms, source and confidence: every offer feeds the market\n"
"                price your requests for quotation are compared with."
msgstr ""
"Precio, condiciones, fuente y confianza: cada oferta alimenta el precio\n"
"                de mercado con el que se comparan sus solicitudes de cotización."

#. module: purchase_competition
#: model:ir.model,name:purchase_competition.model_product_category
msgid "Product Category"
msgstr "Categoría de producto"

