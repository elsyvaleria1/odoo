<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_automation_runtime_search" model="ir.ui.view">
        <field name="name">automation.runtime.search</field>
        <field name="model">automation.runtime</field>
        <field name="arch" type="xml">
            <search string="Workflow Runtimes">
                <field name="name" />
                <field name="automation_id" />
                <field name="partner_id" />
                <field name="reference" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]" />
                <filter
                    name="in_progress"
                    string="In Progress"
                    domain="[('state', '=', 'in_progress')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state', '=', 'error')]" />
                <group>
                    <filter
                        name="group_automation"
                        string="Workflow"
                        context="{'group_by': 'automation_id'}" />
                    <filter
                        name="group_partner"
                        string="Partner"
                        context="{'group_by': 'partner_id'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_date"
                        string="Date"
                        context="{'group_by': 'date'}" />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_ids'}"
                        groups="base.group_multi_company" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_automation_runtime_tree" model="ir.ui.view">
        <field name="name">automation.runtime.tree</field>
        <field name="model">automation.runtime</field>
        <field name="arch" type="xml">
            <list string="Workflow Runtimes">
                <field name="name" />
                <field name="automation_id" />
                <field name="partner_id" />
                <field name="amount" sum="Total" />
                <field name="date" />
                <field name="progress_display" />
                <field
                    name="state"
                    widget="badge"
                    decoration-danger="state == 'error'"
                    decoration-info="state == 'draft'"
                    decoration-muted="state == 'cancel'"
                    decoration-success="state == 'done'"
                    decoration-warning="state == 'in_progress'" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <!-- The fields come from the waiting Input step: automation.runtime._get_view -->
    <record id="view_automation_runtime_form_input" model="ir.ui.view">
        <field name="name">automation.runtime.form.input</field>
        <field name="model">automation.runtime</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Provide Input">
                <sheet>
                    <group name="input_fields" />
                </sheet>
                <footer>
                    <button
                        name="action_submit_input"
                        type="object"
                        string="Continue"
                        class="btn-primary" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <!-- The fields come from the step that waits: automation.runtime.line._get_view -->
    <record id="view_automation_runtime_line_form_input" model="ir.ui.view">
        <field name="name">automation.runtime.line.form.input</field>
        <field name="model">automation.runtime.line</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Provide Input">
                <sheet>
                    <group name="input_fields" />
                </sheet>
                <footer>
                    <button
                        name="action_submit_input"
                        type="object"
                        string="Continue"
                        class="btn-primary" />
                    <button special="cancel" string="Discard" />
                </footer>
            </form>
        </field>
    </record>

    <record id="view_automation_runtime_form" model="ir.ui.view">
        <field name="name">automation.runtime.form</field>
        <field name="model">automation.runtime</field>
        <field name="arch" type="xml">
            <form string="Workflow Runtime">
                <header>
                    <button
                        name="action_start"
                        type="object"
                        string="Start Workflow"
                        invisible="state != 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_next_step"
                        type="object"
                        string="Next Step"
                        invisible="state != 'in_progress'"
                        class="btn-primary" />
                    <button
                        name="action_provide_input"
                        type="object"
                        string="Provide Input"
                        invisible="not awaiting_input"
                        class="btn-primary" />
                    <button
                        name="action_sync_to_definition"
                        type="object"
                        string="Update to Current Workflow"
                        help="Take the automation's current steps and connections; steps that already ran keep what they ran under, and nothing is executed"
                        invisible="state not in ('in_progress', 'waiting_resume')" />
                    <button
                        name="action_retry"
                        type="object"
                        string="Retry Failed Step"
                        invisible="state != 'error'"
                        class="btn-primary" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ['done', 'cancel']" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,in_progress,done" />
                    <field name="awaiting_input" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_automation"
                            type="object"
                            icon="fa-sitemap"
                            class="oe_stat_button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Workflow</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="automation_id" readonly="state != 'draft'" />
                            <field
                                name="partner_id"
                                readonly="state not in ('draft', 'error')" />
                            <field
                                name="third_party_id"
                                readonly="state not in ('draft', 'error')" />
                        </group>
                        <group>
                            <field
                                name="date"
                                readonly="state not in ('draft', 'error')" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                options="{'no_create': True}"
                                readonly="state not in ('draft', 'error')" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field
                                name="amount"
                                readonly="state not in ('draft', 'error')" />
                            <field
                                name="currency_id"
                                readonly="state not in ('draft', 'error')" />
                        </group>
                        <group>
                            <field
                                name="reference"
                                readonly="state not in ('draft', 'error')" />
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Workflow Steps">
                            <field name="line_ids" readonly="1">
                                <list string="Steps" create="0" delete="0">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-danger="state == 'error'"
                                        decoration-info="state in ('waiting', 'scheduled')"
                                        decoration-muted="state in ('done', 'skipped', 'cancel')"
                                        decoration-primary="state == 'in_progress'"
                                        decoration-success="state == 'ready'"
                                        decoration-warning="state == 'paused'" />
                                    <field name="created_record_ref" />
                                    <field name="output_summary" optional="show" />
                                    <field name="error_message" optional="show" />
                                    <button
                                        name="action_run"
                                        type="object"
                                        string="Run"
                                        icon="fa-play"
                                        invisible="state != 'ready' or parent.state not in ('in_progress', 'waiting_resume')" />
                                    <button
                                        name="action_view_document"
                                        type="object"
                                        string="View Document"
                                        icon="fa-external-link"
                                        invisible="not created_record_ref" />
                                </list>
                            </field>
                            <group>
                                <field name="progress" widget="progressbar" />
                                <field name="progress_display" />
                            </group>
                        </page>
                        <page name="diagram" string="Diagram">
                            <widget name="automation_workflow_canvas" mode="run" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_automation_runtime_form_workflow_full" model="ir.ui.view">
        <field name="name">automation.runtime.form.workflow.full</field>
        <field name="model">automation.runtime</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Workflow Runtime" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <field name="automation_id" invisible="1" />
                    <field name="state" invisible="1" />
                    <widget
                        name="automation_workflow_canvas"
                        mode="run"
                        full_screen="1" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_automation_runtime" model="ir.actions.act_window">
        <field name="name">Workflow Runtimes</field>
        <field name="res_model">automation.runtime</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a workflow runtime instance
            </p>
            <p>
                Workflow runtimes execute multi-step automation workflows.
                Start a workflow to process it step-by-step or automatically.
            </p>
        </field>
    </record>

</odoo>
