msgid "steps,"
msgstr "pasos,"

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid "connections"
msgstr "conexiones"

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid "Loading the workflow…"
msgstr "Cargando el flujo de trabajo…"

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid "The workflow could not be drawn."
msgstr "No se pudo dibujar el flujo de trabajo."

