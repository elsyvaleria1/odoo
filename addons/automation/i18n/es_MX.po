msgstr "Flujo de trabajo reintentado"

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
msgid "Only a failed workflow can be retried."
msgstr "Solo se puede reintentar un flujo de trabajo fallido."

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
msgid ""
"'%(run)s' is a sub-workflow of '%(parent)s'. Retry that workflow instead: "
"its step starts a new sub-workflow."
msgstr ""
"'%(run)s' es un subflujo de '%(parent)s'. Reintente ese flujo de trabajo: su"
" paso inicia un subflujo nuevo."

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
msgid "Workflow '%(run)s' has no failed step to retry."
msgstr ""
"El flujo de trabajo '%(run)s' no tiene ningún paso fallido que reintentar."

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
msgid "Workflow failed at: %(steps)s"
msgstr "El flujo de trabajo falló en: %(steps)s"

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
