msgstr "Flujo de trabajo fallido"

#. module: automation
#. odoo-python
#: code:addons/automation/models/automation_runtime.py:0
msgid "unknown step"
msgstr "paso desconocido"

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid ""
"Each step shows where this run stands. Double-click a step to open it, with\n"
"                the document it created or the reason it failed."
msgstr ""
"Cada paso muestra en qué punto va esta ejecución. Haga doble clic en un paso"
" para abrirlo, con el documento que creó o el motivo por el que falló."

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid "This run has no steps yet. Start the workflow to draw them."
msgstr ""
"Esta ejecución aún no tiene pasos. Inicie el flujo de trabajo para "
"dibujarlos."

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
msgid ""
"This automation has no steps yet. Add a step, then connect the steps here."
msgstr ""
"Esta automatización aún no tiene pasos. Agregue un paso y después conecte "
"los pasos aquí."

#. module: automation
#. odoo-javascript
#: code:addons/automation/static/src/workflow_canvas.xml:0
