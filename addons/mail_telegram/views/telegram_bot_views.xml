<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="telegram_bot_view_form_mail" model="ir.ui.view">
        <field name="name">telegram.bot.form.mail</field>
        <field name="model">telegram.bot</field>
        <field name="inherit_id" ref="telegram.view_telegram_bot_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='answer_in_bot_lang']" position="after">
                <field name="notify_mail" />
            </xpath>
        </field>
    </record>

</odoo>
