<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="approval_category_view_form_product" model="ir.ui.view">
        <field name="name">approval.category.view.form.product</field>
        <field name="model">approval.category</field>
        <field
            name="inherit_id"
            ref="approval_app.view_approval_category_form_fields" />
        <field name="arch" type="xml">
            <field name="has_quantity" position="after">
                <field
                    name="has_product"
                    string="Product"
                    widget="radio"
                    options="{'horizontal': true}" />
                <field
                    name="product_ids"
                    placeholder="Leave empty to allow all products"
                    widget="many2many_tags"
                    invisible="has_product == 'no'" />
            </field>
        </field>
    </record>

</odoo>
