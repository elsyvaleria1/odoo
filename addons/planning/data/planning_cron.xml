<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="ir_cron_forecast_schedule" model="ir.cron">
            <field name="name">Planning: generate next recurring shifts</field>
            <field name="model_id" ref="model_planning_recurrency" />
            <field name="state">code</field>
            <field name="code">model._cron_schedule_next()</field>
            <field name="repeat_unit">week</field>
        </record>
        <record id="ir_cron_clear_past_request_to_switch" model="ir.cron">
            <field name="name">Planning: clear switch requests on past shifts</field>
            <field name="model_id" ref="model_planning_slot" />
            <field name="state">code</field>
            <field name="code">model._cron_clear_past_request_to_switch()</field>
            <field name="repeat_unit">day</field>
        </record>
    </data>

</odoo>
