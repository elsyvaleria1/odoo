<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_preview_view_form" model="ir.ui.view">
        <field name="name">planning.preview.form</field>
        <field name="model">wizard.planning.planning.preview</field>
        <field name="arch" type="xml">
            <form>
                <field name="slot_count" invisible="1" />
                <div
                    class="alert alert-warning text-center py-2 mb-2"
                    role="status"
                    invisible="not employee_id or slot_count != 0">
                    This employee has no published shifts scheduled for this period.
                </div>
                <sheet>
                    <group>
                        <field name="employee_id" widget="many2one_avatar_employee" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_preview_shift"
                        type="object"
                        string="Preview"
                        invisible="slot_count &gt; 0"
                        class="btn-primary"
                        data-hotkey="q"
                        disabled="1" />
                    <button
                        name="action_preview_shift"
                        type="object"
                        string="Preview"
                        invisible="slot_count == 0"
                        class="btn-primary"
                        data-hotkey="q" />
                    <button
                        name="discard"
                        special="cancel"
                        string="Discard"
                        class="btn-secondary"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>

    <record id="resource_preview_action" model="ir.actions.act_window">
        <field name="name">Preview Planning</field>
        <field name="res_model">wizard.planning.planning.preview</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="planning_preview_view_form" />
        <field name="target">new</field>
        <field name="context">{"dialog_size": "medium"}</field>
    </record>

</odoo>
