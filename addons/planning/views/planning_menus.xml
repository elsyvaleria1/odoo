        groups="planning.group_planning_manager" />

    <menuitem
        id="planning_menu_settings_resource"
        name="Materials"
        parent="planning_menu_settings"
        action="planning_action_resources"
        sequence="15"
        groups="planning.group_planning_manager" />

    <menuitem
        id="planning_menu_settings_role"
        name="Roles"
        parent="planning_menu_settings"
        action="planning_action_roles"
