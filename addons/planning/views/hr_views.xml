<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.view.form.planning</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <group name="managers" position="after">
                <group name="planning" string="Planning">
                    <field
                        name="planning_role_ids"
                        placeholder="e.g. Bartender"
                        widget="many2many_tags"
                        options="{'color_field': 'color', 'edit_tags': True}" />
                    <field name="default_planning_role_id" />
                    <button
                        name="action_reset_planning_token"
                        type="object"
                        string="Reset schedule and calendar links"
                        confirm="The schedule pages and calendar subscriptions sent to this person stop opening. Continue?"
                        groups="hr.group_hr_user"
                        class="btn-link ps-0" />
                </group>
            </group>
            <button name="action_view_versions" position="before">
                <field name="has_slots" invisible="1" />
                <button
                    name="action_view_planning"
                    type="object"
                    icon="fa-tasks"
                    invisible="not has_slots"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planning</span>
                    </div>
                </button>
            </button>
        </field>
    </record>

    <record id="view_employee_filter_inherit_hr" model="ir.ui.view">
        <field name="name">hr.employee.view.search.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter
                    name="fixed_hours"
                    string="Fixed Hours"
                    domain="[('resource_calendar_id.schedule_type', '=', 'fully_fixed')]" />
                <filter
                    name="flexible_hours"
                    string="Flexible Hours"
                    domain="[('resource_calendar_id.schedule_type', '!=', 'fully_fixed')]" />
                <separator />
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="planning_role_ids" string="Roles" />
            </xpath>
        </field>
    </record>

    <record id="resource_resource_view_form_email" model="ir.ui.view">
        <field name="name">resource.resource.form.planning.email</field>
        <field name="model">resource.resource</field>
        <field name="arch" type="xml">
            <form string="Email Address">
                <group>
                    <field name="name" readonly="1" />
                    <field name="email" required="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="hr_employee_view_form_simplified" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="user_id" invisible="1" />
                    <field
                        name="image_1920"
                        widget="image"
                        options="{&quot;zoom&quot;: true, &quot;preview_image&quot;:&quot;image_128&quot;}"
                        class="oe_avatar" />
                    <div class="oe_title">
                        <label for="name" string="Employee Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. John Doe"
                                required="True" />
                            <a title="Chat" icon="fa-comments" href="#" class="ml8 o_employee_chat_btn" invisible="not context.get('chat_icon') or not user_id" role="button"><i class="fa-solid fa-comments" /></a>
                        </h1>
                        <h2>
                            <field
                                name="job_id"
                                placeholder="Job Position"
                                options="{'no_open': True}" />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field
                                name="phone_ids"
                                widget="many2many_tags"
                                context="{'default_country_id': country_id}" />
                            <field
                                name="work_email"
                                widget="email"
                                required="context.get('force_email', False)" />
                        </group>
                        <group>
                            <field name="department_id" />
                            <field name="parent_id" />
                            <field name="coach_id" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_view_form_email" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="user_id" invisible="1" />
                    <div class="oe_title">
                        <p class="text-muted">Please add a work email for the following employee so that they can receive their planning:</p>
                    </div>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="work_email" widget="email" required="True" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
