<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_planning" model="res.groups.privilege">
        <field name="name">Planning</field>
        <field name="category_id" ref="base.module_category_human_resources" />
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_planning" />
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_planning" />
        <field name="implied_ids" eval="[Command.link(ref('group_planning_user'))]" />
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
    </record>

    <!--
        Field service settings, declared here as in upstream so that their
        xmlids survive the planning_field_service module being uninstalled
    -->
    <record id="group_field_service_allow_geolocation" model="res.groups">
        <field name="name">Field Service Geolocation</field>
    </record>

</odoo>
