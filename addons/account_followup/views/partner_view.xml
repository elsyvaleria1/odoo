<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_partner_view_form" model="ir.ui.view">
            <field name="name">res.partner.view.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="5" />
            <field name="arch" type="xml">
                <xpath
                    expr="//div[@name='anchor_buttons_collections']"
                    position="before">
                    <button
                        name="open_partner_ledger"
                        type="object"
                        icon="fa-list"
                        groups="account.group_account_basic,account.group_account_readonly"
                        invisible="not has_moves"
                        class="oe_stat_button">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field
                                    name="total_net_due"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}" />
                            </span>
                            <span class="o_stat_text">Due</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
        <record id="view_partner_property_form_followup" model="ir.ui.view">
            <field name="name">res.partner.property.form.followup</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form" />
            <field name="arch" type="xml">
                <group name="general" position="after">
                    <group
                        name="invoice_followups"
                        string="Invoice Follow-ups"
                        groups="account.group_account_invoice">
                        <field name="company_id" invisible="1" />
                        <div colspan="2" invisible="not followup_line_id">
                            <field
                                name="followup_line_id"
                                widget="statusbar"
                                domain="[('company_id','=', current_company_id)]"
                                options="{'clickable': '1'}"
                                invisible="not unreconciled_aml_ids" />
                        </div>
                        <label for="followup_status" />
                        <div class="d-flex">
                            <field
                                name="followup_status"
                                widget="badge"
                                class="w-50"
                                decoration-danger="followup_status == 'in_need_of_action'"
                                decoration-warning="followup_status == 'with_overdue_invoices'" />
                            <a
                                name="action_view_partner_followup_journal_items"
                                invisible="followup_status not in ('in_need_of_action', 'with_overdue_invoices')"
                                class="fw-bold w-50"
                                type="object">
                                Journal Items
                            </a>
                        </div>
                        <label for="followup_reminder_type" />
                        <div class="d-flex">
                            <field
                                name="followup_reminder_type"
                                widget="radio"
                                options="{'horizontal': true}"
                                class="w-50" />
                            <a
                                name="%(manual_reminder_action)d"
                                type="action"
                                class="fw-bold w-50">
                                Send
                            </a>
                        </div>
                        <field name="followup_next_action_date" />
                        <field name="followup_responsible_id" />
                    </group>
                </group>
            </field>
        </record>
    </data>

</odoo>
