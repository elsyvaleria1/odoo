<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_follow_up" model="ir.cron">
        <field name="name">Account Report Followup; Execute followup</field>
        <field name="model_id" ref="model_res_partner" />
        <field name="state">code</field>
        <field name="code">model._cron_execute_followup()</field>
        <field name="repeat_interval">1</field>
        <field name="repeat_unit">day</field>
        <field
            name="nextcall"
            eval="(DateTime.now().replace(hour=2, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>

</odoo>
