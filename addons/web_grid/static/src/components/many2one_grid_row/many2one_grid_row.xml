<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        The label is the same in both branches; only what wraps it differs,
        and `canOpen="false"` is a live case (timesheet_grid renders the
        employee row that way), so both wrappers stay.
    -->
    <t t-name="web_grid.Many2OneGridRowLabel">
        <span t-out="this.displayName" t-att-class="{'me-2': this.props.row.isAdditionalRow}"/>
        <t t-foreach="this.extraLines" t-as="extraLine" t-key="extraLine_index">
            <br />
            <span t-out="extraLine" />
        </t>
    </t>

    <t t-name="web_grid.Many2OneGridRow">
        <div t-att-name="this.props.name" t-att-class="this.props.classNames" t-att-style="this.props.style">
            <t t-if="!this.props.canOpen and this.resId">
                <span>
                    <t t-call="web_grid.Many2OneGridRowLabel"/>
                </span>
            </t>
            <t t-elif="this.resId">
                <a class="o_form_uri"
                   t-att-href="`/odoo/${this.urlRelation}/${this.resId}`"
                   t-on-click.prevent="this.onClick"
                >
                    <t t-call="web_grid.Many2OneGridRowLabel"/>
                </a>
            </t>
            <span t-else="" class="o_grid_no_data text-300">None</span>
        </div>
    </t>

</templates>
