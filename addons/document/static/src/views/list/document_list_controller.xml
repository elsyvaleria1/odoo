<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="document.DocumentsListController" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//ViewLayout" position="attributes">
            <attribute name="contentClassName">'o_documents_content' + (this.hidesFolderMenu ? ' o_documents_folder_menu_aside' : '')</attribute>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <t t-call="document.DocumentsViews.ControlPanel"/>
        </xpath>
        <xpath expr="//ViewLayout/t[@t-component='this.props.Renderer']" position="attributes">
            <attribute name="previewStore">this.documentStates.previewStore</attribute>
        </xpath>
        <xpath expr="//div[@t-if='this.hasSelectedRecords']" position="attributes">
            <attribute name="t-if">this.hasSelectedRecords and !this.rightPanelState.previewedDocument</attribute>
        </xpath>
        <!-- the small screen's cog (the desktop's is in the breadcrumbs): the folder's actions too -->
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu[@t-if='!this.hasSelectedRecords']" position="replace">
            <DocumentsCogMenu t-if="!this.hasSelectedRecords"/>
        </xpath>
        <xpath expr="//ActionMenus" position="attributes">
            <attribute name="t-if">this.showActions</attribute>
        </xpath>
    </t>
</templates>
