<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="document_view_form_new_folder" model="ir.ui.view">
        <field name="name">New Folder form</field>
        <field name="model">document.document</field>
        <field name="arch" type="xml">
            <form>
                <field name="type" force_save="1" invisible="1"/>  <!-- save that we're creating a
                folder -->
                <field name="active" string="Active" invisible="1" />
                <!-- read back by the move wizard reopened on the new folder -->
                <field name="access_internal" invisible="1" />
                <field name="access_via_link" invisible="1" />
                <field name="user_permission" invisible="1" />
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Finance"
                                widget="text"
                                options="{'line_breaks': False}"
                                readonly="False"
                                required="True" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_folder_form" model="ir.actions.act_window">
        <field name="name">Add Folder</field>
        <field name="res_model">document.document</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[("type", "=", "folder")]</field>
        <field
            name="context">{
            'form_view_ref': 'document.document_view_form_new_folder',
            'default_type': 'folder',
            'dialog_size': 'medium',
            }</field>
    </record>

</odoo>
