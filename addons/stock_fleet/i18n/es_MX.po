"%(pickings)s cannot be validated without the photo of the delivery slip "
"signed by the customer."
msgstr "No se puede validar %(pickings)s sin la foto de la OUT firmada por el cliente."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/wizards/wizard_stock_picking_unbatch_correction.py:0
msgid ""
"%(pickings)s cannot come off trip %(batch)s: only its pending transfers can."
msgstr "%(pickings)s no puede salir del viaje %(batch)s: solo salen sus albaranes pendientes."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/models/stock_picking_trip.py:0
msgid "%(pickings)s is already on %(batch)s. Take it off that batch before adding it to another one."
msgstr "%(pickings)s ya está en %(batch)s. Quítalo de ese BATCH antes de agregarlo a otro."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/models/stock_picking_trip.py:0
msgid "%(pickings)s taken off the trip as a correction: %(reason)s"
msgstr "%(pickings)s sacado del viaje como corrección: %(reason)s"

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/models/stock_picking_trip.py:0
msgid ""
"%(pickings)s travels on trip %(batch)s, which has already departed. A "
"transfer comes off it only as not delivered, with its reason."
msgstr "%(pickings)s va en el viaje %(batch)s, que ya salió. Un albarán solo sale de él como no entregado, con su motivo."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/wizards/wizard_stock_picking_unbatch_undelivered.py:0
msgid ""
"%(reason)s is a reason to take a transfer off a trip before it leaves, not "
"to send it back from the route."
msgstr "%(reason)s es un motivo para quitar un albarán de un viaje antes de salir, no para regresarlo de la ruta."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/wizards/wizard_stock_picking_unbatch_correction.py:0
msgid ""
"%(reason)s says the goods travelled and came back: register the transfer as "
"not delivered instead."
msgstr "%(reason)s indica que la mercancía viajó y regresó: registra el albarán como no entregado."

#. module: stock_fleet
#. odoo-python
#: code:addons/stock_fleet/models/stock_picking_batch_trip.py:0
msgid "%(vehicle)s is still out on trip %(trip)s: register its return before it leaves again."
msgstr "%(vehicle)s sigue fuera en el viaje %(trip)s: registra su regreso antes de que vuelva a salir."

