<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vpicktree" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.stock.fleet</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_stock_picking_list_vpicktree" />
        <field name="arch" type="xml">
            <field name="picking_type_id" position="after">
                <field name="zip" optional="hide" />
                <field
                    name="shipping_weight"
                    string="Shipping Weight"
                    optional="hide"
                    sum="Total Shipping Weight" />
                <field
                    name="shipping_volume"
                    string="Shipping Volume"
                    optional="hide"
                    sum="Total Shipping Volume" />
            </field>
        </field>
    </record>

    <record id="stock_picking_tree_inherit_stock_fleet" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.stock.transport</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_picking_batch.stock_picking_view_batch_tree_ref" />
        <field name="arch" type="xml">
            <field name="zip" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

    <!--
        A transfer opened from its batch shows no header in stock_picking_batch;
        on a trip the office validates it there too, or sends it back.
    -->
    <record id="view_stock_picking_form_batch_trip" model="ir.ui.view">
        <field name="name">stock.picking.form.batch.trip</field>
        <field name="model">stock.picking</field>
        <field
            name="inherit_id"
            ref="stock_picking_batch.view_stock_picking_form_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="trip_date_departure" invisible="1" />
                <button
                    name="button_validate"
                    type="object"
                    string="Validate"
                    groups="stock.group_stock_user"
                    invisible="state in ('draft', 'confirmed', 'done', 'cancel')"
                    class="oe_highlight"
                    data-hotkey="v" />
                <button
                    name="action_not_delivered"
                    type="object"
                    string="Not delivered"
                    invisible="state != 'assigned' or not trip_date_departure"
                    data-hotkey="x" />
            </xpath>
        </field>
    </record>

</odoo>
