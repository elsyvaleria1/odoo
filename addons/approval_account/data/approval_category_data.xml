<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="approval_category_account_move" model="approval.category">
        <field name="name">Invoice/Bill Approval</field>
        <field name="approval_type">accounting</field>
        <field
            name="description">Approval workflow for existing invoices and bills</field>
        <field name="sequence" eval="10" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">JEA</field>
        <field name="has_amount">required</field>
        <field name="has_partner">optional</field>
        <field name="has_date">required</field>
        <field name="has_reference">optional</field>
        <field name="has_journal">required</field>
        <field name="company_id" eval="False" />
    </record>

    <record
        id="approval_category_account_move_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_account_move" />
        <field name="name">Approvers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
    </record>

    <record id="approval_category_accounting_request" model="approval.category">
        <field name="name">Bill Request</field>
        <field name="approval_type">accounting</field>
        <field name="target_model">account.move</field>
        <field name="account_move_type">in_invoice</field>
        <field name="description">Create vendor bill from approval request</field>
        <field name="sequence" eval="20" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">BR</field>
        <field name="has_product">required</field>
        <field name="has_quantity">required</field>
        <field name="has_partner">required</field>
        <field name="has_reference">optional</field>
        <field name="has_journal">optional</field>
        <field name="has_document">optional</field>
        <field name="company_id" eval="False" />
    </record>

    <record
        id="approval_category_accounting_request_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_accounting_request" />
        <field name="name">Approvers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
    </record>

    <record id="approval_sequence_collection_in_kind" model="ir.sequence">
        <field name="name">Collection in Kind Approval Sequence</field>
        <field name="code">approval.request.collection_in_kind</field>
        <field name="prefix">PAYKIND</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False" />
    </record>

    <record id="approval_category_collection_in_kind" model="approval.category">
        <field name="name">Collection in Kind</field>
        <field name="approval_type">payment</field>
        <field
            name="description">Payment-in-kind approval for assets received as debt payment</field>
        <field name="sequence" eval="30" />
        <field name="approval_minimum">1</field>
        <field name="sequence_code">PAYKIND</field>
        <field name="sequence_id" ref="approval_sequence_collection_in_kind" />
        <field name="has_partner">required</field>
        <field name="has_amount">required</field>
        <field name="has_date">required</field>
        <field name="company_id" eval="False" />
        <field name="has_bsl">no</field>
        <field name="has_automation">no</field>
    </record>

    <record
        id="approval_category_collection_in_kind_step_approvers"
        model="approval.category.step"
        forcecreate="0">
        <field name="category_id" ref="approval_category_collection_in_kind" />
        <field name="name">Approvers</field>
        <field name="sequence" eval="10" />
        <field name="minimum" eval="1" />
        <field name="counts_added_approvers" eval="True" />
    </record>

</odoo>
