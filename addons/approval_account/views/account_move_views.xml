<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_approval" model="ir.ui.view">
        <field name="name">account.move.form.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="before">
                <field name="approval_required" invisible="1" />
                <field name="approval_state" invisible="1" />
                <field name="approval_request_id" invisible="1" />
            </xpath>

            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button
                    name="action_view_approval_request"
                    type="object"
                    string="View Approval"
                    icon="fa-check-square"
                    invisible="not approval_request_id"
                    class="btn-secondary"
                    data-hotkey="v" />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_approval_request"
                    type="object"
                    icon="fa-check-square"
                    invisible="not approval_request_id"
                    class="oe_stat_button">
                    <div class="o_stat_info">
                        <field
                            name="approval_state"
                            string="Approval"
                            widget="statinfo" />
                    </div>
                </button>
                <button
                    name="action_view_approval"
                    type="object"
                    icon="fa-credit-card"
                    invisible="count_approval == 0 or (count_approval == 1 and approval_request_id)"
                    class="oe_stat_button">
                    <field name="count_approval" string="Approvals" widget="statinfo" />
                </button>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="after">
                <page
                    name="approval_info"
                    id="approval_tab"
                    string="Approval"
                    invisible="not approval_request_id">
                    <group col="2">
                        <group string="Approval Status">
                            <field
                                name="approval_state"
                                widget="badge"
                                decoration-danger="approval_state == 'refused'"
                                decoration-success="approval_state == 'approved'"
                                decoration-warning="approval_state == 'pending'" />

                            <field
                                name="approval_progress"
                                widget="progressbar"
                                invisible="approval_state not in ['pending', 'new']" />

                            <field name="date_approval_requested" />
                            <field
                                name="date_approval_granted"
                                invisible="approval_state != 'approved'" />
                        </group>

                        <group string="Approvers">
                            <field name="approval_user_ids" widget="many2many_tags" />

                            <field
                                name="pending_approver_ids"
                                widget="many2many_tags"
                                invisible="approval_state != 'pending'" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
