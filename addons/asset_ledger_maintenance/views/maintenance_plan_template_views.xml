<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_maintenance_plan_template_list" model="ir.ui.view">
        <field name="name">maintenance.plan.template.list</field>
        <field name="model">maintenance.plan.template</field>
        <field name="arch" type="xml">
            <list string="Maintenance Plan Templates">
                <field name="name" />
                <field name="asset_kind_id" />
                <field name="repeat_interval" />
                <field name="repeat_unit" />
                <field name="duration" />
                <field name="maintenance_plan_count" />
                <field name="active" invisible="1" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_maintenance_plan_template_form" model="ir.ui.view">
        <field name="name">maintenance.plan.template.form</field>
        <field name="model">maintenance.plan.template</field>
        <field name="arch" type="xml">
            <form string="Maintenance Plan Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_maintenance_plans"
                            type="object"
                            icon="fa-cogs"
                            class="oe_stat_button">
                            <field
                                name="maintenance_plan_count"
                                string="Plans"
                                widget="statinfo" />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Inactive"
                        invisible="active"
                        bg_color="bg-danger" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="active" />
                            <field name="asset_kind_id" />
                            <field name="product_id" />
                            <field
                                name="equipment_category_ids"
                                widget="many2many_tags" />
                        </group>
                        <group string="Schedule">
                            <field name="repeat_interval" />
                            <field name="repeat_unit" />
                            <field name="duration" />
                            <field name="user_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions">
                            <field name="instructions" />
                        </page>
                        <page string="Generated Plans">
                            <field name="maintenance_plan_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="asset_id" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-danger="state == 'overdue'"
                                        decoration-info="state == 'planned'"
                                        decoration-muted="state == 'upcoming'"
                                        decoration-warning="state == 'today'" />
                                    <field name="date_next_scheduled" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_maintenance_plan_template_kanban" model="ir.ui.view">
        <field name="name">maintenance.plan.template.kanban</field>
        <field name="model">maintenance.plan.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name" />
                <field name="asset_kind_id" />
                <field name="repeat_interval" />
                <field name="repeat_unit" />
                <field name="maintenance_plan_count" />
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span
                                        class="badge badge-info"
                                        t-if="record.asset_kind_id.raw_value">
                                        <field name="asset_kind_id" />
                                    </span>
                                    <br />
                                    <span>Every <field name="repeat_interval" /> <field name="repeat_unit" /></span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill">
                                            <field name="maintenance_plan_count" /> plans
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_maintenance_plan_template_search" model="ir.ui.view">
        <field name="name">maintenance.plan.template.search</field>
        <field name="model">maintenance.plan.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="asset_kind_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]" />
                <separator />
                <filter
                    name="vehicle"
                    string="Vehicle"
                    domain="[('asset_kind_id', '=', 'vehicle')]" />
                <filter
                    name="equipment"
                    string="Equipment"
                    domain="[('asset_kind_id', '=', 'equipment')]" />
                <filter
                    name="machinery"
                    string="Machinery"
                    domain="[('asset_kind_id', '=', 'machinery')]" />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]" />
                <group>
                    <filter
                        name="group_asset_kind_id"
                        string="Asset Type"
                        context="{'group_by': 'asset_kind_id'}" />
                    <filter
                        name="group_interval"
                        string="Interval Type"
                        context="{'group_by': 'repeat_unit'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_maintenance_plan_template" model="ir.actions.act_window">
        <field name="name">Plan Templates</field>
        <field name="res_model">maintenance.plan.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
