<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_maintenance" model="ir.ui.view">
        <field name="name">product.template.form.maintenance</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.view_product_template_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
            <span class="d-inline-flex">
            <field name="maintenance_ok" invisible="not asset_kind_code" />
            <label for="maintenance_ok" invisible="not asset_kind_code" />
            </span>
            </xpath>
        </field>
    </record>

</odoo>
