<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="resource_asset_view_form_maintenance" model="ir.ui.view">
        <field name="name">resource.asset.form.maintenance</field>
        <field name="model">resource.asset</field>
        <field name="inherit_id" ref="asset_ledger.resource_asset_view_form_ledger" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_create_maintenance_order"
                    type="object"
                    string="Order a Maintenance"
                    invisible="not maintenance_ok"
                    class="btn-primary" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    name="maintenance_plans"
                    string="Maintenance"
                    invisible="not maintenance_ok">
                    <group>
                        <field name="maintenance_ok" />
                        <field name="maintenance_state" widget="badge" />
                    </group>
                    <field name="maintenance_plan_ids">
                        <list>
                            <field name="name" />
                            <field name="repeat_interval" />
                            <field name="repeat_unit" />
                            <field name="repeat_anchor" optional="show" />
                            <field name="date_last_done" optional="show" />
                            <field name="date_next_scheduled" />
                            <field name="state" widget="badge" />
                            <field name="active" widget="boolean_toggle" />
                            <button
                                name="action_view_open_order"
                                type="object"
                                string="View Order"
                                icon="fa-external-link" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="resource_asset_view_kanban_maintenance" model="ir.ui.view">
        <field name="name">resource.asset.kanban.maintenance</field>
        <field name="model">resource.asset</field>
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <kanban string="Asset Maintenance">
                <field name="name" />
                <field name="product_id" />
                <field name="maintenance_state" />
                <field name="maintenance_ok" />
                <field name="maintenance_plan_count" />
                <field name="maintenance_count" />
                <templates>
                    <t t-name="card">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click"
                            t-att-data-state="record.maintenance_state.raw_value"
                            t-attf-style="border-left: 4px solid #{                                  record.maintenance_state.raw_value == 'good' ? '#28a745' :                                  record.maintenance_state.raw_value == 'warning' ? '#ffc107' :                                  record.maintenance_state.raw_value == 'critical' ? '#dc3545' : '#6c757d'                              };">
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_details">
                                    <strong><field name="name" /></strong>
                                    <div><field name="product_id" /></div>
                                    <div
                                        t-attf-class="badge badge-#{                                         record.maintenance_state.raw_value == 'good' ? 'success' :                                         record.maintenance_state.raw_value == 'warning' ? 'warning' :                                         record.maintenance_state.raw_value == 'critical' ? 'danger' : 'secondary'                                      }">
                                        <field name="maintenance_state" />
                                    </div>
                                    <div>
                                        Plans: <field name="maintenance_plan_count" /> | Orders: <field name="maintenance_count" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="resource_asset_view_search_maintenance" model="ir.ui.view">
        <field name="name">resource.asset.search.maintenance</field>
        <field name="model">resource.asset</field>
        <field name="priority" eval="10" />
        <field name="arch" type="xml">
            <search string="Asset Maintenance">
                <field
                    name="name"
                    string="Asset"
                    filter_domain="['|', ('name', 'ilike', self), ('license_plate', 'ilike', self)]" />
                <field name="product_id" />
                <field name="maintenance_state" />
                <separator />
                <filter
                    name="maintenance_ok"
                    string="Recurring Maintenance"
                    domain="[('maintenance_ok', '=', True)]" />
                <separator />
                <filter
                    name="maintenance_good"
                    string="Good State"
                    domain="[('maintenance_state', '=', 'good')]" />
                <filter
                    name="maintenance_warning"
                    string="Warning State"
                    domain="[('maintenance_state', '=', 'warning')]" />
                <filter
                    name="maintenance_critical"
                    string="Critical State"
                    domain="[('maintenance_state', '=', 'critical')]" />
                <filter
                    name="maintenance_obsolete"
                    string="Obsolete State"
                    domain="[('maintenance_state', '=', 'obsolete')]" />
                <group>
                    <filter
                        name="group_product"
                        string="Product"
                        context="{'group_by': 'product_id'}" />
                    <filter
                        name="group_maintenance_state"
                        string="Maintenance State"
                        context="{'group_by': 'maintenance_state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_all_assets" model="ir.actions.act_window">
        <field name="name">All Assets</field>
        <field name="res_model">resource.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="resource_asset_view_search_maintenance" />
        <field name="domain">[('kind_code', '!=', 'product')]</field>
        <field name="context">{'search_default_maintenance_ok': True}</field>
        <field
            name="view_ids"
            eval="[Command.clear(), Command.create({'view_mode': 'kanban', 'view_id': ref('resource_asset_view_kanban_maintenance')}), Command.create({'view_mode': 'list', 'view_id': False}), Command.create({'view_mode': 'form', 'view_id': ref('asset_ledger.resource_asset_view_form_ledger')})]" />
    </record>

