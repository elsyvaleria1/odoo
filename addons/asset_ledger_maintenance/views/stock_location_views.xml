<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_location_form_maintenance" model="ir.ui.view">
        <field name="name">stock.location.form.maintenance</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_stock_location_form" />
        <field name="arch" type="xml">
            <field name="usage" position="after">
                <label for="deployed_location" string="Asset State Flags" />
                <div class="o_row">
                    <field name="deployed_location" />
                    <label for="deployed_location" string="Deployed Location" />
                </div>
            </field>
        </field>
    </record>

</odoo>
