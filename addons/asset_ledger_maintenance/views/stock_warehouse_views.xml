<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_form_maintenance" model="ir.ui.view">
        <field name="name">stock.warehouse.form.maintenance</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_stock_warehouse_form" />
        <field name="arch" type="xml">

            <xpath
                expr="//page[@name='warehouse_config']//group[@name='group_resupply']"
                position="after">
                <group name="group_asset_operations" string="Asset Operations">
                    <field name="allow_deployment" />
                </group>
            </xpath>

            <xpath expr="//field[@name='wh_output_stock_loc_id']" position="after">
                <field
                    name="wh_deployed_stock_loc_id"
                    invisible="not allow_deployment"
                    readonly="1" />
            </xpath>

            <xpath expr="//field[@name='xdock_type_id']" position="after">
                <field
                    name="deployment_type_id"
                    invisible="not allow_deployment"
                    readonly="1" />
                <field
                    name="deployment_return_type_id"
                    invisible="not allow_deployment"
                    readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
