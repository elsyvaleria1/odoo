<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="project.TemplateDropdown">
        <button t-if="!this.templates.length" type="button" t-att-class="this.props.newButtonClasses" t-att-disabled="this.props.isDisabled" t-att-data-hotkey="this.props.hotkey" t-on-click.stop="this.props.onCreate" data-bounce-button="">New</button>
        <Dropdown t-else="">
            <button t-attf-class="{{ this.props.newButtonClasses }} o-dropdown-caret" t-att-disabled="this.props.isDisabled" t-att-data-hotkey="this.props.hotkey" data-bounce-button="">
                New
            </button>
            <t t-set-slot="content">
                <DropdownItem tag="'button'" class="'btn btn-link'" onSelected="this.props.onCreate">
                    <t t-out="this.newRecordLabel"/>
                </DropdownItem>
                <div role="separator" class="dropdown-divider"/>
                <div class="dropdown-header" t-out="this.templatesHeader"/>
                <t t-foreach="this.templates" t-as="template" t-key="template.id">
                    <DropdownItem tag="'button'" class="this.templateItemClasses"
                        onSelected="() => this.createFromTemplate(template)">
                        <span class="text-truncate" t-out="template.name"/>
                        <ProjectTemplateButtons t-if="this.isProjectManager" resModel="this.templateResModel" resId="template.id"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
