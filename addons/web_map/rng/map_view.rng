<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"
    xmlns:rng="http://relaxng.org/ns/structure/1.0">
    <define name="map">
        <element name="map">
            <optional>
                <attribute name="string"/>
            </optional>
            <choice>
                <attribute name="res_partner"/>
                <empty/>
            </choice>
            <optional>
                <attribute name="default_order"/>
            </optional>
            <optional>
                <attribute name="default_group_by"/>
            </optional>
            <optional>
                <attribute name="allow_resequence"/>
            </optional>
            <optional>
                <attribute name="routing"/>
            </optional>
            <optional>
                <attribute name="hide_name"/>
            </optional>
            <optional>
                <attribute name="hide_address"/>
            </optional>
            <optional>
                <attribute name="panel_title" />
            </optional>
            <optional>
                <attribute name="hide_title"/>
            </optional>
            <optional>
                <attribute name="limit"/>
            </optional>
            <optional>
                <attribute name="js_class"/>
            </optional>
            <!-- read off every view's arch root by web/views/view.js and
                 view_utils.computeViewClassName, whatever the view type -->
            <optional>
                <attribute name="sample"/>
            </optional>
            <optional>
                <attribute name="class"/>
            </optional>
            <zeroOrMore>
                <ref name="field"/>
            </zeroOrMore>
        </element>
    </define>

    <!-- A map only reads `name` and `string` off a field, but the arch it
         validates is the composed one: an inheriting view adds fields carrying
         the attributes its own view types need (`widget`, `invisible`, ...),
         and enumerating them here would reject an arch the map renders fine.
         `name` is the one attribute the view cannot do without. -->
    <define name="field">
        <element name="field">
            <attribute name="name"/>
            <zeroOrMore>
                <attribute>
                    <anyName>
                        <except>
                            <name>name</name>
                        </except>
                    </anyName>
                </attribute>
            </zeroOrMore>
        </element>
    </define>

    <start>
        <ref name="map"/>
    </start>
</grammar>
