<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name">res.config.settings.view.form.inherit.integration.google</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="integration.res_config_settings_view_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='integration']" position="inside">
                <block name="integration_google" title="Google">
                    <setting
                        string="OAuth Client"
                        help="One Google Cloud OAuth client serves every Google feature; each adds its scopes when a user authorizes it">
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="google_oauth_client_id"
                                    string="Client ID"
                                    class="col-lg-3 o_light_label" />
                                <field name="google_oauth_client_id" />
                            </div>
                            <div class="row mt16">
                                <label
                                    for="google_oauth_client_secret"
                                    string="Client Secret"
                                    class="col-lg-3 o_light_label" />
                                <field
                                    name="google_oauth_client_secret"
                                    placeholder="Kept when left empty"
                                    password="True" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
