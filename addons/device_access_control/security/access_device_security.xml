<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_access_device_webhook" model="res.groups">
        <field name="name">Access Device Webhook Processor</field>
        <field
            name="comment">Technical group for access device webhook processing. Only assigned to access_device_webhook_user.</field>
    </record>

    <record id="access_hr_version_webhook" model="ir.access">
        <field
            name="name">hr.version: the webhook processor reads the employees' versions</field>
        <field name="model_id" ref="hr.model_hr_version" />
        <field name="group_id" ref="group_access_device_webhook" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
    </record>

    <record id="access_res_partner_webhook" model="ir.access">
        <field
            name="name">res.partner: the webhook processor reads the employees' partners</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="group_id" ref="group_access_device_webhook" />
        <field name="kind">permission</field>
        <field name="operation">r</field>
        <field name="domain">[('employee_ids', '!=', False)]</field>
        <field name="reach">all</field>
    </record>

</odoo>
