<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="service_ehome_bridge" model="integration.service">
        <field name="name">EHOME Bridge (access devices)</field>
        <field name="code">ehome_bridge</field>
        <field name="category">other</field>
        <field name="provider">Hikvision EHOME</field>
        <field name="environment">production</field>
        <field name="auth_type">none</field>
        <field name="per_record_connections" eval="True" />
