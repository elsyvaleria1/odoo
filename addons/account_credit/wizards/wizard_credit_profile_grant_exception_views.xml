<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_exception_wizard_form" model="ir.ui.view">
        <field name="name">credit.exception.wizard.form</field>
        <field name="model">wizard.credit.profile.grant.exception</field>
        <field name="arch" type="xml">
            <form>
                <p>
                    An exception lets the customer buy on credit regardless of grade
                    and policy, and it always ends. A reclassification review is
                    opened so the customer gets a grade before it does.
                </p>
                <group>
                    <field name="profile_id" readonly="1" />
                    <field name="max_days" />
                    <field name="exception_until" />
                    <field name="reason" />
                </group>
                <footer>
                    <button
                        name="action_grant"
                        type="object"
                        string="Grant"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
