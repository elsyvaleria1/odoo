<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_provision_run_form" model="ir.ui.view">
        <field name="name">credit.provision.run.form</field>
        <field name="model">credit.provision.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_compute"
                        type="object"
                        string="Compute"
                        invisible="state not in ('draft', 'computed')"
                        class="oe_highlight" />
                    <button
                        name="action_post"
                        type="object"
                        string="Post"
                        groups="account_credit.group_credit_manager,account.group_account_manager"
                        invisible="state != 'computed'"
                        class="oe_highlight" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        groups="account_credit.group_credit_manager,account.group_account_manager"
                        invisible="state in ('cancel',)" />
                    <button
                        name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        invisible="state not in ('computed', 'cancel')" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,computed,posted" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_move"
                            type="object"
                            string="Journal Entry"
                            icon="fa-book"
                            invisible="not move_id"
                            class="oe_stat_button" />
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="state != 'draft'" />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="matrix_id" readonly="state != 'draft'" />
                            <field name="currency_id" invisible="1" />
                            <field name="move_id" invisible="1" />
                        </group>
                        <group>
                            <field name="total_exposure" />
                            <field name="total_expected_loss" />
                            <field name="previous_run_id" />
                            <field name="previous_expected_loss" />
                            <field name="amount_to_book" />
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="partner_id" />
                            <field name="grade_id" />
                            <field name="bucket" />
                            <field name="amount" sum="Total" />
                            <field name="rate" />
                            <field name="expected_loss" sum="Total" />
                            <field name="currency_id" column_invisible="1" />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_credit_provision_run_list" model="ir.ui.view">
        <field name="name">credit.provision.run.list</field>
        <field name="model">credit.provision.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="total_exposure" sum="Total" />
                <field name="total_expected_loss" sum="Total" />
                <field name="amount_to_book" />
                <field name="currency_id" column_invisible="1" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'posted'" />
            </list>
        </field>
    </record>

    <record id="view_credit_provision_run_line_pivot" model="ir.ui.view">
        <field name="name">credit.provision.run.line.pivot</field>
        <field name="model">credit.provision.run.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="grade_id" type="row" />
                <field name="bucket" type="col" />
                <field name="amount" type="measure" />
                <field name="expected_loss" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="action_credit_provision_run" model="ir.actions.act_window">
        <field name="name">Expected Credit Loss</field>
        <field name="res_model">credit.provision.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_credit_provision_run_line" model="ir.actions.act_window">
        <field name="name">Expected Credit Loss by Grade and Aging</field>
        <field name="res_model">credit.provision.run.line</field>
        <field name="view_mode">pivot</field>
    </record>

</odoo>
