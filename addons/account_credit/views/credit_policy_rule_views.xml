<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_policy_rule_list" model="ir.ui.view">
        <field name="name">credit.policy.rule.list</field>
        <field name="model">credit.policy.rule</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="document_kind" />
                <field name="payment_kind" />
                <field name="condition" />
                <field name="state" optional="show" />
                <field name="threshold" optional="show" />
                <field name="grade_ids" widget="many2many_tags" optional="show" />
                <field
                    name="outcome"
                    widget="badge"
                    decoration-danger="outcome == 'block'"
                    decoration-success="outcome == 'allow'"
                    decoration-warning="outcome == 'approve'" />
                <field name="stop" optional="show" />
                <field name="active" invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_credit_policy_rule_form" model="ir.ui.view">
        <field name="name">credit.policy.rule.form</field>
        <field name="model">credit.policy.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule name" /></h1>
                    </div>
                    <group>
                        <group name="scope">
                            <field name="sequence" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="document_kind" />
                            <field name="payment_kind" />
                            <field name="grade_ids" widget="many2many_tags" />
                            <field name="active" invisible="1" />
                        </group>
                        <group name="decision">
                            <field name="condition" />
                            <field
                                name="state"
                                invisible="condition != 'state_is'"
                                required="condition == 'state_is'" />
                            <field
                                name="threshold"
                                invisible="condition not in ('overdue_amount_over', 'overdue_days_over')" />
                            <field name="outcome" />
                            <field name="stop" />
                        </group>
                    </group>
                    <field name="message" placeholder="Message shown to the user" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_credit_policy_rule" model="ir.actions.act_window">
        <field name="name">Credit Policy</field>
        <field name="res_model">credit.policy.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
