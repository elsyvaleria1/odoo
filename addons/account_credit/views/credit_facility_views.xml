<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_facility_list" model="ir.ui.view">
        <field name="name">credit.facility.list</field>
        <field name="model">credit.facility</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'revoked')">
                <field name="date_start" />
                <field name="partner_id" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="source" />
                <field name="amount" sum="Total" />
                <field name="currency_id" column_invisible="1" />
                <field name="date_end" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'active'" />
                <field name="user_id" optional="show" />
                <field name="reason" optional="show" />
                <button
                    name="action_revoke"
                    type="object"
                    string="Revoke"
                    icon="fa-ban"
                    groups="account_credit.group_credit_manager"
                    invisible="state not in ('draft', 'active')" />
            </list>
        </field>
    </record>

    <record id="view_credit_facility_form" model="ir.ui.view">
        <field name="name">credit.facility.form</field>
        <field name="model">credit.facility</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        groups="account_credit.group_credit_manager"
                        invisible="state != 'draft'"
                        class="oe_highlight" />
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        groups="account_credit.group_credit_manager"
                        invisible="state not in ('draft', 'active')" />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id" />
                            <field name="partner_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company" />
                            <field name="source" />
                            <field name="amount" />
                            <field name="currency_id" invisible="1" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="user_id" />
                            <field name="review_id" />
                            <field name="reason" />
                        </group>
                    </group>
                    <field name="order_ids" invisible="source != 'authorization'">
                        <list>
                            <field name="name" />
                            <field name="date_order" />
                            <field name="amount_total" />
                            <field name="state" />
                        </list>
                    </field>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_credit_facility_search" model="ir.ui.view">
        <field name="name">credit.facility.search</field>
        <field name="model">credit.facility</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="reason" />
                <filter
                    name="active"
                    string="Granting"
                    domain="[('state', '=', 'active')]" />
                <filter
                    name="inactive"
                    string="Withdrawn"
                    domain="[('state', 'in', ('expired', 'revoked'))]" />
                <filter
                    name="authorizations"
                    string="Order authorizations"
                    domain="[('source', '=', 'authorization')]" />
                <group>
                    <filter
                        name="group_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}" />
                    <filter
                        name="group_source"
                        string="Source"
                        context="{'group_by': 'source'}" />
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_credit_facility" model="ir.actions.act_window">
        <field name="name">Credit Facilities</field>
        <field name="res_model">credit.facility</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No credit facility yet
            </p>
            <p>
                A facility grants an amount of credit for a period. The credit
                limit of a profile is its valid collateral plus every facility
                granting today.
            </p>
        </field>
    </record>

</odoo>
