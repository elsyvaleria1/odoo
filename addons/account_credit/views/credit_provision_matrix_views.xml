<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_provision_matrix_form" model="ir.ui.view">
        <field name="name">credit.provision.matrix.form</field>
        <field name="model">credit.provision.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Matrix name" /></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="active" invisible="1" />
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="grade_id" />
                            <field name="bucket" />
                            <field name="rate" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_credit_provision_matrix_list" model="ir.ui.view">
        <field name="name">credit.provision.matrix.list</field>
        <field name="model">credit.provision.matrix</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="action_credit_provision_matrix" model="ir.actions.act_window">
        <field name="name">Expected Loss Matrices</field>
        <field name="res_model">credit.provision.matrix</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
