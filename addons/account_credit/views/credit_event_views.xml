<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_credit_event_type_list" model="ir.ui.view">
        <field name="name">credit.event.type.list</field>
        <field name="model">credit.event.type</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="severity" />
                <field name="is_hold" />
                <field name="requires_review" />
                <field name="grade_cap_id" />
            </list>
        </field>
    </record>

    <record id="action_credit_event_type" model="ir.actions.act_window">
        <field name="name">Event Types</field>
        <field name="res_model">credit.event.type</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_credit_event_list" model="ir.ui.view">
        <field name="name">credit.event.list</field>
        <field name="model">credit.event</field>
        <field name="arch" type="xml">
            <list
                default_order="date desc"
                decoration-danger="severity == 'critical' and is_open"
                decoration-muted="not is_open">
                <field name="date" />
                <field name="partner_id" />
                <field
                    name="company_id"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="type_id" />
                <field name="severity" widget="badge" />
                <field name="amount" />
                <field name="note" optional="show" />
                <field name="user_id" optional="hide" />
                <field name="is_open" />
                <field name="lifted_on" optional="hide" />
                <button
                    name="action_lift"
                    type="object"
                    string="Lift"
                    icon="fa-unlock"
                    groups="account_credit.group_credit_manager"
                    invisible="not is_open or not is_hold" />
            </list>
        </field>
    </record>

    <record id="view_credit_event_form" model="ir.ui.view">
        <field name="name">credit.event.form</field>
        <field name="model">credit.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_lift"
                        type="object"
                        string="Lift"
                        groups="account_credit.group_credit_manager"
                        invisible="not is_open"
                        class="oe_highlight" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id" />
                            <field name="type_id" />
                            <field name="date" />
                            <field name="amount" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field name="is_open" />
                            <field name="lifted_on" />
                            <field name="lifted_by_id" />
                            <field name="res_model" invisible="1" />
                            <field name="res_id" invisible="1" />
                        </group>
                    </group>
                    <field name="note" placeholder="Why..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_credit_event_search" model="ir.ui.view">
        <field name="name">credit.event.search</field>
        <field name="model">credit.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="type_id" />
                <filter name="open" string="Open" domain="[('is_open', '=', True)]" />
                <filter
                    name="holds"
                    string="Holds"
                    domain="[('is_hold', '=', True), ('is_open', '=', True)]" />
                <filter
                    name="critical"
                    string="Critical"
                    domain="[('severity', '=', 'critical')]" />
                <group>
                    <filter
                        name="group_type"
                        string="Type"
                        context="{'group_by': 'type_id'}" />
                    <filter
                        name="group_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_credit_event_pivot_transitions" model="ir.ui.view">
        <field name="name">credit.event.pivot.transitions</field>
        <field name="model">credit.event</field>
        <field name="arch" type="xml">
            <pivot string="Grade Transitions">
                <field name="grade_from_id" type="row" />
                <field name="grade_to_id" type="col" />
            </pivot>
        </field>
    </record>

    <record id="action_credit_grade_transitions" model="ir.actions.act_window">
        <field name="name">Grade Transitions</field>
        <field name="res_model">credit.event</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_credit_event_pivot_transitions" />
        <field name="domain">[('code', '=', 'grade_changed')]</field>
        <field name="context">{'pivot_measures': ['__count']}</field>
    </record>

    <record id="action_credit_event" model="ir.actions.act_window">
        <field name="name">Credit Events</field>
        <field name="res_model">credit.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

</odoo>
