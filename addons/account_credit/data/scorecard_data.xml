<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="scorecard_credit" model="scorecard">
        <field name="name">Credit Scorecard</field>
        <field name="res_model">credit.profile</field>
    </record>

    <record id="scorecard_dimension_dbt" model="scorecard.dimension">
        <field name="scorecard_id" ref="scorecard_credit" />
        <field name="code">dbt</field>
        <field name="name">Days Beyond Terms</field>
        <field name="kind">measure</field>
        <field name="weight" eval="40.0" />
        <field name="missing">skip</field>
        <field name="precision" eval="1" />
        <field name="sequence" eval="10" />
        <field
            name="band_ids"
            eval="[             Command.create({'min_value': -100000, 'max_value': 0.1, 'points': 100.0}),             Command.create({'min_value': 0.1, 'max_value': 15.1, 'points': 80.0}),             Command.create({'min_value': 15.1, 'max_value': 30.1, 'points': 60.0}),             Command.create({'min_value': 30.1, 'max_value': 60.1, 'points': 40.0}),             Command.create({'min_value': 60.1, 'max_value': 90.1, 'points': 20.0}),             Command.create({'min_value': 90.1, 'max_value': 0, 'points': 0.0}),         ]" />
    </record>

