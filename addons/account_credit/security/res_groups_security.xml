<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_read_credit_limit" model="res.groups">
        <field
            name="name">Privilege: whoever works on a document is warned of its partner's credit limit</field>
        <field name="is_privilege" eval="True" />
    </record>

    <record id="privilege_read_credit_file_scope" model="res.groups">
        <field
            name="name">Privilege: a partner's credit file holds the same documents whoever reads it</field>
        <field
            name="comment">A credit file is the documents filed under any company's credit folder plus those of a type a credit grade rule requires. The credit limit and document compliance are stored from it, so they may not depend on who recomputes them. Whoever reads a file reads every company's credit folder and the document types the grade rules require, and nothing else of credit.</field>
        <field name="is_privilege" eval="True" />
    </record>

    <record id="privilege_credit_limit" model="res.groups.privilege">
        <field name="name">Credit Limit</field>
        <field name="category_id" ref="base.module_category_accounting" />
        <field name="sequence" eval="160" />
    </record>

    <record id="group_credit_readonly" model="res.groups">
        <field name="name">View</field>
        <field name="sequence" eval="10" />
        <field name="privilege_id" ref="privilege_credit_limit" />
        <field
            name="comment">View credit status, credit types, credit limits, and documents (read-only)</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
    </record>

    <record id="group_credit_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence" eval="20" />
        <field name="privilege_id" ref="privilege_credit_limit" />
        <field name="comment">Edit credit documents for partners</field>
        <field name="implied_ids" eval="[Command.link(ref('group_credit_readonly'))]" />
    </record>

    <record id="group_credit_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence" eval="30" />
        <field name="privilege_id" ref="privilege_credit_limit" />
        <field
            name="comment">Full credit control: edit limits, toggle exceptions, assign credit types, authorize debt</field>
        <field
            name="implied_ids"
            eval="[Command.link(ref('group_credit_user')), Command.link(ref('scoring.group_scoring_manager'))]" />
        <field
            name="user_ids"
            eval="[             Command.link(ref('base.user_root')),             Command.link(ref('base.user_admin')),         ]" />
    </record>

</odoo>
