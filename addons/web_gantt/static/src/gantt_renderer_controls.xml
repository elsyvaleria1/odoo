<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_gantt.GanttRendererControls">

        <div
            class="o_gantt_renderer_controls d-inline-flex d-print-none flex-wrap column-gap-1 align-items-center w-100 bg-view border-bottom sticky-top start-0"
            t-att-class="{ 'px-3': !this.ui.isSmall, 'py-1': this.ui.isSmall }"
        >
            <t t-call="{{ this.constructor.rangeMenuTemplate }}" />
            <hr t-if="this.ui.isSmall" class="my-0 w-100"/>
            <button
                class="o_gantt_button_today btn btn-secondary"
                t-att-class="{ 'ms-3': this.ui.isSmall }"
                title="Focus Today"
                data-hotkey="t"
                t-on-click="this.onTodayClicked"
            >
                Today
            </button>
            <t t-if="this.ui.isSmall">
                <div class="flex-grow-1 w-0"/>
                <Dropdown>
                    <button class="btn btn-secondary me-3" aria-label="Toolbar menu">
                        <i class="fa-solid fa-fw fa-sliders"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-call="{{ this.constructor.toolbarContentTemplate }}" />
                    </t>
                </Dropdown>
            </t>
            <t t-else="" t-call="{{ this.constructor.toolbarContentTemplate }}" />
            <div t-if="this.displayRescheduleMethods">
                <Dropdown>
                    <button class="btn btn-secondary o-dropdown-caret">
                        <t t-out="this.model.metaData.rescheduleMethods[this.state.rescheduleMethod]"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="Object.keys(this.model.metaData.rescheduleMethods)" t-as="method" t-key="method">
                            <DropdownItem
                                class="{ active: method === this.state.rescheduleMethod }"
                                onSelected.bind="() => this.selectRescheduleMethod(method)"
                            >
                                <t t-out="this.model.metaData.rescheduleMethods[method]"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </div>
            <t t-if="this.props.multiSelection" t-component="this.props.multiSelection.Component" reactive="this.props.multiSelection.reactive" />
        </div>
    </t>

    <t t-name="web_gantt.GanttRendererControls.ToolbarContent">
        <t t-if="!this.ui.isSmall">
            <div class="btn-toolbar gap-1" role="toolbar" name="ganttToolbar">
                <button class="btn btn-secondary fa"
                    t-att-class="{ 'fa-compress': this.model.displayParams.displayMode === 'sparse', 'fa-expand': this.model.displayParams.displayMode === 'dense'  }"
                    t-att-title="this.displayModeToggleTitle"
                    t-on-click="this.model.toggleDisplayMode.bind(this.model)"
                >
                </button>
                <div class="btn-group" t-att-class="{ invisible: !this.props.displayExpandCollapseButtons }" name="expandCollapseButtons">
                    <t t-if="this.model.rowsAreExpanded">
                        <button class="o_gantt_button_collapse_rows btn btn-secondary" title="Collapse rows" t-on-click="this.model.collapseRows.bind(this.model)">
                            <i class="fa-solid fa-caret-down"/>
                        </button>
                    </t>
                    <t t-else="">
                        <button class="o_gantt_button_expand_rows btn btn-secondary" title="Expand rows" t-on-click="this.model.expandRows.bind(this.model)">
                            <i class="fa-solid fa-caret-right"/>
                        </button>
                    </t>
                </div>
            </div>
        </t>
        <t t-else="">
            <DropdownItem onSelected="this.model.toggleDisplayMode.bind(this.model)">
                <t t-if="this.model.displayParams.displayMode === 'dense'">
                    <i class="fa-solid fa-up-right-and-down-left-from-center"/>
                    <span class="ms-1">Activate sparse mode</span>
                </t>
                <t t-else="">
                    <i class="fa-solid fa-down-left-and-up-right-to-center"/>
                    <span class="ms-1">Activate dense mode</span>
                </t>
            </DropdownItem>
            <t t-if="this.props.displayExpandCollapseButtons">
                <div class="dropdown-divider" role="separator"/>
                <t t-if="this.model.rowsAreExpanded">
                    <DropdownItem onSelected="this.model.collapseRows.bind(this.model)">
                        <i class="fa-regular fa-square-caret-down"/>
                        <span class="ms-1">Collapse rows</span>
                    </DropdownItem>
                </t>
                <t t-else="">
                    <DropdownItem onSelected="this.model.expandRows.bind(this.model)">
                        <i class="fa-regular fa-square-caret-right"/>
                        <span class="ms-1">Expand rows</span>
                    </DropdownItem>
                </t>
            </t>
        </t>
    </t>

    <t t-name="web_gantt.GanttRendererControls.RangeMenu">
        <div class="btn-group" t-att-class="{ 'ms-3': this.ui.isSmall }">
            <button class="btn btn-secondary" data-hotkey="p" aria-label="Previous period" t-on-click="() => this.selectRange('previous')" >
                <i class="oi oi-arrow-left"/>
            </button>
            <button class="btn btn-secondary" data-hotkey="n" aria-label="Next period" t-on-click="() => this.selectRange('next')">
                <i class="oi oi-arrow-right"/>
            </button>
        </div>
        <GanttScaleSelector t-props="this.getGanttScaleSelectorProps()"/>
    </t>

</templates>
