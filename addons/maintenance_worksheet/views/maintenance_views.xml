<?xml version="1.0" encoding="utf-8"?>
<odoo>
-
    <record id="maintenance_order_view_form_inherit_worksheet" model="ir.ui.view">
        <field name="name">maintenance.order.view.form.inherit.worksheet</field>
        <field name="model">maintenance.order</field>
        <field name="inherit_id" ref="maintenance.maintenance_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='schedule_overlap_count']" position="after">
                <field name="worksheet_template_id" options="{'no_create': True, 'no_create_edit':True}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="worksheet_count" invisible="1"/>
                <button name="action_maintenance_worksheet" type="object" icon="fa-pencil" invisible="not worksheet_template_id or worksheet_count &gt; 0" class="oe_stat_button oe_worksheet">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Worksheet</span>
                    </div>
                </button>
                <button name="action_maintenance_worksheet" type="object" icon="fa-check" invisible="not worksheet_template_id or worksheet_count == 0" class="oe_stat_button oe_worksheet_completed text-success">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Worksheet</span>
                        <span class="o_stat_text">Complete</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="maintenance_plan_view_form_inherit_worksheet" model="ir.ui.view">
        <field name="name">maintenance.plan.form.inherit.worksheet</field>
        <field name="model">maintenance.plan</field>
        <field name="inherit_id" ref="maintenance.maintenance_plan_view_form"/>
        <field name="arch" type="xml">
            <field name="maintenance_team_id" position="before">
                <field name="worksheet_template_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </field>
        </field>
    </record>

</odoo>
