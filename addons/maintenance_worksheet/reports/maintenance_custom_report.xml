<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="maintenance_order_report" model="ir.actions.report">
            <field name="name">Worksheet Report</field>
            <field name="model">maintenance.order</field>
            <field name="report_type">qweb-pdf</field>
            <field
                name="report_name">maintenance_worksheet.maintenance_worksheet</field>
            <field
                name="report_file">maintenance_worksheet.maintenance_worksheet</field>
            <field
                name="print_report_name">'Maintenance Order Worksheet - %s - %s' % (object.name, object.user_id.name)</field>
            <field name="binding_model_id" ref="model_maintenance_order" />
            <field name="binding_type">report</field>
        </record>
    </data>

</odoo>
