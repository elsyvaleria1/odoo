<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_dav_user" model="res.groups">
        <field name="name">DAV Sync User</field>
        <field name="privilege_id" ref="device.res_groups_privilege_device_device" />
        <field
            name="comment">Can use CalDAV/CardDAV synchronization for personal contacts and
            calendars</field>
    </record>

    <record id="group_dav_manager" model="res.groups">
        <field name="name">DAV Sync Manager</field>
        <field name="privilege_id" ref="device.res_groups_privilege_device_device" />
        <field
            name="comment">Can manage DAV addressbooks, calendars, and sync configurations</field>
        <field name="implied_ids" eval="[Command.link(ref('group_dav_user'))]" />
    </record>

    <record id="group_dav_sync_all" model="res.groups">
        <field name="name">DAV Sync: All Contacts</field>
        <field name="privilege_id" ref="device.res_groups_privilege_device_device" />
        <field
            name="comment">Device users in this group sync all company contacts (e.g. reception, management fleet phones)</field>
        <field name="implied_ids" eval="[Command.link(ref('group_dav_user'))]" />
    </record>

</odoo>
