<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dav_addressbook_tree" model="ir.ui.view">
        <field name="name">dav.addressbook.tree</field>
        <field name="model">dav.addressbook</field>
        <field name="arch" type="xml">
            <list string="DAV Addressbooks">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="user_id" />
                <field name="contact_count" />
                <field name="collection_uid" />
            </list>
        </field>
    </record>

    <record id="view_dav_addressbook_form" model="ir.ui.view">
        <field name="name">dav.addressbook.form</field>
        <field name="model">dav.addressbook</field>
        <field name="arch" type="xml">
            <form string="DAV Addressbook">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="user_id" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="collection_uid" readonly="1" />
                            <field name="ctag" readonly="1" />
                            <field name="contact_count" />
                        </group>
                    </group>
                    <group string="Filter Settings">
                        <field name="include_company_contacts" />
                        <field
                            name="contact_domain"
                            widget="domain"
                            options="{'model': 'res.partner'}" />
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dav_addressbook" model="ir.actions.act_window">
        <field name="name">DAV Addressbooks</field>
        <field name="res_model">dav.addressbook</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
