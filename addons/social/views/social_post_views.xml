<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="action_social_post" model="ir.actions.act_window">
            <field name="name">Social Posts</field>
            <field name="res_model">social.post</field>
            <field name="path">social-posts</field>
            <field name="view_mode">kanban,calendar,list,form,pivot</field>
            <field name="context">{'search_default_filter_my_posts':1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Post
                </p>
                <p>
                    Write an enticing post, add images and schedule it to be posted later on multiple platforms at once.
                </p>
            </field>
        </record>
        <record id="menu_social_post" model="ir.ui.menu">
            <field name="action" ref="action_social_post" />
        </record>
        <record id="social_post_view_kanban" model="ir.ui.view">
            <field name="name">social.post.view.kanban</field>
            <field name="model">social.post</field>
            <field name="arch" type="xml">
                <kanban sample="1" js_class="social_post_kanban_view">
                    <field name="image_ids" widget="many2many_binary" />
                    <field name="image_urls" />
                    <field name="post_method" />
                    <field name="has_post_errors" />
                    <field name="media_ids" />
                    <field name="account_ids" />
                    <field name="live_posts_by_media" />
                    <templates>
                        <t t-name="card" class="p-0">
                            <div
                                t-attf-class="#{record.has_post_errors.raw_value ? 'o_social_post_kanban_error' : ''} d-flex flex-column h-100">
                                <div
                                    class="d-flex justify-content-between border-bottom py-2 px-3">
                                    <div class="d-flex align-items-center">
                                        <t
                                            t-foreach="record.media_ids.raw_value"
                                            t-as="media_id"
                                            t-key="media_id_index">
                                            <t t-if="record.live_posts_by_media.raw_value"> <!-- unset in sample mode -->
                                                <img
                                                    class="img me-1"
                                                    height="20"
                                                    t-att-title="title"
                                                    t-attf-src="/web/image/social.media/#{media_id}/image/20x20"
                                                    alt="Media" />
                                            </t>
                                        </t>
                                    </div>
                                    <div>
                                        <field
                                            name="state"
                                            widget="label_selection"
                                            options="{'classes': {'draft': 'secondary', 'posting': 'warning', 'posted': 'success'}}"
                                            t-if="!record.has_post_errors.raw_value" />
                                        <span t-else="" class="badge text-bg-danger">Failed</span> <!-- OPW-2161231 -->
                                    </div>
                                </div>

                                <t
                                    t-set="has_attachments"
                                    t-value="(record.image_urls.raw_value || '[]') !== '[]'" />
                                <div
                                    t-attf-class="o_social_stream_post_message_body flex-grow-1 py-2 px-3 border-bottom #{has_attachments ? 'o_social_stream_post_with_attachments' : ''}">
                                    <div
                                        name="o_social_stream_post_message_text"
                                        t-attf-class="o_social_stream_post_message_text overflow-hidden #{has_attachments ? 'mb-2' : ''}">
                                        <field
                                            name="display_message"
                                            widget="social_post_formatter" />
                                    </div>

                                    <div
                                        t-if="has_attachments"
                                        class="o_social_stream_post_image d-flex mx-n3 overflow-hidden"
                                        t-att-data-images="record.image_urls.raw_value">
                                        <t t-set="image_urls_json" t-value="JSON.parse(record.image_urls.raw_value || '[]')"/>  <!-- fallback on '[]' necessary as unset in sample mode -->
                                        <t
                                            t-foreach="image_urls_json.length &gt; 2 ? image_urls_json.slice(0, 2) : image_urls_json"
                                            t-as="image_url"
                                            t-key="image_url_index">
                                            <t
                                                t-if="image_url_index == 1 and image_urls_json.length &gt; 2">
                                                <a
                                                    class="o_social_stream_post_image_more position-relative d-flex ms-1"
                                                    t-att-data-index="image_url_index"
                                                    t-att-data-image-urls="image_urls_json">
                                                    <img
                                                        t-att-src="image_urls_json[1]"
                                                        alt="Post Image" />
                                                    <div
                                                        class="o_social_stream_post_image_more_overlay d-flex align-items-center h-100 w-100 text-white justify-content-center position-absolute h1 m-0"
                                                        style="user-select: none;">
                                                        +<t t-out="image_urls_json.length - 2" />
                                                    </div>
                                                </a>
                                            </t>
                                            <img
                                                t-else=""
                                                class="o_social_stream_post_image_more"
                                                t-att-src="image_url"
                                                alt="Post Image"
                                                t-att-data-index="image_url_index"
                                                t-att-data-image-urls="image_urls_json" />
                                        </t>
                                    </div>
                                </div>
                                <div
                                    name="post-stats"
                                    class="bg-100 px-3 py-1 border-bottom">
                                    <div
                                        class="d-flex justify-content-between py-1 m-0 small">
                                        Clicks: <field name="click_count" class="fw-bold d-inline-block ms-auto" />
                                    </div>
                                    <div
                                        class="d-flex justify-content-between py-1 m-0 border-top small">
                                        Engagement: <field name="engagement" class="fw-bold d-inline-block ms-auto" />
                                    </div>
                                </div>
                                <div
                                    class="d-flex flex-grow-0 align-items-center px-3 py-2">
                                    <t t-if="record.state.raw_value === 'posted'">
                                        <i
                                            class="fa-regular fa-calendar-check me-1 small fw-bold"
                                            title="Calendar" />
                                        <field
                                            name="published_date"
                                            class="small fw-bold" />
                                    </t>
                                    <t t-if="record.state.raw_value === 'scheduled'">
                                        <i
                                            class="fa-solid fa-calendar-days me-1 small fw-bold"
                                            title="Calendar" />
                                        <field
                                            name="scheduled_date"
                                            class="small fw-bold" />
                                    </t>

                                    <field
                                        name="create_uid"
                                        widget="many2one_avatar_user"
                                        class="ms-auto" />
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="social_post_view_search" model="ir.ui.view">
            <field name="name">social.post.view.search</field>
            <field name="model">social.post</field>
            <field name="arch" type="xml">
                <search>
                    <field name="message" string="Post Message" />
                    <field name="create_uid" string="Published By" />
                    <field name="utm_campaign_id" string="Campaign" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <filter
                        name="filter_my_posts"
                        string="My Posts"
                        domain="[('create_uid','=',uid)]" />
                    <searchpanel>
                        <field name="state" icon="fa-tasks" enable_counters="1" />
                        <field
                            name="account_ids"
                            icon="fa-share-alt"
                            enable_counters="1"
                            select="multi" />
                    </searchpanel>
                    <group>
                        <filter
                            name="filter_utm_campaign_id"
                            string="Campaign"
                            context="{'group_by':'utm_campaign_id'}" />
                        <filter
                            name="filter_calendar_date"
                            string="Calendar Date"
                            context="{'group_by':'calendar_date'}" />
                        <filter
                            name="filter_company_id"
                            string="Company"
                            context="{'group_by':'company_id'}"
                            groups="base.group_multi_company" />
                    </group>
                </search>
            </field>
        </record>
        <record id="social_post_view_calendar" model="ir.ui.view">
            <field name="name">social.post.view.calendar</field>
            <field name="model">social.post</field>
            <field name="arch" type="xml">
                <calendar
                    string="Social Posts"
                    mode="month"
                    color="utm_campaign_id"
                    date_start="calendar_date"
                    quick_create="0">
                    <field name="message" />
                    <field name="is_hatched" invisible="1" />
                    <field name="utm_campaign_id" invisible="1" filters="1" />
                </calendar>
            </field>
        </record>
        <record id="social_post_view_pivot" model="ir.ui.view">
            <field name="name">social.post.view.pivot</field>
            <field name="model">social.post</field>
            <field name="arch" type="xml">
                <pivot string="Social Posts" sample="1">
                    <field name="create_date" type="row" />
                </pivot>
            </field>
        </record>
        <record id="social_post_view_list" model="ir.ui.view">
            <field name="name">social.post.view.list</field>
            <field name="model">social.post</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'draft'">
                    <field name="account_ids" widget="many2many_tags" />
                    <field name="message" />
                    <field
                        name="state"
                        widget="badge"
                        decoration-info="state == 'draft'"
                        decoration-success="state == 'scheduled' or state == 'posted'"
                        decoration-warning="state == 'posting'" />
                </list>
            </field>
        </record>
        <record id="social_post_view_form" model="ir.ui.view">
            <field name="name">social.post.view.form</field>
            <field name="model">social.post</field>
            <field name="inherit_id" ref="social_post_template_view_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button
                            name="action_post"
                            type="object"
                            string="Post"
                            groups="social.group_social_user"
                            invisible="state != 'draft' or post_method == 'scheduled'"
                            class="oe_highlight" />
                        <button
                            name="action_post"
                            type="object"
                            string="Post Now"
                            groups="social.group_social_user"
                            invisible="state != 'scheduled'"
                            data-hotkey="v" />
                        <button
                            name="action_set_draft"
                            type="object"
                            string="Cancel"
                            groups="social.group_social_user"
                            invisible="state != 'scheduled'"
                            data-hotkey="x" />
                        <button
                            name="action_schedule"
                            type="object"
                            string="Schedule"
                            groups="social.group_social_user"
                            invisible="state != 'draft' or post_method == 'now'"
                            class="oe_highlight"
                            data-hotkey="q" />
                        <field name="state" widget="statusbar" />
                    </header>
                </xpath>

                <xpath expr="//sheet/group[1]" position="before">
                    <div
                        class="oe_button_box"
                        name="button_box"
                        invisible="state == 'draft'">
                        <button
                            name="action_redirect_to_clicks"
                            type="object"
                            icon="fa-mouse-pointer"
                            class="oe_stat_button">
                            <field
                                name="click_count"
                                string="Clicks"
                                widget="statinfo" />
                        </button>
                        <button
                            icon="fa-thumbs-up"
                            invisible="engagement == 0"
                            class="oe_stat_button o_social_post_engagement_stat_btn">
                            <field
                                name="engagement"
                                string="Engagement"
                                widget="statinfo" />
                        </button>
                        <button
                            name="social_stream_post_action_my"
                            type="object"
                            icon="fa-newspaper-o"
                            invisible="stream_posts_count == 0"
                            class="oe_stat_button">
                            <field
                                name="stream_posts_count"
                                string="Feed Posts"
                                widget="statinfo" />
                        </button>
                    </div>
                </xpath>

                <xpath expr="//field[@name='account_ids']" position="attributes">
                    <attribute name="invisible">not has_active_accounts or state in ['posting', 'posted']</attribute>
                    <!-- Remove the domain added on the social post template form view and allow to select Youtube accounts for a social post -->
                    <attribute name="domain">[('id', 'in', account_allowed_ids)]</attribute>
                </xpath>

                <xpath expr="//field[@name='message']" position="attributes">
                    <attribute name="readonly">not has_active_accounts or state in ['posting', 'posted']</attribute>
                    <attribute name="required">not image_ids</attribute>
                    <attribute
                        name="invisible"
                        add="state in ['posting', 'posted']"
                        separator="or" />
                </xpath>

                <xpath
                    expr="//notebook[@name='media_customization']"
                    position="attributes">
                    <attribute
                        name="invisible"
                        add="state in ['posting', 'posted']"
                        separator="or" />
                </xpath>

                <xpath
                    expr="//group[@name='previews_placeholder']"
                    position="attributes">
                    <attribute
                        name="invisible"
                        add="state in ['posting', 'posted']"
                        separator="or" />
                </xpath>

                <xpath expr="//field[@name='image_ids']" position="attributes">
                    <attribute name="readonly">state in ['posting', 'posted']</attribute>
                    <attribute name="required">not message and not is_split_per_media</attribute>
                    <attribute
                        name="invisible"
                        add="state in ['posting', 'posted']"
                        separator="or" />
                </xpath>

                <xpath expr="//field[@name='account_ids']" position="before">
                    <field
                        name="company_id"
                        placeholder="Visible to all"
                        options="{'no_create': True}"
                        groups="base.group_multi_company"
                        readonly="state in ['posting', 'posted']" />
                    <field
                        name="company_id"
                        groups="!base.group_multi_company"
                        invisible="1" />
                    <field name="account_allowed_ids" invisible="1" />
                </xpath>

                <xpath expr="//field[@name='image_ids']" position="after">
                    <field
                        name="utm_campaign_id"
                        string="Campaign"
                        context="{'form_view_ref': 'social.utm_campaign_view_form_quick_create_social'}"
                        readonly="state in ['posting', 'posted']" />
                    <field
                        name="post_method"
                        widget="radio"
                        invisible="state != 'draft'" />
                    <field
                        name="scheduled_date"
                        invisible="post_method == 'now' or state in ['posting', 'posted']"
                        required="post_method != 'now'" />
                </xpath>

                <xpath expr="//group[@name='previews_placeholder']" position="after">
                    <group
                        name="live_posts"
                        string="Posts"
                        colspan="2"
                        invisible="state not in ['posting', 'posted']">
                        <field name="live_post_ids" colspan="2" nolabel="1">
                            <kanban>
                                <field name="live_post_link" />
                                <templates>
                                    <t
                                        t-name="card"
                                        class="o_social_live_post_kanban ms-0">
                                        <div class="row">
                                            <div class="col-md-8 fw-bolder">
                                                <field name="account_id" />
                                                <a t-if="record.live_post_link.raw_value" t-att-href="record.live_post_link.raw_value" target="blank"><i class="fa-solid fa-earth-americas ms-1" title="See the post" /></a>
                                            </div>
                                            <div class="col-md-4 text-end mb-2">
                                                <field
                                                    name="state"
                                                    widget="label_selection"
                                                    options="{'classes': {'ready': 'info', 'posting': 'warning', 'posted': 'success', 'failed': 'danger'}}" />
                                            </div>
                                        </div>
                                        <div
                                            class="d-flex flex-row justify-content-between w-100">
                                            <div
                                                class="o_live_post_content d-flex flex-column overflow-hidden pe-2">
                                                <field
                                                    name="message"
                                                    widget="social_post_formatter" />
                                            </div>
                                            <field
                                                name="image_ids"
                                                widget="social_many2many_images"
                                                class="w-auto" />
                                        </div>
                                        <div
                                            class="text-end mt-4 d-flex flex-row w-100 justify-content-between">
                                            <div
                                                class="o_social_live_post_kanban_failure_reason mt-2"
                                                t-att-title="record.failure_reason.raw_value">
                                                <field name="failure_reason" />
                                            </div>
                                            <button
                                                name="action_retry_post"
                                                type="object"
                                                string="Retry"
                                                invisible="state != 'failed'"
                                                class="btn btn-primary">
                                                Retry
                                            </button>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </xpath>

                <xpath expr="//sheet" position="after">
                    <chatter />
                </xpath>
            </field>
        </record>
    </data>

</odoo>
