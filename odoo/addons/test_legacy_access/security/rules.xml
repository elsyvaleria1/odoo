<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_note_own" model="ir.rule">
        <field name="name">Notes: their own</field>
        <field name="model_id" ref="model_test_legacy_access_note" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[Command.link(ref('group_note_user')), Command.link(ref('group_note_auditor'))]" />
    </record>

    <record id="rule_note_manager_all" model="ir.rule">
        <field name="name">Notes: all of them, for managers</field>
        <field name="model_id" ref="model_test_legacy_access_note" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_note_manager'))]" />
    </record>

    <record id="rule_note_not_cancelled" model="ir.rule">
        <field name="name">Notes: never the cancelled ones</field>
        <field name="model_id" ref="model_test_legacy_access_note" />
        <field name="domain_force">[('state', '!=', 'cancel')]</field>
    </record>

    <data noupdate="1">
        <record id="rule_note_public" model="ir.rule">
            <field name="name">Notes: the public ones, for employees</field>
            <field name="model_id" ref="model_test_legacy_access_note" />
            <field name="domain_force">[('public', '=', True)]</field>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]" />
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>
    </data>

</odoo>
