<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_access_drift_view_list" model="ir.ui.view">
        <field name="name">ir.access.drift.list</field>
        <field name="model">ir.access.drift</field>
        <field name="arch" type="xml">
            <list string="Access Drift" create="0" edit="0" delete="0">
                <field name="state" />
                <field name="xmlid" />
                <field name="module" optional="hide" />
                <field name="changed" />
                <field name="writer_id" />
                <field name="first_seen" />
            </list>
        </field>
    </record>

    <record id="ir_access_drift_view_form" model="ir.ui.view">
        <field name="name">ir.access.drift.form</field>
        <field name="model">ir.access.drift</field>
        <field name="arch" type="xml">
            <form string="Access Drift" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="state" />
                            <field name="xmlid" />
                            <field name="module" />
                            <field name="access_id" />
                        </group>
                        <group>
                            <field name="changed" />
                            <field name="writer_id" />
                            <field name="first_seen" />
                        </group>
                    </group>
                    <field name="detail" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="ir_access_drift_view_search" model="ir.ui.view">
        <field name="name">ir.access.drift.search</field>
        <field name="model">ir.access.drift</field>
        <field name="arch" type="xml">
            <search string="Access Drift">
                <field name="xmlid" />
                <field name="module" />
                <field name="changed" />
                <filter
                    name="differs"
                    string="Differs From Its File"
                    domain="[('state', '=', 'differs')]" />
                <filter
                    name="orphan"
                    string="Shipped by No Module"
                    domain="[('state', 'in', ('orphan', 'missing'))]" />
                <filter
                    name="custom"
                    string="Written Without a Module"
                    domain="[('state', '=', 'custom')]" />
                <group>
                    <filter
                        name="group_by_state"
                        string="State"
                        context="{'group_by': 'state'}" />
                    <filter
                        name="group_by_module"
                        string="Module"
                        context="{'group_by': 'module'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_ir_access_drift" model="ir.actions.act_window">
        <field name="name">Access Drift</field>
        <field name="res_model">ir.access.drift</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

</odoo>
