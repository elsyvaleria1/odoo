<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_access_changeset_line_view_list" model="ir.ui.view">
        <field name="name">ir.access.changeset.line.list</field>
        <field name="model">ir.access.changeset.line</field>
        <field name="arch" type="xml">
            <list string="Changes" create="0" edit="0" delete="0">
                <field name="record_name" />
                <field name="operation" />
                <field name="values_before" />
                <field name="values_after" />
            </list>
        </field>
    </record>

    <record id="ir_access_changeset_view_list" model="ir.ui.view">
        <field name="name">ir.access.changeset.list</field>
        <field name="model">ir.access.changeset</field>
        <field name="arch" type="xml">
            <list string="Change Sets" create="0">
                <field name="name" />
                <field name="author_id" />
                <field name="cause" optional="hide" />
                <field name="state" />
                <field name="activated_at" optional="show" />
                <field name="activated_by_id" optional="show" />
                <field name="policy_version" optional="hide" />
            </list>
        </field>
    </record>

    <record id="ir_access_changeset_view_form" model="ir.ui.view">
        <field name="name">ir.access.changeset.form</field>
        <field name="model">ir.access.changeset</field>
        <field name="arch" type="xml">
            <form string="Change Set" create="0">
                <header>
                    <button
                        name="action_propose"
                        type="object"
                        string="Propose"
                        invisible="state != 'draft'"
                        class="btn-primary" />
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        invisible="state not in ('draft', 'proposed')" />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state not in ('draft', 'proposed')" />
                    <button
                        name="action_open_matrix"
                        type="object"
                        string="Access Matrix"
                        invisible="state not in ('draft', 'proposed')" />
                    <button
                        name="action_rollback"
                        type="object"
                        string="Roll Back"
                        invisible="state != 'active'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="author_id" />
                            <field name="cause" />
                            <field
                                name="rollback_of_id"
                                invisible="not rollback_of_id" />
                        </group>
                        <group>
                            <field name="activated_at" />
                            <field name="activated_by_id" />
                            <field name="policy_version" />
                        </group>
                    </group>
                    <notebook>
                        <page name="changes" string="Changes">
                            <field name="line_ids" readonly="1" />
                        </page>
                        <page name="impact" string="Impact">
                            <field name="impact_summary" class="font-monospace" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_access_changeset" model="ir.actions.act_window">
        <field name="name">Change Sets</field>
        <field name="res_model">ir.access.changeset</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
