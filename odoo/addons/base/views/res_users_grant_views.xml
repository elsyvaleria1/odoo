<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_users_grant_view_list" model="ir.ui.view">
        <field name="name">res.users.grant.list</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <list
                string="Grants"
                decoration-info="state == 'scheduled'"
                decoration-muted="state in ('expired', 'revoked')">
                <field name="user_id" />
                <field name="group_id" />
                <field
                    name="company_ids"
                    widget="many2many_tags"
                    optional="show"
                    groups="base.group_multi_company" />
                <field name="date_from" optional="show" />
                <field name="date_to" optional="show" />
                <field name="state" widget="badge" />
                <field name="cause" optional="show" />
                <field name="granted_by_id" optional="show" />
                <field name="create_date" string="Granted On" optional="hide" />
                <field name="reason" optional="hide" />
                <field name="sod_rule_ids" widget="many2many_tags" optional="show" />
            </list>
        </field>
    </record>

    <record id="res_users_grant_view_form" model="ir.ui.view">
        <field name="name">res.users.grant.form</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <form string="Grant">
                <header>
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        confirm="End this grant now?"
                        invisible="state not in ('scheduled', 'active')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="id" />
                            <field name="group_id" readonly="id" />
                            <field
                                name="company_ids"
                                widget="many2many_tags"
                                groups="base.group_multi_company"
                                readonly="state in ('expired', 'revoked')" />
                            <field name="reason" />
                        </group>
                        <group>
                            <field
                                name="date_from"
                                readonly="state not in ('scheduled', False)" />
                            <field
                                name="date_to"
                                readonly="state in ('expired', 'revoked')" />
                            <field name="cause" />
                            <field name="cause_model" invisible="not cause_model" />
                            <field name="cause_res_id" invisible="not cause_model" />
                        </group>
                    </group>
                    <group invisible="not id">
                        <group>
                            <field name="granted_by_id" />
                            <field name="create_date" string="Granted On" />
                        </group>
                        <group invisible="state != 'revoked'">
                            <field name="revoked_by_id" />
                            <field name="revoked_at" />
                            <field name="revoke_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_users_grant_view_search" model="ir.ui.view">
        <field name="name">res.users.grant.search</field>
        <field name="model">res.users.grant</field>
        <field name="arch" type="xml">
            <search string="Grants">
                <field name="user_id" />
                <field name="group_id" />
                <field name="granted_by_id" />
                <filter
                    name="live"
                    string="Live"
                    domain="[('state', 'in', ('scheduled', 'active'))]" />
                <filter
                    name="timed"
                    string="Time-bound"
                    domain="[('date_to', '!=', False)]" />
                <filter
                    name="in_conflict"
                    string="Duties in Conflict"
                    domain="[('sod_rule_ids', '!=', False)]" />
                <separator />
                <filter
                    name="ended"
                    string="Ended"
                    domain="[('state', 'in', ('expired', 'revoked'))]" />
                <group>
                    <filter
                        name="group_by_user"
                        string="User"
                        context="{'group_by': 'user_id'}" />
                    <filter
                        name="group_by_group"
                        string="Group"
                        context="{'group_by': 'group_id'}" />
                    <filter
                        name="group_by_cause"
                        string="Cause"
                        context="{'group_by': 'cause'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_users_grant" model="ir.actions.act_window">
        <field name="name">Grants</field>
        <field name="res_model">res.users.grant</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="res_users_eligibility_view_list" model="ir.ui.view">
        <field name="name">res.users.eligibility.list</field>
        <field name="model">res.users.eligibility</field>
        <field name="arch" type="xml">
            <list string="Eligibilities">
                <field name="user_id" />
                <field name="group_id" />
                <field name="company_ids" widget="many2many_tags" optional="show" />
                <field name="max_hours" />
                <field name="justification_required" optional="hide" />
                <field name="active_until" />
                <field name="state" />
                <button
                    name="action_open_activate"
                    type="object"
                    string="Activate"
                    icon="fa-bolt"
                    invisible="state != 'active' or active_until" />
                <button
                    name="action_stop"
                    type="object"
                    string="Stop"
                    icon="fa-stop"
                    invisible="not active_until" />
            </list>
        </field>
    </record>

    <record id="res_users_eligibility_view_form" model="ir.ui.view">
        <field name="name">res.users.eligibility.form</field>
        <field name="model">res.users.eligibility</field>
        <field name="arch" type="xml">
            <form string="Eligibility">
                <header>
                    <button
                        name="action_open_activate"
                        type="object"
                        string="Activate"
                        invisible="state != 'active' or active_until"
                        class="btn-primary" />
                    <button
                        name="action_stop"
                        type="object"
                        string="Stop"
                        invisible="not active_until" />
                    <button
                        name="action_revoke"
                        type="object"
                        string="Revoke"
                        groups="base.group_erp_manager"
                        invisible="state != 'active'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" readonly="id" />
                            <field name="group_id" readonly="id" />
                            <field name="company_ids" widget="many2many_tags" />
                            <field name="reason" />
                        </group>
                        <group>
                            <field name="max_hours" />
                            <field name="justification_required" />
                            <field name="is_break_glass" />
                            <field name="active_until" />
                            <field name="granted_by_id" />
                            <field name="revoked_by_id" invisible="not revoked_by_id" />
                            <field name="revoked_at" invisible="not revoked_at" />
                            <field name="revoke_reason" invisible="not revoke_reason" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_users_eligibility_view_search" model="ir.ui.view">
        <field name="name">res.users.eligibility.search</field>
        <field name="model">res.users.eligibility</field>
        <field name="arch" type="xml">
            <search string="Eligibilities">
                <field name="user_id" />
                <field name="group_id" />
                <filter
                    name="live"
                    string="Active"
                    domain="[('state', '=', 'active')]" />
                <filter
                    name="break_glass"
                    string="Break-Glass"
                    domain="[('is_break_glass', '=', True)]" />
            </search>
        </field>
    </record>

    <record id="action_res_users_eligibility" model="ir.actions.act_window">
        <field name="name">Eligibilities</field>
        <field name="res_model">res.users.eligibility</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
    </record>

    <record id="res_users_eligibility_activate_view_form" model="ir.ui.view">
        <field name="name">res.users.eligibility.activate.form</field>
        <field name="model">wizard.res.users.eligibility.activate</field>
        <field name="arch" type="xml">
            <form string="Activate">
                <group>
                    <field name="eligibility_id" readonly="1" />
                    <field name="hours" />
                    <field name="justification" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Activate"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="ir_access_log_view_list" model="ir.ui.view">
        <field name="name">ir.access.log.list</field>
        <field name="model">ir.access.log</field>
        <field name="arch" type="xml">
            <list string="Authorization Log" create="0" edit="0" delete="0">
                <field name="create_date" string="Date" />
                <field name="event" />
                <field name="actor_id" />
                <field name="subject_user_id" />
                <field name="group_id" />
                <field name="model_name" optional="show" />
                <field name="operation" optional="show" />
                <field name="res_ids" optional="hide" />
                <field name="cause" optional="show" />
                <field name="count" optional="hide" />
                <field name="reason" optional="show" />
            </list>
        </field>
    </record>

    <record id="ir_access_log_view_search" model="ir.ui.view">
        <field name="name">ir.access.log.search</field>
        <field name="model">ir.access.log</field>
        <field name="arch" type="xml">
            <search string="Authorization Log">
                <field name="subject_user_id" />
                <field name="actor_id" />
                <field name="group_id" />
                <field name="event" />
                <field name="model_name" />
                <filter
                    name="security_changes"
                    string="Security Changes"
                    domain="[('event', 'in', ('security_changed', 'module_security_updated'))]" />
                <filter
                    name="denials"
                    string="Refusals"
                    domain="[('event', '=', 'denial')]" />
                <filter
                    name="grants"
                    string="Grants"
                    domain="[('event', 'like', 'grant_')]" />
                <filter
                    name="links"
                    string="Links"
                    domain="[('event', 'like', 'link_')]" />
                <separator />
                <filter name="create_date" string="Date" date="create_date" />
                <group>
                    <filter
                        name="group_by_month"
                        string="Month"
                        context="{'group_by': 'create_date:month'}" />
                    <filter
                        name="group_by_event"
                        string="Event"
                        context="{'group_by': 'event'}" />
                    <filter
                        name="group_by_subject"
                        string="Subject"
                        context="{'group_by': 'subject_user_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="ir_access_log_view_form" model="ir.ui.view">
        <field name="name">ir.access.log.form</field>
        <field name="model">ir.access.log</field>
        <field name="arch" type="xml">
            <form string="Authorization Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event" />
                            <field name="create_date" string="Date" />
                            <field name="actor_id" />
                            <field name="subject_user_id" />
                            <field name="group_id" />
                            <field name="grant_id" />
                        </group>
                        <group>
                            <field name="model_name" />
                            <field name="operation" />
                            <field name="res_ids" />
                            <field name="cause" />
                            <field name="reason" />
                            <field name="count" />
                        </group>
                    </group>
                    <field name="values" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_access_log" model="ir.actions.act_window">
        <field name="name">Authorization Log</field>
        <field name="res_model">ir.access.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
