# /etc/odoo-runner/deploy.env -- mode 0600, owned by root.
ODOO_URL=https://odoo.example.com
# The deploy runner's own token: a runner with the deploy capability only.
RUNNER_TOKEN=
# The checkouts the production server runs, by the names Odoo's autofix
# repositories use (Autofix > Repositories).
RUNNER_DEPLOY_CHECKOUTS={"odoo": "/opt/odoo/odoo", "agromarin": "/opt/odoo/agromarin", "l10n": "/opt/odoo/l10n"}
# {modules} is the comma-separated list of modules the fix touches.
RUNNER_DEPLOY_UPGRADE=/opt/odoo/venv/bin/python /opt/odoo/odoo/odoo-bin -c /etc/odoo/odoo.conf -d production -u {modules} --stop-after-init --no-http
RUNNER_DEPLOY_RESTART=/usr/bin/systemctl restart odoo.service
# Optional: stop the server for the upgrade instead of upgrading under it.
# RUNNER_DEPLOY_STOP=/usr/bin/systemctl stop odoo.service
# RUNNER_DEPLOY_START=/usr/bin/systemctl start odoo.service
# RUNNER_DEPLOY_UPGRADE_TIMEOUT=3600
# Exit 0 = healthy; retried every 2 s for up to RUNNER_DEPLOY_HEALTH_WAIT seconds.
RUNNER_DEPLOY_HEALTH=/usr/bin/curl -fsS -m 10 -o /dev/null http://127.0.0.1:8069/web/health
RUNNER_DEPLOY_HEALTH_WAIT=120
