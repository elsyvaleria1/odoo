# /etc/odoo-runner/sandbox.env -- mode 0600, owned by root.
# The Odoo server the runner claims work from.
ODOO_URL=https://odoo.example.com
# The token Runners > Runners > Issue Token showed once.
RUNNER_TOKEN=
# The agent's command: Claude Code, outside /home (the service cannot read it).
RUNNER_CLAUDE=/usr/local/bin/claude
